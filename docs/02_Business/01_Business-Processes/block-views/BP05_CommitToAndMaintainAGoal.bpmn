<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP05_CommitToAndMaintainAGoal_Blocks" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP05_CommitToAndMaintainAGoal_Blocks">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A commitment to make, or one to maintain">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="BB01 OpenView · the Goals view, goals grouped by theme with their active measures">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_hub</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="hub" name="Work a goal">
      <bpmn:incoming>SF_T_2_hub</bpmn:incoming>
      <bpmn:incoming>SF_T_4_hub</bpmn:incoming>
      <bpmn:incoming>SF_T_5_hub</bpmn:incoming>
      <bpmn:incoming>SF_T_6_hub</bpmn:incoming>
      <bpmn:incoming>SF_T_7_hub</bpmn:incoming>
      <bpmn:incoming>SF_T_8_hub</bpmn:incoming>
      <bpmn:incoming>SF_T_9_hub</bpmn:incoming>
      <bpmn:incoming>SF_T_10_hub</bpmn:incoming>
      <bpmn:outgoing>SF_hub_Gw_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_3" name="What needs doing?">
      <bpmn:incoming>SF_hub_Gw_3</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_3_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_5</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_6</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_8</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_9</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_10</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_done</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_4" name="BB03 EditContent · the goal, refused where it names no theme">
      <bpmn:incoming>SF_Gw_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_hub</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_5" name="BB05 EditState · the order of the goals within a theme">
      <bpmn:incoming>SF_Gw_3_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_hub</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_6" name="BB07 ArchiveCascadedItem · the goal with its projects, or the goal alone">
      <bpmn:incoming>SF_Gw_3_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_hub</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_7" name="BB10 DeleteCascadedItem · the goal, with its linked ideas and its projects">
      <bpmn:incoming>SF_Gw_3_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_hub</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_8" name="BB02 OpenItem · the inferred statuses, the draft and the linked projects, the sitting itself being BP07's">
      <bpmn:incoming>SF_Gw_3_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_hub</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_9" name="BB03 EditContent · a project created on the goal or one of its measures, working it being BP17's">
      <bpmn:incoming>SF_Gw_3_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_hub</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_10" name="Seam · the archived goals, which are BP15's">
      <bpmn:incoming>SF_Gw_3_T_10</bpmn:incoming>
      <bpmn:outgoing>SF_T_10_hub</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="done" name="Everything done">
      <bpmn:incoming>SF_Gw_3_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_hub" sourceRef="T_2" targetRef="hub" />
    <bpmn:sequenceFlow id="SF_hub_Gw_3" sourceRef="hub" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_4" name="commit to something, or change one" sourceRef="Gw_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_5" name="reorder them" sourceRef="Gw_3" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_6" name="set one aside" sourceRef="Gw_3" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_7" name="end the commitment for good" sourceRef="Gw_3" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_8" name="check one out" sourceRef="Gw_3" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_9" name="start work on one" sourceRef="Gw_3" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_10" name="look at the archived ones" sourceRef="Gw_3" targetRef="T_10" />
    <bpmn:sequenceFlow id="SF_T_4_hub" sourceRef="T_4" targetRef="hub" />
    <bpmn:sequenceFlow id="SF_T_5_hub" sourceRef="T_5" targetRef="hub" />
    <bpmn:sequenceFlow id="SF_T_6_hub" sourceRef="T_6" targetRef="hub" />
    <bpmn:sequenceFlow id="SF_T_7_hub" sourceRef="T_7" targetRef="hub" />
    <bpmn:sequenceFlow id="SF_T_8_hub" sourceRef="T_8" targetRef="hub" />
    <bpmn:sequenceFlow id="SF_T_9_hub" sourceRef="T_9" targetRef="hub" />
    <bpmn:sequenceFlow id="SF_T_10_hub" sourceRef="T_10" targetRef="hub" />
    <bpmn:sequenceFlow id="SF_Gw_3_done" name="nothing more" sourceRef="Gw_3" targetRef="done" />
  </bpmn:process>
