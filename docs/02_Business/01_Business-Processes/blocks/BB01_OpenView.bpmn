<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BB01_OpenView" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BB01_OpenView">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BB01.01 · Read the &lt;view&gt;" sourceRef="T_1" targetRef="readIn" />
    <bpmn:messageFlow id="MF_2" name="&lt;What the view carries&gt;" sourceRef="T_5" targetRef="payload" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>Nothing is fetched here: every record is loaded at start-up, so the chain takes what the view works on and calculates what has to be derived over it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_3" targetRef="TextAnnotation_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:task id="T_1" name="Open the &lt;view&gt;">
      <bpmn:outgoing>SF_T_1_payload</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="payload" name="&lt;What the view carries&gt;">
      <bpmn:incoming>SF_T_1_payload</bpmn:incoming>
      <bpmn:outgoing>SF_payload_End_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_payload" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_2" name="The view is in front of the user">
      <bpmn:incoming>SF_payload_End_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_T_1_payload" sourceRef="T_1" targetRef="payload" />
    <bpmn:sequenceFlow id="SF_payload_End_2" sourceRef="payload" targetRef="End_2" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="readIn" name="&lt;View&gt; requested">
      <bpmn:outgoing>SF_readIn_T_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_readIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_3" name="Take the &lt;view&gt; data the act works on">
      <bpmn:incoming>SF_readIn_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_T_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_4" name="Calculate derived &lt;view&gt; data">
      <bpmn:incoming>SF_T_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_T_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_5" name="Report collected information">
      <bpmn:incoming>SF_T_4_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_End_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_6" name="Read answered">
      <bpmn:incoming>SF_T_5_End_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_T_3_T_4" sourceRef="T_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_4_T_5" sourceRef="T_4" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_readIn_T_3" sourceRef="readIn" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_T_5_End_6" sourceRef="T_5" targetRef="End_6" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_BB01_OpenView">
    <bpmndi:BPMNPlane id="P_BB01_OpenView" bpmnElement="Collaboration_BB01_OpenView">
      <bpmndi:BPMNShape id="Participant_User_di" bpmnElement="Participant_User" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="900" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Bearing_di" bpmnElement="Participant_Bearing" isHorizontal="true">
        <dc:Bounds x="160" y="380" width="900" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_1_di" bpmnElement="T_1">
        <dc:Bounds x="220" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="payload_di" bpmnElement="payload">
        <dc:Bounds x="762" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="738" y="223" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_2_di" bpmnElement="End_2">
        <dc:Bounds x="932" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="908" y="223" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="readIn_di" bpmnElement="readIn">
        <dc:Bounds x="252" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="228" y="523" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_3_di" bpmnElement="T_3">
        <dc:Bounds x="390" y="460" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_4_di" bpmnElement="T_4">
        <dc:Bounds x="560" y="460" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_5_di" bpmnElement="T_5">
        <dc:Bounds x="730" y="460" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_6_di" bpmnElement="End_6">
        <dc:Bounds x="932" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="908" y="523" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SF_T_1_payload_di" bpmnElement="SF_T_1_payload">
        <di:waypoint x="320" y="200" />
        <di:waypoint x="762" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_payload_End_2_di" bpmnElement="SF_payload_End_2">
        <di:waypoint x="798" y="200" />
        <di:waypoint x="932" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_T_3_T_4_di" bpmnElement="SF_T_3_T_4">
        <di:waypoint x="490" y="500" />
        <di:waypoint x="560" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_T_4_T_5_di" bpmnElement="SF_T_4_T_5">
        <di:waypoint x="660" y="500" />
        <di:waypoint x="730" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_readIn_T_3_di" bpmnElement="SF_readIn_T_3">
        <di:waypoint x="288" y="500" />
        <di:waypoint x="390" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_T_5_End_6_di" bpmnElement="SF_T_5_End_6">
        <di:waypoint x="830" y="500" />
        <di:waypoint x="932" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_1_di" bpmnElement="MF_1">
        <di:waypoint x="270" y="240" />
        <di:waypoint x="270" y="482" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_2_di" bpmnElement="MF_2">
        <di:waypoint x="780" y="460" />
        <di:waypoint x="780" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="TextAnnotation_X1_di" bpmnElement="TextAnnotation_X1"><dc:Bounds x="320" y="560" width="240" height="91" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Association_X1_di" bpmnElement="Association_X1"><di:waypoint x="440" y="540" /><di:waypoint x="440" y="560" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
