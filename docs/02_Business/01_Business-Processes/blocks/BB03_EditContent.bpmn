<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BB03_EditContent" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BB03_EditContent">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BB03.01 · Edit a &lt;entity&gt;" sourceRef="T_2" targetRef="editIn" />
    <bpmn:messageFlow id="MF_2" name="The editing outcome" sourceRef="T_7" targetRef="outcome" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>One editor serves a &lt;entity&gt; the user has just named and one they are changing alike, so where a new one lands in the order is not drawn. A refusal is an outcome the reply carries, never an error.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="Gw_4" targetRef="TextAnnotation_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:task id="T_1" name="&lt;Act&gt; the &lt;entity&gt;">
      <bpmn:outgoing>SF_T_1_T_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_2" name="Submit the &lt;entity&gt;">
      <bpmn:incoming>SF_T_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_outcome</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="outcome" name="The editing outcome">
      <bpmn:incoming>SF_T_2_outcome</bpmn:incoming>
      <bpmn:outgoing>SF_outcome_End_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_outcome" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_3" name="Back on the surface">
      <bpmn:incoming>SF_outcome_End_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_T_1_T_2" sourceRef="T_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_outcome" sourceRef="T_2" targetRef="outcome" />
    <bpmn:sequenceFlow id="SF_outcome_End_3" sourceRef="outcome" targetRef="End_3" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="editIn" name="&lt;Entity&gt; submitted">
      <bpmn:outgoing>SF_editIn_Gw_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_editIn" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_4" name="Does a rule refuse the edit?">
      <bpmn:incoming>SF_editIn_Gw_4</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_4_T_5</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_4_T_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_5" name="Refuse it and say why">
      <bpmn:incoming>SF_Gw_4_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_T_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_6" name="Store the edit">
      <bpmn:incoming>SF_Gw_4_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_T_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_7" name="Report the outcome">
      <bpmn:incoming>SF_T_5_T_7</bpmn:incoming>
      <bpmn:incoming>SF_T_6_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_End_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_8" name="&lt;Entity&gt; answered">
      <bpmn:incoming>SF_T_7_End_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Gw_4_T_5" name="yes" sourceRef="Gw_4" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_Gw_4_T_6" name="no" sourceRef="Gw_4" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_T_5_T_7" sourceRef="T_5" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_T_6_T_7" sourceRef="T_6" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_editIn_Gw_4" sourceRef="editIn" targetRef="Gw_4" />
    <bpmn:sequenceFlow id="SF_T_7_End_8" sourceRef="T_7" targetRef="End_8" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_BB03_EditContent">
    <bpmndi:BPMNPlane id="P_BB03_EditContent" bpmnElement="Collaboration_BB03_EditContent">
      <bpmndi:BPMNShape id="Participant_User_di" bpmnElement="Participant_User" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1070" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Bearing_di" bpmnElement="Participant_Bearing" isHorizontal="true">
        <dc:Bounds x="160" y="380" width="1070" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_1_di" bpmnElement="T_1">
        <dc:Bounds x="220" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_2_di" bpmnElement="T_2">
        <dc:Bounds x="390" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="outcome_di" bpmnElement="outcome">
        <dc:Bounds x="932" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="908" y="223" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_3_di" bpmnElement="End_3">
        <dc:Bounds x="1102" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1078" y="223" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="editIn_di" bpmnElement="editIn">
        <dc:Bounds x="422" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="398" y="523" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_4_di" bpmnElement="Gw_4">
        <dc:Bounds x="585" y="475" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="568" y="530" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_5_di" bpmnElement="T_5">
        <dc:Bounds x="730" y="460" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_6_di" bpmnElement="T_6">
        <dc:Bounds x="730" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_7_di" bpmnElement="T_7">
        <dc:Bounds x="900" y="460" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_8_di" bpmnElement="End_8">
        <dc:Bounds x="1102" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1078" y="523" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SF_T_1_T_2_di" bpmnElement="SF_T_1_T_2">
        <di:waypoint x="320" y="200" />
        <di:waypoint x="390" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_T_2_outcome_di" bpmnElement="SF_T_2_outcome">
        <di:waypoint x="490" y="200" />
        <di:waypoint x="932" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_outcome_End_3_di" bpmnElement="SF_outcome_End_3">
        <di:waypoint x="968" y="200" />
        <di:waypoint x="1102" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_Gw_4_T_5_di" bpmnElement="SF_Gw_4_T_5">
        <di:waypoint x="635" y="500" />
        <di:waypoint x="730" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_Gw_4_T_6_di" bpmnElement="SF_Gw_4_T_6">
        <di:waypoint x="635" y="500" />
        <di:waypoint x="665" y="500" />
