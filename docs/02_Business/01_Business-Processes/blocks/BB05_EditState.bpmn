<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BB05_EditState" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BB05_EditState">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BB05.01 · Set a &lt;entity&gt;'s &lt;state&gt;" sourceRef="T_1" targetRef="stateIn" />
    <bpmn:messageFlow id="MF_2" name="The &lt;state&gt; outcome" sourceRef="T_6" targetRef="outcome" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>A state is its own act where it has an owner or a consequence beyond the record; otherwise it is a field of the editor. Where the answer also raises a further act - a move that put an activity's last task into Done - that is the member's own business.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="Gw_3" targetRef="TextAnnotation_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:task id="T_1" name="Set the &lt;entity&gt;'s &lt;state&gt;">
      <bpmn:outgoing>SF_T_1_outcome</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="outcome" name="The &lt;state&gt; outcome">
      <bpmn:incoming>SF_T_1_outcome</bpmn:incoming>
      <bpmn:outgoing>SF_outcome_End_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_outcome" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_2" name="Back on the surface">
      <bpmn:incoming>SF_outcome_End_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_T_1_outcome" sourceRef="T_1" targetRef="outcome" />
    <bpmn:sequenceFlow id="SF_outcome_End_2" sourceRef="outcome" targetRef="End_2" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="stateIn" name="&lt;State&gt; submitted">
      <bpmn:outgoing>SF_stateIn_Gw_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_stateIn" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_3" name="Does a rule refuse the change?">
      <bpmn:incoming>SF_stateIn_Gw_3</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_3_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_4" name="Refuse the change and say why">
      <bpmn:incoming>SF_Gw_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_T_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_5" name="Apply the change">
      <bpmn:incoming>SF_Gw_3_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_T_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_6" name="Report the outcome">
      <bpmn:incoming>SF_T_4_T_6</bpmn:incoming>
      <bpmn:incoming>SF_T_5_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_End_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_7" name="&lt;State&gt; answered">
      <bpmn:incoming>SF_T_6_End_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Gw_3_T_4" name="yes" sourceRef="Gw_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_5" name="no" sourceRef="Gw_3" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_4_T_6" sourceRef="T_4" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_T_5_T_6" sourceRef="T_5" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_stateIn_Gw_3" sourceRef="stateIn" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="SF_T_6_End_7" sourceRef="T_6" targetRef="End_7" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_BB05_EditState">
    <bpmndi:BPMNPlane id="P_BB05_EditState" bpmnElement="Collaboration_BB05_EditState">
      <bpmndi:BPMNShape id="Participant_User_di" bpmnElement="Participant_User" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="900" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Bearing_di" bpmnElement="Participant_Bearing" isHorizontal="true">
        <dc:Bounds x="160" y="380" width="900" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_1_di" bpmnElement="T_1">
        <dc:Bounds x="220" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="outcome_di" bpmnElement="outcome">
        <dc:Bounds x="762" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="738" y="223" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_2_di" bpmnElement="End_2">
        <dc:Bounds x="932" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="908" y="223" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="stateIn_di" bpmnElement="stateIn">
        <dc:Bounds x="252" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="228" y="523" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_3_di" bpmnElement="Gw_3">
        <dc:Bounds x="415" y="475" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="398" y="530" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_4_di" bpmnElement="T_4">
        <dc:Bounds x="560" y="460" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_5_di" bpmnElement="T_5">
        <dc:Bounds x="560" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_6_di" bpmnElement="T_6">
        <dc:Bounds x="730" y="460" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_7_di" bpmnElement="End_7">
        <dc:Bounds x="932" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="908" y="523" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SF_T_1_outcome_di" bpmnElement="SF_T_1_outcome">
        <di:waypoint x="320" y="200" />
        <di:waypoint x="762" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_outcome_End_2_di" bpmnElement="SF_outcome_End_2">
        <di:waypoint x="798" y="200" />
        <di:waypoint x="932" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_Gw_3_T_4_di" bpmnElement="SF_Gw_3_T_4">
        <di:waypoint x="465" y="500" />
        <di:waypoint x="560" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_Gw_3_T_5_di" bpmnElement="SF_Gw_3_T_5">
        <di:waypoint x="465" y="500" />
        <di:waypoint x="495" y="500" />
        <di:waypoint x="495" y="620" />
        <di:waypoint x="560" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_T_4_T_6_di" bpmnElement="SF_T_4_T_6">
        <di:waypoint x="660" y="500" />
        <di:waypoint x="730" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_T_5_T_6_di" bpmnElement="SF_T_5_T_6">
        <di:waypoint x="660" y="620" />
        <di:waypoint x="690" y="620" />
        <di:waypoint x="690" y="500" />
        <di:waypoint x="730" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_stateIn_Gw_3_di" bpmnElement="SF_stateIn_Gw_3">
        <di:waypoint x="288" y="500" />
        <di:waypoint x="415" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_T_6_End_7_di" bpmnElement="SF_T_6_End_7">
        <di:waypoint x="830" y="500" />
        <di:waypoint x="932" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_1_di" bpmnElement="MF_1">
        <di:waypoint x="270" y="240" />
        <di:waypoint x="270" y="482" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_2_di" bpmnElement="MF_2">
        <di:waypoint x="780" y="460" />
        <di:waypoint x="780" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="TextAnnotation_X1_di" bpmnElement="TextAnnotation_X1"><dc:Bounds x="320" y="672" width="240" height="136" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Association_X1_di" bpmnElement="Association_X1"><di:waypoint x="440" y="525" /><di:waypoint x="440" y="672" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
