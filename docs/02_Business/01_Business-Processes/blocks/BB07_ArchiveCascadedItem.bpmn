        <bpmndi:BPMNLabel><dc:Bounds x="1248" y="223" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="back_di" bpmnElement="back">
        <dc:Bounds x="1442" y="182" width="36" height="36" />
