<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BB07_ArchiveCascadedItem" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BB07_ArchiveCascadedItem">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BB07.01 · See what archiving a &lt;entity&gt; takes" sourceRef="T_1" targetRef="archImpactIn" />
    <bpmn:messageFlow id="MF_2" name="BB07.02 · Archive a &lt;entity&gt;" sourceRef="T_4" targetRef="archiveIn" />
    <bpmn:messageFlow id="MF_3" name="What the archiving will take" sourceRef="T_5" targetRef="archImpact" />
    <bpmn:messageFlow id="MF_4" name="The archiving outcome" sourceRef="T_8" targetRef="archived" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>The drawing carries one choice: a valid combination, or no archiving at all. Which combinations are legal is this answer's content, and a cascade the user may decline starts off.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_5" targetRef="TextAnnotation_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:task id="T_1" name="Archive the &lt;entity&gt;">
      <bpmn:outgoing>SF_T_1_archImpact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="archImpact" name="What the archiving will take">
      <bpmn:incoming>SF_T_1_archImpact</bpmn:incoming>
      <bpmn:outgoing>SF_archImpact_Gw_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archImpact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_2" name="Approve what the archiving takes?">
      <bpmn:incoming>SF_archImpact_Gw_2</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_2_T_3</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_back</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_3" name="Select a valid cascading option">
      <bpmn:incoming>SF_Gw_2_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_T_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_4" name="Confirm the archiving">
      <bpmn:incoming>SF_T_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_archived</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="archived" name="The archiving outcome">
      <bpmn:incoming>SF_T_4_archived</bpmn:incoming>
      <bpmn:outgoing>SF_archived_back</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="back" name="Back on the surface">
      <bpmn:incoming>SF_archived_back</bpmn:incoming>
      <bpmn:incoming>SF_Gw_2_back</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_T_1_archImpact" sourceRef="T_1" targetRef="archImpact" />
    <bpmn:sequenceFlow id="SF_archImpact_Gw_2" sourceRef="archImpact" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="SF_T_3_T_4" sourceRef="T_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_4_archived" sourceRef="T_4" targetRef="archived" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_3" name="approve" sourceRef="Gw_2" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_archived_back" sourceRef="archived" targetRef="back" />
    <bpmn:sequenceFlow id="SF_Gw_2_back" name="reject" sourceRef="Gw_2" targetRef="back" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="archImpactIn" name="Archiving impact requested">
      <bpmn:outgoing>SF_archImpactIn_T_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archImpactIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_5" name="Report what the archiving will take, and what of it can be declined">
      <bpmn:incoming>SF_archImpactIn_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_End_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_6" name="Impact answered">
      <bpmn:incoming>SF_T_5_End_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="archiveIn" name="Archiving requested">
      <bpmn:outgoing>SF_archiveIn_T_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archiveIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_7" name="Archive confirmed items">
      <bpmn:incoming>SF_archiveIn_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_T_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_8" name="Report the outcome">
      <bpmn:incoming>SF_T_7_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_End_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_9" name="Archiving answered">
      <bpmn:incoming>SF_T_8_End_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_archImpactIn_T_5" sourceRef="archImpactIn" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_5_End_6" sourceRef="T_5" targetRef="End_6" />
    <bpmn:sequenceFlow id="SF_T_7_T_8" sourceRef="T_7" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_archiveIn_T_7" sourceRef="archiveIn" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_T_8_End_9" sourceRef="T_8" targetRef="End_9" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_BB07_ArchiveCascadedItem">
    <bpmndi:BPMNPlane id="P_BB07_ArchiveCascadedItem" bpmnElement="Collaboration_BB07_ArchiveCascadedItem">
      <bpmndi:BPMNShape id="Participant_User_di" bpmnElement="Participant_User" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1410" height="260" />
