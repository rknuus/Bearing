      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="archImpactIn_di" bpmnElement="archImpactIn">
        <dc:Bounds x="252" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="228" y="523" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_5_di" bpmnElement="T_5">
        <dc:Bounds x="390" y="460" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_6_di" bpmnElement="End_6">
        <dc:Bounds x="592" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="568" y="523" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="archiveIn_di" bpmnElement="archiveIn">
