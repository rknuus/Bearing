        <bpmndi:BPMNLabel><dc:Bounds x="908" y="523" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_7_di" bpmnElement="T_7">
        <dc:Bounds x="1070" y="460" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_8_di" bpmnElement="T_8">
        <dc:Bounds x="1240" y="460" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_9_di" bpmnElement="End_9">
