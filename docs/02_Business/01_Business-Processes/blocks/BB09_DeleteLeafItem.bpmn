        <bpmndi:BPMNLabel><dc:Bounds x="738" y="523" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SF_T_1_deleted_di" bpmnElement="SF_T_1_deleted">
        <di:waypoint x="320" y="200" />
        <di:waypoint x="592" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_deleted_End_2_di" bpmnElement="SF_deleted_End_2">
        <di:waypoint x="628" y="200" />
        <di:waypoint x="762" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_T_3_T_4_di" bpmnElement="SF_T_3_T_4">
