<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BB15_Advice" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BB15_Advice">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:participant id="Participant_Advisor" name="Advisor" processRef="Process_Advisor" />
    <bpmn:messageFlow id="MF_1" name="BB15.01 · Ask the advisor" sourceRef="T_2" targetRef="askIn" />
    <bpmn:messageFlow id="MF_2" name="BB15.03 · See what applying will take" sourceRef="T_5" targetRef="applyImpactIn" />
    <bpmn:messageFlow id="MF_3" name="BB15.04 · Apply the proposal" sourceRef="T_7" targetRef="applyIn" />
    <bpmn:messageFlow id="MF_4" name="The answer, or what went wrong" sourceRef="T_13" targetRef="answer" />
    <bpmn:messageFlow id="MF_5" name="What applying will take, and where it lands" sourceRef="T_15" targetRef="applyImpact" />
    <bpmn:messageFlow id="MF_6" name="What was applied, and where" sourceRef="T_18" targetRef="applied" />
    <bpmn:messageFlow id="MFX_1" name="Advice requested" sourceRef="T_9" targetRef="Participant_Advisor" />
    <bpmn:messageFlow id="MFX_2" name="BB15.02 · Take the advisor's answer" sourceRef="Participant_Advisor" targetRef="Catch_11" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>One answer carries both outcomes: the proposals the advisor returned, or what went wrong where it did not answer at all.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_12" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>Applying runs the user's own operation, so whatever that operation discloses is disclosed here.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_15" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>The proposal is written completely. Nothing is half-applied.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="T_17" targetRef="TextAnnotation_X3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:task id="T_1" name="Write the request">
      <bpmn:outgoing>SF_T_1_T_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_2" name="Submit the request">
      <bpmn:incoming>SF_T_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_answer</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="answer" name="The answer, or what went wrong">
      <bpmn:incoming>SF_T_2_answer</bpmn:incoming>
      <bpmn:outgoing>SF_answer_Gw_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_answer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_3" name="Did the advisor answer?">
      <bpmn:incoming>SF_answer_Gw_3</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_3_Gw_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_back</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_4" name="Take a proposal up?">
      <bpmn:incoming>SF_Gw_3_Gw_4</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_4_T_5</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_4_back</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_5" name="Accept the proposal">
      <bpmn:incoming>SF_Gw_4_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_applyImpact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="applyImpact" name="What applying will take, and where it lands">
      <bpmn:incoming>SF_T_5_applyImpact</bpmn:incoming>
      <bpmn:outgoing>SF_applyImpact_Gw_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_applyImpact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_6" name="Approve what applying takes?">
      <bpmn:incoming>SF_applyImpact_Gw_6</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_6_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_6_back</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_7" name="Apply the proposal">
      <bpmn:incoming>SF_Gw_6_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_applied</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="applied" name="What was applied, and where">
      <bpmn:incoming>SF_T_7_applied</bpmn:incoming>
      <bpmn:outgoing>SF_applied_back</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_applied" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="back" name="Back on the surface">
      <bpmn:incoming>SF_applied_back</bpmn:incoming>
      <bpmn:incoming>SF_Gw_6_back</bpmn:incoming>
      <bpmn:incoming>SF_Gw_4_back</bpmn:incoming>
      <bpmn:incoming>SF_Gw_3_back</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_T_1_T_2" sourceRef="T_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_answer" sourceRef="T_2" targetRef="answer" />
    <bpmn:sequenceFlow id="SF_answer_Gw_3" sourceRef="answer" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="SF_T_5_applyImpact" sourceRef="T_5" targetRef="applyImpact" />
    <bpmn:sequenceFlow id="SF_applyImpact_Gw_6" sourceRef="applyImpact" targetRef="Gw_6" />
    <bpmn:sequenceFlow id="SF_T_7_applied" sourceRef="T_7" targetRef="applied" />
    <bpmn:sequenceFlow id="SF_Gw_6_T_7" name="approve" sourceRef="Gw_6" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_Gw_4_T_5" name="yes" sourceRef="Gw_4" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_Gw_3_Gw_4" name="it answered" sourceRef="Gw_3" targetRef="Gw_4" />
    <bpmn:sequenceFlow id="SF_applied_back" sourceRef="applied" targetRef="back" />
    <bpmn:sequenceFlow id="SF_Gw_6_back" name="reject" sourceRef="Gw_6" targetRef="back" />
    <bpmn:sequenceFlow id="SF_Gw_4_back" name="no" sourceRef="Gw_4" targetRef="back" />
    <bpmn:sequenceFlow id="SF_Gw_3_back" name="it did not" sourceRef="Gw_3" targetRef="back" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="askIn" name="Request submitted">
      <bpmn:outgoing>SF_askIn_T_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_askIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_8" name="Submit the request with its context, the conversation included">
      <bpmn:incoming>SF_askIn_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_T_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_9" name="Keep the request with the conversation, for the turns that follow">
      <bpmn:incoming>SF_T_8_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_End_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_10" name="Request sent">
      <bpmn:incoming>SF_T_9_End_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Catch_11" name="Advisor answered">
      <bpmn:outgoing>SF_Catch_11_T_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Catch_11" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_12" name="Turn each actionable part of the answer into a typed proposal">
      <bpmn:incoming>SF_Catch_11_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_T_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_13" name="Report the outcome">
      <bpmn:incoming>SF_T_12_T_13</bpmn:incoming>
      <bpmn:outgoing>SF_T_13_End_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_14" name="Answer answered">
      <bpmn:incoming>SF_T_13_End_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="applyImpactIn" name="Application impact requested">
      <bpmn:outgoing>SF_applyImpactIn_T_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_applyImpactIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_15" name="Report what applying it will take">
      <bpmn:incoming>SF_applyImpactIn_T_15</bpmn:incoming>
      <bpmn:outgoing>SF_T_15_End_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_16" name="Application impact answered">
      <bpmn:incoming>SF_T_15_End_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="applyIn" name="Application requested">
      <bpmn:outgoing>SF_applyIn_T_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_applyIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_17" name="Apply the proposal">
      <bpmn:incoming>SF_applyIn_T_17</bpmn:incoming>
      <bpmn:outgoing>SF_T_17_T_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_18" name="Report what was applied, and where it landed">
      <bpmn:incoming>SF_T_17_T_18</bpmn:incoming>
      <bpmn:outgoing>SF_T_18_End_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_19" name="Application answered">
      <bpmn:incoming>SF_T_18_End_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_T_8_T_9" sourceRef="T_8" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_askIn_T_8" sourceRef="askIn" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_T_9_End_10" sourceRef="T_9" targetRef="End_10" />
    <bpmn:sequenceFlow id="SF_T_12_T_13" sourceRef="T_12" targetRef="T_13" />
    <bpmn:sequenceFlow id="SF_Catch_11_T_12" sourceRef="Catch_11" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_T_13_End_14" sourceRef="T_13" targetRef="End_14" />
    <bpmn:sequenceFlow id="SF_applyImpactIn_T_15" sourceRef="applyImpactIn" targetRef="T_15" />
    <bpmn:sequenceFlow id="SF_T_15_End_16" sourceRef="T_15" targetRef="End_16" />
    <bpmn:sequenceFlow id="SF_T_17_T_18" sourceRef="T_17" targetRef="T_18" />
    <bpmn:sequenceFlow id="SF_applyIn_T_17" sourceRef="applyIn" targetRef="T_17" />
    <bpmn:sequenceFlow id="SF_T_18_End_19" sourceRef="T_18" targetRef="End_19" />
  </bpmn:process>
  <bpmn:process id="Process_Advisor" isExecutable="false">
  </bpmn:process>
