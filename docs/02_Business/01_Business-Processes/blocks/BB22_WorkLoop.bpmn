<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BB22_WorkLoop" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BB22_WorkLoop">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>Opening it is OpenView: one request, one answer, and the question decides on that answer.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_2" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>One branch per act, each of them a block: EditContent, EditState, ArchiveLeafItem, DeleteCascadedItem, UnarchiveItem, a hand-over to a sub-process, a seam. An act never asks the user to re-read the view afterwards.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_5" targetRef="TextAnnotation_X2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A &lt;entity&gt; needs attention">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Open the &lt;view&gt;">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_T_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_3" name="Work a &lt;entity&gt;">
      <bpmn:incoming>SF_T_2_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_Gw_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_4" name="What needs doing?">
      <bpmn:incoming>SF_T_3_Gw_4</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_4_T_5</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_4_T_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_5" name="Perform one act">
      <bpmn:incoming>SF_Gw_4_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_End_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_6" name="&lt;What the gesture did&gt;">
      <bpmn:incoming>SF_T_5_End_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_7" name="Perform another one">
      <bpmn:incoming>SF_Gw_4_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_End_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_8" name="&lt;What that gesture did&gt;">
      <bpmn:incoming>SF_T_7_End_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_T_3" sourceRef="T_2" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_T_3_Gw_4" sourceRef="T_3" targetRef="Gw_4" />
    <bpmn:sequenceFlow id="SF_T_5_End_6" sourceRef="T_5" targetRef="End_6" />
    <bpmn:sequenceFlow id="SF_Gw_4_T_5" name="an act" sourceRef="Gw_4" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_7_End_8" sourceRef="T_7" targetRef="End_8" />
    <bpmn:sequenceFlow id="SF_Gw_4_T_7" name="another act" sourceRef="Gw_4" targetRef="T_7" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_BB22_WorkLoop">
    <bpmndi:BPMNPlane id="P_BB22_WorkLoop" bpmnElement="Collaboration_BB22_WorkLoop">
      <bpmndi:BPMNShape id="Participant_User_di" bpmnElement="Participant_User" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1070" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="252" y="182" width="36" height="36" />
