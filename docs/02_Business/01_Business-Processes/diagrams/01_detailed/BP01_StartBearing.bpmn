<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP01_StartBearing" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP01_StartBearing">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP01.01 · Start up" sourceRef="T_2" targetRef="bootIn" />
    <bpmn:messageFlow id="MF_2" name="BP01.09 · Close Bearing" sourceRef="T_4" targetRef="closeIn" />
    <bpmn:messageFlow id="MF_3" name="Start-up outcome" sourceRef="report" targetRef="outcome" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>The work is outside Bearing: no folder picker, no in-app repair, no adoption of a folder Bearing does not recognise as its own.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_5" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>Every precondition is checked before anything of the user's is touched, so a launch that fails them leaves the folder exactly as it was. The template files carry the Chores board and the five life areas, so no step creates them. Today is put in play from no day, never from a previous one: a launch is not a rollover. Loading is the one fetch of stored state in the product: every view works from what is loaded here.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_8" targetRef="TextAnnotation_X2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Something to plan or do">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Launch Bearing">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_outcome</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="outcome" name="Start-up outcome">
      <bpmn:incoming>SF_T_2_outcome</bpmn:incoming>
      <bpmn:outgoing>SF_outcome_Gw_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_outcome" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_3" name="What did start-up answer?">
      <bpmn:incoming>SF_outcome_Gw_3</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_3_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_inUse</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_4" name="Acknowledge what Bearing reported">
      <bpmn:incoming>SF_Gw_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_T_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_5" name="Put the reported thing right">
      <bpmn:incoming>SF_T_4_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_End_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_6" name="Ready to relaunch">
      <bpmn:incoming>SF_T_5_End_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="inUse" name="Work in Bearing">
      <bpmn:incoming>SF_Gw_3_inUse</bpmn:incoming>
      <bpmn:outgoing>SF_inUse_End_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_7" name="Bearing in use">
      <bpmn:incoming>SF_inUse_End_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_outcome" sourceRef="T_2" targetRef="outcome" />
    <bpmn:sequenceFlow id="SF_outcome_Gw_3" sourceRef="outcome" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="SF_T_4_T_5" sourceRef="T_4" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_5_End_6" sourceRef="T_5" targetRef="End_6" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_4" name="refused" sourceRef="Gw_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_inUse_End_7" sourceRef="inUse" targetRef="End_7" />
    <bpmn:sequenceFlow id="SF_Gw_3_inUse" name="usable data, set up on this launch or not" sourceRef="Gw_3" targetRef="inUse" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="bootIn" name="Start-up requested">
      <bpmn:outgoing>SF_bootIn_T_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_bootIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_8" name="Inspect the data folder">
      <bpmn:incoming>SF_bootIn_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_T_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_9" name="Check the start-up preconditions">
      <bpmn:incoming>SF_T_8_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_Gw_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_10" name="Preconditions satisfied?">
      <bpmn:incoming>SF_T_9_Gw_10</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_10_Gw_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_10_refuse</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_11" name="Missing or unreachable?">
      <bpmn:incoming>SF_Gw_10_Gw_11</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_11_T_12</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_11_load</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_12" name="Set up data folder">
      <bpmn:incoming>SF_Gw_11_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_load</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="refuse" name="Refuse to start on an unmet precondition">
      <bpmn:incoming>SF_Gw_10_refuse</bpmn:incoming>
      <bpmn:outgoing>SF_refuse_report</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="load" name="Load the data">
      <bpmn:incoming>SF_T_12_load</bpmn:incoming>
      <bpmn:incoming>SF_Gw_11_load</bpmn:incoming>
      <bpmn:outgoing>SF_load_T_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_13" name="Calculate the derived data">
      <bpmn:incoming>SF_load_T_13</bpmn:incoming>
      <bpmn:outgoing>SF_T_13_T_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_14" name="Set current date to today">
      <bpmn:incoming>SF_T_13_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_Gw_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_15" name="Was a data folder set up?">
      <bpmn:incoming>SF_T_14_Gw_15</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_15_T_16</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_15_T_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_16" name="Define the Themes tab as starting tab">
      <bpmn:incoming>SF_Gw_15_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_report</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_17" name="Define the Focus tab as starting tab">
      <bpmn:incoming>SF_Gw_15_T_17</bpmn:incoming>
      <bpmn:outgoing>SF_T_17_report</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="report" name="Report the start-up outcome">
      <bpmn:incoming>SF_T_16_report</bpmn:incoming>
      <bpmn:incoming>SF_T_17_report</bpmn:incoming>
      <bpmn:incoming>SF_refuse_report</bpmn:incoming>
      <bpmn:outgoing>SF_report_End_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_18" name="Start-up answered">
      <bpmn:incoming>SF_report_End_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="closeIn" name="Close requested">
      <bpmn:outgoing>SF_closeIn_T_19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_closeIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_19" name="Shut the product down">
      <bpmn:incoming>SF_closeIn_T_19</bpmn:incoming>
      <bpmn:outgoing>SF_T_19_End_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_20" name="Bearing closed">
      <bpmn:incoming>SF_T_19_End_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_T_8_T_9" sourceRef="T_8" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_T_9_Gw_10" sourceRef="T_9" targetRef="Gw_10" />
    <bpmn:sequenceFlow id="SF_Gw_11_T_12" name="no data folder" sourceRef="Gw_11" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_Gw_10_Gw_11" name="satisfied" sourceRef="Gw_10" targetRef="Gw_11" />
    <bpmn:sequenceFlow id="SF_load_T_13" sourceRef="load" targetRef="T_13" />
    <bpmn:sequenceFlow id="SF_T_13_T_14" sourceRef="T_13" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_T_14_Gw_15" sourceRef="T_14" targetRef="Gw_15" />
    <bpmn:sequenceFlow id="SF_Gw_15_T_16" name="yes - a first run" sourceRef="Gw_15" targetRef="T_16" />
    <bpmn:sequenceFlow id="SF_Gw_15_T_17" name="no - a returning launch" sourceRef="Gw_15" targetRef="T_17" />
    <bpmn:sequenceFlow id="SF_T_16_report" sourceRef="T_16" targetRef="report" />
    <bpmn:sequenceFlow id="SF_T_17_report" sourceRef="T_17" targetRef="report" />
    <bpmn:sequenceFlow id="SF_bootIn_T_8" sourceRef="bootIn" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_report_End_18" sourceRef="report" targetRef="End_18" />
    <bpmn:sequenceFlow id="SF_closeIn_T_19" sourceRef="closeIn" targetRef="T_19" />
    <bpmn:sequenceFlow id="SF_T_19_End_20" sourceRef="T_19" targetRef="End_20" />
    <bpmn:sequenceFlow id="SF_T_12_load" sourceRef="T_12" targetRef="load" />
    <bpmn:sequenceFlow id="SF_Gw_11_load" name="a folder Bearing can work with" sourceRef="Gw_11" targetRef="load" />
    <bpmn:sequenceFlow id="SF_Gw_10_refuse" name="not satisfied" sourceRef="Gw_10" targetRef="refuse" />
    <bpmn:sequenceFlow id="SF_refuse_report" sourceRef="refuse" targetRef="report" />
  </bpmn:process>
