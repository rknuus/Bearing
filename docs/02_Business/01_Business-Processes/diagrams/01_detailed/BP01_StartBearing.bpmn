<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP01_StartBearing" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP01_StartBearing">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP01.01 · Start up" sourceRef="T_2" targetRef="bootIn" />
    <bpmn:messageFlow id="MF_2" name="BP01.02 · Start onboarding" sourceRef="T_10" targetRef="seedIn" />
    <bpmn:messageFlow id="MF_3" name="BP01.03 · Amend the starter set" sourceRef="T_12" targetRef="amendIn" />
    <bpmn:messageFlow id="MF_4" name="BP01.04 · Record vision and mission" sourceRef="T_15" targetRef="vmIn" />
    <bpmn:messageFlow id="MF_5" name="BP01.05 · Complete onboarding" sourceRef="T_17" targetRef="doneIn" />
    <bpmn:messageFlow id="MF_6" name="Start-up outcome" sourceRef="T_28" targetRef="outcome" />
    <bpmn:messageFlow id="MF_7" name="Starter themes" sourceRef="T_31" targetRef="themesShown" />
    <bpmn:messageFlow id="MF_8" name="Starter set updated" sourceRef="T_34" targetRef="amended" />
    <bpmn:messageFlow id="MF_9" name="Vision and mission recorded" sourceRef="T_37" targetRef="vmDone" />
    <bpmn:messageFlow id="MF_10" name="Bearing ready on Focus" sourceRef="T_40" targetRef="ready" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>Recovery is a filesystem operation outside Bearing. There is no folder picker and no adoption of a repository Bearing did not create.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_4" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>The user is the only disambiguator between a first run and lost data. Quitting is safe: the fresh folder is empty and overwrites nothing.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_8" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>Edit, remove or add, inline on the onboarding screen. One instance per adjustment.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="T_12" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>One synchronous call per launch. The four folder states are variations of one operation, not four operations. An unreachable symlink target counts as missing.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="T_19" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>Health, Career, Learning, Relationships, Personal — five, so the product is never empty.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="T_30" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>Reached from either wizard step: skipping is the same act as completing, minus what was skipped.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="T_39" targetRef="TextAnnotation_X6" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Something to plan or do">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Launch Bearing">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_outcome</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="outcome" name="Start-up outcome">
      <bpmn:incoming>SF_T_2_outcome</bpmn:incoming>
      <bpmn:outgoing>SF_outcome_Gw_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_outcome" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_3" name="Versioned by this Bearing, or brought under version control?">
      <bpmn:incoming>SF_outcome_Gw_3</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_3_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_6</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_inUse</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_4" name="Move the folder aside by hand">
      <bpmn:incoming>SF_Gw_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_End_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_5" name="Bearing closed">
      <bpmn:incoming>SF_T_4_End_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_6" name="Read the new-data-folder notice">
      <bpmn:incoming>SF_Gw_3_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_Gw_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_7" name="Was existing data expected at this path?">
      <bpmn:incoming>SF_T_6_Gw_7</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_7_T_8</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_7_T_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_8" name="Quit and restore the backup folder">
      <bpmn:incoming>SF_Gw_7_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_End_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_9" name="Bearing closed">
      <bpmn:incoming>SF_T_8_End_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_10" name="Continue to onboarding">
      <bpmn:incoming>SF_Gw_7_T_10</bpmn:incoming>
      <bpmn:outgoing>SF_T_10_themesShown</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="themesShown" name="Starter themes">
      <bpmn:incoming>SF_T_10_themesShown</bpmn:incoming>
      <bpmn:outgoing>SF_themesShown_review</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_themesShown" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="review" name="Review the starter themes">
      <bpmn:incoming>SF_themesShown_review</bpmn:incoming>
      <bpmn:outgoing>SF_review_Gw_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_11" name="Adjust the starter set?">
      <bpmn:incoming>SF_review_Gw_11</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_11_T_12</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_11_T_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_12" name="Amend a starter theme">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_Gw_11_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_amended</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="amended" name="Starter set updated">
      <bpmn:incoming>SF_T_12_amended</bpmn:incoming>
      <bpmn:outgoing>SF_amended_Gw_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_amended" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_13" name="Keep the starter set">
      <bpmn:incoming>SF_Gw_11_T_13</bpmn:incoming>
      <bpmn:outgoing>SF_T_13_Gw_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_14" name="State a vision and mission?">
      <bpmn:incoming>SF_amended_Gw_14</bpmn:incoming>
      <bpmn:incoming>SF_T_13_Gw_14</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_14_T_15</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_14_T_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_15" name="Write vision and mission">
      <bpmn:incoming>SF_Gw_14_T_15</bpmn:incoming>
      <bpmn:outgoing>SF_T_15_vmDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="vmDone" name="Vision and mission recorded">
      <bpmn:incoming>SF_T_15_vmDone</bpmn:incoming>
      <bpmn:outgoing>SF_vmDone_T_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_vmDone" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_16" name="Skip the step">
      <bpmn:incoming>SF_Gw_14_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_T_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_17" name="Finish onboarding">
      <bpmn:incoming>SF_vmDone_T_17</bpmn:incoming>
      <bpmn:incoming>SF_T_16_T_17</bpmn:incoming>
      <bpmn:outgoing>SF_T_17_ready</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="ready" name="Bearing ready on Focus">
      <bpmn:incoming>SF_T_17_ready</bpmn:incoming>
      <bpmn:outgoing>SF_ready_inUse</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ready" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="inUse" name="Work in Bearing">
      <bpmn:incoming>SF_ready_inUse</bpmn:incoming>
      <bpmn:incoming>SF_Gw_3_inUse</bpmn:incoming>
      <bpmn:outgoing>SF_inUse_End_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_18" name="Bearing in use">
      <bpmn:incoming>SF_inUse_End_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_outcome" sourceRef="T_2" targetRef="outcome" />
    <bpmn:sequenceFlow id="SF_outcome_Gw_3" sourceRef="outcome" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="SF_T_4_End_5" sourceRef="T_4" targetRef="End_5" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_4" name="refused" sourceRef="Gw_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_6" name="a new, empty data folder" sourceRef="Gw_3" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_T_6_Gw_7" sourceRef="T_6" targetRef="Gw_7" />
    <bpmn:sequenceFlow id="SF_T_8_End_9" sourceRef="T_8" targetRef="End_9" />
    <bpmn:sequenceFlow id="SF_Gw_7_T_8" name="yes — it is lost or elsewhere" sourceRef="Gw_7" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_Gw_7_T_10" name="no — this is a first run" sourceRef="Gw_7" targetRef="T_10" />
    <bpmn:sequenceFlow id="SF_T_10_themesShown" sourceRef="T_10" targetRef="themesShown" />
    <bpmn:sequenceFlow id="SF_themesShown_review" sourceRef="themesShown" targetRef="review" />
    <bpmn:sequenceFlow id="SF_review_Gw_11" sourceRef="review" targetRef="Gw_11" />
    <bpmn:sequenceFlow id="SF_T_12_amended" sourceRef="T_12" targetRef="amended" />
    <bpmn:sequenceFlow id="SF_Gw_11_T_12" name="yes" sourceRef="Gw_11" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_Gw_11_T_13" name="no" sourceRef="Gw_11" targetRef="T_13" />
    <bpmn:sequenceFlow id="SF_amended_Gw_14" sourceRef="amended" targetRef="Gw_14" />
    <bpmn:sequenceFlow id="SF_T_13_Gw_14" sourceRef="T_13" targetRef="Gw_14" />
    <bpmn:sequenceFlow id="SF_T_15_vmDone" sourceRef="T_15" targetRef="vmDone" />
    <bpmn:sequenceFlow id="SF_Gw_14_T_15" name="yes" sourceRef="Gw_14" targetRef="T_15" />
    <bpmn:sequenceFlow id="SF_Gw_14_T_16" name="skip — the Themes tab offers it later" sourceRef="Gw_14" targetRef="T_16" />
    <bpmn:sequenceFlow id="SF_vmDone_T_17" sourceRef="vmDone" targetRef="T_17" />
    <bpmn:sequenceFlow id="SF_T_16_T_17" sourceRef="T_16" targetRef="T_17" />
    <bpmn:sequenceFlow id="SF_T_17_ready" sourceRef="T_17" targetRef="ready" />
    <bpmn:sequenceFlow id="SF_ready_inUse" sourceRef="ready" targetRef="inUse" />
    <bpmn:sequenceFlow id="SF_inUse_End_18" sourceRef="inUse" targetRef="End_18" />
    <bpmn:sequenceFlow id="SF_Gw_3_inUse" name="usable data" sourceRef="Gw_3" targetRef="inUse" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="bootIn" name="Start-up requested">
      <bpmn:outgoing>SF_bootIn_T_19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_bootIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_19" name="Resolve the conventional data-folder path">
      <bpmn:incoming>SF_bootIn_T_19</bpmn:incoming>
      <bpmn:outgoing>SF_T_19_T_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_20" name="Inspect the data folder">
      <bpmn:incoming>SF_T_19_T_20</bpmn:incoming>
      <bpmn:outgoing>SF_T_20_Gw_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_21" name="Versioned by this Bearing?">
      <bpmn:incoming>SF_T_20_Gw_21</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_21_T_22</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_21_T_23</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_21_T_25</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_21_T_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_22" name="Load the data">
      <bpmn:incoming>SF_Gw_21_T_22</bpmn:incoming>
      <bpmn:outgoing>SF_T_22_T_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_23" name="Bring the folder under version control">
      <bpmn:incoming>SF_Gw_21_T_23</bpmn:incoming>
      <bpmn:outgoing>SF_T_23_T_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_24" name="Load the newly versioned data">
      <bpmn:incoming>SF_T_23_T_24</bpmn:incoming>
      <bpmn:outgoing>SF_T_24_T_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_25" name="Refuse to adopt the folder">
      <bpmn:incoming>SF_Gw_21_T_25</bpmn:incoming>
      <bpmn:outgoing>SF_T_25_T_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_26" name="Create the data folder">
      <bpmn:incoming>SF_Gw_21_T_26</bpmn:incoming>
      <bpmn:outgoing>SF_T_26_T_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_27" name="Version-control the new folder">
      <bpmn:incoming>SF_T_26_T_27</bpmn:incoming>
      <bpmn:outgoing>SF_T_27_T_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_28" name="Report the start-up outcome">
      <bpmn:incoming>SF_T_22_T_28</bpmn:incoming>
      <bpmn:incoming>SF_T_24_T_28</bpmn:incoming>
      <bpmn:incoming>SF_T_25_T_28</bpmn:incoming>
      <bpmn:incoming>SF_T_27_T_28</bpmn:incoming>
      <bpmn:outgoing>SF_T_28_End_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_29" name="Start-up answered">
      <bpmn:incoming>SF_T_28_End_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="seedIn" name="Onboarding requested">
      <bpmn:outgoing>SF_seedIn_T_30</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_seedIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_30" name="Create the starter themes">
      <bpmn:incoming>SF_seedIn_T_30</bpmn:incoming>
      <bpmn:outgoing>SF_T_30_T_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_31" name="Return the starter set">
      <bpmn:incoming>SF_T_30_T_31</bpmn:incoming>
      <bpmn:outgoing>SF_T_31_End_32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_32" name="Starter set returned">
      <bpmn:incoming>SF_T_31_End_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="amendIn" name="Starter-set amendment requested">
      <bpmn:outgoing>SF_amendIn_T_33</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_amendIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_33" name="Apply the amendment">
      <bpmn:incoming>SF_amendIn_T_33</bpmn:incoming>
      <bpmn:outgoing>SF_T_33_T_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_34" name="Return the starter set">
      <bpmn:incoming>SF_T_33_T_34</bpmn:incoming>
      <bpmn:outgoing>SF_T_34_End_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_35" name="Amendment answered">
      <bpmn:incoming>SF_T_34_End_35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="vmIn" name="Vision and mission submitted">
      <bpmn:outgoing>SF_vmIn_T_36</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_vmIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_36" name="Store the vision and the mission">
      <bpmn:incoming>SF_vmIn_T_36</bpmn:incoming>
      <bpmn:outgoing>SF_T_36_T_37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_37" name="Confirm what was stored">
      <bpmn:incoming>SF_T_36_T_37</bpmn:incoming>
      <bpmn:outgoing>SF_T_37_End_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_38" name="Vision and mission answered">
      <bpmn:incoming>SF_T_37_End_38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="doneIn" name="Onboarding finish requested">
      <bpmn:outgoing>SF_doneIn_T_39</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_doneIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_39" name="Record that onboarding is complete">
      <bpmn:incoming>SF_doneIn_T_39</bpmn:incoming>
      <bpmn:outgoing>SF_T_39_T_40</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_40" name="Open the Focus tab">
      <bpmn:incoming>SF_T_39_T_40</bpmn:incoming>
      <bpmn:outgoing>SF_T_40_End_41</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_41" name="Onboarding answered">
      <bpmn:incoming>SF_T_40_End_41</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_T_19_T_20" sourceRef="T_19" targetRef="T_20" />
    <bpmn:sequenceFlow id="SF_T_20_Gw_21" sourceRef="T_20" targetRef="Gw_21" />
    <bpmn:sequenceFlow id="SF_Gw_21_T_22" name="this Bearing's data" sourceRef="Gw_21" targetRef="T_22" />
    <bpmn:sequenceFlow id="SF_T_23_T_24" sourceRef="T_23" targetRef="T_24" />
    <bpmn:sequenceFlow id="SF_Gw_21_T_23" name="unversioned data" sourceRef="Gw_21" targetRef="T_23" />
    <bpmn:sequenceFlow id="SF_Gw_21_T_25" name="foreign repository" sourceRef="Gw_21" targetRef="T_25" />
    <bpmn:sequenceFlow id="SF_T_26_T_27" sourceRef="T_26" targetRef="T_27" />
    <bpmn:sequenceFlow id="SF_Gw_21_T_26" name="missing or unreachable" sourceRef="Gw_21" targetRef="T_26" />
    <bpmn:sequenceFlow id="SF_T_22_T_28" sourceRef="T_22" targetRef="T_28" />
    <bpmn:sequenceFlow id="SF_T_24_T_28" sourceRef="T_24" targetRef="T_28" />
    <bpmn:sequenceFlow id="SF_T_25_T_28" sourceRef="T_25" targetRef="T_28" />
    <bpmn:sequenceFlow id="SF_T_27_T_28" sourceRef="T_27" targetRef="T_28" />
    <bpmn:sequenceFlow id="SF_bootIn_T_19" sourceRef="bootIn" targetRef="T_19" />
    <bpmn:sequenceFlow id="SF_T_28_End_29" sourceRef="T_28" targetRef="End_29" />
    <bpmn:sequenceFlow id="SF_T_30_T_31" sourceRef="T_30" targetRef="T_31" />
    <bpmn:sequenceFlow id="SF_seedIn_T_30" sourceRef="seedIn" targetRef="T_30" />
    <bpmn:sequenceFlow id="SF_T_31_End_32" sourceRef="T_31" targetRef="End_32" />
    <bpmn:sequenceFlow id="SF_T_33_T_34" sourceRef="T_33" targetRef="T_34" />
