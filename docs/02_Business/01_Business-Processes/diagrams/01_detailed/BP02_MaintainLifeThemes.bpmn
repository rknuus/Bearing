    <bpmn:sequenceFlow id="SF_Gw_10_End_13" name="reject" sourceRef="Gw_10" targetRef="End_13" />
    <bpmn:sequenceFlow id="SF_deleted_End_14" sourceRef="deleted" targetRef="End_14" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_9" name="retire one for good" sourceRef="Gw_3" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_T_15_T_16" sourceRef="T_15" targetRef="T_16" />
    <bpmn:sequenceFlow id="SF_T_16_vmDone" sourceRef="T_16" targetRef="vmDone" />
    <bpmn:sequenceFlow id="SF_vmDone_End_17" sourceRef="vmDone" targetRef="End_17" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_15" name="state who I want to become, and what I am here for" sourceRef="Gw_3" targetRef="T_15" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="editIn" name="Theme submitted">
