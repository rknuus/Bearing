<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP02_MaintainLifeThemes" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP02_MaintainLifeThemes">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP02.02 · Edit a theme" sourceRef="T_5" targetRef="editIn" />
    <bpmn:messageFlow id="MF_2" name="BP02.04 · Reorder themes" sourceRef="T_7" targetRef="reorderIn" />
    <bpmn:messageFlow id="MF_3" name="BP02.05 · See what deleting a theme takes" sourceRef="T_9" targetRef="impactIn" />
    <bpmn:messageFlow id="MF_4" name="BP02.06 · Delete a theme" sourceRef="T_12" targetRef="deleteIn" />
    <bpmn:messageFlow id="MF_5" name="BP02.08 · Record vision and mission" sourceRef="T_16" targetRef="vmIn" />
    <bpmn:messageFlow id="MF_6" name="The editing outcome" sourceRef="T_19" targetRef="recorded" />
    <bpmn:messageFlow id="MF_7" name="The ordering outcome" sourceRef="T_22" targetRef="reordered" />
    <bpmn:messageFlow id="MF_8" name="What the deletion will take" sourceRef="T_24" targetRef="impact" />
    <bpmn:messageFlow id="MF_9" name="The deletion outcome" sourceRef="T_27" targetRef="deleted" />
    <bpmn:messageFlow id="MF_10" name="The recording outcome" sourceRef="T_30" targetRef="vmDone" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>A kept idea loses only its theme affiliation. The goals cannot be kept, so confirming takes them.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="deleted" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>A goal requires a theme, so keeping one is not a legal outcome: where the theme has goals the gesture is approve-or-abandon. An idea may stay behind theme-less, so that cascade is the real choice and it starts off. An archived descendant is counted like a live one.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_24" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>The request carries the cascades the user confirmed, and nothing else goes: an idea left out stays, theme-less. What happens below a deleted goal or idea is that entity's own rule, applied where the deletion reaches it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="T_26" targetRef="TextAnnotation_X3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A theme needs attention">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Work a theme">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_Gw_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_3" name="What needs doing?">
      <bpmn:incoming>SF_T_2_Gw_3</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_3_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_9</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_4" name="Name the theme">
      <bpmn:incoming>SF_Gw_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_T_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_5" name="Submit the theme">
      <bpmn:incoming>SF_T_4_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_recorded</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="recorded" name="The editing outcome">
      <bpmn:incoming>SF_T_5_recorded</bpmn:incoming>
      <bpmn:outgoing>SF_recorded_End_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_recorded" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_6" name="Theme recorded">
      <bpmn:incoming>SF_recorded_End_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_7" name="Order a theme">
      <bpmn:incoming>SF_Gw_3_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_reordered</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="reordered" name="The ordering outcome">
      <bpmn:incoming>SF_T_7_reordered</bpmn:incoming>
      <bpmn:outgoing>SF_reordered_End_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_reordered" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_8" name="Themes ordered">
      <bpmn:incoming>SF_reordered_End_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_9" name="Delete a theme">
      <bpmn:incoming>SF_Gw_3_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_impact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="impact" name="What the deletion will take">
      <bpmn:incoming>SF_T_9_impact</bpmn:incoming>
      <bpmn:outgoing>SF_impact_Gw_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_impact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_10" name="Approve what the deletion takes?">
      <bpmn:incoming>SF_impact_Gw_10</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_10_T_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_10_End_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_11" name="Select a valid cascading option">
      <bpmn:incoming>SF_Gw_10_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_T_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_12" name="Confirm the deletion">
      <bpmn:incoming>SF_T_11_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_deleted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="deleted" name="The deletion outcome">
      <bpmn:incoming>SF_T_12_deleted</bpmn:incoming>
      <bpmn:outgoing>SF_deleted_End_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_deleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_13" name="Deletion abandoned">
      <bpmn:incoming>SF_Gw_10_End_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_14" name="Theme deleted">
      <bpmn:incoming>SF_deleted_End_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_15" name="State the vision and mission">
      <bpmn:incoming>SF_Gw_3_T_15</bpmn:incoming>
      <bpmn:outgoing>SF_T_15_T_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_16" name="Submit the vision and mission">
      <bpmn:incoming>SF_T_15_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_vmDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="vmDone" name="The recording outcome">
      <bpmn:incoming>SF_T_16_vmDone</bpmn:incoming>
      <bpmn:outgoing>SF_vmDone_End_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_vmDone" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_17" name="Vision and mission recorded">
      <bpmn:incoming>SF_vmDone_End_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_Gw_3" sourceRef="T_2" targetRef="Gw_3" />
