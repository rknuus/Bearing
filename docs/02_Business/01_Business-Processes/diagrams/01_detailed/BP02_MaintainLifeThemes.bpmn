      <bpmn:incoming>SF_T_26_T_27</bpmn:incoming>
      <bpmn:outgoing>SF_T_27_End_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_28" name="Deletion answered">
      <bpmn:incoming>SF_T_27_End_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="vmIn" name="Vision and mission submitted">
      <bpmn:outgoing>SF_vmIn_T_29</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_vmIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_29" name="Store the vision and the mission">
      <bpmn:incoming>SF_vmIn_T_29</bpmn:incoming>
      <bpmn:outgoing>SF_T_29_T_30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_30" name="Report the outcome">
      <bpmn:incoming>SF_T_29_T_30</bpmn:incoming>
      <bpmn:outgoing>SF_T_30_End_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_31" name="Record answered">
      <bpmn:incoming>SF_T_30_End_31</bpmn:incoming>
    </bpmn:endEvent>
