    <bpmn:endEvent id="End_25" name="Impact answered">
      <bpmn:incoming>SF_T_24_End_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="deleteIn" name="Theme deletion requested">
      <bpmn:outgoing>SF_deleteIn_T_26</bpmn:outgoing>
