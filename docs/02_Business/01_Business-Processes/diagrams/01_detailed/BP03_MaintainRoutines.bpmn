<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP03_MaintainRoutines" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP03_MaintainRoutines">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP03.01 · Read a theme's routines" sourceRef="themeOpen" targetRef="listIn" />
    <bpmn:messageFlow id="MF_2" name="BP03.08 · Draft the routine input" sourceRef="T_3" targetRef="routineDraftIn" />
    <bpmn:messageFlow id="MF_3" name="BP03.02 · Define a routine" sourceRef="T_4" targetRef="defineIn" />
    <bpmn:messageFlow id="MF_4" name="BP03.03 · Amend a routine" sourceRef="T_5" targetRef="amendIn" />
    <bpmn:messageFlow id="MF_5" name="BP03.04 · Pause or resume a routine" sourceRef="T_6" targetRef="activeIn" />
    <bpmn:messageFlow id="MF_6" name="BP03.05 · Reorder routines" sourceRef="T_7" targetRef="reorderIn" />
    <bpmn:messageFlow id="MF_7" name="BP03.06 · See what deleting a routine takes" sourceRef="T_8" targetRef="impactIn" />
    <bpmn:messageFlow id="MF_8" name="BP03.07 · Delete a routine" sourceRef="confirmDeletion" targetRef="deleteIn" />
    <bpmn:messageFlow id="MF_9" name="The theme's routines with their schedules" sourceRef="T_18" targetRef="list" />
    <bpmn:messageFlow id="MF_10" name="Routine defined" sourceRef="T_24" targetRef="defined" />
    <bpmn:messageFlow id="MF_11" name="Routine amended" sourceRef="T_26" targetRef="amended" />
    <bpmn:messageFlow id="MF_12" name="Active state recorded" sourceRef="T_28" targetRef="activeSet" />
    <bpmn:messageFlow id="MF_13" name="Order recorded" sourceRef="T_30" targetRef="reordered" />
    <bpmn:messageFlow id="MF_14" name="What the deletion will take" sourceRef="T_34" targetRef="impact" />
    <bpmn:messageFlow id="MF_15" name="Routine deleted" sourceRef="T_37" targetRef="deleted" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>A paused routine stops being offered for a day's focus and stops being due or overdue. Any task it already produced stays where it is.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="activeSet" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>The schedule is a recurrence pattern plus preferred days. It says when the routine is due; it never puts work on a board.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="defined" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>The routine stops producing new ones either way.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="T_11" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>Nothing is deleted and nothing is changed.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="T_12" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>There is no in-app undo. Recovery is from version control.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="deleted" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>Due and overdue are computed from the recurrence and the preferred days of the active routines. A paused routine is neither, and the days it spends paused never become overdue. The computation writes nothing.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="T_16" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>Every form on this surface drafts as it is filled in, so leaving it half-finished, a crash and a restart all cost nothing. The draft is one-way: nothing waits for it to be kept. Whichever write commits the form discards it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="T_20" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>One request covers both directions. A paused routine leaves the focus selectables and the due computation, and returns to both on resume.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="T_28" targetRef="TextAnnotation_X8" />
    <bpmn:textAnnotation id="TextAnnotation_X9"><bpmn:text>The occurrences are a declinable cascade, so it starts off. Declining leaves them on Chores and stops the routine producing new ones.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X9" associationDirection="None" sourceRef="T_32" targetRef="TextAnnotation_X9" />
    <bpmn:textAnnotation id="TextAnnotation_X10"><bpmn:text>The theme is required. The recurrence is Daily, Weekly, Monthly or Yearly.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X10" associationDirection="None" sourceRef="T_22" targetRef="TextAnnotation_X10" />
    <bpmn:textAnnotation id="TextAnnotation_X11"><bpmn:text>The request carries the cascade the user approved.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X11" associationDirection="None" sourceRef="T_36" targetRef="TextAnnotation_X11" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A recurring practice needs attention">
      <bpmn:outgoing>SF_Start_1_themeOpen</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="themeOpen" name="Open a theme on the Themes tab">
      <bpmn:incoming>SF_Start_1_themeOpen</bpmn:incoming>
      <bpmn:incoming>SF_T_12_themeOpen</bpmn:incoming>
      <bpmn:incoming>SF_Gw_13_themeOpen</bpmn:incoming>
      <bpmn:outgoing>SF_themeOpen_list</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="list" name="The theme's routines with their schedules">
      <bpmn:incoming>SF_themeOpen_list</bpmn:incoming>
      <bpmn:outgoing>SF_list_Gw_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_list" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_2" name="What needs doing?">
      <bpmn:incoming>SF_list_Gw_2</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_2_T_3</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_5</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_6</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_3" name="Name the routine and set its schedule">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_Gw_2_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_T_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_4" name="Submit the new routine">
      <bpmn:incoming>SF_T_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_defined</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="defined" name="Routine defined">
      <bpmn:incoming>SF_T_4_defined</bpmn:incoming>
      <bpmn:outgoing>SF_defined_Gw_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_defined" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_5" name="Amend the routine">
      <bpmn:incoming>SF_Gw_2_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_amended</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="amended" name="Routine amended">
      <bpmn:incoming>SF_T_5_amended</bpmn:incoming>
      <bpmn:outgoing>SF_amended_Gw_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_amended" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_6" name="Toggle the routine active">
      <bpmn:incoming>SF_Gw_2_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_activeSet</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="activeSet" name="Active state recorded">
      <bpmn:incoming>SF_T_6_activeSet</bpmn:incoming>
      <bpmn:outgoing>SF_activeSet_Gw_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_activeSet" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_7" name="Drag a routine into place">
      <bpmn:incoming>SF_Gw_2_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_reordered</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="reordered" name="Order recorded">
      <bpmn:incoming>SF_T_7_reordered</bpmn:incoming>
      <bpmn:outgoing>SF_reordered_Gw_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_reordered" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_8" name="Choose a routine to delete">
      <bpmn:incoming>SF_Gw_2_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_impact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="impact" name="What the deletion will take">
      <bpmn:incoming>SF_T_8_impact</bpmn:incoming>
      <bpmn:outgoing>SF_impact_Gw_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_impact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_9" name="Let the occurrences go too?">
      <bpmn:incoming>SF_impact_Gw_9</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_9_T_10</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_9_T_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_9_T_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_10" name="Include the occurrences in the cascade">
      <bpmn:incoming>SF_Gw_9_T_10</bpmn:incoming>
      <bpmn:outgoing>SF_T_10_confirmDeletion</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_11" name="Leave the occurrences out of the cascade">
      <bpmn:incoming>SF_Gw_9_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_confirmDeletion</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_12" name="Abandon the deletion">
      <bpmn:incoming>SF_Gw_9_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_themeOpen</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="confirmDeletion" name="Confirm the deletion">
      <bpmn:incoming>SF_T_10_confirmDeletion</bpmn:incoming>
      <bpmn:incoming>SF_T_11_confirmDeletion</bpmn:incoming>
      <bpmn:outgoing>SF_confirmDeletion_deleted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="deleted" name="Routine deleted">
      <bpmn:incoming>SF_confirmDeletion_deleted</bpmn:incoming>
      <bpmn:outgoing>SF_deleted_Gw_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_deleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_13" name="Anything else under this life area?">
      <bpmn:incoming>SF_defined_Gw_13</bpmn:incoming>
      <bpmn:incoming>SF_amended_Gw_13</bpmn:incoming>
      <bpmn:incoming>SF_activeSet_Gw_13</bpmn:incoming>
      <bpmn:incoming>SF_reordered_Gw_13</bpmn:incoming>
      <bpmn:incoming>SF_deleted_Gw_13</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_13_T_14</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_13_themeOpen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_14" name="Leave the life area">
      <bpmn:incoming>SF_Gw_13_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_End_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_15" name="Routines current">
      <bpmn:incoming>SF_T_14_End_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_themeOpen" sourceRef="Start_1" targetRef="themeOpen" />
    <bpmn:sequenceFlow id="SF_themeOpen_list" sourceRef="themeOpen" targetRef="list" />
    <bpmn:sequenceFlow id="SF_list_Gw_2" sourceRef="list" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="SF_T_3_T_4" sourceRef="T_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_4_defined" sourceRef="T_4" targetRef="defined" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_3" name="start a new practice" sourceRef="Gw_2" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_T_5_amended" sourceRef="T_5" targetRef="amended" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_5" name="change one" sourceRef="Gw_2" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_6_activeSet" sourceRef="T_6" targetRef="activeSet" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_6" name="put one on hold, or take it off hold" sourceRef="Gw_2" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_T_7_reordered" sourceRef="T_7" targetRef="reordered" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_7" name="reorder them" sourceRef="Gw_2" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_T_8_impact" sourceRef="T_8" targetRef="impact" />
    <bpmn:sequenceFlow id="SF_impact_Gw_9" sourceRef="impact" targetRef="Gw_9" />
    <bpmn:sequenceFlow id="SF_Gw_9_T_10" name="yes, take them as well" sourceRef="Gw_9" targetRef="T_10" />
    <bpmn:sequenceFlow id="SF_Gw_9_T_11" name="no, leave them on Chores" sourceRef="Gw_9" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_Gw_9_T_12" name="abandon the deletion" sourceRef="Gw_9" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_confirmDeletion_deleted" sourceRef="confirmDeletion" targetRef="deleted" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_8" name="retire one for good" sourceRef="Gw_2" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_defined_Gw_13" sourceRef="defined" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_amended_Gw_13" sourceRef="amended" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_activeSet_Gw_13" sourceRef="activeSet" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_reordered_Gw_13" sourceRef="reordered" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_deleted_Gw_13" sourceRef="deleted" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_Gw_13_T_14" name="no" sourceRef="Gw_13" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_T_14_End_15" sourceRef="T_14" targetRef="End_15" />
    <bpmn:sequenceFlow id="SF_T_10_confirmDeletion" sourceRef="T_10" targetRef="confirmDeletion" />
    <bpmn:sequenceFlow id="SF_T_11_confirmDeletion" sourceRef="T_11" targetRef="confirmDeletion" />
    <bpmn:sequenceFlow id="SF_T_12_themeOpen" sourceRef="T_12" targetRef="themeOpen" />
    <bpmn:sequenceFlow id="SF_Gw_13_themeOpen" name="yes" sourceRef="Gw_13" targetRef="themeOpen" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="listIn" name="Routine list requested">
      <bpmn:outgoing>SF_listIn_T_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_listIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_16" name="Read the theme's routines in their recorded order">
      <bpmn:incoming>SF_listIn_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_T_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_17" name="Derive due and overdue from each active routine's schedule">
      <bpmn:incoming>SF_T_16_T_17</bpmn:incoming>
      <bpmn:outgoing>SF_T_17_T_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_18" name="Leave the paused ones out of the computation">
      <bpmn:incoming>SF_T_17_T_18</bpmn:incoming>
      <bpmn:outgoing>SF_T_18_End_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_19" name="Routine list answered">
      <bpmn:incoming>SF_T_18_End_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="routineDraftIn" name="Routine draft submitted">
      <bpmn:outgoing>SF_routineDraftIn_T_20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_routineDraftIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_20" name="Keep what is typed as a draft">
      <bpmn:incoming>SF_routineDraftIn_T_20</bpmn:incoming>
      <bpmn:outgoing>SF_T_20_End_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_21" name="Draft kept">
      <bpmn:incoming>SF_T_20_End_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="defineIn" name="Routine definition submitted">
      <bpmn:outgoing>SF_defineIn_T_22</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_defineIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_22" name="Store the routine under its theme">
      <bpmn:incoming>SF_defineIn_T_22</bpmn:incoming>
      <bpmn:outgoing>SF_T_22_T_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_23" name="Store its recurrence and preferred days">
      <bpmn:incoming>SF_T_22_T_23</bpmn:incoming>
      <bpmn:outgoing>SF_T_23_T_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_24" name="Place it last in the theme's order">
      <bpmn:incoming>SF_T_23_T_24</bpmn:incoming>
      <bpmn:outgoing>SF_T_24_End_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_25" name="Definition answered">
      <bpmn:incoming>SF_T_24_End_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="amendIn" name="Routine amendment requested">
      <bpmn:outgoing>SF_amendIn_T_26</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_amendIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_26" name="Apply the name and schedule as given">
      <bpmn:incoming>SF_amendIn_T_26</bpmn:incoming>
      <bpmn:outgoing>SF_T_26_End_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_27" name="Amendment answered">
      <bpmn:incoming>SF_T_26_End_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="activeIn" name="Active state submitted">
      <bpmn:outgoing>SF_activeIn_T_28</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_activeIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_28" name="Record the routine's active state">
      <bpmn:incoming>SF_activeIn_T_28</bpmn:incoming>
      <bpmn:outgoing>SF_T_28_End_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_29" name="Active state answered">
      <bpmn:incoming>SF_T_28_End_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="reorderIn" name="Routine reordering requested">
      <bpmn:outgoing>SF_reorderIn_T_30</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_reorderIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_30" name="Record the new relative order within the theme">
      <bpmn:incoming>SF_reorderIn_T_30</bpmn:incoming>
      <bpmn:outgoing>SF_T_30_End_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_31" name="Reordering answered">
      <bpmn:incoming>SF_T_30_End_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="impactIn" name="Deletion impact requested">
      <bpmn:outgoing>SF_impactIn_T_32</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_impactIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_32" name="Collect the task occurrences the routine produced">
      <bpmn:incoming>SF_impactIn_T_32</bpmn:incoming>
      <bpmn:outgoing>SF_T_32_T_33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_33" name="Include the archived ones in the count">
      <bpmn:incoming>SF_T_32_T_33</bpmn:incoming>
      <bpmn:outgoing>SF_T_33_T_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_34" name="Report what the deletion will take">
      <bpmn:incoming>SF_T_33_T_34</bpmn:incoming>
      <bpmn:outgoing>SF_T_34_End_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_35" name="Impact answered">
      <bpmn:incoming>SF_T_34_End_35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="deleteIn" name="Routine deletion requested">
      <bpmn:outgoing>SF_deleteIn_T_36</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_deleteIn" />
    </bpmn:startEvent>
