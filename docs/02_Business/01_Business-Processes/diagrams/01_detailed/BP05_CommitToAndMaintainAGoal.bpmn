    <bpmn:sequenceFlow id="SF_T_22_End_23" sourceRef="T_22" targetRef="End_23" />
    <bpmn:sequenceFlow id="SF_T_4_goalsTab" sourceRef="T_4" targetRef="goalsTab" />
    <bpmn:sequenceFlow id="SF_T_14_confirmArchive" sourceRef="T_14" targetRef="confirmArchive" />
    <bpmn:sequenceFlow id="SF_T_15_confirmArchive" sourceRef="T_15" targetRef="confirmArchive" />
    <bpmn:sequenceFlow id="SF_T_16_goalsTab" sourceRef="T_16" targetRef="goalsTab" />
