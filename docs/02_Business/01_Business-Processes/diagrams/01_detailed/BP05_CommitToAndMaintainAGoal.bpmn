      <bpmn:outgoing>SF_Gw_3_T_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_17</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_23</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_25</bpmn:outgoing>
