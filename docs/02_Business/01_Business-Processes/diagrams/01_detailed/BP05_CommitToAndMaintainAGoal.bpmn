    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_8" name="Goals ordered">
      <bpmn:incoming>SF_goalsReordered_End_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_9" name="Work a progress measure (BP06)">
      <bpmn:incoming>SF_Gw_3_T_9</bpmn:incoming>
