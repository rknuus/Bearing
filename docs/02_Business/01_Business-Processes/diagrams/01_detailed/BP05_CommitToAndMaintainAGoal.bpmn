      <bpmn:outgoing>SF_overview_Gw_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_overview" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_2" name="What needs doing?">
      <bpmn:incoming>SF_overview_Gw_2</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_2_Gw_3</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_Gw_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_12</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_3" name="Any life area to hang it on?">
      <bpmn:incoming>SF_Gw_2_Gw_3</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_3_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_4" name="Read why a goal cannot be framed">
      <bpmn:incoming>SF_Gw_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_goalsTab</bpmn:outgoing>
