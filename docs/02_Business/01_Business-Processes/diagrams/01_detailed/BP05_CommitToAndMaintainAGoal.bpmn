<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP05_CommitToAndMaintainAGoal" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP05_CommitToAndMaintainAGoal">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP05.01 · Read the goals overview" sourceRef="goalsTab" targetRef="overviewIn" />
    <bpmn:messageFlow id="MF_2" name="BP05.16 · Draft the goal input" sourceRef="T_5" targetRef="goalDraftIn" />
    <bpmn:messageFlow id="MF_3" name="BP05.02 · Frame a goal" sourceRef="T_6" targetRef="frameIn" />
    <bpmn:messageFlow id="MF_4" name="BP05.03 · Amend a goal" sourceRef="T_8" targetRef="amendIn" />
    <bpmn:messageFlow id="MF_5" name="BP05.04 · Link an idea to a goal" sourceRef="T_9" targetRef="linkIn" />
    <bpmn:messageFlow id="MF_6" name="BP05.05 · Unlink an idea from a goal" sourceRef="T_10" targetRef="unlinkIn" />
    <bpmn:messageFlow id="MF_7" name="BP05.11 · Reorder goals within a theme" sourceRef="T_11" targetRef="reorderGoalsIn" />
    <bpmn:messageFlow id="MF_8" name="BP05.12 · See what archiving a goal takes" sourceRef="T_12" targetRef="archImpactIn" />
    <bpmn:messageFlow id="MF_9" name="BP05.13 · Archive a goal" sourceRef="confirmArchive" targetRef="archiveIn" />
    <bpmn:messageFlow id="MF_10" name="BP05.14 · See what deleting a goal takes" sourceRef="T_17" targetRef="delImpactIn" />
    <bpmn:messageFlow id="MF_11" name="BP05.15 · Delete a goal" sourceRef="T_19" targetRef="deleteIn" />
    <bpmn:messageFlow id="MF_12" name="Goals grouped by theme" sourceRef="T_29" targetRef="overview" />
    <bpmn:messageFlow id="MF_13" name="Framing outcome" sourceRef="T_36" targetRef="framed" />
    <bpmn:messageFlow id="MF_14" name="Goal amended" sourceRef="T_38" targetRef="amended" />
    <bpmn:messageFlow id="MF_15" name="Idea linked" sourceRef="T_40" targetRef="linked" />
    <bpmn:messageFlow id="MF_16" name="Idea unlinked" sourceRef="T_42" targetRef="unlinked" />
    <bpmn:messageFlow id="MF_17" name="Order recorded" sourceRef="T_44" targetRef="goalsReordered" />
    <bpmn:messageFlow id="MF_18" name="What the archiving will take" sourceRef="T_49" targetRef="archImpact" />
    <bpmn:messageFlow id="MF_19" name="Goal archived" sourceRef="T_53" targetRef="archived" />
    <bpmn:messageFlow id="MF_20" name="What the deletion will take" sourceRef="T_59" targetRef="delImpact" />
    <bpmn:messageFlow id="MF_21" name="Goal deleted" sourceRef="T_64" targetRef="deleted" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>A goal requires a theme, and the user is told so instead of being shown a form that cannot be submitted. Creating the life area is BP02.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_4" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>A goal with no linked idea stays legitimate and is flagged as such.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="unlinked" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>An archived goal still exists, so its projects are not orphaned by it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="T_15" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>Nothing is archived.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="T_16" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>Nothing is deleted.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="T_20" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>There is no in-app undo. Recovery is from version control.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="deleted" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>The flags read the current state. Nothing acts on the goal.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="T_26" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>Cascade, the goal alone, or reject. The keep answer is legal here because an archived goal still exists.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="T_46" targetRef="TextAnnotation_X8" />
    <bpmn:textAnnotation id="TextAnnotation_X9"><bpmn:text>The measures and their history go unasked. Keeping a project behind is not offered.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X9" associationDirection="None" sourceRef="T_55" targetRef="TextAnnotation_X9" />
    <bpmn:textAnnotation id="TextAnnotation_X10"><bpmn:text>Every form on this surface drafts as it is filled in, so leaving it half-finished, a crash and a restart all cost nothing. The draft is one-way: nothing waits for it to be kept. Whichever write commits the form discards it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X10" associationDirection="None" sourceRef="T_24" targetRef="TextAnnotation_X10" />
    <bpmn:textAnnotation id="TextAnnotation_X11"><bpmn:text>A goal has no parent and no children.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X11" associationDirection="None" sourceRef="T_38" targetRef="TextAnnotation_X11" />
    <bpmn:textAnnotation id="TextAnnotation_X12"><bpmn:text>One request frames a theme-only goal and promotes an idea alike. The horizon may be absent.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X12" associationDirection="None" sourceRef="Gw_31" targetRef="TextAnnotation_X12" />
    <bpmn:textAnnotation id="TextAnnotation_X13"><bpmn:text>Archiving is independent of closing out. A check-out record already attached stays with the goal.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X13" associationDirection="None" sourceRef="T_51" targetRef="TextAnnotation_X13" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A commitment to make, or one to maintain">
      <bpmn:outgoing>SF_Start_1_goalsTab</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="goalsTab" name="Open the Goals tab">
      <bpmn:incoming>SF_Start_1_goalsTab</bpmn:incoming>
      <bpmn:incoming>SF_T_4_goalsTab</bpmn:incoming>
      <bpmn:incoming>SF_T_16_goalsTab</bpmn:incoming>
