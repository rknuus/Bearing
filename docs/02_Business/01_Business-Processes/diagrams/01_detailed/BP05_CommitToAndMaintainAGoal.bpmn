      <bpmn:incoming>SF_Gw_21_T_22</bpmn:incoming>
      <bpmn:outgoing>SF_T_22_End_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_23" name="Commitment current">
      <bpmn:incoming>SF_T_22_End_23</bpmn:incoming>
    </bpmn:endEvent>
