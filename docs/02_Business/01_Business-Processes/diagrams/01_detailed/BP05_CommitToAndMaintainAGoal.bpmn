    <bpmn:sequenceFlow id="SF_T_13_T_14" sourceRef="T_13" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_T_14_archived" sourceRef="T_14" targetRef="archived" />
    <bpmn:sequenceFlow id="SF_Gw_12_T_13" name="approve" sourceRef="Gw_12" targetRef="T_13" />
    <bpmn:sequenceFlow id="SF_Gw_12_End_15" name="reject" sourceRef="Gw_12" targetRef="End_15" />
    <bpmn:sequenceFlow id="SF_archived_End_16" sourceRef="archived" targetRef="End_16" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_11" name="set one aside" sourceRef="Gw_3" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_T_17_delImpact" sourceRef="T_17" targetRef="delImpact" />
    <bpmn:sequenceFlow id="SF_delImpact_Gw_18" sourceRef="delImpact" targetRef="Gw_18" />
    <bpmn:sequenceFlow id="SF_T_19_T_20" sourceRef="T_19" targetRef="T_20" />
    <bpmn:sequenceFlow id="SF_T_20_deleted" sourceRef="T_20" targetRef="deleted" />
    <bpmn:sequenceFlow id="SF_Gw_18_T_19" name="approve" sourceRef="Gw_18" targetRef="T_19" />
    <bpmn:sequenceFlow id="SF_Gw_18_End_21" name="reject" sourceRef="Gw_18" targetRef="End_21" />
    <bpmn:sequenceFlow id="SF_deleted_End_22" sourceRef="deleted" targetRef="End_22" />
