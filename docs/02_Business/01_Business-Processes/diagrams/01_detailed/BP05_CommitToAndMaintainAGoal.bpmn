      <bpmn:incoming>SF_T_6_framed</bpmn:incoming>
      <bpmn:outgoing>SF_framed_Gw_21</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_framed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_7" name="Which part?">
      <bpmn:incoming>SF_Gw_2_Gw_7</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_7_T_8</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_7_T_9</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_7_T_10</bpmn:outgoing>
