    <bpmn:sequenceFlow id="SF_T_23_End_24" sourceRef="T_23" targetRef="End_24" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_23" name="check one out" sourceRef="Gw_3" targetRef="T_23" />
    <bpmn:sequenceFlow id="SF_T_25_T_26" sourceRef="T_25" targetRef="T_26" />
    <bpmn:sequenceFlow id="SF_T_26_projectCreated" sourceRef="T_26" targetRef="projectCreated" />
    <bpmn:sequenceFlow id="SF_projectCreated_End_27" sourceRef="projectCreated" targetRef="End_27" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_25" name="start work on one" sourceRef="Gw_3" targetRef="T_25" />
    <bpmn:sequenceFlow id="SF_T_28_End_29" sourceRef="T_28" targetRef="End_29" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_28" name="look at the archived ones" sourceRef="Gw_3" targetRef="T_28" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="editIn" name="Goal submitted">
      <bpmn:outgoing>SF_editIn_Gw_30</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_editIn" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_30" name="Does the goal name a theme?">
      <bpmn:incoming>SF_editIn_Gw_30</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_30_T_31</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_30_T_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_31" name="Store the edit">
      <bpmn:incoming>SF_Gw_30_T_31</bpmn:incoming>
      <bpmn:outgoing>SF_T_31_T_33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_32" name="Refuse it and say why">
      <bpmn:incoming>SF_Gw_30_T_32</bpmn:incoming>
      <bpmn:outgoing>SF_T_32_T_33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_33" name="Report the outcome">
      <bpmn:incoming>SF_T_31_T_33</bpmn:incoming>
      <bpmn:incoming>SF_T_32_T_33</bpmn:incoming>
      <bpmn:outgoing>SF_T_33_End_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_34" name="Goal answered">
      <bpmn:incoming>SF_T_33_End_34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="reorderGoalsIn" name="Goal reordering requested">
      <bpmn:outgoing>SF_reorderGoalsIn_T_35</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_reorderGoalsIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_35" name="Apply the new order">
      <bpmn:incoming>SF_reorderGoalsIn_T_35</bpmn:incoming>
      <bpmn:outgoing>SF_T_35_T_36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_36" name="Report the outcome">
      <bpmn:incoming>SF_T_35_T_36</bpmn:incoming>
      <bpmn:outgoing>SF_T_36_End_37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_37" name="Goal reordering answered">
      <bpmn:incoming>SF_T_36_End_37</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="archImpactIn" name="Archiving impact requested">
      <bpmn:outgoing>SF_archImpactIn_T_38</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archImpactIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_38" name="Report what the archiving will take, and what of it can be declined">
      <bpmn:incoming>SF_archImpactIn_T_38</bpmn:incoming>
      <bpmn:outgoing>SF_T_38_End_39</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_39" name="Archiving impact answered">
      <bpmn:incoming>SF_T_38_End_39</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="archiveIn" name="Goal archiving requested">
      <bpmn:outgoing>SF_archiveIn_T_40</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archiveIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_40" name="Archive confirmed items">
      <bpmn:incoming>SF_archiveIn_T_40</bpmn:incoming>
      <bpmn:outgoing>SF_T_40_T_41</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_41" name="Report the outcome">
      <bpmn:incoming>SF_T_40_T_41</bpmn:incoming>
      <bpmn:outgoing>SF_T_41_End_42</bpmn:outgoing>
