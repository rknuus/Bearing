      <bpmn:outgoing>SF_Gw_12_T_13</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_12_End_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_13" name="Select a valid cascading option">
