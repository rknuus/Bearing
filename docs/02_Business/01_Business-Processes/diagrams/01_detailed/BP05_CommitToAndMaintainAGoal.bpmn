    </bpmn:task>
    <bpmn:endEvent id="End_24" name="Check-out opened">
      <bpmn:incoming>SF_T_23_End_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_25" name="Create a project on the goal, or on one of its measures">
