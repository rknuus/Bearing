    </bpmn:task>
    <bpmn:endEvent id="End_10" name="Measures opened">
      <bpmn:incoming>SF_T_9_End_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_11" name="Archive a goal">
