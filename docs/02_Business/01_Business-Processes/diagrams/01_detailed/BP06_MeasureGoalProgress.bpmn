    </bpmn:startEvent>
    <bpmn:task id="T_21" name="Store the edit">
      <bpmn:incoming>SF_editIn_T_21</bpmn:incoming>
      <bpmn:outgoing>SF_T_21_T_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_22" name="Report the outcome">
      <bpmn:incoming>SF_T_21_T_22</bpmn:incoming>
      <bpmn:outgoing>SF_T_22_End_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_23" name="Measure answered">
      <bpmn:incoming>SF_T_22_End_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="reorderIn" name="Measure reordering requested">
      <bpmn:outgoing>SF_reorderIn_T_24</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_reorderIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_24" name="Apply the new order">
      <bpmn:incoming>SF_reorderIn_T_24</bpmn:incoming>
      <bpmn:outgoing>SF_T_24_T_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_25" name="Report the outcome">
      <bpmn:incoming>SF_T_24_T_25</bpmn:incoming>
      <bpmn:outgoing>SF_T_25_End_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_26" name="Measure reordering answered">
      <bpmn:incoming>SF_T_25_End_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="measureArchiveIn" name="Measure archiving requested">
      <bpmn:outgoing>SF_measureArchiveIn_T_27</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_measureArchiveIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_27" name="Archive the measure">
      <bpmn:incoming>SF_measureArchiveIn_T_27</bpmn:incoming>
      <bpmn:outgoing>SF_T_27_T_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_28" name="Report the outcome">
      <bpmn:incoming>SF_T_27_T_28</bpmn:incoming>
      <bpmn:outgoing>SF_T_28_End_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_29" name="Archiving answered">
      <bpmn:incoming>SF_T_28_End_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="removeIn" name="Measure removal requested">
      <bpmn:outgoing>SF_removeIn_T_30</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_removeIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_30" name="Remove the measure">
      <bpmn:incoming>SF_removeIn_T_30</bpmn:incoming>
      <bpmn:outgoing>SF_T_30_T_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_31" name="Report the outcome">
      <bpmn:incoming>SF_T_30_T_31</bpmn:incoming>
      <bpmn:outgoing>SF_T_31_End_32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_32" name="Removal answered">
      <bpmn:incoming>SF_T_31_End_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_T_18_T_19" sourceRef="T_18" targetRef="T_19" />
    <bpmn:sequenceFlow id="SF_checkInIn_T_18" sourceRef="checkInIn" targetRef="T_18" />
    <bpmn:sequenceFlow id="SF_T_19_End_20" sourceRef="T_19" targetRef="End_20" />
    <bpmn:sequenceFlow id="SF_T_21_T_22" sourceRef="T_21" targetRef="T_22" />
    <bpmn:sequenceFlow id="SF_editIn_T_21" sourceRef="editIn" targetRef="T_21" />
    <bpmn:sequenceFlow id="SF_T_22_End_23" sourceRef="T_22" targetRef="End_23" />
