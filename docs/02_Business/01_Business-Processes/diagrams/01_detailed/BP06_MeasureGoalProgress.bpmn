    <bpmn:sequenceFlow id="SF_reorderIn_T_24" sourceRef="reorderIn" targetRef="T_24" />
    <bpmn:sequenceFlow id="SF_T_25_End_26" sourceRef="T_25" targetRef="End_26" />
    <bpmn:sequenceFlow id="SF_T_27_T_28" sourceRef="T_27" targetRef="T_28" />
    <bpmn:sequenceFlow id="SF_measureArchiveIn_T_27" sourceRef="measureArchiveIn" targetRef="T_27" />
    <bpmn:sequenceFlow id="SF_T_28_End_29" sourceRef="T_28" targetRef="End_29" />
    <bpmn:sequenceFlow id="SF_T_30_T_31" sourceRef="T_30" targetRef="T_31" />
    <bpmn:sequenceFlow id="SF_removeIn_T_30" sourceRef="removeIn" targetRef="T_30" />
    <bpmn:sequenceFlow id="SF_T_31_End_32" sourceRef="T_31" targetRef="End_32" />
  </bpmn:process>
