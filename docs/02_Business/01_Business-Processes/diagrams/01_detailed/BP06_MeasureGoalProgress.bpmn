<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP06_MeasureGoalProgress" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP06_MeasureGoalProgress">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP06.03 · Edit a progress measure" sourceRef="T_5" targetRef="editIn" />
    <bpmn:messageFlow id="MF_2" name="BP06.05 · Reorder progress measures" sourceRef="T_7" targetRef="reorderIn" />
    <bpmn:messageFlow id="MF_3" name="BP06.11 · Archive a progress measure" sourceRef="T_9" targetRef="measureArchiveIn" />
    <bpmn:messageFlow id="MF_4" name="BP06.07 · Remove a progress measure" sourceRef="T_11" targetRef="removeIn" />
    <bpmn:messageFlow id="MF_5" name="BP06.02 · Record a progress check-in" sourceRef="T_14" targetRef="checkInIn" />
    <bpmn:messageFlow id="MF_6" name="The check-in outcome" sourceRef="T_19" targetRef="recorded" />
    <bpmn:messageFlow id="MF_7" name="The editing outcome" sourceRef="T_22" targetRef="measureSaved" />
    <bpmn:messageFlow id="MF_8" name="The ordering outcome" sourceRef="T_25" targetRef="reordered" />
    <bpmn:messageFlow id="MF_9" name="The archiving outcome" sourceRef="T_28" targetRef="measureArchived" />
    <bpmn:messageFlow id="MF_10" name="The removal outcome" sourceRef="T_31" targetRef="removed" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>A goal's measures are its own sub-items and have no page of their own: they are already on the Goals view, read with the goals. This process acts on what is there.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_2" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>An archived measure is listed under the goal it belongs to, in the Goals archive. Reading it, bringing it back and destroying it are their own process (BP15).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_16" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>The check-in history hangs on the measure's identity, never on its position.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="reordered" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>A measure takes its own check-in history with it and brings it back with it. A project parented on it keeps its parent, which still exists.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="measureArchived" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>Its check-in history goes with it, unasked, and nothing else does, so there is nothing to disclose and nothing to approve: a project parented on it survives minus the link.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="removed" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>Numeric carries a start value, a target, a unit and a direction, and its current value starts at the start value; boolean carries done and not done, starting at not done. The type is editable like the start value, the target and the unit, and the recorded check-ins are left as they stand.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="measureSaved" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>Numeric takes the value the current value moves to. Boolean takes done and not done. A note is optional either way. Nothing is read first: the measure and where it stands arrived with the goals.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="recorded" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>Its check-in history goes with it and comes back with it, into a live goal. While it is away it is frozen, so nothing is recorded against it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="T_27" targetRef="TextAnnotation_X8" />
    <bpmn:textAnnotation id="TextAnnotation_X9"><bpmn:text>The history is append-only, so a date that already carries a check-in takes another and each is its own data point. The current value is what the latest one says, and the start value until there is one. A check-in records a data point and infers no status.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X9" associationDirection="None" sourceRef="T_18" targetRef="TextAnnotation_X9" />
    <bpmn:textAnnotation id="TextAnnotation_X10"><bpmn:text>There is no untyped measure. The type is editable like the start value, the target and the unit, and the check-ins already recorded are left as they stand, each in the type it was recorded under.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X10" associationDirection="None" sourceRef="T_21" targetRef="TextAnnotation_X10" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A commitment to measure, or progress to record">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Work a progress measure">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_Gw_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_3" name="What needs doing?">
      <bpmn:incoming>SF_T_2_Gw_3</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_3_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_9</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_13</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_4" name="Define a measure">
      <bpmn:incoming>SF_Gw_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_T_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_5" name="Submit the measure">
      <bpmn:incoming>SF_T_4_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_measureSaved</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="measureSaved" name="The editing outcome">
      <bpmn:incoming>SF_T_5_measureSaved</bpmn:incoming>
      <bpmn:outgoing>SF_measureSaved_End_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_measureSaved" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_6" name="Measure defined">
      <bpmn:incoming>SF_measureSaved_End_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_7" name="Order a measure">
      <bpmn:incoming>SF_Gw_3_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_reordered</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="reordered" name="The ordering outcome">
      <bpmn:incoming>SF_T_7_reordered</bpmn:incoming>
      <bpmn:outgoing>SF_reordered_End_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_reordered" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_8" name="Measures ordered">
      <bpmn:incoming>SF_reordered_End_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_9" name="Archive a measure">
      <bpmn:incoming>SF_Gw_3_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_measureArchived</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="measureArchived" name="The archiving outcome">
      <bpmn:incoming>SF_T_9_measureArchived</bpmn:incoming>
      <bpmn:outgoing>SF_measureArchived_End_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_measureArchived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_10" name="Measure set aside">
      <bpmn:incoming>SF_measureArchived_End_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_11" name="Remove a measure">
      <bpmn:incoming>SF_Gw_3_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_removed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="removed" name="The removal outcome">
      <bpmn:incoming>SF_T_11_removed</bpmn:incoming>
      <bpmn:outgoing>SF_removed_End_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_removed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_12" name="Measure removed">
      <bpmn:incoming>SF_removed_End_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_13" name="Check in on a measure">
      <bpmn:incoming>SF_Gw_3_T_13</bpmn:incoming>
      <bpmn:outgoing>SF_T_13_T_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_14" name="Submit the check-in">
      <bpmn:incoming>SF_T_13_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_recorded</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="recorded" name="The check-in outcome">
      <bpmn:incoming>SF_T_14_recorded</bpmn:incoming>
      <bpmn:outgoing>SF_recorded_End_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_recorded" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_15" name="Progress recorded">
      <bpmn:incoming>SF_recorded_End_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_16" name="Open the archived measures (BP15)">
      <bpmn:incoming>SF_Gw_3_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_End_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_17" name="Archive opened">
      <bpmn:incoming>SF_T_16_End_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_Gw_3" sourceRef="T_2" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="SF_T_4_T_5" sourceRef="T_4" targetRef="T_5" />
