    <bpmn:sequenceFlow id="SF_measureSaved_End_6" sourceRef="measureSaved" targetRef="End_6" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_4" name="add or change what counts" sourceRef="Gw_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_7_reordered" sourceRef="T_7" targetRef="reordered" />
    <bpmn:sequenceFlow id="SF_reordered_End_8" sourceRef="reordered" targetRef="End_8" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_7" name="reorder them" sourceRef="Gw_3" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_T_9_measureArchived" sourceRef="T_9" targetRef="measureArchived" />
    <bpmn:sequenceFlow id="SF_measureArchived_End_10" sourceRef="measureArchived" targetRef="End_10" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_9" name="set one aside" sourceRef="Gw_3" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_T_11_removed" sourceRef="T_11" targetRef="removed" />
    <bpmn:sequenceFlow id="SF_removed_End_12" sourceRef="removed" targetRef="End_12" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_11" name="drop one" sourceRef="Gw_3" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_T_13_T_14" sourceRef="T_13" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_T_14_recorded" sourceRef="T_14" targetRef="recorded" />
    <bpmn:sequenceFlow id="SF_recorded_End_15" sourceRef="recorded" targetRef="End_15" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_13" name="record where one stands" sourceRef="Gw_3" targetRef="T_13" />
    <bpmn:sequenceFlow id="SF_T_16_End_17" sourceRef="T_16" targetRef="End_17" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_16" name="look at the ones set aside" sourceRef="Gw_3" targetRef="T_16" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="checkInIn" name="Check-in submitted">
      <bpmn:outgoing>SF_checkInIn_T_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_checkInIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_18" name="Append the check-in and move the measure's current value">
      <bpmn:incoming>SF_checkInIn_T_18</bpmn:incoming>
      <bpmn:outgoing>SF_T_18_T_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_19" name="Report the outcome">
      <bpmn:incoming>SF_T_18_T_19</bpmn:incoming>
      <bpmn:outgoing>SF_T_19_End_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_20" name="Check-in answered">
      <bpmn:incoming>SF_T_19_End_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="editIn" name="Measure submitted">
      <bpmn:outgoing>SF_editIn_T_21</bpmn:outgoing>
