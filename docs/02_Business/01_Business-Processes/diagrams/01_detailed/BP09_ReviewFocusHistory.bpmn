<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP09_ReviewFocusHistory" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP09_ReviewFocusHistory">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP09.01 · Read a period overview" sourceRef="pick" targetRef="overviewIn" />
    <bpmn:messageFlow id="MF_2" name="BP09.02 · Read a day's log" sourceRef="T_4" targetRef="logIn" />
    <bpmn:messageFlow id="MF_3" name="The period with its coverage and theme balance" sourceRef="T_12" targetRef="overview" />
    <bpmn:messageFlow id="MF_4" name="That day's log" sourceRef="T_14" targetRef="log" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>Previous, next and back-to-current are the same read with another parameter.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_3" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>The day focus editor opens on the selected day and the period stays behind it. Setting the focus is BP08.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_5" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>One read serves week, month and year, and serves previous, next and current alike. There is no day-scoped view. The Chores board is absent from history: a derived member cannot be reconstructed for a past date.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="T_9" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>The log holds what was completed, what was still open, and the notes written that day.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="T_14" targetRef="TextAnnotation_X4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A stretch of days worth looking back on">
      <bpmn:outgoing>SF_Start_1_pick</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="pick" name="Choose a period and a scope">
      <bpmn:incoming>SF_Start_1_pick</bpmn:incoming>
      <bpmn:incoming>SF_T_3_pick</bpmn:incoming>
      <bpmn:incoming>SF_log_pick</bpmn:incoming>
      <bpmn:outgoing>SF_pick_overview</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="overview" name="The period with its coverage and theme balance">
      <bpmn:incoming>SF_pick_overview</bpmn:incoming>
      <bpmn:outgoing>SF_overview_Gw_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_overview" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_2" name="What next?">
      <bpmn:incoming>SF_overview_Gw_2</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_2_T_3</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_5</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_3" name="Step the period, or switch the scope">
      <bpmn:incoming>SF_Gw_2_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_pick</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_4" name="Open that day's log">
      <bpmn:incoming>SF_Gw_2_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_log</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="log" name="That day's log">
      <bpmn:incoming>SF_T_4_log</bpmn:incoming>
      <bpmn:outgoing>SF_log_pick</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_log" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_5" name="Select the day to edit">
      <bpmn:incoming>SF_Gw_2_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_End_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_6" name="Day opened for editing">
      <bpmn:incoming>SF_T_5_End_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_7" name="Close the review">
      <bpmn:incoming>SF_Gw_2_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_End_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_8" name="Review done">
      <bpmn:incoming>SF_T_7_End_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_pick" sourceRef="Start_1" targetRef="pick" />
    <bpmn:sequenceFlow id="SF_pick_overview" sourceRef="pick" targetRef="overview" />
    <bpmn:sequenceFlow id="SF_overview_Gw_2" sourceRef="overview" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_3" name="look at another period" sourceRef="Gw_2" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_T_4_log" sourceRef="T_4" targetRef="log" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_4" name="understand one day" sourceRef="Gw_2" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_5_End_6" sourceRef="T_5" targetRef="End_6" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_5" name="change a day's plan" sourceRef="Gw_2" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_7" name="nothing more" sourceRef="Gw_2" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_T_7_End_8" sourceRef="T_7" targetRef="End_8" />
    <bpmn:sequenceFlow id="SF_T_3_pick" sourceRef="T_3" targetRef="pick" />
    <bpmn:sequenceFlow id="SF_log_pick" sourceRef="log" targetRef="pick" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="overviewIn" name="Period overview requested">
      <bpmn:outgoing>SF_overviewIn_T_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_overviewIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_9" name="Read the days of the requested period">
      <bpmn:incoming>SF_overviewIn_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_T_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_10" name="State the period and its relation to now">
      <bpmn:incoming>SF_T_9_T_10</bpmn:incoming>
      <bpmn:outgoing>SF_T_10_T_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_11" name="Compute the coverage over the period">
      <bpmn:incoming>SF_T_10_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_T_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_12" name="Compute the theme balance over the period">
      <bpmn:incoming>SF_T_11_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_End_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_13" name="Overview answered">
      <bpmn:incoming>SF_T_12_End_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="logIn" name="Day log requested">
      <bpmn:outgoing>SF_logIn_T_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_logIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_14" name="Read the log written for that date">
      <bpmn:incoming>SF_logIn_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_End_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_15" name="Day log answered">
      <bpmn:incoming>SF_T_14_End_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_T_9_T_10" sourceRef="T_9" targetRef="T_10" />
    <bpmn:sequenceFlow id="SF_T_10_T_11" sourceRef="T_10" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_T_11_T_12" sourceRef="T_11" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_overviewIn_T_9" sourceRef="overviewIn" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_T_12_End_13" sourceRef="T_12" targetRef="End_13" />
    <bpmn:sequenceFlow id="SF_logIn_T_14" sourceRef="logIn" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_T_14_End_15" sourceRef="T_14" targetRef="End_15" />
  </bpmn:process>
