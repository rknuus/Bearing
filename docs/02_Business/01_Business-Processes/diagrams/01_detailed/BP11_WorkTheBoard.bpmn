<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP11_WorkTheBoard" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP11_WorkTheBoard">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP11.03 · Move a task" sourceRef="T_4" targetRef="moveIn" />
    <bpmn:messageFlow id="MF_2" name="BP11.09 · Set the activity Done" sourceRef="T_7" targetRef="activityIn" />
    <bpmn:messageFlow id="MF_3" name="BP11.05 · Order a task" sourceRef="T_11" targetRef="orderIn" />
    <bpmn:messageFlow id="MF_4" name="BP11.06 · Edit a task" sourceRef="T_14" targetRef="editIn" />
    <bpmn:messageFlow id="MF_5" name="BP11.07 · Archive a task" sourceRef="T_16" targetRef="archiveIn" />
    <bpmn:messageFlow id="MF_6" name="BP11.08 · Delete a task" sourceRef="T_18" targetRef="deleteIn" />
    <bpmn:messageFlow id="MF_7" name="The move's outcome" sourceRef="T_35" targetRef="moved" />
    <bpmn:messageFlow id="MF_8" name="The ordering outcome" sourceRef="T_38" targetRef="ordered" />
    <bpmn:messageFlow id="MF_9" name="The editing outcome" sourceRef="T_43" targetRef="amended" />
    <bpmn:messageFlow id="MF_10" name="The archiving outcome" sourceRef="T_46" targetRef="archived" />
    <bpmn:messageFlow id="MF_11" name="The deletion outcome" sourceRef="T_49" targetRef="deleted" />
    <bpmn:messageFlow id="MF_12" name="The state-change outcome" sourceRef="T_52" targetRef="activitySet" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>The lanes come from a template that governs every board of the project, and changing them is its own process (BP12).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_25" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>Settling everything since the last check-out is its own process (BP13), and it archives what that span completed.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_27" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>The archive is reached by an explicit act. Reading it, bringing one back and destroying one out of it are its own process (BP15).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="T_29" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>Capturing a batch of tasks, tidying it and committing it is its own process (BP10), and nothing it stages takes effect until it is committed.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="T_23" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>Archiving is a conscious gesture. A task sitting in Done does not archive itself.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="archived" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>A task owns nothing, so there is nothing to disclose and no cascade to approve.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="deleted" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>What the task says and its priority are fields of the one editor; the board is not, a task staying on the board it was created on for its whole life. Priority changes only while the task is in the Backlog, so work in motion is sent back there first, which re-opens its triage - by this editor or by dragging it between the sections.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="amended" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>Where tasks on the board are still open, they are disclosed with the offer and the answer travels with the closing: close them with the activity, set them aside, or leave them open. Where nothing is open there is nothing to disclose and nothing to answer.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="activitySet" targetRef="TextAnnotation_X8" />
    <bpmn:textAnnotation id="TextAnnotation_X9"><bpmn:text>A task never moves to another board. Returning it to the Backlog re-opens its triage.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X9" associationDirection="None" sourceRef="T_31" targetRef="TextAnnotation_X9" />
    <bpmn:textAnnotation id="TextAnnotation_X10"><bpmn:text>This is one of the acts that archive a task, and the one that takes a single card. A routine's task archives by the same acts as any other.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X10" associationDirection="None" sourceRef="T_45" targetRef="TextAnnotation_X10" />
    <bpmn:textAnnotation id="TextAnnotation_X11"><bpmn:text>A task owns nothing, so nothing goes with it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X11" associationDirection="None" sourceRef="T_48" targetRef="TextAnnotation_X11" />
    <bpmn:textAnnotation id="TextAnnotation_X12"><bpmn:text>The board and the column are untouched by an edit. Triage happens at intake, so the priority is changeable only in the Backlog; the three are Important and Urgent, Not Important and Urgent, and Important and Not Urgent.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X12" associationDirection="None" sourceRef="Gw_40" targetRef="TextAnnotation_X12" />
    <bpmn:textAnnotation id="TextAnnotation_X13"><bpmn:text>The Course page owns an activity's state (BP18); this is the completion offer answered from the board. A Done activity can be reopened there.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X13" associationDirection="None" sourceRef="T_51" targetRef="TextAnnotation_X13" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Work to get done">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Work the board">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_Gw_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_3" name="What needs doing?">
      <bpmn:incoming>SF_T_2_Gw_3</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_3_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_13</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_16</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_18</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_20</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_22</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_25</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_27</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_4" name="Move a task to another column or triage section">
      <bpmn:incoming>SF_Gw_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_moved</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="moved" name="The move's outcome">
      <bpmn:incoming>SF_T_4_moved</bpmn:incoming>
      <bpmn:outgoing>SF_moved_Gw_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_moved" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_5" name="Did the move close an activity's last task?">
      <bpmn:incoming>SF_moved_Gw_5</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_5_Gw_6</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_5_End_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_6" name="Mark the activity Done?">
      <bpmn:incoming>SF_Gw_5_Gw_6</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_6_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_6_End_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_7" name="Submit the closing, saying what becomes of the tasks still open">
      <bpmn:incoming>SF_Gw_6_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_activitySet</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="activitySet" name="The state-change outcome">
      <bpmn:incoming>SF_T_7_activitySet</bpmn:incoming>
      <bpmn:outgoing>SF_activitySet_End_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_activitySet" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_8" name="Activity closed">
      <bpmn:incoming>SF_activitySet_End_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_9" name="Activity left in progress">
      <bpmn:incoming>SF_Gw_6_End_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_10" name="Work moved on">
      <bpmn:incoming>SF_Gw_5_End_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_11" name="Order a task (within column/section)">
      <bpmn:incoming>SF_Gw_3_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_ordered</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="ordered" name="The ordering outcome">
      <bpmn:incoming>SF_T_11_ordered</bpmn:incoming>
      <bpmn:outgoing>SF_ordered_End_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ordered" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_12" name="Tasks ordered">
      <bpmn:incoming>SF_ordered_End_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_13" name="Amend the task">
      <bpmn:incoming>SF_Gw_3_T_13</bpmn:incoming>
      <bpmn:outgoing>SF_T_13_T_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_14" name="Submit the task">
      <bpmn:incoming>SF_T_13_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_amended</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="amended" name="The editing outcome">
      <bpmn:incoming>SF_T_14_amended</bpmn:incoming>
      <bpmn:outgoing>SF_amended_End_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_amended" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_15" name="Task recorded">
      <bpmn:incoming>SF_amended_End_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_16" name="Archive the task">
      <bpmn:incoming>SF_Gw_3_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_archived</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="archived" name="The archiving outcome">
      <bpmn:incoming>SF_T_16_archived</bpmn:incoming>
      <bpmn:outgoing>SF_archived_End_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_17" name="Task filed away">
      <bpmn:incoming>SF_archived_End_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_18" name="Delete a task">
      <bpmn:incoming>SF_Gw_3_T_18</bpmn:incoming>
      <bpmn:outgoing>SF_T_18_deleted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="deleted" name="The deletion outcome">
      <bpmn:incoming>SF_T_18_deleted</bpmn:incoming>
      <bpmn:outgoing>SF_deleted_End_19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_deleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_19" name="Task deleted">
      <bpmn:incoming>SF_deleted_End_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_20" name="Select a board">
      <bpmn:incoming>SF_Gw_3_T_20</bpmn:incoming>
      <bpmn:outgoing>SF_T_20_End_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_21" name="Another board opened">
      <bpmn:incoming>SF_T_20_End_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_22" name="Open task capture (BP10)">
      <bpmn:incoming>SF_Gw_3_T_22</bpmn:incoming>
      <bpmn:outgoing>SF_T_22_T_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_23" name="Work on uncommitted tasks">
      <bpmn:incoming>SF_T_22_T_23</bpmn:incoming>
      <bpmn:outgoing>SF_T_23_End_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_24" name="Capture opened">
      <bpmn:incoming>SF_T_23_End_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_25" name="Adjust the column template (BP12)">
      <bpmn:incoming>SF_Gw_3_T_25</bpmn:incoming>
      <bpmn:outgoing>SF_T_25_End_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_26" name="Column settings opened">
      <bpmn:incoming>SF_T_25_End_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_27" name="Check the work out (BP13)">
      <bpmn:incoming>SF_Gw_3_T_27</bpmn:incoming>
      <bpmn:outgoing>SF_T_27_End_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_28" name="Check-out started">
      <bpmn:incoming>SF_T_27_End_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_29" name="Open the archived tasks (BP15)">
      <bpmn:incoming>SF_Gw_3_T_29</bpmn:incoming>
      <bpmn:outgoing>SF_T_29_End_30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_30" name="Archive opened">
      <bpmn:incoming>SF_T_29_End_30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_Gw_3" sourceRef="T_2" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="SF_T_4_moved" sourceRef="T_4" targetRef="moved" />
    <bpmn:sequenceFlow id="SF_moved_Gw_5" sourceRef="moved" targetRef="Gw_5" />
    <bpmn:sequenceFlow id="SF_T_7_activitySet" sourceRef="T_7" targetRef="activitySet" />
    <bpmn:sequenceFlow id="SF_activitySet_End_8" sourceRef="activitySet" targetRef="End_8" />
    <bpmn:sequenceFlow id="SF_Gw_6_T_7" name="yes" sourceRef="Gw_6" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_Gw_6_End_9" name="no" sourceRef="Gw_6" targetRef="End_9" />
    <bpmn:sequenceFlow id="SF_Gw_5_Gw_6" name="yes" sourceRef="Gw_5" targetRef="Gw_6" />
    <bpmn:sequenceFlow id="SF_Gw_5_End_10" name="no" sourceRef="Gw_5" targetRef="End_10" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_4" name="move work along" sourceRef="Gw_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_11_ordered" sourceRef="T_11" targetRef="ordered" />
    <bpmn:sequenceFlow id="SF_ordered_End_12" sourceRef="ordered" targetRef="End_12" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_11" name="order what is waiting" sourceRef="Gw_3" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_T_13_T_14" sourceRef="T_13" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_T_14_amended" sourceRef="T_14" targetRef="amended" />
    <bpmn:sequenceFlow id="SF_amended_End_15" sourceRef="amended" targetRef="End_15" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_13" name="fix what a task says, or re-triage it" sourceRef="Gw_3" targetRef="T_13" />
    <bpmn:sequenceFlow id="SF_T_16_archived" sourceRef="T_16" targetRef="archived" />
    <bpmn:sequenceFlow id="SF_archived_End_17" sourceRef="archived" targetRef="End_17" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_16" name="file one away" sourceRef="Gw_3" targetRef="T_16" />
    <bpmn:sequenceFlow id="SF_T_18_deleted" sourceRef="T_18" targetRef="deleted" />
    <bpmn:sequenceFlow id="SF_deleted_End_19" sourceRef="deleted" targetRef="End_19" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_18" name="throw one away" sourceRef="Gw_3" targetRef="T_18" />
    <bpmn:sequenceFlow id="SF_T_20_End_21" sourceRef="T_20" targetRef="End_21" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_20" name="move to another board" sourceRef="Gw_3" targetRef="T_20" />
    <bpmn:sequenceFlow id="SF_T_22_T_23" sourceRef="T_22" targetRef="T_23" />
    <bpmn:sequenceFlow id="SF_T_23_End_24" sourceRef="T_23" targetRef="End_24" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_22" name="write more work down" sourceRef="Gw_3" targetRef="T_22" />
    <bpmn:sequenceFlow id="SF_T_25_End_26" sourceRef="T_25" targetRef="End_26" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_25" name="change the lanes" sourceRef="Gw_3" targetRef="T_25" />
    <bpmn:sequenceFlow id="SF_T_27_End_28" sourceRef="T_27" targetRef="End_28" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_27" name="settle what is done" sourceRef="Gw_3" targetRef="T_27" />
    <bpmn:sequenceFlow id="SF_T_29_End_30" sourceRef="T_29" targetRef="End_30" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_29" name="look at the archived ones" sourceRef="Gw_3" targetRef="T_29" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="moveIn" name="Move requested">
      <bpmn:outgoing>SF_moveIn_T_31</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_moveIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_31" name="Place the task where the request names, a column or a triage section">
      <bpmn:incoming>SF_moveIn_T_31</bpmn:incoming>
      <bpmn:outgoing>SF_T_31_Gw_32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_32" name="Is this a move inside the Backlog?">
      <bpmn:incoming>SF_T_31_Gw_32</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_32_T_33</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_32_T_34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_33" name="Take the section it lands in as its priority">
      <bpmn:incoming>SF_Gw_32_T_33</bpmn:incoming>
      <bpmn:outgoing>SF_T_33_T_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_34" name="Keep its priority with it">
      <bpmn:incoming>SF_Gw_32_T_34</bpmn:incoming>
      <bpmn:outgoing>SF_T_34_T_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_35" name="Report the outcome, and whether an activity's last task reached Done">
      <bpmn:incoming>SF_T_33_T_35</bpmn:incoming>
      <bpmn:incoming>SF_T_34_T_35</bpmn:incoming>
      <bpmn:outgoing>SF_T_35_End_36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_36" name="Move answered">
      <bpmn:incoming>SF_T_35_End_36</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="orderIn" name="Order submitted">
      <bpmn:outgoing>SF_orderIn_T_37</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_orderIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_37" name="Apply the new order">
      <bpmn:incoming>SF_orderIn_T_37</bpmn:incoming>
      <bpmn:outgoing>SF_T_37_T_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_38" name="Report the outcome">
      <bpmn:incoming>SF_T_37_T_38</bpmn:incoming>
      <bpmn:outgoing>SF_T_38_End_39</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_39" name="Order answered">
      <bpmn:incoming>SF_T_38_End_39</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="editIn" name="Task submitted">
      <bpmn:outgoing>SF_editIn_Gw_40</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_editIn" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_40" name="Is the task in the Backlog?">
      <bpmn:incoming>SF_editIn_Gw_40</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_40_T_41</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_40_T_42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_41" name="Store the edit, the priority included">
