<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP12_ManageBoardColumns" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP12_ManageBoardColumns">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP12.01 · Read the column template" sourceRef="columns" targetRef="templateIn" />
    <bpmn:messageFlow id="MF_2" name="BP12.02 · Rename a column" sourceRef="T_3" targetRef="renameIn" />
    <bpmn:messageFlow id="MF_3" name="BP12.09 · Draft the column input" sourceRef="T_4" targetRef="columnDraftIn" />
    <bpmn:messageFlow id="MF_4" name="BP12.03 · Insert a column" sourceRef="T_5" targetRef="insertIn" />
    <bpmn:messageFlow id="MF_5" name="BP12.04 · Reorder columns" sourceRef="T_6" targetRef="reorderIn" />
    <bpmn:messageFlow id="MF_6" name="BP12.05 · Change a column's role" sourceRef="T_7" targetRef="roleIn" />
    <bpmn:messageFlow id="MF_7" name="BP12.06 · Archive a column's tasks" sourceRef="T_8" targetRef="archiveIn" />
    <bpmn:messageFlow id="MF_8" name="BP12.07 · See what deleting a column takes" sourceRef="T_9" targetRef="impactIn" />
    <bpmn:messageFlow id="MF_9" name="BP12.08 · Delete a column" sourceRef="T_11" targetRef="deleteIn" />
    <bpmn:messageFlow id="MF_10" name="The columns with their roles and what may change" sourceRef="T_22" targetRef="template" />
    <bpmn:messageFlow id="MF_11" name="Column renamed" sourceRef="T_24" targetRef="renamed" />
    <bpmn:messageFlow id="MF_12" name="Column inserted" sourceRef="T_30" targetRef="inserted" />
    <bpmn:messageFlow id="MF_13" name="Order recorded" sourceRef="T_32" targetRef="reordered" />
    <bpmn:messageFlow id="MF_14" name="Role recorded" sourceRef="T_38" targetRef="roleSet" />
    <bpmn:messageFlow id="MF_15" name="Tasks archived" sourceRef="T_41" targetRef="archived" />
    <bpmn:messageFlow id="MF_16" name="What the deletion will take" sourceRef="T_45" targetRef="impact" />
    <bpmn:messageFlow id="MF_17" name="Column deleted" sourceRef="T_51" targetRef="deleted" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>One template governs every board of a project with no deviation inside it. Chores owns a template of its own, governing that one board.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="template" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>A name is the user's word for the lane. Renaming never changes what the lane means.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="renamed" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>This is the archiving act that takes a whole column's worth at once, on the board in front of the user. The column itself stays.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="archived" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>InProgress to Done makes its tasks count as completed, and Done to InProgress unwinds completions that were already counted.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="roleSet" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>One request inserts before and after alike. The new column carries a role from the outset.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="inserted" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>Nothing is deleted and nothing is moved.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="T_12" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>There is no in-app undo. Recovery is from version control.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="deleted" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>The Backlog column's role is reported as fixed, and a Done column's as changeable only while another Done column remains. The user is told what may change instead of being refused after the fact. An activity-based project's template governs one board per activity, so the count says how far any change here reaches.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="T_18" targetRef="TextAnnotation_X8" />
    <bpmn:textAnnotation id="TextAnnotation_X9"><bpmn:text>Every form on this surface drafts as it is filled in, so leaving it half-finished, a crash and a restart all cost nothing. The draft is one-way: nothing waits for it to be kept. Whichever write commits the form discards it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X9" associationDirection="None" sourceRef="T_16" targetRef="TextAnnotation_X9" />
    <bpmn:textAnnotation id="TextAnnotation_X10"><bpmn:text>The role is untouched. Day check-out and the advisor read the role, never the name.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X10" associationDirection="None" sourceRef="T_24" targetRef="TextAnnotation_X10" />
    <bpmn:textAnnotation id="TextAnnotation_X11"><bpmn:text>The Backlog role never changes. The last Done column cannot leave the role. Within those limits the consequences are the user's.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X11" associationDirection="None" sourceRef="Gw_34" targetRef="TextAnnotation_X11" />
    <bpmn:textAnnotation id="TextAnnotation_X12"><bpmn:text>Archiving is a conscious gesture here as everywhere: no task archives itself. This act reaches the one board the user is on, unlike a change to the template itself.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X12" associationDirection="None" sourceRef="T_40" targetRef="TextAnnotation_X12" />
    <bpmn:textAnnotation id="TextAnnotation_X13"><bpmn:text>A task cannot be left without a column, so the cascade is approve-or-abandon and detaching is not offered. Deleting a lane deletes it on every board the template governs, so the disclosure counts all of them. A column empty everywhere has nothing to disclose and deletes cleanly.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X13" associationDirection="None" sourceRef="T_43" targetRef="TextAnnotation_X13" />
    <bpmn:textAnnotation id="TextAnnotation_X14"><bpmn:text>One Backlog column and at least one Done column, enforced once per template rather than once per board. A second Backlog is refused with its reason. The new lane appears on every board the template governs.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X14" associationDirection="None" sourceRef="Gw_26" targetRef="TextAnnotation_X14" />
    <bpmn:textAnnotation id="TextAnnotation_X15"><bpmn:text>The Backlog column and the last Done column are refused with their reason, for the same reason their roles cannot change.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X15" associationDirection="None" sourceRef="Gw_47" targetRef="TextAnnotation_X15" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="The lanes no longer fit the work">
      <bpmn:outgoing>SF_Start_1_columns</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="columns" name="Open the column settings of a board">
      <bpmn:incoming>SF_Start_1_columns</bpmn:incoming>
      <bpmn:incoming>SF_T_12_columns</bpmn:incoming>
      <bpmn:incoming>SF_Gw_13_columns</bpmn:incoming>
      <bpmn:outgoing>SF_columns_template</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="template" name="The columns with their roles and what may change">
      <bpmn:incoming>SF_columns_template</bpmn:incoming>
      <bpmn:outgoing>SF_template_Gw_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_template" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_2" name="What needs doing?">
      <bpmn:incoming>SF_template_Gw_2</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_2_T_3</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_6</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_8</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_3" name="Type a new name">
      <bpmn:incoming>SF_Gw_2_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_renamed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="renamed" name="Column renamed">
      <bpmn:incoming>SF_T_3_renamed</bpmn:incoming>
      <bpmn:outgoing>SF_renamed_Gw_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_renamed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_4" name="Name the new column and pick its role">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_Gw_2_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_T_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_5" name="Place it before or after an existing one">
      <bpmn:incoming>SF_T_4_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_inserted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="inserted" name="Column inserted">
      <bpmn:incoming>SF_T_5_inserted</bpmn:incoming>
      <bpmn:outgoing>SF_inserted_Gw_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_inserted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_6" name="Drag a column into place">
      <bpmn:incoming>SF_Gw_2_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_reordered</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="reordered" name="Order recorded">
      <bpmn:incoming>SF_T_6_reordered</bpmn:incoming>
      <bpmn:outgoing>SF_reordered_Gw_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_reordered" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_7" name="Pick a column whose role may change">
      <bpmn:incoming>SF_Gw_2_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_roleSet</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="roleSet" name="Role recorded">
      <bpmn:incoming>SF_T_7_roleSet</bpmn:incoming>
      <bpmn:outgoing>SF_roleSet_Gw_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_roleSet" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_8" name="Archive everything in the column on this board">
      <bpmn:incoming>SF_Gw_2_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_archived</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="archived" name="Tasks archived">
      <bpmn:incoming>SF_T_8_archived</bpmn:incoming>
      <bpmn:outgoing>SF_archived_Gw_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_9" name="Choose a column to delete">
      <bpmn:incoming>SF_Gw_2_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_impact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="impact" name="What the deletion will take">
      <bpmn:incoming>SF_T_9_impact</bpmn:incoming>
      <bpmn:outgoing>SF_impact_Gw_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_impact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_10" name="Approve what the deletion takes?">
      <bpmn:incoming>SF_impact_Gw_10</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_10_T_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_10_T_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_11" name="Confirm the deletion">
      <bpmn:incoming>SF_Gw_10_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_deleted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="deleted" name="Column deleted">
      <bpmn:incoming>SF_T_11_deleted</bpmn:incoming>
      <bpmn:outgoing>SF_deleted_Gw_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_deleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_12" name="Abandon the deletion">
      <bpmn:incoming>SF_Gw_10_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_columns</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_13" name="Anything else about these lanes?">
      <bpmn:incoming>SF_renamed_Gw_13</bpmn:incoming>
      <bpmn:incoming>SF_inserted_Gw_13</bpmn:incoming>
      <bpmn:incoming>SF_reordered_Gw_13</bpmn:incoming>
      <bpmn:incoming>SF_roleSet_Gw_13</bpmn:incoming>
      <bpmn:incoming>SF_archived_Gw_13</bpmn:incoming>
      <bpmn:incoming>SF_deleted_Gw_13</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_13_T_14</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_13_columns</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_14" name="Leave the column settings">
      <bpmn:incoming>SF_Gw_13_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_End_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_15" name="Lanes fit the work">
      <bpmn:incoming>SF_T_14_End_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_columns" sourceRef="Start_1" targetRef="columns" />
    <bpmn:sequenceFlow id="SF_columns_template" sourceRef="columns" targetRef="template" />
    <bpmn:sequenceFlow id="SF_template_Gw_2" sourceRef="template" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="SF_T_3_renamed" sourceRef="T_3" targetRef="renamed" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_3" name="rename one" sourceRef="Gw_2" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_T_4_T_5" sourceRef="T_4" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_5_inserted" sourceRef="T_5" targetRef="inserted" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_4" name="add a lane" sourceRef="Gw_2" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_6_reordered" sourceRef="T_6" targetRef="reordered" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_6" name="reorder them" sourceRef="Gw_2" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_T_7_roleSet" sourceRef="T_7" targetRef="roleSet" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_7" name="change what a lane means" sourceRef="Gw_2" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_T_8_archived" sourceRef="T_8" targetRef="archived" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_8" name="clear out a lane" sourceRef="Gw_2" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_T_9_impact" sourceRef="T_9" targetRef="impact" />
    <bpmn:sequenceFlow id="SF_impact_Gw_10" sourceRef="impact" targetRef="Gw_10" />
    <bpmn:sequenceFlow id="SF_T_11_deleted" sourceRef="T_11" targetRef="deleted" />
    <bpmn:sequenceFlow id="SF_Gw_10_T_11" name="approve" sourceRef="Gw_10" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_Gw_10_T_12" name="abandon" sourceRef="Gw_10" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_9" name="remove a lane" sourceRef="Gw_2" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_renamed_Gw_13" sourceRef="renamed" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_inserted_Gw_13" sourceRef="inserted" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_reordered_Gw_13" sourceRef="reordered" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_roleSet_Gw_13" sourceRef="roleSet" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_archived_Gw_13" sourceRef="archived" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_deleted_Gw_13" sourceRef="deleted" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_Gw_13_T_14" name="no" sourceRef="Gw_13" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_T_14_End_15" sourceRef="T_14" targetRef="End_15" />
    <bpmn:sequenceFlow id="SF_T_12_columns" sourceRef="T_12" targetRef="columns" />
    <bpmn:sequenceFlow id="SF_Gw_13_columns" name="yes" sourceRef="Gw_13" targetRef="columns" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="columnDraftIn" name="Column draft submitted">
      <bpmn:outgoing>SF_columnDraftIn_T_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_columnDraftIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_16" name="Keep what is typed as a draft">
      <bpmn:incoming>SF_columnDraftIn_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_End_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_17" name="Draft kept">
      <bpmn:incoming>SF_T_16_End_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="templateIn" name="Template requested">
      <bpmn:outgoing>SF_templateIn_T_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_templateIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_18" name="Read the template that governs the board">
      <bpmn:incoming>SF_templateIn_T_18</bpmn:incoming>
      <bpmn:outgoing>SF_T_18_T_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_19" name="Report how many boards that template governs">
      <bpmn:incoming>SF_T_18_T_19</bpmn:incoming>
      <bpmn:outgoing>SF_T_19_T_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_20" name="Read each column with its role and its name">
      <bpmn:incoming>SF_T_19_T_20</bpmn:incoming>
      <bpmn:outgoing>SF_T_20_T_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_21" name="Report which role changes are legal">
      <bpmn:incoming>SF_T_20_T_21</bpmn:incoming>
      <bpmn:outgoing>SF_T_21_T_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_22" name="Report which columns carry tasks, across every board the template governs">
      <bpmn:incoming>SF_T_21_T_22</bpmn:incoming>
      <bpmn:outgoing>SF_T_22_End_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_23" name="Template answered">
      <bpmn:incoming>SF_T_22_End_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="renameIn" name="Rename submitted">
      <bpmn:outgoing>SF_renameIn_T_24</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_renameIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_24" name="Apply the name as given">
      <bpmn:incoming>SF_renameIn_T_24</bpmn:incoming>
      <bpmn:outgoing>SF_T_24_End_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_25" name="Rename answered">
      <bpmn:incoming>SF_T_24_End_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="insertIn" name="Insertion submitted">
      <bpmn:outgoing>SF_insertIn_Gw_26</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_insertIn" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_26" name="Would the insertion break the invariant?">
      <bpmn:incoming>SF_insertIn_Gw_26</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_26_T_27</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_26_T_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_27" name="Refuse the insertion and say why">
      <bpmn:incoming>SF_Gw_26_T_27</bpmn:incoming>
      <bpmn:outgoing>SF_T_27_T_30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_28" name="Place the column at the position the request names">
      <bpmn:incoming>SF_Gw_26_T_28</bpmn:incoming>
      <bpmn:outgoing>SF_T_28_T_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_29" name="Store its role and its name">
      <bpmn:incoming>SF_T_28_T_29</bpmn:incoming>
      <bpmn:outgoing>SF_T_29_T_30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_30" name="Report the outcome">
      <bpmn:incoming>SF_T_27_T_30</bpmn:incoming>
      <bpmn:incoming>SF_T_29_T_30</bpmn:incoming>
      <bpmn:outgoing>SF_T_30_End_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_31" name="Insertion answered">
      <bpmn:incoming>SF_T_30_End_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="reorderIn" name="Column reordering requested">
      <bpmn:outgoing>SF_reorderIn_T_32</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_reorderIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_32" name="Record the new left-to-right order in the template">
      <bpmn:incoming>SF_reorderIn_T_32</bpmn:incoming>
      <bpmn:outgoing>SF_T_32_End_33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_33" name="Column reordering answered">
      <bpmn:incoming>SF_T_32_End_33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="roleIn" name="Role submitted">
      <bpmn:outgoing>SF_roleIn_Gw_34</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_roleIn" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_34" name="Is the change within the two limits?">
      <bpmn:incoming>SF_roleIn_Gw_34</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_34_T_35</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_34_T_37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_35" name="Record the column's new role">
      <bpmn:incoming>SF_Gw_34_T_35</bpmn:incoming>
      <bpmn:outgoing>SF_T_35_T_36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_36" name="Recount what the board's Done columns now hold">
      <bpmn:incoming>SF_T_35_T_36</bpmn:incoming>
      <bpmn:outgoing>SF_T_36_T_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_37" name="Refuse the change and say why">
      <bpmn:incoming>SF_Gw_34_T_37</bpmn:incoming>
      <bpmn:outgoing>SF_T_37_T_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_38" name="Report the outcome">
      <bpmn:incoming>SF_T_36_T_38</bpmn:incoming>
      <bpmn:incoming>SF_T_37_T_38</bpmn:incoming>
      <bpmn:outgoing>SF_T_38_End_39</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_39" name="Role answered">
      <bpmn:incoming>SF_T_38_End_39</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="archiveIn" name="Column archiving requested">
      <bpmn:outgoing>SF_archiveIn_T_40</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archiveIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_40" name="Archive every task in the column on the board the user is on">
      <bpmn:incoming>SF_archiveIn_T_40</bpmn:incoming>
      <bpmn:outgoing>SF_T_40_T_41</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_41" name="Leave the column in the template">
      <bpmn:incoming>SF_T_40_T_41</bpmn:incoming>
      <bpmn:outgoing>SF_T_41_End_42</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_42" name="Column archiving answered">
      <bpmn:incoming>SF_T_41_End_42</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="impactIn" name="Deletion impact requested">
      <bpmn:outgoing>SF_impactIn_T_43</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_impactIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_43" name="Collect the tasks in that column on every board the template governs">
      <bpmn:incoming>SF_impactIn_T_43</bpmn:incoming>
      <bpmn:outgoing>SF_T_43_T_44</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_44" name="Include the archived ones in the count">
      <bpmn:incoming>SF_T_43_T_44</bpmn:incoming>
      <bpmn:outgoing>SF_T_44_T_45</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_45" name="Report what the deletion will take, board by board">
      <bpmn:incoming>SF_T_44_T_45</bpmn:incoming>
      <bpmn:outgoing>SF_T_45_End_46</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_46" name="Impact answered">
      <bpmn:incoming>SF_T_45_End_46</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="deleteIn" name="Column deletion requested">
      <bpmn:outgoing>SF_deleteIn_Gw_47</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_deleteIn" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_47" name="Is the column one the invariant protects?">
      <bpmn:incoming>SF_deleteIn_Gw_47</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_47_T_48</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_47_T_49</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_48" name="Refuse the deletion and say why">
      <bpmn:incoming>SF_Gw_47_T_48</bpmn:incoming>
      <bpmn:outgoing>SF_T_48_T_51</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_49" name="Delete the tasks it held on every board the template governs">
      <bpmn:incoming>SF_Gw_47_T_49</bpmn:incoming>
      <bpmn:outgoing>SF_T_49_T_50</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_50" name="Delete the column from the template">
      <bpmn:incoming>SF_T_49_T_50</bpmn:incoming>
      <bpmn:outgoing>SF_T_50_T_51</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_51" name="Report the outcome">
      <bpmn:incoming>SF_T_48_T_51</bpmn:incoming>
      <bpmn:incoming>SF_T_50_T_51</bpmn:incoming>
      <bpmn:outgoing>SF_T_51_End_52</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_52" name="Column deletion answered">
      <bpmn:incoming>SF_T_51_End_52</bpmn:incoming>
    </bpmn:endEvent>
