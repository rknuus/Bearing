        <dc:Bounds x="2600" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_9_di" bpmnElement="T_9">
        <dc:Bounds x="2600" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="closing_di" bpmnElement="closing">
        <dc:Bounds x="2770" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
