        <dc:Bounds x="560" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_12_di" bpmnElement="T_12">
        <dc:Bounds x="730" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_13_di" bpmnElement="T_13">
        <dc:Bounds x="900" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>
