<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP14_RollTheDayOver" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP14_RollTheDayOver">
    <bpmn:participant id="Participant_Clock" name="Clock" processRef="Process_Clock">
      <bpmn:extensionElements>
        <bpd:initiator xmlns:bpd="urn:bpmn-dsl:pool" kind="scheduler" />
      </bpmn:extensionElements>
    </bpmn:participant>
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP14.01 · Roll the day over" sourceRef="T_2" targetRef="rollIn" />
    <bpmn:messageFlow id="MF_2" name="The day rolled over" sourceRef="T_9" targetRef="rolled" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>The board in front of the user stays open and a gesture already under way, a drag included, is unaffected. That the date advanced is said quietly, and where the new date carries no focus that is said with it; nothing is offered and nothing is asked. Setting a focus is the user's own act, started on the Focus tab (BP08).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="rolled" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>Rollover creates nothing and destroys nothing: no task is spawned, nothing is archived, nothing is closed and nothing is settled, and the date that just ended keeps the focus record it already had. That date joins the span the next check-out settles. Chores follows the new date on its own while it carries work that is not done.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_7" targetRef="TextAnnotation_X2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Clock" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Local midnight">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
          <bpmn:timerEventDefinition id="TED_Start_1" />
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Reach the next date">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_End_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_3" name="Date advanced">
      <bpmn:incoming>SF_T_2_End_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_End_3" sourceRef="T_2" targetRef="End_3" />
  </bpmn:process>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_4" name="At work in Bearing">
      <bpmn:outgoing>SF_Start_4_T_5</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_5" name="Work on whatever is open">
      <bpmn:incoming>SF_Start_4_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_rolled</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="rolled" name="The day rolled over">
      <bpmn:incoming>SF_T_5_rolled</bpmn:incoming>
      <bpmn:outgoing>SF_rolled_End_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_rolled" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_6" name="New day in play">
      <bpmn:incoming>SF_rolled_End_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_4_T_5" sourceRef="Start_4" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_5_rolled" sourceRef="T_5" targetRef="rolled" />
    <bpmn:sequenceFlow id="SF_rolled_End_6" sourceRef="rolled" targetRef="End_6" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="rollIn" name="Rollover due">
      <bpmn:outgoing>SF_rollIn_T_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_rollIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_7" name="Update current date">
      <bpmn:incoming>SF_rollIn_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_T_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_8" name="Put the new date's focus in play, empty until it is set">
      <bpmn:incoming>SF_T_7_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_T_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_9" name="Report the new date's focus">
      <bpmn:incoming>SF_T_8_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_End_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_10" name="Rollover answered">
      <bpmn:incoming>SF_T_9_End_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_T_7_T_8" sourceRef="T_7" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_T_8_T_9" sourceRef="T_8" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_rollIn_T_7" sourceRef="rollIn" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_T_9_End_10" sourceRef="T_9" targetRef="End_10" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_BP14_RollTheDayOver">
