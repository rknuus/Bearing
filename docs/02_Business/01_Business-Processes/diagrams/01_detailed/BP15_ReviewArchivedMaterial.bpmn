<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP15_ReviewArchivedMaterial" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP15_ReviewArchivedMaterial">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP15.01 · Read the archived items" sourceRef="archive" targetRef="listIn" />
    <bpmn:messageFlow id="MF_2" name="BP15.02 · See what unarchiving will bring back" sourceRef="T_5" targetRef="impactIn" />
    <bpmn:messageFlow id="MF_3" name="BP15.03 · Unarchive an item" sourceRef="T_7" targetRef="unarchiveIn" />
    <bpmn:messageFlow id="MF_4" name="The archived items of that kind" sourceRef="T_14" targetRef="list" />
    <bpmn:messageFlow id="MF_5" name="What comes back, or why it cannot" sourceRef="T_19" targetRef="impact" />
    <bpmn:messageFlow id="MF_6" name="The item back in the working set" sourceRef="T_25" targetRef="unarchived" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>The archive is read by an explicit act. Nothing archived shows up in the working view.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_3" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>An archived item is readable and frozen. Changing one means bringing it back first, and an archived goal still carries its check-out record.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_4" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>A member deleted out of the archive, or a surrounding that is now gone, leaves the bundle unreassemblable. The item stays archived.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="T_8" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>The whole bundle comes back as it went. No part of it can be picked and nothing is re-parented, relocated or approximated.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="unarchived" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>One request serves all four archivable kinds: ideas, goals, projects and tasks. Archived material is retained on disk and reachable only this way.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="T_12" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>A project brings its activities and their tasks; a goal brings its measures and their check-in history. The bundle is judged whole: a subset is never offered.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="T_16" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>Ordering is relative, so the position an archived item comes back to was never occupied while it was away. The check-out record of a goal that comes back is untouched.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="Gw_21" targetRef="TextAnnotation_X7" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Something to look up, or something to bring back">
      <bpmn:outgoing>SF_Start_1_archive</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="archive" name="Open the archive">
      <bpmn:incoming>SF_Start_1_archive</bpmn:incoming>
      <bpmn:incoming>SF_T_3_archive</bpmn:incoming>
      <bpmn:incoming>SF_Gw_9_archive</bpmn:incoming>
      <bpmn:outgoing>SF_archive_list</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="list" name="The archived items of that kind">
      <bpmn:incoming>SF_archive_list</bpmn:incoming>
      <bpmn:outgoing>SF_list_Gw_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_list" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_2" name="What needs doing?">
      <bpmn:incoming>SF_list_Gw_2</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_2_T_3</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_3" name="Change the kind or the filter in force">
      <bpmn:incoming>SF_Gw_2_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_archive</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_4" name="Read the item as it stands">
      <bpmn:incoming>SF_Gw_2_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_Gw_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_5" name="Choose an item to unarchive">
      <bpmn:incoming>SF_Gw_2_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_impact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="impact" name="What comes back, or why it cannot">
      <bpmn:incoming>SF_T_5_impact</bpmn:incoming>
      <bpmn:outgoing>SF_impact_Gw_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_impact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_6" name="Can the bundle come back whole?">
      <bpmn:incoming>SF_impact_Gw_6</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_6_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_6_T_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_7" name="Confirm the unarchiving">
      <bpmn:incoming>SF_Gw_6_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_unarchived</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="unarchived" name="The item back in the working set">
      <bpmn:incoming>SF_T_7_unarchived</bpmn:incoming>
      <bpmn:outgoing>SF_unarchived_Gw_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_unarchived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_8" name="Read why it stays archived">
      <bpmn:incoming>SF_Gw_6_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_Gw_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_9" name="Anything else in the archive?">
      <bpmn:incoming>SF_T_4_Gw_9</bpmn:incoming>
      <bpmn:incoming>SF_unarchived_Gw_9</bpmn:incoming>
      <bpmn:incoming>SF_T_8_Gw_9</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_9_T_10</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_9_archive</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_10" name="Leave the archive">
      <bpmn:incoming>SF_Gw_9_T_10</bpmn:incoming>
      <bpmn:outgoing>SF_T_10_End_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_11" name="Archive reviewed">
      <bpmn:incoming>SF_T_10_End_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_archive" sourceRef="Start_1" targetRef="archive" />
    <bpmn:sequenceFlow id="SF_archive_list" sourceRef="archive" targetRef="list" />
    <bpmn:sequenceFlow id="SF_list_Gw_2" sourceRef="list" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_3" name="narrow or re-scope the list" sourceRef="Gw_2" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_4" name="read one" sourceRef="Gw_2" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_5_impact" sourceRef="T_5" targetRef="impact" />
    <bpmn:sequenceFlow id="SF_impact_Gw_6" sourceRef="impact" targetRef="Gw_6" />
    <bpmn:sequenceFlow id="SF_T_7_unarchived" sourceRef="T_7" targetRef="unarchived" />
    <bpmn:sequenceFlow id="SF_Gw_6_T_7" name="yes" sourceRef="Gw_6" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_Gw_6_T_8" name="no" sourceRef="Gw_6" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_5" name="bring one back" sourceRef="Gw_2" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_4_Gw_9" sourceRef="T_4" targetRef="Gw_9" />
    <bpmn:sequenceFlow id="SF_unarchived_Gw_9" sourceRef="unarchived" targetRef="Gw_9" />
    <bpmn:sequenceFlow id="SF_T_8_Gw_9" sourceRef="T_8" targetRef="Gw_9" />
    <bpmn:sequenceFlow id="SF_Gw_9_T_10" name="no" sourceRef="Gw_9" targetRef="T_10" />
    <bpmn:sequenceFlow id="SF_T_10_End_11" sourceRef="T_10" targetRef="End_11" />
    <bpmn:sequenceFlow id="SF_T_3_archive" sourceRef="T_3" targetRef="archive" />
    <bpmn:sequenceFlow id="SF_Gw_9_archive" name="yes" sourceRef="Gw_9" targetRef="archive" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="listIn" name="Archive list requested">
      <bpmn:outgoing>SF_listIn_T_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_listIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_12" name="Read the archived items of the kind asked for">
      <bpmn:incoming>SF_listIn_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_T_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_13" name="Apply the filter and the sort in force">
      <bpmn:incoming>SF_T_12_T_13</bpmn:incoming>
      <bpmn:outgoing>SF_T_13_T_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_14" name="Carry each archived goal's check-out record with it">
      <bpmn:incoming>SF_T_13_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_End_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_15" name="Archive list answered">
      <bpmn:incoming>SF_T_14_End_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="impactIn" name="Unarchive impact requested">
      <bpmn:outgoing>SF_impactIn_T_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_impactIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_16" name="Collect the whole bundle the item was archived with">
      <bpmn:incoming>SF_impactIn_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_T_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_17" name="Check that every member is still there">
      <bpmn:incoming>SF_T_16_T_17</bpmn:incoming>
      <bpmn:outgoing>SF_T_17_T_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_18" name="Check that the surroundings can still hold it">
      <bpmn:incoming>SF_T_17_T_18</bpmn:incoming>
      <bpmn:outgoing>SF_T_18_T_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_19" name="Report what comes back, or what is missing">
      <bpmn:incoming>SF_T_18_T_19</bpmn:incoming>
      <bpmn:outgoing>SF_T_19_End_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_20" name="Unarchive impact answered">
      <bpmn:incoming>SF_T_19_End_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="unarchiveIn" name="Unarchive requested">
      <bpmn:outgoing>SF_unarchiveIn_Gw_21</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_unarchiveIn" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_21" name="Is the bundle reassemblable?">
      <bpmn:incoming>SF_unarchiveIn_Gw_21</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_21_T_22</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_21_T_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_22" name="Return every member to its prior state">
      <bpmn:incoming>SF_Gw_21_T_22</bpmn:incoming>
      <bpmn:outgoing>SF_T_22_T_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_23" name="Return every member to its prior position">
      <bpmn:incoming>SF_T_22_T_23</bpmn:incoming>
      <bpmn:outgoing>SF_T_23_T_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_24" name="Refuse the unarchiving and say what is missing">
      <bpmn:incoming>SF_Gw_21_T_24</bpmn:incoming>
      <bpmn:outgoing>SF_T_24_T_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_25" name="Report the outcome">
      <bpmn:incoming>SF_T_23_T_25</bpmn:incoming>
      <bpmn:incoming>SF_T_24_T_25</bpmn:incoming>
      <bpmn:outgoing>SF_T_25_End_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_26" name="Unarchive answered">
      <bpmn:incoming>SF_T_25_End_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_T_12_T_13" sourceRef="T_12" targetRef="T_13" />
    <bpmn:sequenceFlow id="SF_T_13_T_14" sourceRef="T_13" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_listIn_T_12" sourceRef="listIn" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_T_14_End_15" sourceRef="T_14" targetRef="End_15" />
    <bpmn:sequenceFlow id="SF_T_16_T_17" sourceRef="T_16" targetRef="T_17" />
    <bpmn:sequenceFlow id="SF_T_17_T_18" sourceRef="T_17" targetRef="T_18" />
    <bpmn:sequenceFlow id="SF_T_18_T_19" sourceRef="T_18" targetRef="T_19" />
    <bpmn:sequenceFlow id="SF_impactIn_T_16" sourceRef="impactIn" targetRef="T_16" />
    <bpmn:sequenceFlow id="SF_T_19_End_20" sourceRef="T_19" targetRef="End_20" />
    <bpmn:sequenceFlow id="SF_T_22_T_23" sourceRef="T_22" targetRef="T_23" />
    <bpmn:sequenceFlow id="SF_Gw_21_T_22" name="yes" sourceRef="Gw_21" targetRef="T_22" />
    <bpmn:sequenceFlow id="SF_Gw_21_T_24" name="no" sourceRef="Gw_21" targetRef="T_24" />
    <bpmn:sequenceFlow id="SF_T_23_T_25" sourceRef="T_23" targetRef="T_25" />
    <bpmn:sequenceFlow id="SF_T_24_T_25" sourceRef="T_24" targetRef="T_25" />
    <bpmn:sequenceFlow id="SF_unarchiveIn_Gw_21" sourceRef="unarchiveIn" targetRef="Gw_21" />
    <bpmn:sequenceFlow id="SF_T_25_End_26" sourceRef="T_25" targetRef="End_26" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_BP15_ReviewArchivedMaterial">
