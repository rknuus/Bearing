<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP15_ReviewArchivedMaterial" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP15_ReviewArchivedMaterial">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP15.04 · See what deleting the archived item takes" sourceRef="T_4" targetRef="delImpactIn" />
    <bpmn:messageFlow id="MF_2" name="BP15.05 · Delete an archived item" sourceRef="T_7" targetRef="deleteIn" />
    <bpmn:messageFlow id="MF_3" name="BP15.03 · Unarchive an item" sourceRef="T_10" targetRef="unarchiveIn" />
    <bpmn:messageFlow id="MF_4" name="What the deletion will take" sourceRef="T_12" targetRef="delImpact" />
    <bpmn:messageFlow id="MF_5" name="The deletion outcome" sourceRef="T_15" targetRef="deleted" />
    <bpmn:messageFlow id="MF_6" name="What came back, or why it cannot" sourceRef="report" targetRef="unarchived" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>The whole bundle comes back as it went: no part of it can be picked and nothing is re-parented, relocated or approximated. A member deleted out of the archive, or a surrounding that is now gone, leaves it unreassemblable, and then the item stays archived.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="unarchived" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>What the item owns goes with it and what hangs on it is the cascade its own rule gives, exactly as it would for a live item. A leaf has nothing to disclose, so the disclosure is empty and there is nothing to weigh.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="deleted" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>The item's own rule governs what the deletion reaches, as it does for a live one. Where the item owns nothing the answer is empty.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="T_12" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>A project brings its activities and their tasks; a goal brings its measures and their check-in history; a measure brings its own, and a goal's check-out record is untouched. An archived item's position is never occupied while it is away, so the bundle comes back to it. One answer carries both outcomes.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="Gw_17" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>Whatever bundle needed the deleted item can no longer be reassembled, so an unarchive that wanted it is refused afterwards and that item stays archived.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="T_14" targetRef="TextAnnotation_X5" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Something to look up, or something to bring back">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Work the archive">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_Gw_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_3" name="What needs doing?">
      <bpmn:incoming>SF_T_2_Gw_3</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_3_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_4" name="Delete an archived item">
      <bpmn:incoming>SF_Gw_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_delImpact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="delImpact" name="What the deletion will take">
      <bpmn:incoming>SF_T_4_delImpact</bpmn:incoming>
      <bpmn:outgoing>SF_delImpact_Gw_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_delImpact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_5" name="Approve what the deletion takes?">
      <bpmn:incoming>SF_delImpact_Gw_5</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_5_T_6</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_5_End_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_6" name="Select a valid cascading option">
      <bpmn:incoming>SF_Gw_5_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_T_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_7" name="Confirm the deletion">
      <bpmn:incoming>SF_T_6_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_deleted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="deleted" name="The deletion outcome">
      <bpmn:incoming>SF_T_7_deleted</bpmn:incoming>
      <bpmn:outgoing>SF_deleted_End_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_deleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_8" name="Deletion abandoned">
      <bpmn:incoming>SF_Gw_5_End_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_9" name="Item destroyed">
      <bpmn:incoming>SF_deleted_End_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_10" name="Unarchive an item">
      <bpmn:incoming>SF_Gw_3_T_10</bpmn:incoming>
      <bpmn:outgoing>SF_T_10_unarchived</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="unarchived" name="What came back, or why it cannot">
      <bpmn:incoming>SF_T_10_unarchived</bpmn:incoming>
      <bpmn:outgoing>SF_unarchived_End_11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_unarchived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_11" name="Item brought back">
      <bpmn:incoming>SF_unarchived_End_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_Gw_3" sourceRef="T_2" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="SF_T_4_delImpact" sourceRef="T_4" targetRef="delImpact" />
    <bpmn:sequenceFlow id="SF_delImpact_Gw_5" sourceRef="delImpact" targetRef="Gw_5" />
    <bpmn:sequenceFlow id="SF_T_6_T_7" sourceRef="T_6" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_T_7_deleted" sourceRef="T_7" targetRef="deleted" />
    <bpmn:sequenceFlow id="SF_Gw_5_T_6" name="approve" sourceRef="Gw_5" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_Gw_5_End_8" name="reject" sourceRef="Gw_5" targetRef="End_8" />
    <bpmn:sequenceFlow id="SF_deleted_End_9" sourceRef="deleted" targetRef="End_9" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_4" name="drop one for good" sourceRef="Gw_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_10_unarchived" sourceRef="T_10" targetRef="unarchived" />
    <bpmn:sequenceFlow id="SF_unarchived_End_11" sourceRef="unarchived" targetRef="End_11" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_10" name="bring one back" sourceRef="Gw_3" targetRef="T_10" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="delImpactIn" name="Deletion impact requested">
      <bpmn:outgoing>SF_delImpactIn_T_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_delImpactIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_12" name="Report what the deletion will take, and what of it can be declined">
      <bpmn:incoming>SF_delImpactIn_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_End_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_13" name="Deletion impact answered">
      <bpmn:incoming>SF_T_12_End_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="deleteIn" name="Deletion requested">
      <bpmn:outgoing>SF_deleteIn_T_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_deleteIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_14" name="Delete confirmed items">
      <bpmn:incoming>SF_deleteIn_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_T_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_15" name="Report the outcome">
      <bpmn:incoming>SF_T_14_T_15</bpmn:incoming>
      <bpmn:outgoing>SF_T_15_End_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_16" name="Deletion answered">
      <bpmn:incoming>SF_T_15_End_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="unarchiveIn" name="Unarchive requested">
      <bpmn:outgoing>SF_unarchiveIn_Gw_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_unarchiveIn" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_17" name="Can the bundle come back whole?">
      <bpmn:incoming>SF_unarchiveIn_Gw_17</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_17_T_18</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_17_report</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_18" name="Return the bundle to its prior state and position">
      <bpmn:incoming>SF_Gw_17_T_18</bpmn:incoming>
      <bpmn:outgoing>SF_T_18_report</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="report" name="Report the outcome">
      <bpmn:incoming>SF_T_18_report</bpmn:incoming>
      <bpmn:incoming>SF_Gw_17_report</bpmn:incoming>
      <bpmn:outgoing>SF_report_End_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_19" name="Unarchive answered">
      <bpmn:incoming>SF_report_End_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_delImpactIn_T_12" sourceRef="delImpactIn" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_T_12_End_13" sourceRef="T_12" targetRef="End_13" />
    <bpmn:sequenceFlow id="SF_T_14_T_15" sourceRef="T_14" targetRef="T_15" />
    <bpmn:sequenceFlow id="SF_deleteIn_T_14" sourceRef="deleteIn" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_T_15_End_16" sourceRef="T_15" targetRef="End_16" />
    <bpmn:sequenceFlow id="SF_Gw_17_T_18" name="yes" sourceRef="Gw_17" targetRef="T_18" />
    <bpmn:sequenceFlow id="SF_unarchiveIn_Gw_17" sourceRef="unarchiveIn" targetRef="Gw_17" />
    <bpmn:sequenceFlow id="SF_report_End_19" sourceRef="report" targetRef="End_19" />
    <bpmn:sequenceFlow id="SF_T_18_report" sourceRef="T_18" targetRef="report" />
    <bpmn:sequenceFlow id="SF_Gw_17_report" name="no" sourceRef="Gw_17" targetRef="report" />
  </bpmn:process>
