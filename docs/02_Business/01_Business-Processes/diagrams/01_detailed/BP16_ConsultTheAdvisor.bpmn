<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP16_ConsultTheAdvisor" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP16_ConsultTheAdvisor">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:participant id="Participant_Advisor" name="Advisor" processRef="Process_Advisor" />
    <bpmn:messageFlow id="MF_1" name="BP16.02 · Ask the advisor" sourceRef="T_5" targetRef="askIn" />
    <bpmn:messageFlow id="MF_2" name="BP16.07 · See what applying will take" sourceRef="T_9" targetRef="applyImpactIn" />
    <bpmn:messageFlow id="MF_3" name="BP16.04 · Apply the proposal" sourceRef="T_11" targetRef="applyIn" />
    <bpmn:messageFlow id="MF_4" name="BP16.05 · Dismiss the proposal" sourceRef="T_14" targetRef="dismissIn" />
    <bpmn:messageFlow id="MF_5" name="BP16.06 · Clear the conversation" sourceRef="T_16" targetRef="clearIn" />
    <bpmn:messageFlow id="MF_6" name="The answer, or what went wrong" sourceRef="T_26" targetRef="answer" />
    <bpmn:messageFlow id="MF_7" name="What applying will take, and where it lands" sourceRef="T_28" targetRef="applyImpact" />
    <bpmn:messageFlow id="MF_8" name="What was applied, and where" sourceRef="T_31" targetRef="applied" />
    <bpmn:messageFlow id="MF_9" name="What was dismissed" sourceRef="T_34" targetRef="dismissed" />
    <bpmn:messageFlow id="MF_10" name="What was cleared" sourceRef="T_37" targetRef="cleared" />
    <bpmn:messageFlow id="MFX_1" name="Advice requested" sourceRef="T_19" targetRef="Participant_Advisor" />
    <bpmn:messageFlow id="MFX_2" name="BP16.03 · Take the advisor's answer" sourceRef="Participant_Advisor" targetRef="Catch_21" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>Applying runs the user's own operation, so whatever that operation discloses is disclosed here: what a deletion will take, the answers an archiving offers, and any part of the funnel the change lands in.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="applyImpact" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>The answer arrives on its own. The advisor is slower than the rest of the product and stays non-blocking while it thinks. An unreachable service, a timeout, or an answer nothing usable could be made of is reported as what it is, and nothing is left looking like a proposal.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="answer" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>Clearing is deliberate. One conversation runs for the session and nothing clears it on the user's behalf.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="cleared" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>The proposal stays outstanding and nothing is written.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="T_12" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>The proposal is written completely. Nothing is half-applied.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="applied" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>A proposal is a structured object, never prose to be parsed. At most one proposal is outstanding per target, and an already-applied or already-dismissed one is closed and untouched.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="T_22" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>A proposal that takes nothing has nothing to disclose. One that deletes or archives discloses exactly what the user's own gesture would, because it is that gesture.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="T_28" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>A proposal already applied or dismissed is closed, and nothing reopens it (BR-70).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="T_33" targetRef="TextAnnotation_X8" />
    <bpmn:textAnnotation id="TextAnnotation_X9"><bpmn:text>Applied and dismissed proposals are closed already and are unaffected by clearing.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X9" associationDirection="None" sourceRef="T_36" targetRef="TextAnnotation_X9" />
    <bpmn:textAnnotation id="TextAnnotation_X10"><bpmn:text>The whole funnel goes with the request: themes, ideas, goals, routines, focus history, tasks and progress check-ins.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X10" associationDirection="None" sourceRef="T_18" targetRef="TextAnnotation_X10" />
    <bpmn:textAnnotation id="TextAnnotation_X11"><bpmn:text>A proposal to create something carries everything that thing needs.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X11" associationDirection="None" sourceRef="T_30" targetRef="TextAnnotation_X11" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A second opinion wanted">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Work with the advisor">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_Gw_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_3" name="What needs doing?">
      <bpmn:incoming>SF_T_2_Gw_3</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_3_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_9</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_14</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_4" name="Write the request">
      <bpmn:incoming>SF_Gw_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_T_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_5" name="Submit the request">
      <bpmn:incoming>SF_T_4_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_answer</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="answer" name="The answer, or what went wrong">
      <bpmn:incoming>SF_T_5_answer</bpmn:incoming>
      <bpmn:outgoing>SF_answer_Gw_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_answer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_6" name="Did the advisor answer?">
      <bpmn:incoming>SF_answer_Gw_6</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_6_End_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_6_End_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_7" name="The advisor answered">
      <bpmn:incoming>SF_Gw_6_End_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_8" name="Nothing usable came back">
      <bpmn:incoming>SF_Gw_6_End_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_9" name="Accept the proposal">
      <bpmn:incoming>SF_Gw_3_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_applyImpact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="applyImpact" name="What applying will take, and where it lands">
      <bpmn:incoming>SF_T_9_applyImpact</bpmn:incoming>
      <bpmn:outgoing>SF_applyImpact_Gw_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_applyImpact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_10" name="Approve what applying takes?">
      <bpmn:incoming>SF_applyImpact_Gw_10</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_10_T_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_10_T_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_11" name="Apply the proposal">
      <bpmn:incoming>SF_Gw_10_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_applied</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="applied" name="What was applied, and where">
      <bpmn:incoming>SF_T_11_applied</bpmn:incoming>
      <bpmn:outgoing>SF_applied_End_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_applied" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_12" name="Abandon the application">
      <bpmn:incoming>SF_Gw_10_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_End_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_13" name="Proposal settled">
      <bpmn:incoming>SF_applied_End_13</bpmn:incoming>
      <bpmn:incoming>SF_T_12_End_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_14" name="Dismiss the proposal">
      <bpmn:incoming>SF_Gw_3_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_dismissed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="dismissed" name="What was dismissed">
      <bpmn:incoming>SF_T_14_dismissed</bpmn:incoming>
      <bpmn:outgoing>SF_dismissed_End_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_dismissed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_15" name="Proposal dismissed">
      <bpmn:incoming>SF_dismissed_End_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_16" name="Clear the conversation">
      <bpmn:incoming>SF_Gw_3_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_cleared</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="cleared" name="What was cleared">
      <bpmn:incoming>SF_T_16_cleared</bpmn:incoming>
      <bpmn:outgoing>SF_cleared_End_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_cleared" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_17" name="Conversation cleared">
      <bpmn:incoming>SF_cleared_End_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_Gw_3" sourceRef="T_2" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="SF_T_4_T_5" sourceRef="T_4" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_5_answer" sourceRef="T_5" targetRef="answer" />
    <bpmn:sequenceFlow id="SF_answer_Gw_6" sourceRef="answer" targetRef="Gw_6" />
    <bpmn:sequenceFlow id="SF_Gw_6_End_7" name="it answered" sourceRef="Gw_6" targetRef="End_7" />
    <bpmn:sequenceFlow id="SF_Gw_6_End_8" name="it did not" sourceRef="Gw_6" targetRef="End_8" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_4" name="ask something" sourceRef="Gw_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_9_applyImpact" sourceRef="T_9" targetRef="applyImpact" />
    <bpmn:sequenceFlow id="SF_applyImpact_Gw_10" sourceRef="applyImpact" targetRef="Gw_10" />
    <bpmn:sequenceFlow id="SF_T_11_applied" sourceRef="T_11" targetRef="applied" />
    <bpmn:sequenceFlow id="SF_Gw_10_T_11" name="approve" sourceRef="Gw_10" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_Gw_10_T_12" name="reject" sourceRef="Gw_10" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_applied_End_13" sourceRef="applied" targetRef="End_13" />
    <bpmn:sequenceFlow id="SF_T_12_End_13" sourceRef="T_12" targetRef="End_13" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_9" name="take a proposal up" sourceRef="Gw_3" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_T_14_dismissed" sourceRef="T_14" targetRef="dismissed" />
    <bpmn:sequenceFlow id="SF_dismissed_End_15" sourceRef="dismissed" targetRef="End_15" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_14" name="turn one down" sourceRef="Gw_3" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_T_16_cleared" sourceRef="T_16" targetRef="cleared" />
    <bpmn:sequenceFlow id="SF_cleared_End_17" sourceRef="cleared" targetRef="End_17" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_16" name="start over" sourceRef="Gw_3" targetRef="T_16" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="askIn" name="Request submitted">
      <bpmn:outgoing>SF_askIn_T_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_askIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_18" name="Submit the request incl. the conversation and current state">
      <bpmn:incoming>SF_askIn_T_18</bpmn:incoming>
      <bpmn:outgoing>SF_T_18_T_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_19" name="Extend conversation by request">
      <bpmn:incoming>SF_T_18_T_19</bpmn:incoming>
      <bpmn:outgoing>SF_T_19_End_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_20" name="Request sent">
      <bpmn:incoming>SF_T_19_End_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Catch_21" name="Advisor answered">
      <bpmn:outgoing>SF_Catch_21_T_22</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Catch_21" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_22" name="Turn each actionable part of the answer into a typed proposal">
      <bpmn:incoming>SF_Catch_21_T_22</bpmn:incoming>
      <bpmn:outgoing>SF_T_22_T_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_23" name="Keep what could not be turned into one as prose, and say so">
      <bpmn:incoming>SF_T_22_T_23</bpmn:incoming>
      <bpmn:outgoing>SF_T_23_T_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_24" name="Supersede the outstanding proposal on each target the answer touches">
      <bpmn:incoming>SF_T_23_T_24</bpmn:incoming>
      <bpmn:outgoing>SF_T_24_T_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_25" name="Keep the answer with the conversation, for the turns that follow">
      <bpmn:incoming>SF_T_24_T_25</bpmn:incoming>
      <bpmn:outgoing>SF_T_25_T_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_26" name="Report the outcome">
      <bpmn:incoming>SF_T_25_T_26</bpmn:incoming>
      <bpmn:outgoing>SF_T_26_End_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_27" name="Answer answered">
      <bpmn:incoming>SF_T_26_End_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="applyImpactIn" name="Application impact requested">
      <bpmn:outgoing>SF_applyImpactIn_T_28</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_applyImpactIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_28" name="Report what applying will take">
      <bpmn:incoming>SF_applyImpactIn_T_28</bpmn:incoming>
      <bpmn:outgoing>SF_T_28_End_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_29" name="Application impact answered">
      <bpmn:incoming>SF_T_28_End_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="applyIn" name="Application requested">
      <bpmn:outgoing>SF_applyIn_T_30</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_applyIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_30" name="Apply the proposal">
      <bpmn:incoming>SF_applyIn_T_30</bpmn:incoming>
      <bpmn:outgoing>SF_T_30_T_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_31" name="Report what was applied, and where it landed">
      <bpmn:incoming>SF_T_30_T_31</bpmn:incoming>
      <bpmn:outgoing>SF_T_31_End_32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_32" name="Application answered">
      <bpmn:incoming>SF_T_31_End_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="dismissIn" name="Dismissal requested">
      <bpmn:outgoing>SF_dismissIn_T_33</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_dismissIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_33" name="Close the proposal as dismissed">
      <bpmn:incoming>SF_dismissIn_T_33</bpmn:incoming>
      <bpmn:outgoing>SF_T_33_T_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_34" name="Report the outcome">
      <bpmn:incoming>SF_T_33_T_34</bpmn:incoming>
      <bpmn:outgoing>SF_T_34_End_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_35" name="Dismissal answered">
      <bpmn:incoming>SF_T_34_End_35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="clearIn" name="Clear requested">
      <bpmn:outgoing>SF_clearIn_T_36</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_clearIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_36" name="Drop the conversation and its outstanding proposals">
      <bpmn:incoming>SF_clearIn_T_36</bpmn:incoming>
      <bpmn:outgoing>SF_T_36_T_37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_37" name="Report the outcome">
      <bpmn:incoming>SF_T_36_T_37</bpmn:incoming>
      <bpmn:outgoing>SF_T_37_End_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_38" name="Clear answered">
      <bpmn:incoming>SF_T_37_End_38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_T_18_T_19" sourceRef="T_18" targetRef="T_19" />
    <bpmn:sequenceFlow id="SF_askIn_T_18" sourceRef="askIn" targetRef="T_18" />
    <bpmn:sequenceFlow id="SF_T_19_End_20" sourceRef="T_19" targetRef="End_20" />
    <bpmn:sequenceFlow id="SF_T_22_T_23" sourceRef="T_22" targetRef="T_23" />
    <bpmn:sequenceFlow id="SF_T_23_T_24" sourceRef="T_23" targetRef="T_24" />
    <bpmn:sequenceFlow id="SF_T_24_T_25" sourceRef="T_24" targetRef="T_25" />
    <bpmn:sequenceFlow id="SF_T_25_T_26" sourceRef="T_25" targetRef="T_26" />
    <bpmn:sequenceFlow id="SF_Catch_21_T_22" sourceRef="Catch_21" targetRef="T_22" />
    <bpmn:sequenceFlow id="SF_T_26_End_27" sourceRef="T_26" targetRef="End_27" />
    <bpmn:sequenceFlow id="SF_applyImpactIn_T_28" sourceRef="applyImpactIn" targetRef="T_28" />
    <bpmn:sequenceFlow id="SF_T_28_End_29" sourceRef="T_28" targetRef="End_29" />
    <bpmn:sequenceFlow id="SF_T_30_T_31" sourceRef="T_30" targetRef="T_31" />
    <bpmn:sequenceFlow id="SF_applyIn_T_30" sourceRef="applyIn" targetRef="T_30" />
    <bpmn:sequenceFlow id="SF_T_31_End_32" sourceRef="T_31" targetRef="End_32" />
    <bpmn:sequenceFlow id="SF_T_33_T_34" sourceRef="T_33" targetRef="T_34" />
    <bpmn:sequenceFlow id="SF_dismissIn_T_33" sourceRef="dismissIn" targetRef="T_33" />
    <bpmn:sequenceFlow id="SF_T_34_End_35" sourceRef="T_34" targetRef="End_35" />
    <bpmn:sequenceFlow id="SF_T_36_T_37" sourceRef="T_36" targetRef="T_37" />
    <bpmn:sequenceFlow id="SF_clearIn_T_36" sourceRef="clearIn" targetRef="T_36" />
    <bpmn:sequenceFlow id="SF_T_37_End_38" sourceRef="T_37" targetRef="End_38" />
  </bpmn:process>
  <bpmn:process id="Process_Advisor" isExecutable="false">
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_BP16_ConsultTheAdvisor">
    <bpmndi:BPMNPlane id="P_BP16_ConsultTheAdvisor" bpmnElement="Collaboration_BP16_ConsultTheAdvisor">
      <bpmndi:BPMNShape id="Participant_User_di" bpmnElement="Participant_User" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1750" height="740" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Bearing_di" bpmnElement="Participant_Bearing" isHorizontal="true">
        <dc:Bounds x="160" y="860" width="1750" height="740" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Advisor_di" bpmnElement="Participant_Advisor" isHorizontal="true">
        <dc:Bounds x="160" y="1640" width="1750" height="260" />
      </bpmndi:BPMNShape>
