<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP18_PlanAProjectsCourse" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP18_PlanAProjectsCourse">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP18.02 · Edit an activity" sourceRef="T_5" targetRef="actEditIn" />
    <bpmn:messageFlow id="MF_2" name="BP18.10 · See what the state change takes" sourceRef="T_7" targetRef="stateImpactIn" />
    <bpmn:messageFlow id="MF_3" name="BP18.04 · Set an activity's state" sourceRef="T_8" targetRef="stateIn" />
    <bpmn:messageFlow id="MF_4" name="BP18.07 · Add a dependency" sourceRef="T_10" targetRef="depAddIn" />
    <bpmn:messageFlow id="MF_5" name="BP18.08 · Remove a dependency" sourceRef="T_12" targetRef="depRemoveIn" />
    <bpmn:messageFlow id="MF_6" name="BP18.05 · See what deleting an activity takes" sourceRef="T_14" targetRef="actImpactIn" />
    <bpmn:messageFlow id="MF_7" name="BP18.06 · Delete an activity" sourceRef="T_17" targetRef="actDeleteIn" />
    <bpmn:messageFlow id="MF_8" name="The editing outcome" sourceRef="T_22" targetRef="actCreated" />
    <bpmn:messageFlow id="MF_9" name="What the change will take" sourceRef="T_24" targetRef="stateImpact" />
    <bpmn:messageFlow id="MF_10" name="The state-change outcome" sourceRef="T_27" targetRef="stateSet" />
    <bpmn:messageFlow id="MF_11" name="The dependency outcome" sourceRef="T_32" targetRef="depAdded" />
    <bpmn:messageFlow id="MF_12" name="The removal outcome" sourceRef="T_35" targetRef="depRemoved" />
    <bpmn:messageFlow id="MF_13" name="What the activity deletion will take" sourceRef="T_37" targetRef="actImpact" />
    <bpmn:messageFlow id="MF_14" name="The deletion outcome" sourceRef="T_40" targetRef="actDeleted" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>Finish-to-start, and only between activities of this project.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="depAdded" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>An activity-based project only. A new activity is what brings its board into existence. The state is not edited here: it is set by its own request.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="actCreated" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>What the change takes is disclosed before it is submitted, and where tasks are still open the answer travels with the request: close them with the activity, set them aside, or leave them open. Where nothing is open there is nothing to answer.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="stateSet" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>No start-to-start, no lag, no overlap, and no edge to another project's activity.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="Gw_29" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>A task needs a board, so declining has no legal outcome: the gesture is approved or abandoned. The dependency edges simply go.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="T_37" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>Activities are flat: finer granularity means more activities, never sub-activities. A board exists because its owner exists.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="T_20" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>This is also where the board's completion offer lands.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="T_26" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>The gap an edge leaves is not closed transitively. An activity is never archived on its own; only its project's archiving takes it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="T_39" targetRef="TextAnnotation_X8" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A plan to lay out, or work to move on">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Work the plan">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_Gw_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_3" name="Which part of the plan?">
      <bpmn:incoming>SF_T_2_Gw_3</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_3_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_10</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_12</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_4" name="Define the activity">
      <bpmn:incoming>SF_Gw_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_T_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_5" name="Submit the activity">
      <bpmn:incoming>SF_T_4_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_actCreated</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="actCreated" name="The editing outcome">
      <bpmn:incoming>SF_T_5_actCreated</bpmn:incoming>
      <bpmn:outgoing>SF_actCreated_End_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_actCreated" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_6" name="Activity recorded">
      <bpmn:incoming>SF_actCreated_End_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_7" name="Set the activity's state">
      <bpmn:incoming>SF_Gw_3_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_stateImpact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="stateImpact" name="What the change will take">
      <bpmn:incoming>SF_T_7_stateImpact</bpmn:incoming>
      <bpmn:outgoing>SF_stateImpact_T_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_stateImpact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_8" name="Submit the state change, saying what becomes of the tasks still open">
      <bpmn:incoming>SF_stateImpact_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_stateSet</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="stateSet" name="The state-change outcome">
      <bpmn:incoming>SF_T_8_stateSet</bpmn:incoming>
      <bpmn:outgoing>SF_stateSet_End_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_stateSet" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_9" name="Activity state set">
      <bpmn:incoming>SF_stateSet_End_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_10" name="Add a dependency between two activities">
      <bpmn:incoming>SF_Gw_3_T_10</bpmn:incoming>
      <bpmn:outgoing>SF_T_10_depAdded</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="depAdded" name="The dependency outcome">
      <bpmn:incoming>SF_T_10_depAdded</bpmn:incoming>
      <bpmn:outgoing>SF_depAdded_End_11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_depAdded" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_11" name="Dependency added">
      <bpmn:incoming>SF_depAdded_End_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_12" name="Remove a dependency">
      <bpmn:incoming>SF_Gw_3_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_depRemoved</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="depRemoved" name="The removal outcome">
      <bpmn:incoming>SF_T_12_depRemoved</bpmn:incoming>
      <bpmn:outgoing>SF_depRemoved_End_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_depRemoved" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_13" name="Dependency dropped">
      <bpmn:incoming>SF_depRemoved_End_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_14" name="Delete an activity">
      <bpmn:incoming>SF_Gw_3_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_actImpact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="actImpact" name="What the activity deletion will take">
      <bpmn:incoming>SF_T_14_actImpact</bpmn:incoming>
      <bpmn:outgoing>SF_actImpact_Gw_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_actImpact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_15" name="Approve what the deletion takes?">
      <bpmn:incoming>SF_actImpact_Gw_15</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_15_T_16</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_15_End_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_16" name="Select a valid cascading option">
      <bpmn:incoming>SF_Gw_15_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_T_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_17" name="Confirm the deletion">
      <bpmn:incoming>SF_T_16_T_17</bpmn:incoming>
      <bpmn:outgoing>SF_T_17_actDeleted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="actDeleted" name="The deletion outcome">
      <bpmn:incoming>SF_T_17_actDeleted</bpmn:incoming>
      <bpmn:outgoing>SF_actDeleted_End_19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_actDeleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_18" name="Deletion abandoned">
      <bpmn:incoming>SF_Gw_15_End_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_19" name="Activity deleted">
      <bpmn:incoming>SF_actDeleted_End_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_Gw_3" sourceRef="T_2" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="SF_T_4_T_5" sourceRef="T_4" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_5_actCreated" sourceRef="T_5" targetRef="actCreated" />
    <bpmn:sequenceFlow id="SF_actCreated_End_6" sourceRef="actCreated" targetRef="End_6" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_4" name="add an activity, or change one" sourceRef="Gw_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_7_stateImpact" sourceRef="T_7" targetRef="stateImpact" />
    <bpmn:sequenceFlow id="SF_stateImpact_T_8" sourceRef="stateImpact" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_T_8_stateSet" sourceRef="T_8" targetRef="stateSet" />
    <bpmn:sequenceFlow id="SF_stateSet_End_9" sourceRef="stateSet" targetRef="End_9" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_7" name="move one along, or reopen it" sourceRef="Gw_3" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_T_10_depAdded" sourceRef="T_10" targetRef="depAdded" />
    <bpmn:sequenceFlow id="SF_depAdded_End_11" sourceRef="depAdded" targetRef="End_11" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_10" name="say what waits for what" sourceRef="Gw_3" targetRef="T_10" />
    <bpmn:sequenceFlow id="SF_T_12_depRemoved" sourceRef="T_12" targetRef="depRemoved" />
    <bpmn:sequenceFlow id="SF_depRemoved_End_13" sourceRef="depRemoved" targetRef="End_13" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_12" name="drop a dependency" sourceRef="Gw_3" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_T_14_actImpact" sourceRef="T_14" targetRef="actImpact" />
    <bpmn:sequenceFlow id="SF_actImpact_Gw_15" sourceRef="actImpact" targetRef="Gw_15" />
    <bpmn:sequenceFlow id="SF_T_16_T_17" sourceRef="T_16" targetRef="T_17" />
    <bpmn:sequenceFlow id="SF_T_17_actDeleted" sourceRef="T_17" targetRef="actDeleted" />
    <bpmn:sequenceFlow id="SF_Gw_15_T_16" name="approve" sourceRef="Gw_15" targetRef="T_16" />
    <bpmn:sequenceFlow id="SF_Gw_15_End_18" name="reject" sourceRef="Gw_15" targetRef="End_18" />
    <bpmn:sequenceFlow id="SF_actDeleted_End_19" sourceRef="actDeleted" targetRef="End_19" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_14" name="remove an activity" sourceRef="Gw_3" targetRef="T_14" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="actEditIn" name="Activity submitted">
      <bpmn:outgoing>SF_actEditIn_T_20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_actEditIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_20" name="Store the edit">
      <bpmn:incoming>SF_actEditIn_T_20</bpmn:incoming>
      <bpmn:outgoing>SF_T_20_T_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_21" name="Give a new activity its board">
      <bpmn:incoming>SF_T_20_T_21</bpmn:incoming>
      <bpmn:outgoing>SF_T_21_T_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_22" name="Report the outcome">
      <bpmn:incoming>SF_T_21_T_22</bpmn:incoming>
      <bpmn:outgoing>SF_T_22_End_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_23" name="Activity answered">
      <bpmn:incoming>SF_T_22_End_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="stateImpactIn" name="State-change impact requested">
      <bpmn:outgoing>SF_stateImpactIn_T_24</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_stateImpactIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_24" name="Report which of the activity's tasks are still open, and what may become of them">
      <bpmn:incoming>SF_stateImpactIn_T_24</bpmn:incoming>
      <bpmn:outgoing>SF_T_24_End_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_25" name="State-change impact answered">
      <bpmn:incoming>SF_T_24_End_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="stateIn" name="Activity state submitted">
      <bpmn:outgoing>SF_stateIn_T_26</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_stateIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_26" name="Record the state the request names, and do with the open tasks what the request carries">
      <bpmn:incoming>SF_stateIn_T_26</bpmn:incoming>
      <bpmn:outgoing>SF_T_26_T_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_27" name="Report the outcome, and what the change clears or raises elsewhere">
      <bpmn:incoming>SF_T_26_T_27</bpmn:incoming>
      <bpmn:outgoing>SF_T_27_End_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_28" name="Activity state answered">
      <bpmn:incoming>SF_T_27_End_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="depAddIn" name="Dependency submitted">
      <bpmn:outgoing>SF_depAddIn_Gw_29</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_depAddIn" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_29" name="Would the edge close a cycle?">
      <bpmn:incoming>SF_depAddIn_Gw_29</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_29_T_30</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_29_T_31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_30" name="Refuse the edge and name the path it would close">
      <bpmn:incoming>SF_Gw_29_T_30</bpmn:incoming>
      <bpmn:outgoing>SF_T_30_T_32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_31" name="Store the finish-to-start edge within the project">
      <bpmn:incoming>SF_Gw_29_T_31</bpmn:incoming>
      <bpmn:outgoing>SF_T_31_T_32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_32" name="Report the outcome">
      <bpmn:incoming>SF_T_30_T_32</bpmn:incoming>
      <bpmn:incoming>SF_T_31_T_32</bpmn:incoming>
      <bpmn:outgoing>SF_T_32_End_33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_33" name="Dependency answered">
      <bpmn:incoming>SF_T_32_End_33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="depRemoveIn" name="Dependency removal requested">
      <bpmn:outgoing>SF_depRemoveIn_T_34</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_depRemoveIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_34" name="Delete the dependency">
      <bpmn:incoming>SF_depRemoveIn_T_34</bpmn:incoming>
      <bpmn:outgoing>SF_T_34_T_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_35" name="Report the outcome">
      <bpmn:incoming>SF_T_34_T_35</bpmn:incoming>
      <bpmn:outgoing>SF_T_35_End_36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_36" name="Dependency removal answered">
      <bpmn:incoming>SF_T_35_End_36</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="actImpactIn" name="Activity deletion impact requested">
      <bpmn:outgoing>SF_actImpactIn_T_37</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_actImpactIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_37" name="Report what the deletion will take, and what of it can be declined">
      <bpmn:incoming>SF_actImpactIn_T_37</bpmn:incoming>
      <bpmn:outgoing>SF_T_37_End_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_38" name="Activity impact answered">
      <bpmn:incoming>SF_T_37_End_38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="actDeleteIn" name="Activity deletion requested">
      <bpmn:outgoing>SF_actDeleteIn_T_39</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_actDeleteIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_39" name="Delete confirmed items">
      <bpmn:incoming>SF_actDeleteIn_T_39</bpmn:incoming>
      <bpmn:outgoing>SF_T_39_T_40</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_40" name="Report the outcome">
      <bpmn:incoming>SF_T_39_T_40</bpmn:incoming>
      <bpmn:outgoing>SF_T_40_End_41</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_41" name="Activity deletion answered">
      <bpmn:incoming>SF_T_40_End_41</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_T_20_T_21" sourceRef="T_20" targetRef="T_21" />
    <bpmn:sequenceFlow id="SF_T_21_T_22" sourceRef="T_21" targetRef="T_22" />
    <bpmn:sequenceFlow id="SF_actEditIn_T_20" sourceRef="actEditIn" targetRef="T_20" />
    <bpmn:sequenceFlow id="SF_T_22_End_23" sourceRef="T_22" targetRef="End_23" />
    <bpmn:sequenceFlow id="SF_stateImpactIn_T_24" sourceRef="stateImpactIn" targetRef="T_24" />
    <bpmn:sequenceFlow id="SF_T_24_End_25" sourceRef="T_24" targetRef="End_25" />
    <bpmn:sequenceFlow id="SF_T_26_T_27" sourceRef="T_26" targetRef="T_27" />
    <bpmn:sequenceFlow id="SF_stateIn_T_26" sourceRef="stateIn" targetRef="T_26" />
    <bpmn:sequenceFlow id="SF_T_27_End_28" sourceRef="T_27" targetRef="End_28" />
    <bpmn:sequenceFlow id="SF_Gw_29_T_30" name="yes" sourceRef="Gw_29" targetRef="T_30" />
    <bpmn:sequenceFlow id="SF_Gw_29_T_31" name="no" sourceRef="Gw_29" targetRef="T_31" />
    <bpmn:sequenceFlow id="SF_T_30_T_32" sourceRef="T_30" targetRef="T_32" />
    <bpmn:sequenceFlow id="SF_T_31_T_32" sourceRef="T_31" targetRef="T_32" />
