<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP19_KeepAnEditAsADraft" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP19_KeepAnEditAsADraft">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP19.01 · Keep the edit as a draft" sourceRef="T_2" targetRef="draftIn" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>Leaving it costs nothing: it is there on the next launch, half-finished, and it has changed nothing meanwhile. Committing it is the act of whichever process the field belongs to, and that is what discards the draft.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_2" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>One-way: nothing waits for the draft to be kept. It stays out of the planning history, and nothing it describes takes effect until the gesture that owns it completes.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_4" targetRef="TextAnnotation_X2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A draftable field is being filled in">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Type into the field">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_End_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_3" name="The edit is safe either way">
      <bpmn:incoming>SF_T_2_End_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_End_3" sourceRef="T_2" targetRef="End_3" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="draftIn" name="Edit submitted">
      <bpmn:outgoing>SF_draftIn_T_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_draftIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_4" name="Keep what is typed as a draft">
      <bpmn:incoming>SF_draftIn_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_End_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_5" name="Draft kept">
      <bpmn:incoming>SF_T_4_End_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_draftIn_T_4" sourceRef="draftIn" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_4_End_5" sourceRef="T_4" targetRef="End_5" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_BP19_KeepAnEditAsADraft">
    <bpmndi:BPMNPlane id="P_BP19_KeepAnEditAsADraft" bpmnElement="Collaboration_BP19_KeepAnEditAsADraft">
      <bpmndi:BPMNShape id="Participant_User_di" bpmnElement="Participant_User" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="730" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Bearing_di" bpmnElement="Participant_Bearing" isHorizontal="true">
        <dc:Bounds x="160" y="380" width="730" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="252" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="228" y="223" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_2_di" bpmnElement="T_2">
        <dc:Bounds x="390" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_3_di" bpmnElement="End_3">
        <dc:Bounds x="592" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="568" y="223" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="draftIn_di" bpmnElement="draftIn">
        <dc:Bounds x="422" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="398" y="523" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_4_di" bpmnElement="T_4">
        <dc:Bounds x="560" y="460" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_5_di" bpmnElement="End_5">
        <dc:Bounds x="762" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="738" y="523" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SF_Start_1_T_2_di" bpmnElement="SF_Start_1_T_2">
        <di:waypoint x="288" y="200" />
        <di:waypoint x="390" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_T_2_End_3_di" bpmnElement="SF_T_2_End_3">
        <di:waypoint x="490" y="200" />
        <di:waypoint x="592" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_draftIn_T_4_di" bpmnElement="SF_draftIn_T_4">
        <di:waypoint x="458" y="500" />
        <di:waypoint x="560" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_T_4_End_5_di" bpmnElement="SF_T_4_End_5">
        <di:waypoint x="660" y="500" />
        <di:waypoint x="762" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_1_di" bpmnElement="MF_1">
        <di:waypoint x="440" y="240" />
        <di:waypoint x="440" y="482" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="TextAnnotation_X1_di" bpmnElement="TextAnnotation_X1"><dc:Bounds x="320" y="19" width="240" height="121" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Association_X1_di" bpmnElement="Association_X1"><di:waypoint x="440" y="160" /><di:waypoint x="440" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="TextAnnotation_X2_di" bpmnElement="TextAnnotation_X2"><dc:Bounds x="490" y="560" width="240" height="91" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Association_X2_di" bpmnElement="Association_X2"><di:waypoint x="610" y="540" /><di:waypoint x="610" y="560" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
