<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP01_StartBearing" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP01_StartBearing">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP01.01 · Start up" sourceRef="T_2" targetRef="bootIn" />
    <bpmn:messageFlow id="MF_2" name="BP01.02 · Seed the starter themes" sourceRef="T_12" targetRef="seedIn" />
    <bpmn:messageFlow id="MF_3" name="BP01.03 · Amend a starter theme" sourceRef="T_14" targetRef="amendIn" />
    <bpmn:messageFlow id="MF_4" name="BP01.06 · Remove a starter theme" sourceRef="T_15" targetRef="removeIn" />
    <bpmn:messageFlow id="MF_5" name="BP01.07 · Add a theme" sourceRef="T_16" targetRef="addIn" />
    <bpmn:messageFlow id="MF_6" name="BP01.08 · Draft the wizard input" sourceRef="T_20" targetRef="wizDraftIn" />
    <bpmn:messageFlow id="MF_7" name="BP01.04 · Record vision and mission" sourceRef="T_21" targetRef="vmIn" />
    <bpmn:messageFlow id="MF_8" name="BP01.05 · Complete onboarding" sourceRef="T_23" targetRef="doneIn" />
    <bpmn:messageFlow id="MF_9" name="Start-up outcome" sourceRef="BP01.01_StartUp" targetRef="outcome" />
    <bpmn:messageFlow id="MF_10" name="Starter themes" sourceRef="BP01.02_SeedTheStarterThemes" targetRef="themesShown" />
    <bpmn:messageFlow id="MF_11" name="Starter set updated" sourceRef="BP01.03_AmendAStarterTheme" targetRef="amended" />
    <bpmn:messageFlow id="MF_12" name="Starter set updated" sourceRef="BP01.06_RemoveAStarterTheme" targetRef="removed" />
    <bpmn:messageFlow id="MF_13" name="Starter set updated" sourceRef="BP01.07_AddATheme" targetRef="added" />
    <bpmn:messageFlow id="MF_14" name="Vision and mission recorded" sourceRef="BP01.04_RecordVisionAndMission" targetRef="vmDone" />
    <bpmn:messageFlow id="MF_15" name="Bearing ready on Focus" sourceRef="BP01.05_CompleteOnboarding" targetRef="ready" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>Recovery is a filesystem operation outside Bearing. There is no folder picker and no adoption of a repository Bearing did not create.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_4" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>The user is the only disambiguator between a first run and lost data. Quitting is safe: the fresh folder is empty and overwrites nothing.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_8" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>Nothing is seeded. The Chores board exists from the first start-up, so ideas and non-project tasks can be worked straight away.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="T_18" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>A starter theme has nothing under it yet, so removing one takes nothing with it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="T_15" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>One synchronous call per launch. The four folder states are variations of one operation, not four operations. An unreachable symlink target counts as missing. Creating the folder is what brings the Chores board into existence. The day in play is set to the current date here, from no day rather than from a previous one. A launch onto usable data lands on Focus; a first run lands there when onboarding completes.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="BP01.01_StartUp" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>Health, Career, Learning, Relationships, Personal — five, enough to start with. The chain runs only when the user asks for a starter set.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="BP01.02_SeedTheStarterThemes" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>Editing, removing and adding are three operations, not three variations of one, so the wizard's inline edits are three call sites.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="BP01.03_AmendAStarterTheme" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>Every form on this surface drafts as it is filled in, so leaving it half-finished, a crash and a restart all cost nothing. The draft is one-way: nothing waits for it to be kept. Whichever write commits the form discards it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="BP01.08_DraftTheWizardInput" targetRef="TextAnnotation_X8" />
    <bpmn:textAnnotation id="TextAnnotation_X9"><bpmn:text>Reached from either wizard step: skipping is the same act as completing, minus what was skipped.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X9" associationDirection="None" sourceRef="BP01.05_CompleteOnboarding" targetRef="TextAnnotation_X9" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Something to plan or do">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Launch Bearing">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_outcome</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="outcome" name="Start-up outcome">
      <bpmn:incoming>SF_T_2_outcome</bpmn:incoming>
      <bpmn:outgoing>SF_outcome_Gw_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_outcome" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_3" name="Versioned by this Bearing, or brought under version control?">
      <bpmn:incoming>SF_outcome_Gw_3</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_3_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_6</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_inUse</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_4" name="Move the folder aside by hand">
      <bpmn:incoming>SF_Gw_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_End_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_5" name="Bearing closed">
      <bpmn:incoming>SF_T_4_End_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_6" name="Read the new-data-folder notice">
      <bpmn:incoming>SF_Gw_3_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_Gw_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_7" name="Was existing data expected at this path?">
      <bpmn:incoming>SF_T_6_Gw_7</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_7_T_8</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_7_T_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_8" name="Quit and restore the backup folder">
      <bpmn:incoming>SF_Gw_7_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_End_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_9" name="Bearing closed">
      <bpmn:incoming>SF_T_8_End_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_10" name="Continue to onboarding">
      <bpmn:incoming>SF_Gw_7_T_10</bpmn:incoming>
      <bpmn:outgoing>SF_T_10_Gw_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_11" name="Set up life areas now?">
      <bpmn:incoming>SF_T_10_Gw_11</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_11_T_12</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_11_T_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_12" name="Ask for a starter set">
      <bpmn:incoming>SF_Gw_11_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_themesShown</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="themesShown" name="Starter themes">
      <bpmn:incoming>SF_T_12_themesShown</bpmn:incoming>
      <bpmn:outgoing>SF_themesShown_review</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_themesShown" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="review" name="Review the starter themes">
      <bpmn:incoming>SF_themesShown_review</bpmn:incoming>
      <bpmn:outgoing>SF_review_Gw_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_13" name="Adjust the starter set?">
      <bpmn:incoming>SF_review_Gw_13</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_13_T_14</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_13_T_15</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_13_T_16</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_13_T_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_14" name="Amend a starter theme">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_Gw_13_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_amended</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="amended" name="Starter set updated">
      <bpmn:incoming>SF_T_14_amended</bpmn:incoming>
      <bpmn:outgoing>SF_amended_Gw_19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_amended" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_15" name="Remove a starter theme">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_Gw_13_T_15</bpmn:incoming>
      <bpmn:outgoing>SF_T_15_removed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="removed" name="Starter set updated">
      <bpmn:incoming>SF_T_15_removed</bpmn:incoming>
      <bpmn:outgoing>SF_removed_Gw_19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_removed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_16" name="Add a life area of my own">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_Gw_13_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_added</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="added" name="Starter set updated">
      <bpmn:incoming>SF_T_16_added</bpmn:incoming>
      <bpmn:outgoing>SF_added_Gw_19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_added" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_17" name="Keep the starter set">
      <bpmn:incoming>SF_Gw_13_T_17</bpmn:incoming>
      <bpmn:outgoing>SF_T_17_Gw_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_18" name="Skip the themes step">
      <bpmn:incoming>SF_Gw_11_T_18</bpmn:incoming>
      <bpmn:outgoing>SF_T_18_Gw_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_19" name="State a vision and mission?">
      <bpmn:incoming>SF_amended_Gw_19</bpmn:incoming>
      <bpmn:incoming>SF_removed_Gw_19</bpmn:incoming>
      <bpmn:incoming>SF_added_Gw_19</bpmn:incoming>
      <bpmn:incoming>SF_T_17_Gw_19</bpmn:incoming>
      <bpmn:incoming>SF_T_18_Gw_19</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_19_T_20</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_19_T_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_20" name="Write vision and mission">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_Gw_19_T_20</bpmn:incoming>
      <bpmn:outgoing>SF_T_20_T_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_21" name="Submit the prose">
      <bpmn:incoming>SF_T_20_T_21</bpmn:incoming>
      <bpmn:outgoing>SF_T_21_vmDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="vmDone" name="Vision and mission recorded">
      <bpmn:incoming>SF_T_21_vmDone</bpmn:incoming>
      <bpmn:outgoing>SF_vmDone_T_23</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_vmDone" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_22" name="Skip the step">
      <bpmn:incoming>SF_Gw_19_T_22</bpmn:incoming>
      <bpmn:outgoing>SF_T_22_T_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_23" name="Finish onboarding">
      <bpmn:incoming>SF_vmDone_T_23</bpmn:incoming>
      <bpmn:incoming>SF_T_22_T_23</bpmn:incoming>
      <bpmn:outgoing>SF_T_23_ready</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="ready" name="Bearing ready on Focus">
      <bpmn:incoming>SF_T_23_ready</bpmn:incoming>
      <bpmn:outgoing>SF_ready_inUse</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ready" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="inUse" name="Work in Bearing">
      <bpmn:incoming>SF_ready_inUse</bpmn:incoming>
      <bpmn:incoming>SF_Gw_3_inUse</bpmn:incoming>
      <bpmn:outgoing>SF_inUse_End_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_24" name="Bearing in use">
      <bpmn:incoming>SF_inUse_End_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_outcome" sourceRef="T_2" targetRef="outcome" />
    <bpmn:sequenceFlow id="SF_outcome_Gw_3" sourceRef="outcome" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="SF_T_4_End_5" sourceRef="T_4" targetRef="End_5" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_4" name="refused" sourceRef="Gw_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_6" name="a new, empty data folder" sourceRef="Gw_3" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_T_6_Gw_7" sourceRef="T_6" targetRef="Gw_7" />
    <bpmn:sequenceFlow id="SF_T_8_End_9" sourceRef="T_8" targetRef="End_9" />
    <bpmn:sequenceFlow id="SF_Gw_7_T_8" name="yes — it is lost or elsewhere" sourceRef="Gw_7" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_Gw_7_T_10" name="no — this is a first run" sourceRef="Gw_7" targetRef="T_10" />
    <bpmn:sequenceFlow id="SF_T_10_Gw_11" sourceRef="T_10" targetRef="Gw_11" />
    <bpmn:sequenceFlow id="SF_T_12_themesShown" sourceRef="T_12" targetRef="themesShown" />
    <bpmn:sequenceFlow id="SF_themesShown_review" sourceRef="themesShown" targetRef="review" />
    <bpmn:sequenceFlow id="SF_review_Gw_13" sourceRef="review" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_T_14_amended" sourceRef="T_14" targetRef="amended" />
    <bpmn:sequenceFlow id="SF_Gw_13_T_14" name="rename or recolour one" sourceRef="Gw_13" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_T_15_removed" sourceRef="T_15" targetRef="removed" />
    <bpmn:sequenceFlow id="SF_Gw_13_T_15" name="drop one" sourceRef="Gw_13" targetRef="T_15" />
    <bpmn:sequenceFlow id="SF_T_16_added" sourceRef="T_16" targetRef="added" />
    <bpmn:sequenceFlow id="SF_Gw_13_T_16" name="add one" sourceRef="Gw_13" targetRef="T_16" />
    <bpmn:sequenceFlow id="SF_Gw_13_T_17" name="no" sourceRef="Gw_13" targetRef="T_17" />
    <bpmn:sequenceFlow id="SF_Gw_11_T_12" name="yes" sourceRef="Gw_11" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_Gw_11_T_18" name="skip — the Themes tab offers it later" sourceRef="Gw_11" targetRef="T_18" />
    <bpmn:sequenceFlow id="SF_amended_Gw_19" sourceRef="amended" targetRef="Gw_19" />
    <bpmn:sequenceFlow id="SF_removed_Gw_19" sourceRef="removed" targetRef="Gw_19" />
    <bpmn:sequenceFlow id="SF_added_Gw_19" sourceRef="added" targetRef="Gw_19" />
    <bpmn:sequenceFlow id="SF_T_17_Gw_19" sourceRef="T_17" targetRef="Gw_19" />
    <bpmn:sequenceFlow id="SF_T_18_Gw_19" sourceRef="T_18" targetRef="Gw_19" />
    <bpmn:sequenceFlow id="SF_T_20_T_21" sourceRef="T_20" targetRef="T_21" />
    <bpmn:sequenceFlow id="SF_T_21_vmDone" sourceRef="T_21" targetRef="vmDone" />
    <bpmn:sequenceFlow id="SF_Gw_19_T_20" name="yes" sourceRef="Gw_19" targetRef="T_20" />
    <bpmn:sequenceFlow id="SF_Gw_19_T_22" name="skip — the Themes tab offers it later" sourceRef="Gw_19" targetRef="T_22" />
    <bpmn:sequenceFlow id="SF_vmDone_T_23" sourceRef="vmDone" targetRef="T_23" />
    <bpmn:sequenceFlow id="SF_T_22_T_23" sourceRef="T_22" targetRef="T_23" />
    <bpmn:sequenceFlow id="SF_T_23_ready" sourceRef="T_23" targetRef="ready" />
    <bpmn:sequenceFlow id="SF_ready_inUse" sourceRef="ready" targetRef="inUse" />
    <bpmn:sequenceFlow id="SF_inUse_End_24" sourceRef="inUse" targetRef="End_24" />
    <bpmn:sequenceFlow id="SF_Gw_3_inUse" name="usable data" sourceRef="Gw_3" targetRef="inUse" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="bootIn" name="Start-up requested">
      <bpmn:outgoing>SF_bootIn_BP01.01_StartUp</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_bootIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP01.01_StartUp" name="Start up">
      <bpmn:incoming>SF_bootIn_BP01.01_StartUp</bpmn:incoming>
      <bpmn:outgoing>SF_BP01.01_StartUp_End_41</bpmn:outgoing>
      <bpmn:startEvent id="BP01.01_StartUp_s" name="Start">
        <bpmn:outgoing>SF_BP01.01_StartUp_s_T_25</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_25" name="Resolve the conventional data-folder path">
        <bpmn:incoming>SF_BP01.01_StartUp_s_T_25</bpmn:incoming>
        <bpmn:outgoing>SF_T_25_T_26</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_26" name="Inspect the data folder">
        <bpmn:incoming>SF_T_25_T_26</bpmn:incoming>
        <bpmn:outgoing>SF_T_26_Gw_27</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="Gw_27" name="Versioned by this Bearing?">
        <bpmn:incoming>SF_T_26_Gw_27</bpmn:incoming>
        <bpmn:outgoing>SF_Gw_27_T_28</bpmn:outgoing>
        <bpmn:outgoing>SF_Gw_27_T_29</bpmn:outgoing>
        <bpmn:outgoing>SF_Gw_27_T_31</bpmn:outgoing>
        <bpmn:outgoing>SF_Gw_27_T_32</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="T_28" name="Load the data">
        <bpmn:incoming>SF_Gw_27_T_28</bpmn:incoming>
        <bpmn:outgoing>SF_T_28_T_35</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_29" name="Bring the folder under version control">
        <bpmn:incoming>SF_Gw_27_T_29</bpmn:incoming>
        <bpmn:outgoing>SF_T_29_T_30</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_30" name="Load the newly versioned data">
        <bpmn:incoming>SF_T_29_T_30</bpmn:incoming>
        <bpmn:outgoing>SF_T_30_T_35</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_31" name="Refuse to adopt the folder">
        <bpmn:incoming>SF_Gw_27_T_31</bpmn:incoming>
        <bpmn:outgoing>SF_T_31_T_35</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_32" name="Create the data folder">
        <bpmn:incoming>SF_Gw_27_T_32</bpmn:incoming>
        <bpmn:outgoing>SF_T_32_T_33</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_33" name="Version-control the new folder">
        <bpmn:incoming>SF_T_32_T_33</bpmn:incoming>
        <bpmn:outgoing>SF_T_33_T_34</bpmn:outgoing>
