<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP02_MaintainLifeThemes" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP02_MaintainLifeThemes">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP02.01 · Read the themes overview" sourceRef="themesTab" targetRef="overviewIn" />
    <bpmn:messageFlow id="MF_2" name="BP02.10 · Draft the theme input" sourceRef="T_3" targetRef="themeDraftIn" />
    <bpmn:messageFlow id="MF_3" name="BP02.02 · Create a theme" sourceRef="T_4" targetRef="createIn" />
    <bpmn:messageFlow id="MF_4" name="BP02.03 · Amend a theme" sourceRef="T_5" targetRef="amendIn" />
    <bpmn:messageFlow id="MF_5" name="BP02.04 · Reorder themes" sourceRef="T_6" targetRef="reorderIn" />
    <bpmn:messageFlow id="MF_6" name="BP02.09 · Seed the starter themes" sourceRef="T_7" targetRef="seedIn" />
    <bpmn:messageFlow id="MF_7" name="BP02.05 · See what deleting a theme takes" sourceRef="T_8" targetRef="impactIn" />
    <bpmn:messageFlow id="MF_8" name="BP02.06 · Delete a theme" sourceRef="confirmDeletion" targetRef="deleteIn" />
    <bpmn:messageFlow id="MF_9" name="BP02.07 · Read vision and mission" sourceRef="T_16" targetRef="vmReadIn" />
    <bpmn:messageFlow id="MF_10" name="BP02.08 · Record vision and mission" sourceRef="T_17" targetRef="vmIn" />
    <bpmn:messageFlow id="MF_11" name="Themes with their goal and routine counts" sourceRef="BP02.01_ReadTheThemesOverview" targetRef="overview" />
    <bpmn:messageFlow id="MF_12" name="Theme created" sourceRef="BP02.02_CreateTheme" targetRef="created" />
    <bpmn:messageFlow id="MF_13" name="Theme amended" sourceRef="BP02.03_AmendTheme" targetRef="amended" />
    <bpmn:messageFlow id="MF_14" name="Order recorded" sourceRef="BP02.04_ReorderThemes" targetRef="reordered" />
    <bpmn:messageFlow id="MF_15" name="What the deletion will take" sourceRef="BP02.05_ReadTheDeletionImpact" targetRef="impact" />
    <bpmn:messageFlow id="MF_16" name="Theme deleted" sourceRef="BP02.06_DeleteTheme" targetRef="deleted" />
    <bpmn:messageFlow id="MF_17" name="Starter themes" sourceRef="BP02.09_SeedTheStarterThemes" targetRef="seeded" />
    <bpmn:messageFlow id="MF_18" name="Vision and mission" sourceRef="BP02.07_ReadVisionAndMission" targetRef="vmShown" />
    <bpmn:messageFlow id="MF_19" name="Vision and mission recorded" sourceRef="BP02.08_RecordVisionAndMission" targetRef="vmDone" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>The routines go either way. Their tasks stay on Chores, with nothing producing new ones.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_15" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>Renaming and recolouring are one request. The colour the user picks is what propagates downstream.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="amended" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>Open to a user who skipped the wizard, or who deleted every theme.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="seeded" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>A kept idea loses only its theme affiliation and stays legitimate.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="T_11" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>Nothing is deleted and nothing is changed.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="T_12" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>Emptying both fields is how they are unset. Nothing else depends on them.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="vmDone" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>The goals and routines cannot be kept, so confirming takes them. There is no in-app undo; recovery is from version control.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="deleted" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>Archived goals are not counted. The count states what is live under the theme today. Whether the prose is set is what distinguishes a collapsed section from one never written; the prose itself is read on expanding it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="BP02.01_ReadTheThemesOverview" targetRef="TextAnnotation_X8" />
    <bpmn:textAnnotation id="TextAnnotation_X9"><bpmn:text>Every form on this surface drafts as it is filled in, so leaving it half-finished, a crash and a restart all cost nothing. The draft is one-way: nothing waits for it to be kept. Whichever write commits the form discards it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X9" associationDirection="None" sourceRef="BP02.10_DraftTheThemeInput" targetRef="TextAnnotation_X9" />
    <bpmn:textAnnotation id="TextAnnotation_X10"><bpmn:text>One request covers the name, the colour or both. The colour reaches every entity under the theme.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X10" associationDirection="None" sourceRef="BP02.03_AmendTheme" targetRef="TextAnnotation_X10" />
    <bpmn:textAnnotation id="TextAnnotation_X11"><bpmn:text>Order is relative, so a theme's place is never a stored index.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X11" associationDirection="None" sourceRef="BP02.04_ReorderThemes" targetRef="TextAnnotation_X11" />
    <bpmn:textAnnotation id="TextAnnotation_X12"><bpmn:text>A goal and a routine each require a theme, so keeping one is not a legal outcome: the gesture is then approve-or-abandon. An idea may stay behind theme-less, so that cascade is the one real choice and starts off. The disclosure reaches two levels down, because a deleted goal takes its projects and measures with it, and so does an included idea. An archived descendant is counted like a live one.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X12" associationDirection="None" sourceRef="BP02.05_ReadTheDeletionImpact" targetRef="TextAnnotation_X12" />
    <bpmn:textAnnotation id="TextAnnotation_X13"><bpmn:text>The only thing in the product with a default worth seeding. BP01 seeds the same set at a first run; whether the two call sites are one System Interaction is a Design finding.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X13" associationDirection="None" sourceRef="BP02.09_SeedTheStarterThemes" targetRef="TextAnnotation_X13" />
    <bpmn:textAnnotation id="TextAnnotation_X14"><bpmn:text>Both fields are optional. Empty text is the unset state.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X14" associationDirection="None" sourceRef="BP02.08_RecordVisionAndMission" targetRef="TextAnnotation_X14" />
    <bpmn:textAnnotation id="TextAnnotation_X15"><bpmn:text>The request carries the cascade the user approved. What happens below a deleted goal or idea is that entity's own rule, applied where the deletion reaches it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X15" associationDirection="None" sourceRef="BP02.06_DeleteTheme" targetRef="TextAnnotation_X15" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A life area needs attention">
      <bpmn:outgoing>SF_Start_1_themesTab</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="themesTab" name="Open the Themes tab">
      <bpmn:incoming>SF_Start_1_themesTab</bpmn:incoming>
      <bpmn:incoming>SF_T_12_themesTab</bpmn:incoming>
      <bpmn:incoming>SF_Gw_18_themesTab</bpmn:incoming>
      <bpmn:outgoing>SF_themesTab_overview</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="overview" name="Themes with their goal and routine counts">
      <bpmn:incoming>SF_themesTab_overview</bpmn:incoming>
      <bpmn:outgoing>SF_overview_Gw_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_overview" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_2" name="What needs doing?">
      <bpmn:incoming>SF_overview_Gw_2</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_2_T_3</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_5</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_6</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_8</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_3" name="Name and colour a new theme">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_Gw_2_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_T_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_4" name="Submit the new theme">
      <bpmn:incoming>SF_T_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_created</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="created" name="Theme created">
      <bpmn:incoming>SF_T_4_created</bpmn:incoming>
      <bpmn:outgoing>SF_created_Gw_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_created" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_5" name="Amend the theme">
      <bpmn:incoming>SF_Gw_2_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_amended</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="amended" name="Theme amended">
      <bpmn:incoming>SF_T_5_amended</bpmn:incoming>
      <bpmn:outgoing>SF_amended_Gw_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_amended" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_6" name="Drag a theme into place">
      <bpmn:incoming>SF_Gw_2_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_reordered</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="reordered" name="Order recorded">
      <bpmn:incoming>SF_T_6_reordered</bpmn:incoming>
      <bpmn:outgoing>SF_reordered_Gw_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_reordered" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_7" name="Ask for the starter set again">
      <bpmn:incoming>SF_Gw_2_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_seeded</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="seeded" name="Starter themes">
      <bpmn:incoming>SF_T_7_seeded</bpmn:incoming>
      <bpmn:outgoing>SF_seeded_Gw_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_seeded" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_8" name="Choose a theme to delete">
      <bpmn:incoming>SF_Gw_2_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_impact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="impact" name="What the deletion will take">
      <bpmn:incoming>SF_T_8_impact</bpmn:incoming>
      <bpmn:outgoing>SF_impact_Gw_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_impact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_9" name="Let the ideas go too?">
      <bpmn:incoming>SF_impact_Gw_9</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_9_T_10</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_9_T_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_9_T_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_10" name="Include the ideas in the cascade">
      <bpmn:incoming>SF_Gw_9_T_10</bpmn:incoming>
      <bpmn:outgoing>SF_T_10_confirmDeletion</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_11" name="Leave the ideas out of the cascade">
      <bpmn:incoming>SF_Gw_9_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_confirmDeletion</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_12" name="Abandon the deletion">
      <bpmn:incoming>SF_Gw_9_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_themesTab</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_13" name="Let the routines' tasks go too?">
      <bpmn:outgoing>SF_Gw_13_T_14</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_13_T_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_14" name="Include the task occurrences in the cascade">
      <bpmn:incoming>SF_Gw_13_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_confirmDeletion</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_15" name="Leave the task occurrences out of the cascade">
      <bpmn:incoming>SF_Gw_13_T_15</bpmn:incoming>
      <bpmn:outgoing>SF_T_15_confirmDeletion</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="confirmDeletion" name="Confirm the deletion">
      <bpmn:incoming>SF_T_14_confirmDeletion</bpmn:incoming>
      <bpmn:incoming>SF_T_15_confirmDeletion</bpmn:incoming>
      <bpmn:incoming>SF_T_10_confirmDeletion</bpmn:incoming>
      <bpmn:incoming>SF_T_11_confirmDeletion</bpmn:incoming>
      <bpmn:outgoing>SF_confirmDeletion_deleted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="deleted" name="Theme deleted">
      <bpmn:incoming>SF_confirmDeletion_deleted</bpmn:incoming>
      <bpmn:outgoing>SF_deleted_Gw_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_deleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_16" name="Expand the vision and mission section">
      <bpmn:incoming>SF_Gw_2_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_vmShown</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="vmShown" name="Vision and mission">
      <bpmn:incoming>SF_T_16_vmShown</bpmn:incoming>
      <bpmn:outgoing>SF_vmShown_T_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_vmShown" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_17" name="Write vision and mission">
      <bpmn:incoming>SF_vmShown_T_17</bpmn:incoming>
      <bpmn:outgoing>SF_T_17_vmDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="vmDone" name="Vision and mission recorded">
      <bpmn:incoming>SF_T_17_vmDone</bpmn:incoming>
      <bpmn:outgoing>SF_vmDone_Gw_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_vmDone" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_18" name="Anything else on this tab?">
      <bpmn:incoming>SF_created_Gw_18</bpmn:incoming>
      <bpmn:incoming>SF_amended_Gw_18</bpmn:incoming>
      <bpmn:incoming>SF_reordered_Gw_18</bpmn:incoming>
      <bpmn:incoming>SF_seeded_Gw_18</bpmn:incoming>
      <bpmn:incoming>SF_deleted_Gw_18</bpmn:incoming>
      <bpmn:incoming>SF_vmDone_Gw_18</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_18_T_19</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_18_themesTab</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_19" name="Leave the tab">
      <bpmn:incoming>SF_Gw_18_T_19</bpmn:incoming>
      <bpmn:outgoing>SF_T_19_End_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_20" name="Life areas current">
      <bpmn:incoming>SF_T_19_End_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_themesTab" sourceRef="Start_1" targetRef="themesTab" />
    <bpmn:sequenceFlow id="SF_themesTab_overview" sourceRef="themesTab" targetRef="overview" />
    <bpmn:sequenceFlow id="SF_overview_Gw_2" sourceRef="overview" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="SF_T_3_T_4" sourceRef="T_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_4_created" sourceRef="T_4" targetRef="created" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_3" name="add a life area" sourceRef="Gw_2" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_T_5_amended" sourceRef="T_5" targetRef="amended" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_5" name="rename or recolour one" sourceRef="Gw_2" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_6_reordered" sourceRef="T_6" targetRef="reordered" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_6" name="reorder them" sourceRef="Gw_2" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_T_7_seeded" sourceRef="T_7" targetRef="seeded" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_7" name="start over with a starter set" sourceRef="Gw_2" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_T_8_impact" sourceRef="T_8" targetRef="impact" />
    <bpmn:sequenceFlow id="SF_impact_Gw_9" sourceRef="impact" targetRef="Gw_9" />
    <bpmn:sequenceFlow id="SF_Gw_9_T_10" name="yes, take them as well" sourceRef="Gw_9" targetRef="T_10" />
    <bpmn:sequenceFlow id="SF_Gw_9_T_11" name="no, keep them theme-less" sourceRef="Gw_9" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_Gw_9_T_12" name="abandon the deletion" sourceRef="Gw_9" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_Gw_13_T_14" name="yes, take them as well" sourceRef="Gw_13" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_Gw_13_T_15" name="no, leave them on Chores" sourceRef="Gw_13" targetRef="T_15" />
    <bpmn:sequenceFlow id="SF_T_14_confirmDeletion" sourceRef="T_14" targetRef="confirmDeletion" />
    <bpmn:sequenceFlow id="SF_T_15_confirmDeletion" sourceRef="T_15" targetRef="confirmDeletion" />
    <bpmn:sequenceFlow id="SF_confirmDeletion_deleted" sourceRef="confirmDeletion" targetRef="deleted" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_8" name="retire one for good" sourceRef="Gw_2" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_T_16_vmShown" sourceRef="T_16" targetRef="vmShown" />
    <bpmn:sequenceFlow id="SF_vmShown_T_17" sourceRef="vmShown" targetRef="T_17" />
    <bpmn:sequenceFlow id="SF_T_17_vmDone" sourceRef="T_17" targetRef="vmDone" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_16" name="state who I want to become" sourceRef="Gw_2" targetRef="T_16" />
    <bpmn:sequenceFlow id="SF_created_Gw_18" sourceRef="created" targetRef="Gw_18" />
    <bpmn:sequenceFlow id="SF_amended_Gw_18" sourceRef="amended" targetRef="Gw_18" />
    <bpmn:sequenceFlow id="SF_reordered_Gw_18" sourceRef="reordered" targetRef="Gw_18" />
    <bpmn:sequenceFlow id="SF_seeded_Gw_18" sourceRef="seeded" targetRef="Gw_18" />
    <bpmn:sequenceFlow id="SF_deleted_Gw_18" sourceRef="deleted" targetRef="Gw_18" />
    <bpmn:sequenceFlow id="SF_vmDone_Gw_18" sourceRef="vmDone" targetRef="Gw_18" />
    <bpmn:sequenceFlow id="SF_Gw_18_T_19" name="no" sourceRef="Gw_18" targetRef="T_19" />
    <bpmn:sequenceFlow id="SF_T_19_End_20" sourceRef="T_19" targetRef="End_20" />
    <bpmn:sequenceFlow id="SF_T_10_confirmDeletion" sourceRef="T_10" targetRef="confirmDeletion" />
    <bpmn:sequenceFlow id="SF_T_11_confirmDeletion" sourceRef="T_11" targetRef="confirmDeletion" />
    <bpmn:sequenceFlow id="SF_T_12_themesTab" sourceRef="T_12" targetRef="themesTab" />
    <bpmn:sequenceFlow id="SF_Gw_18_themesTab" name="yes" sourceRef="Gw_18" targetRef="themesTab" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="overviewIn" name="Themes overview requested">
      <bpmn:outgoing>SF_overviewIn_BP02.01_ReadTheThemesOverview</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_overviewIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP02.01_ReadTheThemesOverview" name="Read the themes overview">
      <bpmn:incoming>SF_overviewIn_BP02.01_ReadTheThemesOverview</bpmn:incoming>
      <bpmn:outgoing>SF_BP02.01_ReadTheThemesOverview_End_24</bpmn:outgoing>
      <bpmn:startEvent id="BP02.01_ReadTheThemesOverview_s" name="Start">
        <bpmn:outgoing>SF_BP02.01_ReadTheThemesOverview_s_T_21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_21" name="Read the themes in their recorded order">
        <bpmn:incoming>SF_BP02.01_ReadTheThemesOverview_s_T_21</bpmn:incoming>
        <bpmn:outgoing>SF_T_21_T_22</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_22" name="Count the active goals and routines per theme">
