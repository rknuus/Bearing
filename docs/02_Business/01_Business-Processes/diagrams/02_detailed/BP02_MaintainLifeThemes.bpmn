      <bpmn:outgoing>SF_deleted_End_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_deleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_13" name="Deletion abandoned">
      <bpmn:incoming>SF_Gw_10_End_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_14" name="Theme deleted">
      <bpmn:incoming>SF_deleted_End_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_15" name="State the vision and mission">
