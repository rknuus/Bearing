  <bpmndi:BPMNDiagram id="D_BP02_MaintainLifeThemes">
    <bpmndi:BPMNPlane id="P_BP02_MaintainLifeThemes" bpmnElement="Collaboration_BP02_MaintainLifeThemes">
      <bpmndi:BPMNShape id="Participant_User_di" bpmnElement="Participant_User" isHorizontal="true">
