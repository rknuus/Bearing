    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_6" name="Theme recorded">
      <bpmn:incoming>SF_recorded_End_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_7" name="Order a theme">
