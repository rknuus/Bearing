<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP03_MaintainRoutines" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP03_MaintainRoutines">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP03.02 · Edit a routine" sourceRef="T_5" targetRef="editIn" />
    <bpmn:messageFlow id="MF_2" name="BP03.04 · Pause or resume a routine" sourceRef="T_7" targetRef="activeIn" />
    <bpmn:messageFlow id="MF_3" name="BP03.05 · Reorder routines" sourceRef="T_9" targetRef="reorderIn" />
    <bpmn:messageFlow id="MF_4" name="BP03.06 · See what deleting a routine takes" sourceRef="T_11" targetRef="impactIn" />
    <bpmn:messageFlow id="MF_5" name="BP03.07 · Delete a routine" sourceRef="T_14" targetRef="deleteIn" />
    <bpmn:messageFlow id="MF_6" name="The editing outcome" sourceRef="BP03.02_EditRoutine" targetRef="recorded" />
    <bpmn:messageFlow id="MF_7" name="The pause-or-resume outcome" sourceRef="BP03.04_SetRoutineActive" targetRef="activeSet" />
    <bpmn:messageFlow id="MF_8" name="The ordering outcome" sourceRef="BP03.05_ReorderRoutines" targetRef="reordered" />
    <bpmn:messageFlow id="MF_9" name="What the deletion will take" sourceRef="BP03.06_ReadTheDeletionImpact" targetRef="impact" />
    <bpmn:messageFlow id="MF_10" name="The deletion outcome" sourceRef="BP03.07_DeleteRoutine" targetRef="deleted" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>The schedule is a recurrence pattern plus preferred days: it says when the routine is due, and never puts work on a board.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="recorded" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>The routine stops producing new ones either way; the occurrences it already produced go or stay on Chores.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="deleted" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>A paused routine leaves the focus selectables and the due computation, and returns to both on resume.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="BP03.04_SetRoutineActive" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>The occurrences are a declinable cascade, so it starts off. Declining leaves them on Chores and stops the routine producing new ones.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="BP03.06_ReadTheDeletionImpact" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>A routine carries no life area. The recurrence is Daily, Weekly, Monthly or Yearly.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="BP03.02_EditRoutine" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>The request carries the cascade the user approved.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="BP03.07_DeleteRoutine" targetRef="TextAnnotation_X6" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A routine needs attention">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Work a routine">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_Gw_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_3" name="What needs doing?">
      <bpmn:incoming>SF_T_2_Gw_3</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_3_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_9</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_4" name="Define the routine">
      <bpmn:incoming>SF_Gw_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_T_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_5" name="Submit the routine">
      <bpmn:incoming>SF_T_4_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_recorded</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="recorded" name="The editing outcome">
      <bpmn:incoming>SF_T_5_recorded</bpmn:incoming>
      <bpmn:outgoing>SF_recorded_End_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_recorded" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_6" name="Routine recorded">
      <bpmn:incoming>SF_recorded_End_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_7" name="Pause or resume the routine">
      <bpmn:incoming>SF_Gw_3_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_activeSet</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="activeSet" name="The pause-or-resume outcome">
      <bpmn:incoming>SF_T_7_activeSet</bpmn:incoming>
      <bpmn:outgoing>SF_activeSet_End_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_activeSet" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_8" name="Routine paused or resumed">
      <bpmn:incoming>SF_activeSet_End_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_9" name="Order a routine">
      <bpmn:incoming>SF_Gw_3_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_reordered</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="reordered" name="The ordering outcome">
      <bpmn:incoming>SF_T_9_reordered</bpmn:incoming>
      <bpmn:outgoing>SF_reordered_End_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_reordered" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_10" name="Routines ordered">
      <bpmn:incoming>SF_reordered_End_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_11" name="Delete a routine">
      <bpmn:incoming>SF_Gw_3_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_impact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="impact" name="What the deletion will take">
      <bpmn:incoming>SF_T_11_impact</bpmn:incoming>
      <bpmn:outgoing>SF_impact_Gw_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_impact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_12" name="Approve what the deletion takes?">
      <bpmn:incoming>SF_impact_Gw_12</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_12_T_13</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_12_End_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_13" name="Select a valid cascading option">
      <bpmn:incoming>SF_Gw_12_T_13</bpmn:incoming>
      <bpmn:outgoing>SF_T_13_T_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_14" name="Confirm the deletion">
      <bpmn:incoming>SF_T_13_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_deleted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="deleted" name="The deletion outcome">
      <bpmn:incoming>SF_T_14_deleted</bpmn:incoming>
      <bpmn:outgoing>SF_deleted_End_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_deleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_15" name="Deletion abandoned">
      <bpmn:incoming>SF_Gw_12_End_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_16" name="Routine deleted">
      <bpmn:incoming>SF_deleted_End_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_Gw_3" sourceRef="T_2" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="SF_T_4_T_5" sourceRef="T_4" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_5_recorded" sourceRef="T_5" targetRef="recorded" />
    <bpmn:sequenceFlow id="SF_recorded_End_6" sourceRef="recorded" targetRef="End_6" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_4" name="add or change a routine" sourceRef="Gw_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_7_activeSet" sourceRef="T_7" targetRef="activeSet" />
    <bpmn:sequenceFlow id="SF_activeSet_End_8" sourceRef="activeSet" targetRef="End_8" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_7" name="put one on hold, or take it off hold" sourceRef="Gw_3" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_T_9_reordered" sourceRef="T_9" targetRef="reordered" />
    <bpmn:sequenceFlow id="SF_reordered_End_10" sourceRef="reordered" targetRef="End_10" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_9" name="reorder them" sourceRef="Gw_3" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_T_11_impact" sourceRef="T_11" targetRef="impact" />
    <bpmn:sequenceFlow id="SF_impact_Gw_12" sourceRef="impact" targetRef="Gw_12" />
    <bpmn:sequenceFlow id="SF_T_13_T_14" sourceRef="T_13" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_T_14_deleted" sourceRef="T_14" targetRef="deleted" />
    <bpmn:sequenceFlow id="SF_Gw_12_T_13" name="approve" sourceRef="Gw_12" targetRef="T_13" />
    <bpmn:sequenceFlow id="SF_Gw_12_End_15" name="reject" sourceRef="Gw_12" targetRef="End_15" />
    <bpmn:sequenceFlow id="SF_deleted_End_16" sourceRef="deleted" targetRef="End_16" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_11" name="retire one for good" sourceRef="Gw_3" targetRef="T_11" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="editIn" name="Routine submitted">
      <bpmn:outgoing>SF_editIn_BP03.02_EditRoutine</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_editIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP03.02_EditRoutine" name="Edit a routine">
      <bpmn:incoming>SF_editIn_BP03.02_EditRoutine</bpmn:incoming>
      <bpmn:outgoing>SF_BP03.02_EditRoutine_End_19</bpmn:outgoing>
      <bpmn:startEvent id="BP03.02_EditRoutine_s" name="Start">
        <bpmn:outgoing>SF_BP03.02_EditRoutine_s_T_17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_17" name="Store the edit">
        <bpmn:incoming>SF_BP03.02_EditRoutine_s_T_17</bpmn:incoming>
        <bpmn:outgoing>SF_T_17_T_18</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_18" name="Report the outcome">
        <bpmn:incoming>SF_T_17_T_18</bpmn:incoming>
        <bpmn:outgoing>SF_T_18_BP03.02_EditRoutine_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP03.02_EditRoutine_e" name="fertig">
        <bpmn:incoming>SF_T_18_BP03.02_EditRoutine_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_17_T_18" sourceRef="T_17" targetRef="T_18" />
      <bpmn:sequenceFlow id="SF_BP03.02_EditRoutine_s_T_17" sourceRef="BP03.02_EditRoutine_s" targetRef="T_17" />
      <bpmn:sequenceFlow id="SF_T_18_BP03.02_EditRoutine_e" sourceRef="T_18" targetRef="BP03.02_EditRoutine_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_19" name="Routine answered">
      <bpmn:incoming>SF_BP03.02_EditRoutine_End_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="activeIn" name="Pause or resume submitted">
      <bpmn:outgoing>SF_activeIn_BP03.04_SetRoutineActive</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_activeIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP03.04_SetRoutineActive" name="Pause or resume a routine">
      <bpmn:incoming>SF_activeIn_BP03.04_SetRoutineActive</bpmn:incoming>
      <bpmn:outgoing>SF_BP03.04_SetRoutineActive_End_22</bpmn:outgoing>
      <bpmn:startEvent id="BP03.04_SetRoutineActive_s" name="Start">
        <bpmn:outgoing>SF_BP03.04_SetRoutineActive_s_T_20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_20" name="Apply the pause or the resume">
        <bpmn:incoming>SF_BP03.04_SetRoutineActive_s_T_20</bpmn:incoming>
        <bpmn:outgoing>SF_T_20_T_21</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_21" name="Report the outcome">
        <bpmn:incoming>SF_T_20_T_21</bpmn:incoming>
        <bpmn:outgoing>SF_T_21_BP03.04_SetRoutineActive_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP03.04_SetRoutineActive_e" name="fertig">
        <bpmn:incoming>SF_T_21_BP03.04_SetRoutineActive_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_20_T_21" sourceRef="T_20" targetRef="T_21" />
      <bpmn:sequenceFlow id="SF_BP03.04_SetRoutineActive_s_T_20" sourceRef="BP03.04_SetRoutineActive_s" targetRef="T_20" />
      <bpmn:sequenceFlow id="SF_T_21_BP03.04_SetRoutineActive_e" sourceRef="T_21" targetRef="BP03.04_SetRoutineActive_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_22" name="Pause or resume answered">
      <bpmn:incoming>SF_BP03.04_SetRoutineActive_End_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="reorderIn" name="Routine reordering requested">
      <bpmn:outgoing>SF_reorderIn_BP03.05_ReorderRoutines</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_reorderIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP03.05_ReorderRoutines" name="Reorder routines">
      <bpmn:incoming>SF_reorderIn_BP03.05_ReorderRoutines</bpmn:incoming>
      <bpmn:outgoing>SF_BP03.05_ReorderRoutines_End_25</bpmn:outgoing>
      <bpmn:startEvent id="BP03.05_ReorderRoutines_s" name="Start">
        <bpmn:outgoing>SF_BP03.05_ReorderRoutines_s_T_23</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_23" name="Apply the new order">
        <bpmn:incoming>SF_BP03.05_ReorderRoutines_s_T_23</bpmn:incoming>
        <bpmn:outgoing>SF_T_23_T_24</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_24" name="Report the outcome">
        <bpmn:incoming>SF_T_23_T_24</bpmn:incoming>
        <bpmn:outgoing>SF_T_24_BP03.05_ReorderRoutines_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP03.05_ReorderRoutines_e" name="fertig">
        <bpmn:incoming>SF_T_24_BP03.05_ReorderRoutines_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_23_T_24" sourceRef="T_23" targetRef="T_24" />
      <bpmn:sequenceFlow id="SF_BP03.05_ReorderRoutines_s_T_23" sourceRef="BP03.05_ReorderRoutines_s" targetRef="T_23" />
      <bpmn:sequenceFlow id="SF_T_24_BP03.05_ReorderRoutines_e" sourceRef="T_24" targetRef="BP03.05_ReorderRoutines_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_25" name="Reordering answered">
      <bpmn:incoming>SF_BP03.05_ReorderRoutines_End_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="impactIn" name="Deletion impact requested">
      <bpmn:outgoing>SF_impactIn_BP03.06_ReadTheDeletionImpact</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_impactIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP03.06_ReadTheDeletionImpact" name="See what deleting a routine takes">
      <bpmn:incoming>SF_impactIn_BP03.06_ReadTheDeletionImpact</bpmn:incoming>
      <bpmn:outgoing>SF_BP03.06_ReadTheDeletionImpact_End_27</bpmn:outgoing>
      <bpmn:startEvent id="BP03.06_ReadTheDeletionImpact_s" name="Start">
        <bpmn:outgoing>SF_BP03.06_ReadTheDeletionImpact_s_T_26</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_26" name="Report what the deletion will take, and what of it can be declined">
        <bpmn:incoming>SF_BP03.06_ReadTheDeletionImpact_s_T_26</bpmn:incoming>
        <bpmn:outgoing>SF_T_26_BP03.06_ReadTheDeletionImpact_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP03.06_ReadTheDeletionImpact_e" name="fertig">
        <bpmn:incoming>SF_T_26_BP03.06_ReadTheDeletionImpact_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_BP03.06_ReadTheDeletionImpact_s_T_26" sourceRef="BP03.06_ReadTheDeletionImpact_s" targetRef="T_26" />
      <bpmn:sequenceFlow id="SF_T_26_BP03.06_ReadTheDeletionImpact_e" sourceRef="T_26" targetRef="BP03.06_ReadTheDeletionImpact_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_27" name="Impact answered">
      <bpmn:incoming>SF_BP03.06_ReadTheDeletionImpact_End_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="deleteIn" name="Routine deletion requested">
      <bpmn:outgoing>SF_deleteIn_BP03.07_DeleteRoutine</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_deleteIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP03.07_DeleteRoutine" name="Delete a routine">
      <bpmn:incoming>SF_deleteIn_BP03.07_DeleteRoutine</bpmn:incoming>
      <bpmn:outgoing>SF_BP03.07_DeleteRoutine_End_30</bpmn:outgoing>
      <bpmn:startEvent id="BP03.07_DeleteRoutine_s" name="Start">
        <bpmn:outgoing>SF_BP03.07_DeleteRoutine_s_T_28</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_28" name="Delete confirmed items">
        <bpmn:incoming>SF_BP03.07_DeleteRoutine_s_T_28</bpmn:incoming>
        <bpmn:outgoing>SF_T_28_T_29</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_29" name="Report the outcome">
        <bpmn:incoming>SF_T_28_T_29</bpmn:incoming>
        <bpmn:outgoing>SF_T_29_BP03.07_DeleteRoutine_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP03.07_DeleteRoutine_e" name="fertig">
        <bpmn:incoming>SF_T_29_BP03.07_DeleteRoutine_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_28_T_29" sourceRef="T_28" targetRef="T_29" />
      <bpmn:sequenceFlow id="SF_BP03.07_DeleteRoutine_s_T_28" sourceRef="BP03.07_DeleteRoutine_s" targetRef="T_28" />
      <bpmn:sequenceFlow id="SF_T_29_BP03.07_DeleteRoutine_e" sourceRef="T_29" targetRef="BP03.07_DeleteRoutine_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_30" name="Deletion answered">
      <bpmn:incoming>SF_BP03.07_DeleteRoutine_End_30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_editIn_BP03.02_EditRoutine" sourceRef="editIn" targetRef="BP03.02_EditRoutine" />
    <bpmn:sequenceFlow id="SF_BP03.02_EditRoutine_End_19" sourceRef="BP03.02_EditRoutine" targetRef="End_19" />
    <bpmn:sequenceFlow id="SF_activeIn_BP03.04_SetRoutineActive" sourceRef="activeIn" targetRef="BP03.04_SetRoutineActive" />
    <bpmn:sequenceFlow id="SF_BP03.04_SetRoutineActive_End_22" sourceRef="BP03.04_SetRoutineActive" targetRef="End_22" />
    <bpmn:sequenceFlow id="SF_reorderIn_BP03.05_ReorderRoutines" sourceRef="reorderIn" targetRef="BP03.05_ReorderRoutines" />
    <bpmn:sequenceFlow id="SF_BP03.05_ReorderRoutines_End_25" sourceRef="BP03.05_ReorderRoutines" targetRef="End_25" />
    <bpmn:sequenceFlow id="SF_impactIn_BP03.06_ReadTheDeletionImpact" sourceRef="impactIn" targetRef="BP03.06_ReadTheDeletionImpact" />
    <bpmn:sequenceFlow id="SF_BP03.06_ReadTheDeletionImpact_End_27" sourceRef="BP03.06_ReadTheDeletionImpact" targetRef="End_27" />
    <bpmn:sequenceFlow id="SF_deleteIn_BP03.07_DeleteRoutine" sourceRef="deleteIn" targetRef="BP03.07_DeleteRoutine" />
