    <bpmn:sequenceFlow id="SF_Gw_16_T_17" name="approve" sourceRef="Gw_16" targetRef="T_17" />
    <bpmn:sequenceFlow id="SF_Gw_16_End_19" name="reject" sourceRef="Gw_16" targetRef="End_19" />
    <bpmn:sequenceFlow id="SF_deleted_End_20" sourceRef="deleted" targetRef="End_20" />
