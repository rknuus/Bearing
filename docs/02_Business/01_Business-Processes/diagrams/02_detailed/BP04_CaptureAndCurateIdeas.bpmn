    <bpmn:sequenceFlow id="SF_Gw_3_T_27" name="look at the archived ones" sourceRef="Gw_3" targetRef="T_27" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="editIn" name="Idea submitted">
      <bpmn:outgoing>SF_editIn_BP04.02_EditIdea</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_editIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP04.02_EditIdea" name="Edit an idea">
      <bpmn:incoming>SF_editIn_BP04.02_EditIdea</bpmn:incoming>
      <bpmn:outgoing>SF_BP04.02_EditIdea_End_31</bpmn:outgoing>
      <bpmn:startEvent id="BP04.02_EditIdea_s" name="Start">
        <bpmn:outgoing>SF_BP04.02_EditIdea_s_T_29</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_29" name="Store the edit">
        <bpmn:incoming>SF_BP04.02_EditIdea_s_T_29</bpmn:incoming>
        <bpmn:outgoing>SF_T_29_T_30</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_30" name="Report the outcome">
        <bpmn:incoming>SF_T_29_T_30</bpmn:incoming>
        <bpmn:outgoing>SF_T_30_BP04.02_EditIdea_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP04.02_EditIdea_e" name="fertig">
        <bpmn:incoming>SF_T_30_BP04.02_EditIdea_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_29_T_30" sourceRef="T_29" targetRef="T_30" />
      <bpmn:sequenceFlow id="SF_BP04.02_EditIdea_s_T_29" sourceRef="BP04.02_EditIdea_s" targetRef="T_29" />
      <bpmn:sequenceFlow id="SF_T_30_BP04.02_EditIdea_e" sourceRef="T_30" targetRef="BP04.02_EditIdea_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_31" name="Idea answered">
      <bpmn:incoming>SF_BP04.02_EditIdea_End_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="reorderIn" name="Idea reordering requested">
      <bpmn:outgoing>SF_reorderIn_BP04.05_ReorderIdeas</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_reorderIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP04.05_ReorderIdeas" name="Reorder ideas">
      <bpmn:incoming>SF_reorderIn_BP04.05_ReorderIdeas</bpmn:incoming>
      <bpmn:outgoing>SF_BP04.05_ReorderIdeas_End_34</bpmn:outgoing>
      <bpmn:startEvent id="BP04.05_ReorderIdeas_s" name="Start">
        <bpmn:outgoing>SF_BP04.05_ReorderIdeas_s_T_32</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_32" name="Apply the new order">
