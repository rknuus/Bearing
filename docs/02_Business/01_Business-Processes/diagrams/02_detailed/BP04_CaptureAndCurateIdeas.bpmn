      <bpmn:incoming>SF_Gw_10_End_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_14" name="Idea set aside">
      <bpmn:incoming>SF_archived_End_14</bpmn:incoming>
