    <bpmn:sequenceFlow id="SF_T_12_archived" sourceRef="T_12" targetRef="archived" />
    <bpmn:sequenceFlow id="SF_Gw_10_T_11" name="approve" sourceRef="Gw_10" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_Gw_10_End_13" name="reject" sourceRef="Gw_10" targetRef="End_13" />
    <bpmn:sequenceFlow id="SF_archived_End_14" sourceRef="archived" targetRef="End_14" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_9" name="park one" sourceRef="Gw_3" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_T_15_delImpact" sourceRef="T_15" targetRef="delImpact" />
    <bpmn:sequenceFlow id="SF_delImpact_Gw_16" sourceRef="delImpact" targetRef="Gw_16" />
