    <bpmn:sequenceFlow id="SF_T_25_projectCreated" sourceRef="T_25" targetRef="projectCreated" />
    <bpmn:sequenceFlow id="SF_projectCreated_End_26" sourceRef="projectCreated" targetRef="End_26" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_24" name="start work on one" sourceRef="Gw_3" targetRef="T_24" />
