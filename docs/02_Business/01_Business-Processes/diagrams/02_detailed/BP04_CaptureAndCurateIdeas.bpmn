<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP04_CaptureAndCurateIdeas" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP04_CaptureAndCurateIdeas">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP04.01 · Read the ideation overview" sourceRef="ideationTab" targetRef="overviewIn" />
    <bpmn:messageFlow id="MF_2" name="BP04.02 · Capture an idea" sourceRef="T_3" targetRef="captureIn" />
    <bpmn:messageFlow id="MF_3" name="BP04.03 · Amend an idea" sourceRef="T_4" targetRef="amendIn" />
    <bpmn:messageFlow id="MF_4" name="BP04.04 · Draft the idea input" sourceRef="T_5" targetRef="notesIn" />
    <bpmn:messageFlow id="MF_5" name="BP04.10 · Commit the idea notes" sourceRef="T_6" targetRef="commitNotesIn" />
    <bpmn:messageFlow id="MF_6" name="BP04.05 · Reorder ideas" sourceRef="T_8" targetRef="reorderIn" />
    <bpmn:messageFlow id="MF_7" name="BP04.06 · See what archiving an idea takes" sourceRef="T_9" targetRef="archImpactIn" />
    <bpmn:messageFlow id="MF_8" name="BP04.07 · Archive an idea" sourceRef="T_11" targetRef="archiveIn" />
    <bpmn:messageFlow id="MF_9" name="BP04.08 · See what deleting an idea takes" sourceRef="T_13" targetRef="delImpactIn" />
    <bpmn:messageFlow id="MF_10" name="BP04.09 · Delete an idea" sourceRef="T_15" targetRef="deleteIn" />
    <bpmn:messageFlow id="MF_11" name="Ideas, filtered and sorted" sourceRef="BP04.01_ReadTheIdeationOverview" targetRef="overview" />
    <bpmn:messageFlow id="MF_12" name="Idea captured" sourceRef="BP04.02_CaptureIdea" targetRef="captured" />
    <bpmn:messageFlow id="MF_13" name="Idea amended" sourceRef="BP04.03_AmendIdea" targetRef="amended" />
    <bpmn:messageFlow id="MF_14" name="Notes committed" sourceRef="BP04.10_CommitIdeaNotes" targetRef="notesCommitted" />
    <bpmn:messageFlow id="MF_15" name="Order recorded" sourceRef="BP04.05_ReorderIdeas" targetRef="reordered" />
    <bpmn:messageFlow id="MF_16" name="What the archiving will take" sourceRef="BP04.06_ReadTheArchivingImpact" targetRef="archImpact" />
    <bpmn:messageFlow id="MF_17" name="Idea archived" sourceRef="BP04.07_ArchiveIdea" targetRef="archived" />
    <bpmn:messageFlow id="MF_18" name="What the deletion will take" sourceRef="BP04.08_ReadTheDeletionImpact" targetRef="delImpact" />
    <bpmn:messageFlow id="MF_19" name="Idea deleted" sourceRef="BP04.09_DeleteIdea" targetRef="deleted" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>The notes are kept as a draft while the user writes, one instance per keystroke batch, and the draft survives a crash and a restart.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_5" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>Both are remembered between sessions, so the next read uses them.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_7" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>A theme is optional at capture. A theme-less idea is grouped under Unthemed.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="captured" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>The title and the theme affiliation are one request.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="amended" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>The order groups related ideas. It carries no priority.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="reordered" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>Leaving the editor is the commit. Nothing is in the planning history before it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="notesCommitted" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>Nothing is archived.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="T_12" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>Nothing is deleted.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="T_16" targetRef="TextAnnotation_X8" />
    <bpmn:textAnnotation id="TextAnnotation_X9"><bpmn:text>There is no in-app undo. Recovery is from version control.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X9" associationDirection="None" sourceRef="deleted" targetRef="TextAnnotation_X9" />
    <bpmn:textAnnotation id="TextAnnotation_X10"><bpmn:text>Archived ideas are not in the working view.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X10" associationDirection="None" sourceRef="BP04.01_ReadTheIdeationOverview" targetRef="TextAnnotation_X10" />
    <bpmn:textAnnotation id="TextAnnotation_X11"><bpmn:text>The theme may be absent.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X11" associationDirection="None" sourceRef="BP04.02_CaptureIdea" targetRef="TextAnnotation_X11" />
    <bpmn:textAnnotation id="TextAnnotation_X12"><bpmn:text>An archived idea is not editable.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X12" associationDirection="None" sourceRef="BP04.03_AmendIdea" targetRef="TextAnnotation_X12" />
    <bpmn:textAnnotation id="TextAnnotation_X13"><bpmn:text>Every form on this surface drafts as it is filled in — the capture form, the title and theme, and the notes as they are written. The draft is one-way: nothing waits for it to be kept, it changes nothing on the idea, and whichever write commits the form discards it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X13" associationDirection="None" sourceRef="BP04.04_DraftTheIdeaInput" targetRef="TextAnnotation_X13" />
    <bpmn:textAnnotation id="TextAnnotation_X14"><bpmn:text>Nothing below a project can be left behind, so the gesture is approve-or-abandon.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X14" associationDirection="None" sourceRef="BP04.06_ReadTheArchivingImpact" targetRef="TextAnnotation_X14" />
    <bpmn:textAnnotation id="TextAnnotation_X15"><bpmn:text>Keeping a project behind is not offered. A goal that links the idea survives minus the link.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X15" associationDirection="None" sourceRef="BP04.08_ReadTheDeletionImpact" targetRef="TextAnnotation_X15" />
    <bpmn:textAnnotation id="TextAnnotation_X16"><bpmn:text>The commit is what enters the planning history, and the draft is dropped once it is in.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X16" associationDirection="None" sourceRef="BP04.10_CommitIdeaNotes" targetRef="TextAnnotation_X16" />
    <bpmn:textAnnotation id="TextAnnotation_X17"><bpmn:text>Unarchiving restores the whole bundle.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X17" associationDirection="None" sourceRef="BP04.07_ArchiveIdea" targetRef="TextAnnotation_X17" />
    <bpmn:textAnnotation id="TextAnnotation_X18"><bpmn:text>A goal left with no linked idea is flagged on its current state.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X18" associationDirection="None" sourceRef="BP04.09_DeleteIdea" targetRef="TextAnnotation_X18" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="An idea worth keeping, or a list worth tidying">
      <bpmn:outgoing>SF_Start_1_ideationTab</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="ideationTab" name="Open the Ideation tab">
      <bpmn:incoming>SF_Start_1_ideationTab</bpmn:incoming>
      <bpmn:incoming>SF_T_7_ideationTab</bpmn:incoming>
      <bpmn:incoming>SF_T_12_ideationTab</bpmn:incoming>
      <bpmn:incoming>SF_T_16_ideationTab</bpmn:incoming>
      <bpmn:incoming>SF_Gw_17_ideationTab</bpmn:incoming>
      <bpmn:outgoing>SF_ideationTab_overview</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="overview" name="Ideas, filtered and sorted">
      <bpmn:incoming>SF_ideationTab_overview</bpmn:incoming>
      <bpmn:outgoing>SF_overview_Gw_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_overview" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_2" name="What needs doing?">
      <bpmn:incoming>SF_overview_Gw_2</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_2_T_3</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_5</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_8</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_9</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_3" name="Write the idea down">
      <bpmn:incoming>SF_Gw_2_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_captured</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="captured" name="Idea captured">
      <bpmn:incoming>SF_T_3_captured</bpmn:incoming>
      <bpmn:outgoing>SF_captured_Gw_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_captured" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_4" name="Amend the idea">
      <bpmn:incoming>SF_Gw_2_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_amended</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="amended" name="Idea amended">
      <bpmn:incoming>SF_T_4_amended</bpmn:incoming>
      <bpmn:outgoing>SF_amended_Gw_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_amended" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_5" name="Write into the idea notes">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_Gw_2_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_T_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_6" name="Leave the notes editor">
      <bpmn:incoming>SF_T_5_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_notesCommitted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="notesCommitted" name="Notes committed">
      <bpmn:incoming>SF_T_6_notesCommitted</bpmn:incoming>
      <bpmn:outgoing>SF_notesCommitted_Gw_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_notesCommitted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_7" name="Change the filter or the ordering in force">
      <bpmn:incoming>SF_Gw_2_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_ideationTab</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_8" name="Drag an idea into place">
      <bpmn:incoming>SF_Gw_2_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_reordered</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="reordered" name="Order recorded">
      <bpmn:incoming>SF_T_8_reordered</bpmn:incoming>
      <bpmn:outgoing>SF_reordered_Gw_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_reordered" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_9" name="Choose an idea to archive">
      <bpmn:incoming>SF_Gw_2_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_archImpact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="archImpact" name="What the archiving will take">
      <bpmn:incoming>SF_T_9_archImpact</bpmn:incoming>
      <bpmn:outgoing>SF_archImpact_Gw_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archImpact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_10" name="Approve what the archiving takes?">
      <bpmn:incoming>SF_archImpact_Gw_10</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_10_T_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_10_T_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_11" name="Confirm the archiving">
      <bpmn:incoming>SF_Gw_10_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_archived</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="archived" name="Idea archived">
      <bpmn:incoming>SF_T_11_archived</bpmn:incoming>
      <bpmn:outgoing>SF_archived_Gw_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_12" name="Abandon the archiving">
      <bpmn:incoming>SF_Gw_10_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_ideationTab</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_13" name="Choose an idea to delete">
      <bpmn:incoming>SF_Gw_2_T_13</bpmn:incoming>
      <bpmn:outgoing>SF_T_13_delImpact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="delImpact" name="What the deletion will take">
      <bpmn:incoming>SF_T_13_delImpact</bpmn:incoming>
      <bpmn:outgoing>SF_delImpact_Gw_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_delImpact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_14" name="Approve what the deletion takes?">
      <bpmn:incoming>SF_delImpact_Gw_14</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_14_T_15</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_14_T_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_15" name="Confirm the deletion">
      <bpmn:incoming>SF_Gw_14_T_15</bpmn:incoming>
      <bpmn:outgoing>SF_T_15_deleted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="deleted" name="Idea deleted">
      <bpmn:incoming>SF_T_15_deleted</bpmn:incoming>
      <bpmn:outgoing>SF_deleted_Gw_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_deleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_16" name="Abandon the deletion">
      <bpmn:incoming>SF_Gw_14_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_ideationTab</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_17" name="Anything else on this tab?">
      <bpmn:incoming>SF_captured_Gw_17</bpmn:incoming>
      <bpmn:incoming>SF_amended_Gw_17</bpmn:incoming>
      <bpmn:incoming>SF_notesCommitted_Gw_17</bpmn:incoming>
      <bpmn:incoming>SF_reordered_Gw_17</bpmn:incoming>
      <bpmn:incoming>SF_archived_Gw_17</bpmn:incoming>
      <bpmn:incoming>SF_deleted_Gw_17</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_17_T_18</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_17_ideationTab</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_18" name="Leave the tab">
      <bpmn:incoming>SF_Gw_17_T_18</bpmn:incoming>
      <bpmn:outgoing>SF_T_18_End_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_19" name="Ideation current">
      <bpmn:incoming>SF_T_18_End_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_ideationTab" sourceRef="Start_1" targetRef="ideationTab" />
    <bpmn:sequenceFlow id="SF_ideationTab_overview" sourceRef="ideationTab" targetRef="overview" />
    <bpmn:sequenceFlow id="SF_overview_Gw_2" sourceRef="overview" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="SF_T_3_captured" sourceRef="T_3" targetRef="captured" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_3" name="capture something new" sourceRef="Gw_2" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_T_4_amended" sourceRef="T_4" targetRef="amended" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_4" name="change one" sourceRef="Gw_2" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_5_T_6" sourceRef="T_5" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_T_6_notesCommitted" sourceRef="T_6" targetRef="notesCommitted" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_5" name="think it through" sourceRef="Gw_2" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_7" name="narrow or reorder the list" sourceRef="Gw_2" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_T_8_reordered" sourceRef="T_8" targetRef="reordered" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_8" name="group related ones together" sourceRef="Gw_2" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_T_9_archImpact" sourceRef="T_9" targetRef="archImpact" />
    <bpmn:sequenceFlow id="SF_archImpact_Gw_10" sourceRef="archImpact" targetRef="Gw_10" />
    <bpmn:sequenceFlow id="SF_T_11_archived" sourceRef="T_11" targetRef="archived" />
    <bpmn:sequenceFlow id="SF_Gw_10_T_11" name="approve" sourceRef="Gw_10" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_Gw_10_T_12" name="abandon" sourceRef="Gw_10" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_9" name="park one" sourceRef="Gw_2" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_T_13_delImpact" sourceRef="T_13" targetRef="delImpact" />
    <bpmn:sequenceFlow id="SF_delImpact_Gw_14" sourceRef="delImpact" targetRef="Gw_14" />
    <bpmn:sequenceFlow id="SF_T_15_deleted" sourceRef="T_15" targetRef="deleted" />
    <bpmn:sequenceFlow id="SF_Gw_14_T_15" name="approve" sourceRef="Gw_14" targetRef="T_15" />
    <bpmn:sequenceFlow id="SF_Gw_14_T_16" name="abandon" sourceRef="Gw_14" targetRef="T_16" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_13" name="drop one for good" sourceRef="Gw_2" targetRef="T_13" />
    <bpmn:sequenceFlow id="SF_captured_Gw_17" sourceRef="captured" targetRef="Gw_17" />
    <bpmn:sequenceFlow id="SF_amended_Gw_17" sourceRef="amended" targetRef="Gw_17" />
    <bpmn:sequenceFlow id="SF_notesCommitted_Gw_17" sourceRef="notesCommitted" targetRef="Gw_17" />
    <bpmn:sequenceFlow id="SF_reordered_Gw_17" sourceRef="reordered" targetRef="Gw_17" />
    <bpmn:sequenceFlow id="SF_archived_Gw_17" sourceRef="archived" targetRef="Gw_17" />
    <bpmn:sequenceFlow id="SF_deleted_Gw_17" sourceRef="deleted" targetRef="Gw_17" />
    <bpmn:sequenceFlow id="SF_Gw_17_T_18" name="no" sourceRef="Gw_17" targetRef="T_18" />
    <bpmn:sequenceFlow id="SF_T_18_End_19" sourceRef="T_18" targetRef="End_19" />
    <bpmn:sequenceFlow id="SF_T_7_ideationTab" sourceRef="T_7" targetRef="ideationTab" />
    <bpmn:sequenceFlow id="SF_T_12_ideationTab" sourceRef="T_12" targetRef="ideationTab" />
    <bpmn:sequenceFlow id="SF_T_16_ideationTab" sourceRef="T_16" targetRef="ideationTab" />
    <bpmn:sequenceFlow id="SF_Gw_17_ideationTab" name="yes" sourceRef="Gw_17" targetRef="ideationTab" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="overviewIn" name="Ideation overview requested">
      <bpmn:outgoing>SF_overviewIn_BP04.01_ReadTheIdeationOverview</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_overviewIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP04.01_ReadTheIdeationOverview" name="Read the ideation overview">
      <bpmn:incoming>SF_overviewIn_BP04.01_ReadTheIdeationOverview</bpmn:incoming>
      <bpmn:outgoing>SF_BP04.01_ReadTheIdeationOverview_End_23</bpmn:outgoing>
      <bpmn:startEvent id="BP04.01_ReadTheIdeationOverview_s" name="Start">
        <bpmn:outgoing>SF_BP04.01_ReadTheIdeationOverview_s_T_20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_20" name="Read the ideas the filter admits">
        <bpmn:incoming>SF_BP04.01_ReadTheIdeationOverview_s_T_20</bpmn:incoming>
        <bpmn:outgoing>SF_T_20_T_21</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_21" name="Apply the ordering in force">
        <bpmn:incoming>SF_T_20_T_21</bpmn:incoming>
        <bpmn:outgoing>SF_T_21_T_22</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_22" name="Group the theme-less ideas as Unthemed">
