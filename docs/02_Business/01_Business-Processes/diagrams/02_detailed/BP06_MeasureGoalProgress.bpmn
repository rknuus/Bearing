<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP06_MeasureGoalProgress" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP06_MeasureGoalProgress">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP06.08 · Read the goal's progress measures" sourceRef="goalOpen" targetRef="measuresIn" />
    <bpmn:messageFlow id="MF_2" name="BP06.09 · Draft the measure input" sourceRef="T_5" targetRef="measureDraftIn" />
    <bpmn:messageFlow id="MF_3" name="BP06.03 · Add a progress measure" sourceRef="T_6" targetRef="addIn" />
    <bpmn:messageFlow id="MF_4" name="BP06.04 · Amend a progress measure" sourceRef="T_7" targetRef="amendIn" />
    <bpmn:messageFlow id="MF_5" name="BP06.05 · Reorder progress measures" sourceRef="T_8" targetRef="reorderIn" />
    <bpmn:messageFlow id="MF_6" name="BP06.06 · See what removing a measure takes" sourceRef="T_9" targetRef="impactIn" />
    <bpmn:messageFlow id="MF_7" name="BP06.07 · Remove a progress measure" sourceRef="T_11" targetRef="removeIn" />
    <bpmn:messageFlow id="MF_8" name="BP06.01 · Read a measure's check-in history" sourceRef="T_13" targetRef="historyIn" />
    <bpmn:messageFlow id="MF_9" name="BP06.02 · Record a progress check-in" sourceRef="T_15" targetRef="checkInIn" />
    <bpmn:messageFlow id="MF_10" name="The measures with their types and targets" sourceRef="BP06.08_ReadAGoalsProgressMeasures" targetRef="measures" />
    <bpmn:messageFlow id="MF_11" name="The measure's check-ins over time" sourceRef="BP06.01_ReadTheCheckInHistory" targetRef="history" />
    <bpmn:messageFlow id="MF_12" name="Check-in recorded" sourceRef="BP06.02_RecordProgressCheckIn" targetRef="recorded" />
    <bpmn:messageFlow id="MF_13" name="Measure added" sourceRef="BP06.03_AddProgressMeasure" targetRef="added" />
    <bpmn:messageFlow id="MF_14" name="Measure amended" sourceRef="BP06.04_AmendProgressMeasure" targetRef="amended" />
    <bpmn:messageFlow id="MF_15" name="Order recorded" sourceRef="BP06.05_ReorderProgressMeasures" targetRef="reordered" />
    <bpmn:messageFlow id="MF_16" name="What the removal will take" sourceRef="BP06.06_ReadTheMeasureRemovalImpact" targetRef="impact" />
    <bpmn:messageFlow id="MF_17" name="Measure removed" sourceRef="BP06.07_RemoveProgressMeasure" targetRef="removed" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>The type is amendable like the target and the unit, and the recorded check-ins are left as they stand.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="amended" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>The check-in history hangs on the measure's identity, never on its position.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="reordered" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>Numeric carries a target, a unit and a direction. Boolean carries done and not done.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="added" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>Nothing is removed.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="T_12" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>Numeric takes the value reached. Boolean takes done and not done. A note is optional either way.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="recorded" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>An archived goal is frozen, its measures and their check-ins included. Unarchiving it is what makes any of this possible again.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="T_3" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>Every form on this surface drafts as it is filled in, so leaving it half-finished, a crash and a restart all cost nothing. The draft is one-way: nothing waits for it to be kept. Whichever write commits the form discards it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="BP06.09_DraftTheMeasureInput" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>The history hangs on the measure's identity, so reordering the measures never disturbs it. The goal is known to be live by now: the freeze is answered at the entry.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="BP06.01_ReadTheCheckInHistory" targetRef="TextAnnotation_X8" />
    <bpmn:textAnnotation id="TextAnnotation_X9"><bpmn:text>The type is amendable like the target and the unit. Each check-in keeps the type it was recorded under, so the history is never rewritten.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X9" associationDirection="None" sourceRef="BP06.04_AmendProgressMeasure" targetRef="TextAnnotation_X9" />
    <bpmn:textAnnotation id="TextAnnotation_X10"><bpmn:text>The check-in history goes unasked. The projects are a cascade the user approves or abandons.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X10" associationDirection="None" sourceRef="BP06.06_ReadTheMeasureRemovalImpact" targetRef="TextAnnotation_X10" />
    <bpmn:textAnnotation id="TextAnnotation_X11"><bpmn:text>There is no untyped measure.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X11" associationDirection="None" sourceRef="BP06.03_AddProgressMeasure" targetRef="TextAnnotation_X11" />
    <bpmn:textAnnotation id="TextAnnotation_X12"><bpmn:text>The history is append-only, so a date that already carries a check-in takes another and each is its own data point. A check-in records a data point and infers no status.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X12" associationDirection="None" sourceRef="BP06.02_RecordProgressCheckIn" targetRef="TextAnnotation_X12" />
    <bpmn:textAnnotation id="TextAnnotation_X13"><bpmn:text>The goals overview carries no measures, so this is where they are read. An archived goal is reported as such, and nothing here can change while it is.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X13" associationDirection="None" sourceRef="BP06.08_ReadAGoalsProgressMeasures" targetRef="TextAnnotation_X13" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A commitment to measure, or progress to record">
      <bpmn:outgoing>SF_Start_1_goalOpen</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="goalOpen" name="Open a goal's progress measures">
      <bpmn:incoming>SF_Start_1_goalOpen</bpmn:incoming>
      <bpmn:incoming>SF_T_12_goalOpen</bpmn:incoming>
      <bpmn:incoming>SF_Gw_17_goalOpen</bpmn:incoming>
      <bpmn:outgoing>SF_goalOpen_measures</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="measures" name="The measures with their types and targets">
      <bpmn:incoming>SF_goalOpen_measures</bpmn:incoming>
      <bpmn:outgoing>SF_measures_Gw_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_measures" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_2" name="Is the goal archived?">
      <bpmn:incoming>SF_measures_Gw_2</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_2_T_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_3" name="Read why nothing here can change">
      <bpmn:incoming>SF_Gw_2_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_leaving</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_4" name="What needs doing?">
      <bpmn:outgoing>SF_Gw_4_T_5</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_4_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_4_T_8</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_4_T_9</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_4_T_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_5" name="Type the measure and set its target">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_Gw_4_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_T_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_6" name="Submit the measure">
      <bpmn:incoming>SF_T_5_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_added</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="added" name="Measure added">
      <bpmn:incoming>SF_T_6_added</bpmn:incoming>
      <bpmn:outgoing>SF_added_leaving</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_added" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_7" name="Amend the measure">
      <bpmn:incoming>SF_Gw_4_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_amended</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="amended" name="Measure amended">
      <bpmn:incoming>SF_T_7_amended</bpmn:incoming>
      <bpmn:outgoing>SF_amended_leaving</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_amended" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_8" name="Drag a measure into place">
      <bpmn:incoming>SF_Gw_4_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_reordered</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="reordered" name="Order recorded">
      <bpmn:incoming>SF_T_8_reordered</bpmn:incoming>
      <bpmn:outgoing>SF_reordered_leaving</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_reordered" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_9" name="Choose a measure to remove">
      <bpmn:incoming>SF_Gw_4_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_impact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="impact" name="What the removal will take">
      <bpmn:incoming>SF_T_9_impact</bpmn:incoming>
      <bpmn:outgoing>SF_impact_Gw_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_impact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_10" name="Approve what the removal takes?">
      <bpmn:incoming>SF_impact_Gw_10</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_10_T_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_10_T_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_11" name="Confirm the removal">
      <bpmn:incoming>SF_Gw_10_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_removed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="removed" name="Measure removed">
      <bpmn:incoming>SF_T_11_removed</bpmn:incoming>
      <bpmn:outgoing>SF_removed_leaving</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_removed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_12" name="Abandon the removal">
      <bpmn:incoming>SF_Gw_10_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_goalOpen</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_13" name="Open a progress measure">
      <bpmn:incoming>SF_Gw_4_T_13</bpmn:incoming>
      <bpmn:outgoing>SF_T_13_history</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="history" name="The measure's check-ins over time">
      <bpmn:incoming>SF_T_13_history</bpmn:incoming>
      <bpmn:outgoing>SF_history_Gw_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_history" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_14" name="Anything to record?">
      <bpmn:incoming>SF_history_Gw_14</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_14_T_15</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_14_T_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_15" name="State the value reached">
      <bpmn:incoming>SF_Gw_14_T_15</bpmn:incoming>
      <bpmn:outgoing>SF_T_15_recorded</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="recorded" name="Check-in recorded">
      <bpmn:incoming>SF_T_15_recorded</bpmn:incoming>
      <bpmn:outgoing>SF_recorded_leaving</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_recorded" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_16" name="Read the trend and leave it">
      <bpmn:incoming>SF_Gw_14_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_leaving</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="leaving" name="Take stock">
      <bpmn:incoming>SF_added_leaving</bpmn:incoming>
      <bpmn:incoming>SF_amended_leaving</bpmn:incoming>
      <bpmn:incoming>SF_reordered_leaving</bpmn:incoming>
      <bpmn:incoming>SF_removed_leaving</bpmn:incoming>
      <bpmn:incoming>SF_recorded_leaving</bpmn:incoming>
      <bpmn:incoming>SF_T_16_leaving</bpmn:incoming>
      <bpmn:incoming>SF_T_3_leaving</bpmn:incoming>
      <bpmn:outgoing>SF_leaving_Gw_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_17" name="Anything else on this goal?">
      <bpmn:incoming>SF_leaving_Gw_17</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_17_T_18</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_17_goalOpen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_18" name="Leave the goal">
      <bpmn:incoming>SF_Gw_17_T_18</bpmn:incoming>
      <bpmn:outgoing>SF_T_18_End_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_19" name="Progress measured">
      <bpmn:incoming>SF_T_18_End_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_goalOpen" sourceRef="Start_1" targetRef="goalOpen" />
    <bpmn:sequenceFlow id="SF_goalOpen_measures" sourceRef="goalOpen" targetRef="measures" />
    <bpmn:sequenceFlow id="SF_measures_Gw_2" sourceRef="measures" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_3" name="archived" sourceRef="Gw_2" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_T_5_T_6" sourceRef="T_5" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_T_6_added" sourceRef="T_6" targetRef="added" />
    <bpmn:sequenceFlow id="SF_Gw_4_T_5" name="say what counts" sourceRef="Gw_4" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_7_amended" sourceRef="T_7" targetRef="amended" />
    <bpmn:sequenceFlow id="SF_Gw_4_T_7" name="change what counts" sourceRef="Gw_4" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_T_8_reordered" sourceRef="T_8" targetRef="reordered" />
    <bpmn:sequenceFlow id="SF_Gw_4_T_8" name="reorder them" sourceRef="Gw_4" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_T_9_impact" sourceRef="T_9" targetRef="impact" />
    <bpmn:sequenceFlow id="SF_impact_Gw_10" sourceRef="impact" targetRef="Gw_10" />
    <bpmn:sequenceFlow id="SF_T_11_removed" sourceRef="T_11" targetRef="removed" />
    <bpmn:sequenceFlow id="SF_Gw_10_T_11" name="approve" sourceRef="Gw_10" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_Gw_10_T_12" name="abandon" sourceRef="Gw_10" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_Gw_4_T_9" name="drop one" sourceRef="Gw_4" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_T_13_history" sourceRef="T_13" targetRef="history" />
    <bpmn:sequenceFlow id="SF_history_Gw_14" sourceRef="history" targetRef="Gw_14" />
    <bpmn:sequenceFlow id="SF_T_15_recorded" sourceRef="T_15" targetRef="recorded" />
    <bpmn:sequenceFlow id="SF_Gw_14_T_15" name="yes" sourceRef="Gw_14" targetRef="T_15" />
    <bpmn:sequenceFlow id="SF_Gw_14_T_16" name="no" sourceRef="Gw_14" targetRef="T_16" />
    <bpmn:sequenceFlow id="SF_Gw_4_T_13" name="record where one stands" sourceRef="Gw_4" targetRef="T_13" />
    <bpmn:sequenceFlow id="SF_added_leaving" sourceRef="added" targetRef="leaving" />
    <bpmn:sequenceFlow id="SF_amended_leaving" sourceRef="amended" targetRef="leaving" />
    <bpmn:sequenceFlow id="SF_reordered_leaving" sourceRef="reordered" targetRef="leaving" />
    <bpmn:sequenceFlow id="SF_removed_leaving" sourceRef="removed" targetRef="leaving" />
    <bpmn:sequenceFlow id="SF_recorded_leaving" sourceRef="recorded" targetRef="leaving" />
    <bpmn:sequenceFlow id="SF_T_16_leaving" sourceRef="T_16" targetRef="leaving" />
    <bpmn:sequenceFlow id="SF_leaving_Gw_17" sourceRef="leaving" targetRef="Gw_17" />
    <bpmn:sequenceFlow id="SF_Gw_17_T_18" name="no" sourceRef="Gw_17" targetRef="T_18" />
    <bpmn:sequenceFlow id="SF_T_18_End_19" sourceRef="T_18" targetRef="End_19" />
    <bpmn:sequenceFlow id="SF_T_3_leaving" sourceRef="T_3" targetRef="leaving" />
    <bpmn:sequenceFlow id="SF_T_12_goalOpen" sourceRef="T_12" targetRef="goalOpen" />
    <bpmn:sequenceFlow id="SF_Gw_17_goalOpen" name="yes" sourceRef="Gw_17" targetRef="goalOpen" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="measureDraftIn" name="Measure draft submitted">
      <bpmn:outgoing>SF_measureDraftIn_BP06.09_DraftTheMeasureInput</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_measureDraftIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP06.09_DraftTheMeasureInput" name="Draft the measure input">
      <bpmn:incoming>SF_measureDraftIn_BP06.09_DraftTheMeasureInput</bpmn:incoming>
      <bpmn:outgoing>SF_BP06.09_DraftTheMeasureInput_End_21</bpmn:outgoing>
      <bpmn:startEvent id="BP06.09_DraftTheMeasureInput_s" name="Start">
        <bpmn:outgoing>SF_BP06.09_DraftTheMeasureInput_s_T_20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_20" name="Keep what is typed as a draft">
        <bpmn:incoming>SF_BP06.09_DraftTheMeasureInput_s_T_20</bpmn:incoming>
        <bpmn:outgoing>SF_T_20_BP06.09_DraftTheMeasureInput_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP06.09_DraftTheMeasureInput_e" name="fertig">
        <bpmn:incoming>SF_T_20_BP06.09_DraftTheMeasureInput_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_BP06.09_DraftTheMeasureInput_s_T_20" sourceRef="BP06.09_DraftTheMeasureInput_s" targetRef="T_20" />
      <bpmn:sequenceFlow id="SF_T_20_BP06.09_DraftTheMeasureInput_e" sourceRef="T_20" targetRef="BP06.09_DraftTheMeasureInput_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_21" name="Draft kept">
      <bpmn:incoming>SF_BP06.09_DraftTheMeasureInput_End_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="measuresIn" name="Measure list requested">
      <bpmn:outgoing>SF_measuresIn_BP06.08_ReadAGoalsProgressMeasures</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_measuresIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP06.08_ReadAGoalsProgressMeasures" name="Read the goal's progress measures">
      <bpmn:incoming>SF_measuresIn_BP06.08_ReadAGoalsProgressMeasures</bpmn:incoming>
      <bpmn:outgoing>SF_BP06.08_ReadAGoalsProgressMeasures_End_25</bpmn:outgoing>
      <bpmn:startEvent id="BP06.08_ReadAGoalsProgressMeasures_s" name="Start">
        <bpmn:outgoing>SF_BP06.08_ReadAGoalsProgressMeasures_s_T_22</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_22" name="Read the goal's measures in their recorded order">
        <bpmn:incoming>SF_BP06.08_ReadAGoalsProgressMeasures_s_T_22</bpmn:incoming>
        <bpmn:outgoing>SF_T_22_T_23</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_23" name="Read each measure's type, target and latest check-in">
        <bpmn:incoming>SF_T_22_T_23</bpmn:incoming>
        <bpmn:outgoing>SF_T_23_T_24</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_24" name="Report whether the goal is archived">
        <bpmn:incoming>SF_T_23_T_24</bpmn:incoming>
        <bpmn:outgoing>SF_T_24_BP06.08_ReadAGoalsProgressMeasures_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP06.08_ReadAGoalsProgressMeasures_e" name="fertig">
        <bpmn:incoming>SF_T_24_BP06.08_ReadAGoalsProgressMeasures_e</bpmn:incoming>
      </bpmn:endEvent>
