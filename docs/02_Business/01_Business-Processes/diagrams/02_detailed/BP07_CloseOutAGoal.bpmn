<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP07_CloseOutAGoal" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP07_CloseOutAGoal">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP07.01 · Read the goal's check-out proposal" sourceRef="checkOut" targetRef="proposalIn" />
    <bpmn:messageFlow id="MF_2" name="BP07.02 · Draft the goal check-out" sourceRef="T_9" targetRef="draftIn" />
    <bpmn:messageFlow id="MF_3" name="BP07.03 · See what archiving the goal takes" sourceRef="T_11" targetRef="archImpactIn" />
    <bpmn:messageFlow id="MF_4" name="BP07.04 · Close out the goal" sourceRef="closing" targetRef="closeIn" />
    <bpmn:messageFlow id="MF_5" name="BP07.05 · Seed a follow-up goal" sourceRef="T_18" targetRef="seedIn" />
    <bpmn:messageFlow id="MF_6" name="BP07.06 · Create the follow-up goal" sourceRef="T_20" targetRef="followUpIn" />
    <bpmn:messageFlow id="MF_7" name="The proposal with a status per measure" sourceRef="BP07.01_ReadTheCheckOutProposal" targetRef="proposal" />
    <bpmn:messageFlow id="MF_8" name="Draft kept" sourceRef="BP07.02_DraftTheGoalCheckOut" targetRef="draftKept" />
    <bpmn:messageFlow id="MF_9" name="What the archiving will take" sourceRef="BP07.03_ReadTheArchivingImpact" targetRef="archImpact" />
    <bpmn:messageFlow id="MF_10" name="Goal checked out" sourceRef="BP07.04_CloseOutGoal" targetRef="closed" />
    <bpmn:messageFlow id="MF_11" name="The seeded follow-up for review" sourceRef="BP07.05_SeedFollowUpGoal" targetRef="seeded" />
    <bpmn:messageFlow id="MF_12" name="Follow-up goal created" sourceRef="BP07.06_CreateFollowUpGoal" targetRef="followUp" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>An archived goal is frozen. Bringing it back is what makes a judgment possible again, and a check-out record it already carries is untouched meanwhile.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_3" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>Achieved, partially achieved, missed or abandoned. The outcome is required; everything else in the sitting is optional.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_5" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>Any inferred status can be overridden, a boolean measure set to Partial included. The rule constrains the inference, never the judgment.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="T_7" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>The sitting is kept as a draft while it is filled in, so leaving it, a crash and a restart cost nothing.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="draftKept" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>An archived goal still exists, so its projects are not orphaned by it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="T_14" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>The check-out completes either way. A goal left active can be archived directly later.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="T_15" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>Abandoning the follow-up still leaves the check-out complete.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="T_21" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>The proposal is what the system observed: the statuses are inferred, not decided. A check-out is available at any time, with or without a horizon, as long as the goal is not archived.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="BP07.01_ReadTheCheckOutProposal" targetRef="TextAnnotation_X8" />
    <bpmn:textAnnotation id="TextAnnotation_X9"><bpmn:text>A draft is not a commit. Nothing it describes takes effect until the check-out is completed.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X9" associationDirection="None" sourceRef="BP07.02_DraftTheGoalCheckOut" targetRef="TextAnnotation_X9" />
    <bpmn:textAnnotation id="TextAnnotation_X10"><bpmn:text>Cascade, the goal alone, or reject. The keep answer is legal here because an archived goal still exists.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X10" associationDirection="None" sourceRef="BP07.03_ReadTheArchivingImpact" targetRef="TextAnnotation_X10" />
    <bpmn:textAnnotation id="TextAnnotation_X11"><bpmn:text>The check-out record stays attached to the goal, archived or not, and unarchiving never revokes it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X11" associationDirection="None" sourceRef="BP07.04_CloseOutGoal" targetRef="TextAnnotation_X11" />
    <bpmn:textAnnotation id="TextAnnotation_X12"><bpmn:text>Check-out notes are dropped. A goal that was open-ended stays open-ended. The seed is reviewed before anything is created.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X12" associationDirection="None" sourceRef="BP07.05_SeedFollowUpGoal" targetRef="TextAnnotation_X12" />
    <bpmn:textAnnotation id="TextAnnotation_X13"><bpmn:text>The iteration chain stays traceable from the follow-up back to the check-out.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X13" associationDirection="None" sourceRef="BP07.06_CreateFollowUpGoal" targetRef="TextAnnotation_X13" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A cycle ending, or a commitment to settle">
      <bpmn:outgoing>SF_Start_1_checkOut</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="checkOut" name="Open a goal's check-out">
      <bpmn:incoming>SF_Start_1_checkOut</bpmn:incoming>
      <bpmn:outgoing>SF_checkOut_proposal</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="proposal" name="The proposal with a status per measure">
      <bpmn:incoming>SF_checkOut_proposal</bpmn:incoming>
      <bpmn:outgoing>SF_proposal_Gw_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_proposal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_2" name="Is the goal archived?">
      <bpmn:incoming>SF_proposal_Gw_2</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_2_T_3</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_3" name="Read why it cannot be checked out">
      <bpmn:incoming>SF_Gw_2_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_End_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_4" name="Nothing to settle">
      <bpmn:incoming>SF_T_3_End_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_5" name="Rate the overall outcome">
      <bpmn:incoming>SF_Gw_2_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_Gw_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_6" name="Accept the inferred statuses?">
      <bpmn:incoming>SF_T_5_Gw_6</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_6_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_6_T_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_7" name="Set a status by hand">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_Gw_6_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_T_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_8" name="Keep what was inferred">
      <bpmn:incoming>SF_Gw_6_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_T_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_9" name="Write the retro and the per-measure notes">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_T_7_T_9</bpmn:incoming>
      <bpmn:incoming>SF_T_8_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_draftKept</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="draftKept" name="Draft kept">
      <bpmn:incoming>SF_T_9_draftKept</bpmn:incoming>
      <bpmn:outgoing>SF_draftKept_Gw_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_draftKept" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_10" name="Archive the goal as this closes?">
      <bpmn:incoming>SF_draftKept_Gw_10</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_10_T_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_10_T_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_11" name="Choose an archiving reach">
      <bpmn:incoming>SF_Gw_10_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_archImpact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="archImpact" name="What the archiving will take">
      <bpmn:incoming>SF_T_11_archImpact</bpmn:incoming>
      <bpmn:outgoing>SF_archImpact_Gw_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archImpact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_12" name="How far should the archiving reach?">
      <bpmn:incoming>SF_archImpact_Gw_12</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_12_T_13</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_12_T_14</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_12_T_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_13" name="Approve the whole cascade">
      <bpmn:incoming>SF_Gw_12_T_13</bpmn:incoming>
      <bpmn:outgoing>SF_T_13_closing</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_14" name="Keep the projects active">
      <bpmn:incoming>SF_Gw_12_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_closing</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_15" name="Withdraw the archiving">
      <bpmn:incoming>SF_Gw_12_T_15</bpmn:incoming>
      <bpmn:outgoing>SF_T_15_closing</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_16" name="Turn the archive action off">
      <bpmn:incoming>SF_Gw_10_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_closing</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="closing" name="Complete the check-out">
      <bpmn:incoming>SF_T_13_closing</bpmn:incoming>
      <bpmn:incoming>SF_T_14_closing</bpmn:incoming>
      <bpmn:incoming>SF_T_15_closing</bpmn:incoming>
      <bpmn:incoming>SF_T_16_closing</bpmn:incoming>
      <bpmn:outgoing>SF_closing_closed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="closed" name="Goal checked out">
      <bpmn:incoming>SF_closing_closed</bpmn:incoming>
      <bpmn:outgoing>SF_closed_Gw_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_closed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_17" name="Carry the commitment forward?">
      <bpmn:incoming>SF_closed_Gw_17</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_17_T_18</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_17_T_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_18" name="Ask for a follow-up">
      <bpmn:incoming>SF_Gw_17_T_18</bpmn:incoming>
      <bpmn:outgoing>SF_T_18_seeded</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="seeded" name="The seeded follow-up for review">
      <bpmn:incoming>SF_T_18_seeded</bpmn:incoming>
      <bpmn:outgoing>SF_seeded_review</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_seeded" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="review" name="Review the follow-up">
      <bpmn:incoming>SF_seeded_review</bpmn:incoming>
      <bpmn:outgoing>SF_review_Gw_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_19" name="Commit the follow-up?">
      <bpmn:incoming>SF_review_Gw_19</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_19_T_20</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_19_T_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_20" name="Commit the follow-up goal">
      <bpmn:incoming>SF_Gw_19_T_20</bpmn:incoming>
      <bpmn:outgoing>SF_T_20_followUp</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="followUp" name="Follow-up goal created">
      <bpmn:incoming>SF_T_20_followUp</bpmn:incoming>
      <bpmn:outgoing>SF_followUp_End_23</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_followUp" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_21" name="Abandon the follow-up">
      <bpmn:incoming>SF_Gw_19_T_21</bpmn:incoming>
      <bpmn:outgoing>SF_T_21_End_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_22" name="Leave the commitment without a successor">
      <bpmn:incoming>SF_Gw_17_T_22</bpmn:incoming>
      <bpmn:outgoing>SF_T_22_End_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_23" name="Commitment settled">
      <bpmn:incoming>SF_followUp_End_23</bpmn:incoming>
      <bpmn:incoming>SF_T_21_End_23</bpmn:incoming>
      <bpmn:incoming>SF_T_22_End_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_checkOut" sourceRef="Start_1" targetRef="checkOut" />
    <bpmn:sequenceFlow id="SF_checkOut_proposal" sourceRef="checkOut" targetRef="proposal" />
    <bpmn:sequenceFlow id="SF_proposal_Gw_2" sourceRef="proposal" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="SF_T_3_End_4" sourceRef="T_3" targetRef="End_4" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_3" name="archived" sourceRef="Gw_2" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_5" name="live" sourceRef="Gw_2" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_5_Gw_6" sourceRef="T_5" targetRef="Gw_6" />
    <bpmn:sequenceFlow id="SF_Gw_6_T_7" name="override one" sourceRef="Gw_6" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_Gw_6_T_8" name="take them as they are" sourceRef="Gw_6" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_T_7_T_9" sourceRef="T_7" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_T_8_T_9" sourceRef="T_8" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_T_9_draftKept" sourceRef="T_9" targetRef="draftKept" />
    <bpmn:sequenceFlow id="SF_draftKept_Gw_10" sourceRef="draftKept" targetRef="Gw_10" />
    <bpmn:sequenceFlow id="SF_T_11_archImpact" sourceRef="T_11" targetRef="archImpact" />
    <bpmn:sequenceFlow id="SF_archImpact_Gw_12" sourceRef="archImpact" targetRef="Gw_12" />
    <bpmn:sequenceFlow id="SF_Gw_12_T_13" name="the goal and its projects" sourceRef="Gw_12" targetRef="T_13" />
    <bpmn:sequenceFlow id="SF_Gw_12_T_14" name="the goal alone" sourceRef="Gw_12" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_Gw_12_T_15" name="reject the archiving" sourceRef="Gw_12" targetRef="T_15" />
    <bpmn:sequenceFlow id="SF_Gw_10_T_11" name="yes, the default" sourceRef="Gw_10" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_Gw_10_T_16" name="no, leave it active" sourceRef="Gw_10" targetRef="T_16" />
    <bpmn:sequenceFlow id="SF_T_13_closing" sourceRef="T_13" targetRef="closing" />
    <bpmn:sequenceFlow id="SF_T_14_closing" sourceRef="T_14" targetRef="closing" />
    <bpmn:sequenceFlow id="SF_T_15_closing" sourceRef="T_15" targetRef="closing" />
    <bpmn:sequenceFlow id="SF_T_16_closing" sourceRef="T_16" targetRef="closing" />
    <bpmn:sequenceFlow id="SF_closing_closed" sourceRef="closing" targetRef="closed" />
    <bpmn:sequenceFlow id="SF_closed_Gw_17" sourceRef="closed" targetRef="Gw_17" />
    <bpmn:sequenceFlow id="SF_T_18_seeded" sourceRef="T_18" targetRef="seeded" />
    <bpmn:sequenceFlow id="SF_seeded_review" sourceRef="seeded" targetRef="review" />
    <bpmn:sequenceFlow id="SF_review_Gw_19" sourceRef="review" targetRef="Gw_19" />
    <bpmn:sequenceFlow id="SF_T_20_followUp" sourceRef="T_20" targetRef="followUp" />
    <bpmn:sequenceFlow id="SF_Gw_19_T_20" name="commit it" sourceRef="Gw_19" targetRef="T_20" />
    <bpmn:sequenceFlow id="SF_Gw_19_T_21" name="abandon it" sourceRef="Gw_19" targetRef="T_21" />
    <bpmn:sequenceFlow id="SF_Gw_17_T_18" name="yes" sourceRef="Gw_17" targetRef="T_18" />
    <bpmn:sequenceFlow id="SF_Gw_17_T_22" name="no, end it here" sourceRef="Gw_17" targetRef="T_22" />
    <bpmn:sequenceFlow id="SF_followUp_End_23" sourceRef="followUp" targetRef="End_23" />
    <bpmn:sequenceFlow id="SF_T_21_End_23" sourceRef="T_21" targetRef="End_23" />
    <bpmn:sequenceFlow id="SF_T_22_End_23" sourceRef="T_22" targetRef="End_23" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="proposalIn" name="Check-out proposal requested">
      <bpmn:outgoing>SF_proposalIn_BP07.01_ReadTheCheckOutProposal</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_proposalIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP07.01_ReadTheCheckOutProposal" name="Read the goal's check-out proposal">
      <bpmn:incoming>SF_proposalIn_BP07.01_ReadTheCheckOutProposal</bpmn:incoming>
      <bpmn:outgoing>SF_BP07.01_ReadTheCheckOutProposal_End_29</bpmn:outgoing>
      <bpmn:startEvent id="BP07.01_ReadTheCheckOutProposal_s" name="Start">
        <bpmn:outgoing>SF_BP07.01_ReadTheCheckOutProposal_s_T_24</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_24" name="Read the goal with its measures and their latest check-ins">
        <bpmn:incoming>SF_BP07.01_ReadTheCheckOutProposal_s_T_24</bpmn:incoming>
        <bpmn:outgoing>SF_T_24_T_25</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_25" name="Infer a status per measure from its type">
        <bpmn:incoming>SF_T_24_T_25</bpmn:incoming>
        <bpmn:outgoing>SF_T_25_T_26</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_26" name="Read the draft left by an earlier sitting">
        <bpmn:incoming>SF_T_25_T_26</bpmn:incoming>
        <bpmn:outgoing>SF_T_26_T_27</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_27" name="Report whether the goal is archived">
        <bpmn:incoming>SF_T_26_T_27</bpmn:incoming>
        <bpmn:outgoing>SF_T_27_T_28</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_28" name="Report the proposal">
        <bpmn:incoming>SF_T_27_T_28</bpmn:incoming>
        <bpmn:outgoing>SF_T_28_BP07.01_ReadTheCheckOutProposal_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP07.01_ReadTheCheckOutProposal_e" name="fertig">
        <bpmn:incoming>SF_T_28_BP07.01_ReadTheCheckOutProposal_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_24_T_25" sourceRef="T_24" targetRef="T_25" />
      <bpmn:sequenceFlow id="SF_T_25_T_26" sourceRef="T_25" targetRef="T_26" />
      <bpmn:sequenceFlow id="SF_T_26_T_27" sourceRef="T_26" targetRef="T_27" />
      <bpmn:sequenceFlow id="SF_T_27_T_28" sourceRef="T_27" targetRef="T_28" />
      <bpmn:sequenceFlow id="SF_BP07.01_ReadTheCheckOutProposal_s_T_24" sourceRef="BP07.01_ReadTheCheckOutProposal_s" targetRef="T_24" />
      <bpmn:sequenceFlow id="SF_T_28_BP07.01_ReadTheCheckOutProposal_e" sourceRef="T_28" targetRef="BP07.01_ReadTheCheckOutProposal_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_29" name="Proposal answered">
