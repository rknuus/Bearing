<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP08_SetADaysFocus" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP08_SetADaysFocus">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP08.02 · Set the day's focus" sourceRef="T_5" targetRef="setIn" />
    <bpmn:messageFlow id="MF_2" name="What was committed, or why not" sourceRef="BP08.02_SetTheDaysFocus" targetRef="focusSet" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>Zero to many per project. The ready ones are offered first; nothing forces one at a time. A simple project contributes its own board and has no activities to pick.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_3" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>Chores is never picked. It joins the day on its own while it carries work that is not done.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="focusSet" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>A commit replaces the date's previous selection rather than adding to it, so the boards in play are exactly what was last committed. A routine that already owes a task gets no second one, on any date. Due and overdue are treated the same. Dropping a routine leaves a task already created where it is.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="BP08.02_SetTheDaysFocus" targetRef="TextAnnotation_X3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A day to commit to">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Pick or drop the projects to work on">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_T_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_3" name="Pick or drop the activities inside each activity-based project">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_T_2_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_T_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_4" name="Pick or drop the routines to keep up">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_T_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_T_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_5" name="Commit the day's focus">
      <bpmn:incoming>SF_T_4_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_focusSet</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="focusSet" name="What was committed, or why not">
      <bpmn:incoming>SF_T_5_focusSet</bpmn:incoming>
      <bpmn:outgoing>SF_focusSet_End_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_focusSet" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_6" name="Day committed">
      <bpmn:incoming>SF_focusSet_End_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_T_3" sourceRef="T_2" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_T_3_T_4" sourceRef="T_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_4_T_5" sourceRef="T_4" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_5_focusSet" sourceRef="T_5" targetRef="focusSet" />
    <bpmn:sequenceFlow id="SF_focusSet_End_6" sourceRef="focusSet" targetRef="End_6" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="setIn" name="Day focus submitted">
      <bpmn:outgoing>SF_setIn_BP08.02_SetTheDaysFocus</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_setIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP08.02_SetTheDaysFocus" name="Set the day's focus">
      <bpmn:incoming>SF_setIn_BP08.02_SetTheDaysFocus</bpmn:incoming>
      <bpmn:outgoing>SF_BP08.02_SetTheDaysFocus_End_10</bpmn:outgoing>
      <bpmn:startEvent id="BP08.02_SetTheDaysFocus_s" name="Start">
        <bpmn:outgoing>SF_BP08.02_SetTheDaysFocus_s_T_7</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_7" name="Replace the date's selection with what was committed">
        <bpmn:incoming>SF_BP08.02_SetTheDaysFocus_s_T_7</bpmn:incoming>
        <bpmn:outgoing>SF_T_7_T_8</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_8" name="Create the task a selected routine owes, where none is outstanding, on Chores">
        <bpmn:incoming>SF_T_7_T_8</bpmn:incoming>
        <bpmn:outgoing>SF_T_8_T_9</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_9" name="Report the outcome, with the day's focus">
        <bpmn:incoming>SF_T_8_T_9</bpmn:incoming>
        <bpmn:outgoing>SF_T_9_BP08.02_SetTheDaysFocus_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP08.02_SetTheDaysFocus_e" name="fertig">
        <bpmn:incoming>SF_T_9_BP08.02_SetTheDaysFocus_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_7_T_8" sourceRef="T_7" targetRef="T_8" />
      <bpmn:sequenceFlow id="SF_T_8_T_9" sourceRef="T_8" targetRef="T_9" />
      <bpmn:sequenceFlow id="SF_BP08.02_SetTheDaysFocus_s_T_7" sourceRef="BP08.02_SetTheDaysFocus_s" targetRef="T_7" />
      <bpmn:sequenceFlow id="SF_T_9_BP08.02_SetTheDaysFocus_e" sourceRef="T_9" targetRef="BP08.02_SetTheDaysFocus_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_10" name="Day focus answered">
      <bpmn:incoming>SF_BP08.02_SetTheDaysFocus_End_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_setIn_BP08.02_SetTheDaysFocus" sourceRef="setIn" targetRef="BP08.02_SetTheDaysFocus" />
    <bpmn:sequenceFlow id="SF_BP08.02_SetTheDaysFocus_End_10" sourceRef="BP08.02_SetTheDaysFocus" targetRef="End_10" />
  </bpmn:process>
