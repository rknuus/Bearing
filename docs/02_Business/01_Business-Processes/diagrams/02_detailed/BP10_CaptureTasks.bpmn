<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP10_CaptureTasks" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP10_CaptureTasks">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP10.02 · Stage a task" sourceRef="T_3" targetRef="stageIn" />
    <bpmn:messageFlow id="MF_2" name="BP10.03 · Edit a staged task" sourceRef="submit" targetRef="editIn" />
    <bpmn:messageFlow id="MF_3" name="BP10.04 · Reorder staged tasks" sourceRef="T_6" targetRef="reorderIn" />
    <bpmn:messageFlow id="MF_4" name="BP10.05 · Discard staged tasks" sourceRef="discardSubmit" targetRef="discardIn" />
    <bpmn:messageFlow id="MF_5" name="BP10.06 · Commit the staged tasks" sourceRef="T_9" targetRef="commitIn" />
    <bpmn:messageFlow id="MF_6" name="The staging outcome" sourceRef="BP10.02_StageTaskDraft" targetRef="staged" />
    <bpmn:messageFlow id="MF_7" name="The editing outcome" sourceRef="BP10.03_AmendStagedDraft" targetRef="amended" />
    <bpmn:messageFlow id="MF_8" name="The ordering outcome" sourceRef="BP10.04_ReorderStagedDrafts" targetRef="reordered" />
    <bpmn:messageFlow id="MF_9" name="The discard outcome" sourceRef="BP10.05_DiscardStagedDrafts" targetRef="discarded" />
    <bpmn:messageFlow id="MF_10" name="The commit outcome" sourceRef="BP10.06_CommitStagedTasks" targetRef="committed" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>Opening the surface is the act of whichever surface offers it, and the board draws it (BP11); this process starts inside it. The batch a previous gesture left staged is in front of the user when capture opens - it survives leaving the gesture, a crash and a restart, so capture resumes it rather than starting over. Where nothing was left staged, the batch starts empty.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="hub" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>Closing the surface is not discarding the batch: it survives as a draft, and nothing it describes takes effect until it is committed. Throwing it away is the discard act.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_11" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>Staging is one task at a time, and the batch is what has been staged so far. Staging is also what sets the priority: the batch is laid out as three priority columns - Important and Urgent, Not Important and Urgent, Important and Not Urgent - and the column a task is staged into is the priority it carries.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="staged" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>What a staged task says and the priority it carries are fields of the one request, which is why moving it into another priority column arrives here too: the editor and the drag are two gestures on one request. Nothing takes effect until the batch is committed.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="amended" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>A staged task owns nothing, so there is nothing to disclose and no cascade to approve. Throwing one away and throwing the whole batch away are two gestures on one request.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="discarded" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>A staged task is not a commit. It is kept outside version control.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="BP10.02_StageTaskDraft" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>Every task in the batch lands on the board capture was opened from - a project's board, or Chores where that is the board the user is on. Capture names no board and creates none. The batch commits as one act.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="BP10.06_CommitStagedTasks" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>A staged task is never on a board, so its priority is open for as long as the batch is uncommitted.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="BP10.03_AmendStagedDraft" targetRef="TextAnnotation_X8" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Work worth writing down">
      <bpmn:outgoing>SF_Start_1_hub</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="hub" name="Work on uncommitted tasks">
      <bpmn:incoming>SF_Start_1_hub</bpmn:incoming>
      <bpmn:incoming>SF_staged_hub</bpmn:incoming>
      <bpmn:incoming>SF_amended_hub</bpmn:incoming>
      <bpmn:incoming>SF_reordered_hub</bpmn:incoming>
      <bpmn:incoming>SF_discarded_hub</bpmn:incoming>
      <bpmn:outgoing>SF_hub_Gw_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_2" name="Work the tasks?">
      <bpmn:incoming>SF_hub_Gw_2</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_2_T_3</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_5</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_6</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_8</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_9</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_3" name="Stage a task">
      <bpmn:incoming>SF_Gw_2_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_staged</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="staged" name="The staging outcome">
      <bpmn:incoming>SF_T_3_staged</bpmn:incoming>
      <bpmn:outgoing>SF_staged_hub</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_staged" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_4" name="Amend a staged task">
      <bpmn:incoming>SF_Gw_2_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_submit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="submit" name="Submit the task">
      <bpmn:incoming>SF_T_4_submit</bpmn:incoming>
      <bpmn:incoming>SF_T_5_submit</bpmn:incoming>
      <bpmn:outgoing>SF_submit_amended</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="amended" name="The editing outcome">
      <bpmn:incoming>SF_submit_amended</bpmn:incoming>
      <bpmn:outgoing>SF_amended_hub</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_amended" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_5" name="Reprioritize a task to another column">
      <bpmn:incoming>SF_Gw_2_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_submit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_6" name="Order a staged task within a column">
      <bpmn:incoming>SF_Gw_2_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_reordered</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="reordered" name="The ordering outcome">
      <bpmn:incoming>SF_T_6_reordered</bpmn:incoming>
      <bpmn:outgoing>SF_reordered_hub</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_reordered" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_7" name="Delete a staged task">
      <bpmn:incoming>SF_Gw_2_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_discardSubmit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="discardSubmit" name="Submit the discard">
      <bpmn:incoming>SF_T_7_discardSubmit</bpmn:incoming>
      <bpmn:incoming>SF_T_8_discardSubmit</bpmn:incoming>
      <bpmn:outgoing>SF_discardSubmit_discarded</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="discarded" name="The discard outcome">
      <bpmn:incoming>SF_discardSubmit_discarded</bpmn:incoming>
      <bpmn:outgoing>SF_discarded_hub</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_discarded" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_8" name="Discard all staged tasks">
      <bpmn:incoming>SF_Gw_2_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_discardSubmit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_9" name="Commit the staged tasks">
      <bpmn:incoming>SF_Gw_2_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_committed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="committed" name="The commit outcome">
      <bpmn:incoming>SF_T_9_committed</bpmn:incoming>
      <bpmn:outgoing>SF_committed_End_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_committed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_10" name="Tasks captured">
      <bpmn:incoming>SF_committed_End_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_11" name="Close capture without committing">
      <bpmn:incoming>SF_Gw_2_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_End_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_12" name="Batch left as a draft">
      <bpmn:incoming>SF_T_11_End_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_hub" sourceRef="Start_1" targetRef="hub" />
    <bpmn:sequenceFlow id="SF_hub_Gw_2" sourceRef="hub" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="SF_T_3_staged" sourceRef="T_3" targetRef="staged" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_3" name="write another one down" sourceRef="Gw_2" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_T_4_submit" sourceRef="T_4" targetRef="submit" />
    <bpmn:sequenceFlow id="SF_submit_amended" sourceRef="submit" targetRef="amended" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_4" name="fix what a staged task says" sourceRef="Gw_2" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_5" name="reprioritize one into another column" sourceRef="Gw_2" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_6_reordered" sourceRef="T_6" targetRef="reordered" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_6" name="reorder them" sourceRef="Gw_2" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_T_7_discardSubmit" sourceRef="T_7" targetRef="discardSubmit" />
    <bpmn:sequenceFlow id="SF_discardSubmit_discarded" sourceRef="discardSubmit" targetRef="discarded" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_7" name="throw one away" sourceRef="Gw_2" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_8" name="throw the whole batch away" sourceRef="Gw_2" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_T_9_committed" sourceRef="T_9" targetRef="committed" />
    <bpmn:sequenceFlow id="SF_committed_End_10" sourceRef="committed" targetRef="End_10" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_9" name="commit the batch" sourceRef="Gw_2" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_T_11_End_12" sourceRef="T_11" targetRef="End_12" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_11" name="leave it for later" sourceRef="Gw_2" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_staged_hub" sourceRef="staged" targetRef="hub" />
    <bpmn:sequenceFlow id="SF_amended_hub" sourceRef="amended" targetRef="hub" />
    <bpmn:sequenceFlow id="SF_T_5_submit" sourceRef="T_5" targetRef="submit" />
    <bpmn:sequenceFlow id="SF_reordered_hub" sourceRef="reordered" targetRef="hub" />
    <bpmn:sequenceFlow id="SF_discarded_hub" sourceRef="discarded" targetRef="hub" />
    <bpmn:sequenceFlow id="SF_T_8_discardSubmit" sourceRef="T_8" targetRef="discardSubmit" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="stageIn" name="Staging requested">
      <bpmn:outgoing>SF_stageIn_BP10.02_StageTaskDraft</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_stageIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP10.02_StageTaskDraft" name="Stage a task">
      <bpmn:incoming>SF_stageIn_BP10.02_StageTaskDraft</bpmn:incoming>
      <bpmn:outgoing>SF_BP10.02_StageTaskDraft_End_15</bpmn:outgoing>
      <bpmn:startEvent id="BP10.02_StageTaskDraft_s" name="Start">
        <bpmn:outgoing>SF_BP10.02_StageTaskDraft_s_T_13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_13" name="Stage the task to a priority column">
        <bpmn:incoming>SF_BP10.02_StageTaskDraft_s_T_13</bpmn:incoming>
        <bpmn:outgoing>SF_T_13_T_14</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_14" name="Report the outcome">
        <bpmn:incoming>SF_T_13_T_14</bpmn:incoming>
        <bpmn:outgoing>SF_T_14_BP10.02_StageTaskDraft_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP10.02_StageTaskDraft_e" name="fertig">
        <bpmn:incoming>SF_T_14_BP10.02_StageTaskDraft_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_13_T_14" sourceRef="T_13" targetRef="T_14" />
      <bpmn:sequenceFlow id="SF_BP10.02_StageTaskDraft_s_T_13" sourceRef="BP10.02_StageTaskDraft_s" targetRef="T_13" />
      <bpmn:sequenceFlow id="SF_T_14_BP10.02_StageTaskDraft_e" sourceRef="T_14" targetRef="BP10.02_StageTaskDraft_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_15" name="Staging answered">
      <bpmn:incoming>SF_BP10.02_StageTaskDraft_End_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="editIn" name="Edit submitted">
      <bpmn:outgoing>SF_editIn_BP10.03_AmendStagedDraft</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_editIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP10.03_AmendStagedDraft" name="Edit a staged task">
      <bpmn:incoming>SF_editIn_BP10.03_AmendStagedDraft</bpmn:incoming>
      <bpmn:outgoing>SF_BP10.03_AmendStagedDraft_End_18</bpmn:outgoing>
      <bpmn:startEvent id="BP10.03_AmendStagedDraft_s" name="Start">
        <bpmn:outgoing>SF_BP10.03_AmendStagedDraft_s_T_16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_16" name="Store the edit, the priority included">
        <bpmn:incoming>SF_BP10.03_AmendStagedDraft_s_T_16</bpmn:incoming>
        <bpmn:outgoing>SF_T_16_T_17</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_17" name="Report the outcome">
        <bpmn:incoming>SF_T_16_T_17</bpmn:incoming>
        <bpmn:outgoing>SF_T_17_BP10.03_AmendStagedDraft_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP10.03_AmendStagedDraft_e" name="fertig">
        <bpmn:incoming>SF_T_17_BP10.03_AmendStagedDraft_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_16_T_17" sourceRef="T_16" targetRef="T_17" />
      <bpmn:sequenceFlow id="SF_BP10.03_AmendStagedDraft_s_T_16" sourceRef="BP10.03_AmendStagedDraft_s" targetRef="T_16" />
      <bpmn:sequenceFlow id="SF_T_17_BP10.03_AmendStagedDraft_e" sourceRef="T_17" targetRef="BP10.03_AmendStagedDraft_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_18" name="Edit answered">
      <bpmn:incoming>SF_BP10.03_AmendStagedDraft_End_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="reorderIn" name="Reordering requested">
      <bpmn:outgoing>SF_reorderIn_BP10.04_ReorderStagedDrafts</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_reorderIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP10.04_ReorderStagedDrafts" name="Reorder staged tasks">
      <bpmn:incoming>SF_reorderIn_BP10.04_ReorderStagedDrafts</bpmn:incoming>
      <bpmn:outgoing>SF_BP10.04_ReorderStagedDrafts_End_21</bpmn:outgoing>
      <bpmn:startEvent id="BP10.04_ReorderStagedDrafts_s" name="Start">
        <bpmn:outgoing>SF_BP10.04_ReorderStagedDrafts_s_T_19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_19" name="Apply the new order">
        <bpmn:incoming>SF_BP10.04_ReorderStagedDrafts_s_T_19</bpmn:incoming>
        <bpmn:outgoing>SF_T_19_T_20</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_20" name="Report the outcome">
        <bpmn:incoming>SF_T_19_T_20</bpmn:incoming>
        <bpmn:outgoing>SF_T_20_BP10.04_ReorderStagedDrafts_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP10.04_ReorderStagedDrafts_e" name="fertig">
        <bpmn:incoming>SF_T_20_BP10.04_ReorderStagedDrafts_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_19_T_20" sourceRef="T_19" targetRef="T_20" />
      <bpmn:sequenceFlow id="SF_BP10.04_ReorderStagedDrafts_s_T_19" sourceRef="BP10.04_ReorderStagedDrafts_s" targetRef="T_19" />
      <bpmn:sequenceFlow id="SF_T_20_BP10.04_ReorderStagedDrafts_e" sourceRef="T_20" targetRef="BP10.04_ReorderStagedDrafts_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_21" name="Reordering answered">
      <bpmn:incoming>SF_BP10.04_ReorderStagedDrafts_End_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="discardIn" name="Discard requested">
      <bpmn:outgoing>SF_discardIn_BP10.05_DiscardStagedDrafts</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_discardIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP10.05_DiscardStagedDrafts" name="Discard staged tasks">
      <bpmn:incoming>SF_discardIn_BP10.05_DiscardStagedDrafts</bpmn:incoming>
      <bpmn:outgoing>SF_BP10.05_DiscardStagedDrafts_End_24</bpmn:outgoing>
      <bpmn:startEvent id="BP10.05_DiscardStagedDrafts_s" name="Start">
        <bpmn:outgoing>SF_BP10.05_DiscardStagedDrafts_s_T_22</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_22" name="Delete the staged tasks the request names">
        <bpmn:incoming>SF_BP10.05_DiscardStagedDrafts_s_T_22</bpmn:incoming>
        <bpmn:outgoing>SF_T_22_T_23</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_23" name="Report the outcome">
        <bpmn:incoming>SF_T_22_T_23</bpmn:incoming>
        <bpmn:outgoing>SF_T_23_BP10.05_DiscardStagedDrafts_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP10.05_DiscardStagedDrafts_e" name="fertig">
        <bpmn:incoming>SF_T_23_BP10.05_DiscardStagedDrafts_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_22_T_23" sourceRef="T_22" targetRef="T_23" />
      <bpmn:sequenceFlow id="SF_BP10.05_DiscardStagedDrafts_s_T_22" sourceRef="BP10.05_DiscardStagedDrafts_s" targetRef="T_22" />
      <bpmn:sequenceFlow id="SF_T_23_BP10.05_DiscardStagedDrafts_e" sourceRef="T_23" targetRef="BP10.05_DiscardStagedDrafts_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_24" name="Discard answered">
      <bpmn:incoming>SF_BP10.05_DiscardStagedDrafts_End_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="commitIn" name="Batch commit requested">
      <bpmn:outgoing>SF_commitIn_BP10.06_CommitStagedTasks</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_commitIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP10.06_CommitStagedTasks" name="Commit the staged tasks">
      <bpmn:incoming>SF_commitIn_BP10.06_CommitStagedTasks</bpmn:incoming>
      <bpmn:outgoing>SF_BP10.06_CommitStagedTasks_End_28</bpmn:outgoing>
      <bpmn:startEvent id="BP10.06_CommitStagedTasks_s" name="Start">
        <bpmn:outgoing>SF_BP10.06_CommitStagedTasks_s_T_25</bpmn:outgoing>
