<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP10_CaptureTasks" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP10_CaptureTasks">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP10.07 · Read the staged batch" sourceRef="T_2" targetRef="draftsIn" />
    <bpmn:messageFlow id="MF_2" name="BP10.01 · Read the selectable boards" sourceRef="T_6" targetRef="boardsIn" />
    <bpmn:messageFlow id="MF_3" name="BP10.02 · Stage a task draft" sourceRef="T_7" targetRef="stageIn" />
    <bpmn:messageFlow id="MF_4" name="BP10.03 · Amend a staged draft" sourceRef="T_9" targetRef="amendIn" />
    <bpmn:messageFlow id="MF_5" name="BP10.04 · Reorder staged drafts" sourceRef="T_10" targetRef="reorderIn" />
    <bpmn:messageFlow id="MF_6" name="BP10.05 · Discard staged drafts" sourceRef="T_11" targetRef="discardIn" />
    <bpmn:messageFlow id="MF_7" name="BP10.06 · Commit the staged tasks" sourceRef="T_14" targetRef="commitIn" />
    <bpmn:messageFlow id="MF_8" name="The staged batch, if any" sourceRef="BP10.07_ReadTheStagedBatch" targetRef="drafts" />
    <bpmn:messageFlow id="MF_9" name="The boards that exist" sourceRef="BP10.01_ReadTheSelectableBoards" targetRef="boards" />
    <bpmn:messageFlow id="MF_10" name="Draft staged" sourceRef="BP10.02_StageTaskDraft" targetRef="staged" />
    <bpmn:messageFlow id="MF_11" name="Draft amended" sourceRef="BP10.03_AmendStagedDraft" targetRef="amended" />
    <bpmn:messageFlow id="MF_12" name="Order recorded" sourceRef="BP10.04_ReorderStagedDrafts" targetRef="reordered" />
    <bpmn:messageFlow id="MF_13" name="Drafts discarded" sourceRef="BP10.05_DiscardStagedDrafts" targetRef="discarded" />
    <bpmn:messageFlow id="MF_14" name="Tasks on their boards" sourceRef="BP10.06_CommitStagedTasks" targetRef="committed" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>A staged batch survives leaving the gesture, a crash and a restart, so capture resumes it rather than starting over.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_4" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>One instance per task. The bucket is Important and Urgent, Not Important and Urgent, or Important and Not Urgent.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="staged" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>The staged batch survives as a draft. Nothing it describes takes effect until the batch is committed.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="T_16" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>The answer is empty where nothing was left staged. A draft is kept outside version control.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="BP10.07_ReadTheStagedBatch" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>Chores is never a destination the user picks. Naming no board at all is what sends a task there. The answer is empty until the first project exists, and then naming no board is the only legal capture.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="BP10.01_ReadTheSelectableBoards" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>A staged draft is not a commit. It is kept outside version control.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="BP10.02_StageTaskDraft" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>One request discards a single draft and the whole batch alike.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="BP10.05_DiscardStagedDrafts" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>Capturing a task never creates a board. The batch commits as one act.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="BP10.06_CommitStagedTasks" targetRef="TextAnnotation_X8" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Work worth writing down">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Open task capture">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_drafts</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="drafts" name="The staged batch, if any">
      <bpmn:incoming>SF_T_2_drafts</bpmn:incoming>
      <bpmn:outgoing>SF_drafts_Gw_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_drafts" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_3" name="A batch left from before?">
      <bpmn:incoming>SF_drafts_Gw_3</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_3_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_4" name="Pick up where the batch was left">
      <bpmn:incoming>SF_Gw_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_T_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_5" name="Start a fresh batch">
      <bpmn:incoming>SF_Gw_3_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_T_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_6" name="Open the board picker">
      <bpmn:incoming>SF_T_4_T_6</bpmn:incoming>
      <bpmn:incoming>SF_T_5_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_boards</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="boards" name="The boards that exist">
      <bpmn:incoming>SF_T_6_boards</bpmn:incoming>
      <bpmn:outgoing>SF_boards_T_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_boards" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_7" name="Stage a task in its triage bucket">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_boards_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_staged</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="staged" name="Draft staged">
      <bpmn:incoming>SF_T_7_staged</bpmn:incoming>
      <bpmn:outgoing>SF_staged_tidy</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_staged" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="tidy" name="Look over the batch">
      <bpmn:incoming>SF_staged_tidy</bpmn:incoming>
      <bpmn:incoming>SF_amended_tidy</bpmn:incoming>
      <bpmn:incoming>SF_reordered_tidy</bpmn:incoming>
      <bpmn:incoming>SF_discarded_tidy</bpmn:incoming>
      <bpmn:outgoing>SF_tidy_Gw_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_8" name="Anything to tidy before committing?">
      <bpmn:incoming>SF_tidy_Gw_8</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_8_T_9</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_8_T_10</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_8_T_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_8_T_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_9" name="Amend the staged draft">
      <bpmn:incoming>SF_Gw_8_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_amended</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="amended" name="Draft amended">
      <bpmn:incoming>SF_T_9_amended</bpmn:incoming>
      <bpmn:outgoing>SF_amended_tidy</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_amended" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_10" name="Drag a staged draft into place">
      <bpmn:incoming>SF_Gw_8_T_10</bpmn:incoming>
      <bpmn:outgoing>SF_T_10_reordered</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="reordered" name="Order recorded">
      <bpmn:incoming>SF_T_10_reordered</bpmn:incoming>
      <bpmn:outgoing>SF_reordered_tidy</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_reordered" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_11" name="Discard the staged drafts">
      <bpmn:incoming>SF_Gw_8_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_discarded</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="discarded" name="Drafts discarded">
      <bpmn:incoming>SF_T_11_discarded</bpmn:incoming>
      <bpmn:outgoing>SF_discarded_tidy</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_discarded" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_12" name="Leave the batch as it stands">
      <bpmn:incoming>SF_Gw_8_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_decide</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="decide" name="Commit or leave it">
      <bpmn:incoming>SF_T_12_decide</bpmn:incoming>
      <bpmn:outgoing>SF_decide_Gw_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_13" name="Commit the batch now?">
      <bpmn:incoming>SF_decide_Gw_13</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_13_T_14</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_13_T_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_14" name="Commit the staged tasks">
      <bpmn:incoming>SF_Gw_13_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_committed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="committed" name="Tasks on their boards">
      <bpmn:incoming>SF_T_14_committed</bpmn:incoming>
      <bpmn:outgoing>SF_committed_End_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_committed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_15" name="Tasks captured">
      <bpmn:incoming>SF_committed_End_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_16" name="Leave the gesture">
      <bpmn:incoming>SF_Gw_13_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_End_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_17" name="Batch left as a draft">
      <bpmn:incoming>SF_T_16_End_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_drafts" sourceRef="T_2" targetRef="drafts" />
    <bpmn:sequenceFlow id="SF_drafts_Gw_3" sourceRef="drafts" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_4" name="yes" sourceRef="Gw_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_5" name="no" sourceRef="Gw_3" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_4_T_6" sourceRef="T_4" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_T_5_T_6" sourceRef="T_5" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_T_6_boards" sourceRef="T_6" targetRef="boards" />
    <bpmn:sequenceFlow id="SF_boards_T_7" sourceRef="boards" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_T_7_staged" sourceRef="T_7" targetRef="staged" />
    <bpmn:sequenceFlow id="SF_staged_tidy" sourceRef="staged" targetRef="tidy" />
    <bpmn:sequenceFlow id="SF_tidy_Gw_8" sourceRef="tidy" targetRef="Gw_8" />
    <bpmn:sequenceFlow id="SF_T_9_amended" sourceRef="T_9" targetRef="amended" />
    <bpmn:sequenceFlow id="SF_Gw_8_T_9" name="change a staged task" sourceRef="Gw_8" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_T_10_reordered" sourceRef="T_10" targetRef="reordered" />
    <bpmn:sequenceFlow id="SF_Gw_8_T_10" name="reorder them" sourceRef="Gw_8" targetRef="T_10" />
    <bpmn:sequenceFlow id="SF_T_11_discarded" sourceRef="T_11" targetRef="discarded" />
    <bpmn:sequenceFlow id="SF_Gw_8_T_11" name="throw one away, or all of them" sourceRef="Gw_8" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_Gw_8_T_12" name="no" sourceRef="Gw_8" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_T_12_decide" sourceRef="T_12" targetRef="decide" />
    <bpmn:sequenceFlow id="SF_decide_Gw_13" sourceRef="decide" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_T_14_committed" sourceRef="T_14" targetRef="committed" />
    <bpmn:sequenceFlow id="SF_committed_End_15" sourceRef="committed" targetRef="End_15" />
    <bpmn:sequenceFlow id="SF_Gw_13_T_14" name="commit" sourceRef="Gw_13" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_T_16_End_17" sourceRef="T_16" targetRef="End_17" />
    <bpmn:sequenceFlow id="SF_Gw_13_T_16" name="leave it for later" sourceRef="Gw_13" targetRef="T_16" />
    <bpmn:sequenceFlow id="SF_amended_tidy" sourceRef="amended" targetRef="tidy" />
    <bpmn:sequenceFlow id="SF_reordered_tidy" sourceRef="reordered" targetRef="tidy" />
    <bpmn:sequenceFlow id="SF_discarded_tidy" sourceRef="discarded" targetRef="tidy" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="draftsIn" name="Staged batch requested">
      <bpmn:outgoing>SF_draftsIn_BP10.07_ReadTheStagedBatch</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_draftsIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP10.07_ReadTheStagedBatch" name="Read the staged batch">
      <bpmn:incoming>SF_draftsIn_BP10.07_ReadTheStagedBatch</bpmn:incoming>
      <bpmn:outgoing>SF_BP10.07_ReadTheStagedBatch_End_19</bpmn:outgoing>
      <bpmn:startEvent id="BP10.07_ReadTheStagedBatch_s" name="Start">
        <bpmn:outgoing>SF_BP10.07_ReadTheStagedBatch_s_T_18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_18" name="Read the drafts staged and not yet committed">
        <bpmn:incoming>SF_BP10.07_ReadTheStagedBatch_s_T_18</bpmn:incoming>
        <bpmn:outgoing>SF_T_18_BP10.07_ReadTheStagedBatch_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP10.07_ReadTheStagedBatch_e" name="fertig">
        <bpmn:incoming>SF_T_18_BP10.07_ReadTheStagedBatch_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_BP10.07_ReadTheStagedBatch_s_T_18" sourceRef="BP10.07_ReadTheStagedBatch_s" targetRef="T_18" />
      <bpmn:sequenceFlow id="SF_T_18_BP10.07_ReadTheStagedBatch_e" sourceRef="T_18" targetRef="BP10.07_ReadTheStagedBatch_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_19" name="Staged batch answered">
      <bpmn:incoming>SF_BP10.07_ReadTheStagedBatch_End_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="boardsIn" name="Board list requested">
      <bpmn:outgoing>SF_boardsIn_BP10.01_ReadTheSelectableBoards</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_boardsIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP10.01_ReadTheSelectableBoards" name="Read the selectable boards">
      <bpmn:incoming>SF_boardsIn_BP10.01_ReadTheSelectableBoards</bpmn:incoming>
      <bpmn:outgoing>SF_BP10.01_ReadTheSelectableBoards_End_22</bpmn:outgoing>
      <bpmn:startEvent id="BP10.01_ReadTheSelectableBoards_s" name="Start">
        <bpmn:outgoing>SF_BP10.01_ReadTheSelectableBoards_s_T_20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_20" name="Read the boards that exist, grouped by project">
        <bpmn:incoming>SF_BP10.01_ReadTheSelectableBoards_s_T_20</bpmn:incoming>
        <bpmn:outgoing>SF_T_20_T_21</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_21" name="Leave Chores out of the offer">
        <bpmn:incoming>SF_T_20_T_21</bpmn:incoming>
        <bpmn:outgoing>SF_T_21_BP10.01_ReadTheSelectableBoards_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP10.01_ReadTheSelectableBoards_e" name="fertig">
        <bpmn:incoming>SF_T_21_BP10.01_ReadTheSelectableBoards_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_20_T_21" sourceRef="T_20" targetRef="T_21" />
      <bpmn:sequenceFlow id="SF_BP10.01_ReadTheSelectableBoards_s_T_20" sourceRef="BP10.01_ReadTheSelectableBoards_s" targetRef="T_20" />
      <bpmn:sequenceFlow id="SF_T_21_BP10.01_ReadTheSelectableBoards_e" sourceRef="T_21" targetRef="BP10.01_ReadTheSelectableBoards_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_22" name="Board list answered">
      <bpmn:incoming>SF_BP10.01_ReadTheSelectableBoards_End_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="stageIn" name="Draft staged">
      <bpmn:outgoing>SF_stageIn_BP10.02_StageTaskDraft</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_stageIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP10.02_StageTaskDraft" name="Stage a task draft">
      <bpmn:incoming>SF_stageIn_BP10.02_StageTaskDraft</bpmn:incoming>
      <bpmn:outgoing>SF_BP10.02_StageTaskDraft_End_25</bpmn:outgoing>
      <bpmn:startEvent id="BP10.02_StageTaskDraft_s" name="Start">
        <bpmn:outgoing>SF_BP10.02_StageTaskDraft_s_T_23</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_23" name="Store the draft with its title and bucket">
        <bpmn:incoming>SF_BP10.02_StageTaskDraft_s_T_23</bpmn:incoming>
        <bpmn:outgoing>SF_T_23_T_24</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_24" name="Place it last in its bucket">
        <bpmn:incoming>SF_T_23_T_24</bpmn:incoming>
        <bpmn:outgoing>SF_T_24_BP10.02_StageTaskDraft_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP10.02_StageTaskDraft_e" name="fertig">
        <bpmn:incoming>SF_T_24_BP10.02_StageTaskDraft_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_23_T_24" sourceRef="T_23" targetRef="T_24" />
      <bpmn:sequenceFlow id="SF_BP10.02_StageTaskDraft_s_T_23" sourceRef="BP10.02_StageTaskDraft_s" targetRef="T_23" />
      <bpmn:sequenceFlow id="SF_T_24_BP10.02_StageTaskDraft_e" sourceRef="T_24" targetRef="BP10.02_StageTaskDraft_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_25" name="Staging answered">
      <bpmn:incoming>SF_BP10.02_StageTaskDraft_End_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="amendIn" name="Draft amendment requested">
      <bpmn:outgoing>SF_amendIn_BP10.03_AmendStagedDraft</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_amendIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP10.03_AmendStagedDraft" name="Amend a staged draft">
      <bpmn:incoming>SF_amendIn_BP10.03_AmendStagedDraft</bpmn:incoming>
      <bpmn:outgoing>SF_BP10.03_AmendStagedDraft_End_27</bpmn:outgoing>
      <bpmn:startEvent id="BP10.03_AmendStagedDraft_s" name="Start">
        <bpmn:outgoing>SF_BP10.03_AmendStagedDraft_s_T_26</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_26" name="Apply the title, bucket and board as given">
        <bpmn:incoming>SF_BP10.03_AmendStagedDraft_s_T_26</bpmn:incoming>
        <bpmn:outgoing>SF_T_26_BP10.03_AmendStagedDraft_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP10.03_AmendStagedDraft_e" name="fertig">
