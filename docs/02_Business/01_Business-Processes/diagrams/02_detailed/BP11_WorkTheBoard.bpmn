<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP11_WorkTheBoard" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP11_WorkTheBoard">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP11.01 · Read the boards in play" sourceRef="execution" targetRef="stripIn" />
    <bpmn:messageFlow id="MF_2" name="BP11.02 · Read a board" sourceRef="T_2" targetRef="boardIn" />
    <bpmn:messageFlow id="MF_3" name="BP11.03 · Move a task" sourceRef="T_4" targetRef="moveIn" />
    <bpmn:messageFlow id="MF_4" name="BP11.09 · Set the activity Done" sourceRef="T_8" targetRef="activityIn" />
    <bpmn:messageFlow id="MF_5" name="BP11.04 · Prioritize a task" sourceRef="T_11" targetRef="prioritizeIn" />
    <bpmn:messageFlow id="MF_6" name="BP11.05 · Rank a task" sourceRef="T_12" targetRef="rankIn" />
    <bpmn:messageFlow id="MF_7" name="BP11.10 · Draft the task input" sourceRef="T_13" targetRef="taskDraftIn" />
    <bpmn:messageFlow id="MF_8" name="BP11.06 · Amend a task" sourceRef="T_14" targetRef="amendIn" />
    <bpmn:messageFlow id="MF_9" name="BP11.07 · Archive a task" sourceRef="T_15" targetRef="archiveIn" />
    <bpmn:messageFlow id="MF_10" name="BP11.08 · Delete a task" sourceRef="T_16" targetRef="deleteIn" />
    <bpmn:messageFlow id="MF_11" name="The board strip, focus first" sourceRef="BP11.01_ReadTheBoardsInPlay" targetRef="strip" />
    <bpmn:messageFlow id="MF_12" name="The board with its columns, cards and lineage" sourceRef="BP11.02_ReadABoard" targetRef="board" />
    <bpmn:messageFlow id="MF_13" name="Task moved" sourceRef="BP11.03_MoveTask" targetRef="moved" />
    <bpmn:messageFlow id="MF_14" name="Priority recorded" sourceRef="BP11.04_PrioritizeTask" targetRef="prioritized" />
    <bpmn:messageFlow id="MF_15" name="Rank recorded" sourceRef="BP11.05_RankTask" targetRef="ranked" />
    <bpmn:messageFlow id="MF_16" name="Task amended" sourceRef="BP11.06_AmendTask" targetRef="amended" />
    <bpmn:messageFlow id="MF_17" name="Task archived" sourceRef="BP11.07_ArchiveTask" targetRef="archived" />
    <bpmn:messageFlow id="MF_18" name="Task deleted" sourceRef="BP11.08_DeleteTask" targetRef="deleted" />
    <bpmn:messageFlow id="MF_19" name="Activity state recorded" sourceRef="BP11.09_SetTheActivityDone" targetRef="activitySet" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>Priority changes only while the task is in the Backlog. Work in motion is sent back there first, which re-opens its triage.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="prioritized" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>Archiving is a conscious gesture. A task sitting in Done does not archive itself.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="archived" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>A task owns nothing, so there is nothing to disclose and no cascade to approve. There is no in-app undo; recovery is from version control.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="deleted" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>Content and placement are separate concerns, and the board is neither: a task stays on the board it was created on for its whole life.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="amended" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>Declining is a legitimate answer. The activity stays InProgress and is closed by hand on the Course page.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="T_9" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>The strip holds every board and the focus orders it. An out-of-focus activity-based project is one entry, opening to its activities on demand. Where the date has no focus, the first board in the strip is the one named.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="BP11.01_ReadTheBoardsInPlay" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>A board with no tasks is an empty board, not an empty page. A project's template governs its boards; the Chores board owns its template itself. The flag on an unfinished predecessor names it and clears itself when that predecessor completes.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="BP11.02_ReadABoard" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>Every form on this surface drafts as it is filled in, so leaving it half-finished, a crash and a restart all cost nothing. The draft is one-way: nothing waits for it to be kept. Whichever write commits the form discards it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="BP11.10_DraftTheTaskInput" targetRef="TextAnnotation_X8" />
    <bpmn:textAnnotation id="TextAnnotation_X9"><bpmn:text>One request moves a task between columns and sends it back to the Backlog alike. A task never moves to another board. Returning it to the Backlog re-opens its triage.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X9" associationDirection="None" sourceRef="BP11.03_MoveTask" targetRef="TextAnnotation_X9" />
    <bpmn:textAnnotation id="TextAnnotation_X10"><bpmn:text>Triage happens at intake, so priority lives in the Backlog. The buckets are Important and Urgent, Not Important and Urgent, and Important and Not Urgent.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X10" associationDirection="None" sourceRef="BP11.04_PrioritizeTask" targetRef="TextAnnotation_X10" />
    <bpmn:textAnnotation id="TextAnnotation_X11"><bpmn:text>This is one of the three acts that archive a task, and the one that takes a single card. A routine's task archives by these same acts and no others.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X11" associationDirection="None" sourceRef="BP11.07_ArchiveTask" targetRef="TextAnnotation_X11" />
    <bpmn:textAnnotation id="TextAnnotation_X12"><bpmn:text>A task owns nothing, so nothing goes with it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X12" associationDirection="None" sourceRef="BP11.08_DeleteTask" targetRef="TextAnnotation_X12" />
    <bpmn:textAnnotation id="TextAnnotation_X13"><bpmn:text>The board and the column are untouched by an amendment.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X13" associationDirection="None" sourceRef="BP11.06_AmendTask" targetRef="TextAnnotation_X13" />
    <bpmn:textAnnotation id="TextAnnotation_X14"><bpmn:text>The Course page owns an activity's state; this is the completion offer answered from the board. A Done activity can be reopened there.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X14" associationDirection="None" sourceRef="BP11.09_SetTheActivityDone" targetRef="TextAnnotation_X14" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Work to get done">
      <bpmn:outgoing>SF_Start_1_execution</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="execution" name="Open the Execution page">
      <bpmn:incoming>SF_Start_1_execution</bpmn:incoming>
      <bpmn:incoming>SF_T_17_execution</bpmn:incoming>
      <bpmn:outgoing>SF_execution_strip</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="strip" name="The board strip, focus first">
      <bpmn:incoming>SF_execution_strip</bpmn:incoming>
      <bpmn:outgoing>SF_strip_T_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_strip" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_2" name="Open a board">
      <bpmn:incoming>SF_strip_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_board</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="board" name="The board with its columns, cards and lineage">
      <bpmn:incoming>SF_T_2_board</bpmn:incoming>
      <bpmn:outgoing>SF_board_working</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_board" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="working" name="Work the board">
      <bpmn:incoming>SF_board_working</bpmn:incoming>
      <bpmn:incoming>SF_activitySet_working</bpmn:incoming>
      <bpmn:incoming>SF_T_9_working</bpmn:incoming>
      <bpmn:incoming>SF_T_10_working</bpmn:incoming>
      <bpmn:incoming>SF_prioritized_working</bpmn:incoming>
      <bpmn:incoming>SF_ranked_working</bpmn:incoming>
      <bpmn:incoming>SF_amended_working</bpmn:incoming>
      <bpmn:incoming>SF_archived_working</bpmn:incoming>
      <bpmn:incoming>SF_deleted_working</bpmn:incoming>
      <bpmn:outgoing>SF_working_Gw_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_3" name="What needs doing?">
      <bpmn:incoming>SF_working_Gw_3</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_3_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_12</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_13</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_15</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_16</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_4" name="Drag a task to another column">
      <bpmn:incoming>SF_Gw_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_moved</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="moved" name="Task moved">
      <bpmn:incoming>SF_T_4_moved</bpmn:incoming>
      <bpmn:outgoing>SF_moved_Gw_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_moved" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_5" name="Was that an activity's last task into Done?">
      <bpmn:incoming>SF_moved_Gw_5</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_5_T_6</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_5_T_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_6" name="Answer the completion offer">
      <bpmn:incoming>SF_Gw_5_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_Gw_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_7" name="Mark the activity Done?">
      <bpmn:incoming>SF_T_6_Gw_7</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_7_T_8</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_7_T_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_8" name="Close the activity">
      <bpmn:incoming>SF_Gw_7_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_activitySet</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="activitySet" name="Activity state recorded">
      <bpmn:incoming>SF_T_8_activitySet</bpmn:incoming>
      <bpmn:outgoing>SF_activitySet_working</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_activitySet" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_9" name="Leave the activity in progress">
      <bpmn:incoming>SF_Gw_7_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_working</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_10" name="Carry on">
      <bpmn:incoming>SF_Gw_5_T_10</bpmn:incoming>
      <bpmn:outgoing>SF_T_10_working</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_11" name="Change the task's bucket">
      <bpmn:incoming>SF_Gw_3_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_prioritized</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="prioritized" name="Priority recorded">
      <bpmn:incoming>SF_T_11_prioritized</bpmn:incoming>
      <bpmn:outgoing>SF_prioritized_working</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_prioritized" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_12" name="Drag a task within its bucket">
      <bpmn:incoming>SF_Gw_3_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_ranked</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="ranked" name="Rank recorded">
      <bpmn:incoming>SF_T_12_ranked</bpmn:incoming>
      <bpmn:outgoing>SF_ranked_working</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ranked" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_13" name="Retype the task's title or description">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_Gw_3_T_13</bpmn:incoming>
      <bpmn:outgoing>SF_T_13_T_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_14" name="Submit the amendment">
      <bpmn:incoming>SF_T_13_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_amended</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="amended" name="Task amended">
      <bpmn:incoming>SF_T_14_amended</bpmn:incoming>
      <bpmn:outgoing>SF_amended_working</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_amended" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_15" name="Archive the task">
      <bpmn:incoming>SF_Gw_3_T_15</bpmn:incoming>
      <bpmn:outgoing>SF_T_15_archived</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="archived" name="Task archived">
      <bpmn:incoming>SF_T_15_archived</bpmn:incoming>
      <bpmn:outgoing>SF_archived_working</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_16" name="Confirm the deletion">
      <bpmn:incoming>SF_Gw_3_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_deleted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="deleted" name="Task deleted">
      <bpmn:incoming>SF_T_16_deleted</bpmn:incoming>
      <bpmn:outgoing>SF_deleted_working</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_deleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_17" name="Pick another board from the strip">
      <bpmn:incoming>SF_Gw_3_T_17</bpmn:incoming>
      <bpmn:outgoing>SF_T_17_execution</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_18" name="Work moved on" />
    <bpmn:sequenceFlow id="SF_Start_1_execution" sourceRef="Start_1" targetRef="execution" />
    <bpmn:sequenceFlow id="SF_execution_strip" sourceRef="execution" targetRef="strip" />
    <bpmn:sequenceFlow id="SF_strip_T_2" sourceRef="strip" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_board" sourceRef="T_2" targetRef="board" />
    <bpmn:sequenceFlow id="SF_board_working" sourceRef="board" targetRef="working" />
    <bpmn:sequenceFlow id="SF_working_Gw_3" sourceRef="working" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="SF_T_4_moved" sourceRef="T_4" targetRef="moved" />
    <bpmn:sequenceFlow id="SF_moved_Gw_5" sourceRef="moved" targetRef="Gw_5" />
    <bpmn:sequenceFlow id="SF_T_6_Gw_7" sourceRef="T_6" targetRef="Gw_7" />
    <bpmn:sequenceFlow id="SF_T_8_activitySet" sourceRef="T_8" targetRef="activitySet" />
    <bpmn:sequenceFlow id="SF_Gw_7_T_8" name="yes" sourceRef="Gw_7" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_Gw_7_T_9" name="no" sourceRef="Gw_7" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_Gw_5_T_6" name="yes" sourceRef="Gw_5" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_Gw_5_T_10" name="no" sourceRef="Gw_5" targetRef="T_10" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_4" name="move work along" sourceRef="Gw_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_11_prioritized" sourceRef="T_11" targetRef="prioritized" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_11" name="re-triage something" sourceRef="Gw_3" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_T_12_ranked" sourceRef="T_12" targetRef="ranked" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_12" name="order what is waiting" sourceRef="Gw_3" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_T_13_T_14" sourceRef="T_13" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_T_14_amended" sourceRef="T_14" targetRef="amended" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_13" name="fix what a task says" sourceRef="Gw_3" targetRef="T_13" />
    <bpmn:sequenceFlow id="SF_T_15_archived" sourceRef="T_15" targetRef="archived" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_15" name="file one away" sourceRef="Gw_3" targetRef="T_15" />
    <bpmn:sequenceFlow id="SF_T_16_deleted" sourceRef="T_16" targetRef="deleted" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_16" name="throw one away" sourceRef="Gw_3" targetRef="T_16" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_17" name="move to another board" sourceRef="Gw_3" targetRef="T_17" />
    <bpmn:sequenceFlow id="SF_activitySet_working" sourceRef="activitySet" targetRef="working" />
    <bpmn:sequenceFlow id="SF_T_9_working" sourceRef="T_9" targetRef="working" />
    <bpmn:sequenceFlow id="SF_T_10_working" sourceRef="T_10" targetRef="working" />
    <bpmn:sequenceFlow id="SF_prioritized_working" sourceRef="prioritized" targetRef="working" />
    <bpmn:sequenceFlow id="SF_ranked_working" sourceRef="ranked" targetRef="working" />
    <bpmn:sequenceFlow id="SF_amended_working" sourceRef="amended" targetRef="working" />
    <bpmn:sequenceFlow id="SF_archived_working" sourceRef="archived" targetRef="working" />
    <bpmn:sequenceFlow id="SF_deleted_working" sourceRef="deleted" targetRef="working" />
    <bpmn:sequenceFlow id="SF_T_17_execution" sourceRef="T_17" targetRef="execution" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="taskDraftIn" name="Task draft submitted">
      <bpmn:outgoing>SF_taskDraftIn_BP11.10_DraftTheTaskInput</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_taskDraftIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP11.10_DraftTheTaskInput" name="Draft the task input">
      <bpmn:incoming>SF_taskDraftIn_BP11.10_DraftTheTaskInput</bpmn:incoming>
      <bpmn:outgoing>SF_BP11.10_DraftTheTaskInput_End_20</bpmn:outgoing>
      <bpmn:startEvent id="BP11.10_DraftTheTaskInput_s" name="Start">
        <bpmn:outgoing>SF_BP11.10_DraftTheTaskInput_s_T_19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_19" name="Keep what is typed as a draft">
        <bpmn:incoming>SF_BP11.10_DraftTheTaskInput_s_T_19</bpmn:incoming>
        <bpmn:outgoing>SF_T_19_BP11.10_DraftTheTaskInput_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP11.10_DraftTheTaskInput_e" name="fertig">
        <bpmn:incoming>SF_T_19_BP11.10_DraftTheTaskInput_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_BP11.10_DraftTheTaskInput_s_T_19" sourceRef="BP11.10_DraftTheTaskInput_s" targetRef="T_19" />
      <bpmn:sequenceFlow id="SF_T_19_BP11.10_DraftTheTaskInput_e" sourceRef="T_19" targetRef="BP11.10_DraftTheTaskInput_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_20" name="Draft kept">
      <bpmn:incoming>SF_BP11.10_DraftTheTaskInput_End_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="stripIn" name="Board strip requested">
      <bpmn:outgoing>SF_stripIn_BP11.01_ReadTheBoardsInPlay</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_stripIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP11.01_ReadTheBoardsInPlay" name="Read the boards in play">
      <bpmn:incoming>SF_stripIn_BP11.01_ReadTheBoardsInPlay</bpmn:incoming>
      <bpmn:outgoing>SF_BP11.01_ReadTheBoardsInPlay_End_26</bpmn:outgoing>
      <bpmn:startEvent id="BP11.01_ReadTheBoardsInPlay_s" name="Start">
        <bpmn:outgoing>SF_BP11.01_ReadTheBoardsInPlay_s_T_21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_21" name="Read every board that exists">
        <bpmn:incoming>SF_BP11.01_ReadTheBoardsInPlay_s_T_21</bpmn:incoming>
        <bpmn:outgoing>SF_T_21_T_22</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_22" name="Leave an archived project's boards out">
