<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP13_CheckOutTheWork" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP13_CheckOutTheWork">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP13.01 · Read the account since the last check-out" sourceRef="T_2" targetRef="accountIn" />
    <bpmn:messageFlow id="MF_2" name="BP13.03 · Check out the work" sourceRef="T_5" targetRef="closeIn" />
    <bpmn:messageFlow id="MF_3" name="The figures, and what was completed" sourceRef="BP13.01_ReadTheAccount" targetRef="account" />
    <bpmn:messageFlow id="MF_4" name="The check-out outcome" sourceRef="BP13.03_CheckOutTheWork" targetRef="log" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Work to settle">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Open the check-out">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_account</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="account" name="The figures, and what was completed">
      <bpmn:incoming>SF_T_2_account</bpmn:incoming>
      <bpmn:outgoing>SF_account_T_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_account" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_3" name="Write the check-out notes">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_account_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_T_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_4" name="Choose whether to archive what is done">
      <bpmn:incoming>SF_T_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_T_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_5" name="Complete the check-out">
      <bpmn:incoming>SF_T_4_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_log</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="log" name="The check-out outcome">
      <bpmn:incoming>SF_T_5_log</bpmn:incoming>
      <bpmn:outgoing>SF_log_End_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_log" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_6" name="Work settled">
      <bpmn:incoming>SF_log_End_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_account" sourceRef="T_2" targetRef="account" />
    <bpmn:sequenceFlow id="SF_account_T_3" sourceRef="account" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_T_3_T_4" sourceRef="T_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_4_T_5" sourceRef="T_4" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_5_log" sourceRef="T_5" targetRef="log" />
    <bpmn:sequenceFlow id="SF_log_End_6" sourceRef="log" targetRef="End_6" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="accountIn" name="Account requested">
      <bpmn:outgoing>SF_accountIn_BP13.01_ReadTheAccount</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_accountIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP13.01_ReadTheAccount" name="Read the account since the last check-out">
      <bpmn:incoming>SF_accountIn_BP13.01_ReadTheAccount</bpmn:incoming>
      <bpmn:outgoing>SF_BP13.01_ReadTheAccount_End_12</bpmn:outgoing>
      <bpmn:startEvent id="BP13.01_ReadTheAccount_s" name="Start">
        <bpmn:outgoing>SF_BP13.01_ReadTheAccount_s_T_7</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_7" name="Take everything since the last check-out, or everything so far where there is none">
        <bpmn:incoming>SF_BP13.01_ReadTheAccount_s_T_7</bpmn:incoming>
        <bpmn:outgoing>SF_T_7_T_8</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_8" name="Take what reached Done or InProgress in that span, and on which boards">
        <bpmn:incoming>SF_T_7_T_8</bpmn:incoming>
        <bpmn:outgoing>SF_T_8_T_9</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_9" name="Take the boards the span's focuses chose">
        <bpmn:incoming>SF_T_8_T_9</bpmn:incoming>
        <bpmn:outgoing>SF_T_9_T_10</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_10" name="Count the span's figures over the boards that moved and the boards that were chosen">
        <bpmn:incoming>SF_T_9_T_10</bpmn:incoming>
        <bpmn:outgoing>SF_T_10_T_11</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_11" name="Report the account">
        <bpmn:incoming>SF_T_10_T_11</bpmn:incoming>
        <bpmn:outgoing>SF_T_11_BP13.01_ReadTheAccount_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP13.01_ReadTheAccount_e" name="fertig">
        <bpmn:incoming>SF_T_11_BP13.01_ReadTheAccount_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_7_T_8" sourceRef="T_7" targetRef="T_8" />
      <bpmn:sequenceFlow id="SF_T_8_T_9" sourceRef="T_8" targetRef="T_9" />
      <bpmn:sequenceFlow id="SF_T_9_T_10" sourceRef="T_9" targetRef="T_10" />
      <bpmn:sequenceFlow id="SF_T_10_T_11" sourceRef="T_10" targetRef="T_11" />
      <bpmn:sequenceFlow id="SF_BP13.01_ReadTheAccount_s_T_7" sourceRef="BP13.01_ReadTheAccount_s" targetRef="T_7" />
      <bpmn:sequenceFlow id="SF_T_11_BP13.01_ReadTheAccount_e" sourceRef="T_11" targetRef="BP13.01_ReadTheAccount_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_12" name="Account answered">
      <bpmn:incoming>SF_BP13.01_ReadTheAccount_End_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="closeIn" name="Check-out submitted">
      <bpmn:outgoing>SF_closeIn_BP13.03_CheckOutTheWork</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_closeIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP13.03_CheckOutTheWork" name="Check out the work">
      <bpmn:incoming>SF_closeIn_BP13.03_CheckOutTheWork</bpmn:incoming>
      <bpmn:outgoing>SF_BP13.03_CheckOutTheWork_End_16</bpmn:outgoing>
      <bpmn:startEvent id="BP13.03_CheckOutTheWork_s" name="Start">
        <bpmn:outgoing>SF_BP13.03_CheckOutTheWork_s_T_13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_13" name="Append the check-out's log">
        <bpmn:incoming>SF_BP13.03_CheckOutTheWork_s_T_13</bpmn:incoming>
        <bpmn:outgoing>SF_T_13_T_14</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_14" name="Archive what the check-out asked to archive">
        <bpmn:incoming>SF_T_13_T_14</bpmn:incoming>
        <bpmn:outgoing>SF_T_14_T_15</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_15" name="Report the outcome, with the check-out's log">
        <bpmn:incoming>SF_T_14_T_15</bpmn:incoming>
        <bpmn:outgoing>SF_T_15_BP13.03_CheckOutTheWork_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP13.03_CheckOutTheWork_e" name="fertig">
        <bpmn:incoming>SF_T_15_BP13.03_CheckOutTheWork_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_13_T_14" sourceRef="T_13" targetRef="T_14" />
      <bpmn:sequenceFlow id="SF_T_14_T_15" sourceRef="T_14" targetRef="T_15" />
      <bpmn:sequenceFlow id="SF_BP13.03_CheckOutTheWork_s_T_13" sourceRef="BP13.03_CheckOutTheWork_s" targetRef="T_13" />
      <bpmn:sequenceFlow id="SF_T_15_BP13.03_CheckOutTheWork_e" sourceRef="T_15" targetRef="BP13.03_CheckOutTheWork_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_16" name="Check-out answered">
      <bpmn:incoming>SF_BP13.03_CheckOutTheWork_End_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_accountIn_BP13.01_ReadTheAccount" sourceRef="accountIn" targetRef="BP13.01_ReadTheAccount" />
    <bpmn:sequenceFlow id="SF_BP13.01_ReadTheAccount_End_12" sourceRef="BP13.01_ReadTheAccount" targetRef="End_12" />
    <bpmn:sequenceFlow id="SF_closeIn_BP13.03_CheckOutTheWork" sourceRef="closeIn" targetRef="BP13.03_CheckOutTheWork" />
    <bpmn:sequenceFlow id="SF_BP13.03_CheckOutTheWork_End_16" sourceRef="BP13.03_CheckOutTheWork" targetRef="End_16" />
  </bpmn:process>
