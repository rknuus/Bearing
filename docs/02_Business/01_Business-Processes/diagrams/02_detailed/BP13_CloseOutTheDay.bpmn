<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP13_CloseOutTheDay" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP13_CloseOutTheDay">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP13.01 · Read the day's account" sourceRef="checkOut" targetRef="accountIn" />
    <bpmn:messageFlow id="MF_2" name="BP13.02 · Draft the day notes" sourceRef="T_3" targetRef="notesIn" />
    <bpmn:messageFlow id="MF_3" name="BP13.03 · Close out the day" sourceRef="closing" targetRef="closeIn" />
    <bpmn:messageFlow id="MF_4" name="What is done and what is still open" sourceRef="BP13.01_ReadTheDaysAccount" targetRef="account" />
    <bpmn:messageFlow id="MF_5" name="Notes drafted" sourceRef="BP13.02_DraftTheDayNotes" targetRef="notesDrafted" />
    <bpmn:messageFlow id="MF_6" name="The day's log" sourceRef="BP13.03_CloseOutTheDay" targetRef="log" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>Both lists are read from the boards as they stand, not from when anything moved. The user confirms them rather than editing them.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_2" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>The notes are a running journal started in the morning and finished in the evening, so the draft is current at every moment.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="notesDrafted" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>The archive action takes every task in a Done column on the day's boards and on Chores.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="T_5" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>Reset returns the task to the top of its Backlog bucket, where its triage re-opens.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="T_8" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>Running the check-out again on the same date updates that day's log rather than creating a second one.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="log" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>Chores is out of the account even while it is in play: a chore being done is not progress on what was committed to. A date with no focus has an empty account. A date never checked out stays checkable out.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="BP13.01_ReadTheDaysAccount" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>A draft is not a commit. The notes enter the day's log when the check-out completes.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="BP13.02_DraftTheDayNotes" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>The reset touches the day's chosen boards only. Chores tasks already archived by hand are simply not there to take. The log stays available as that day's explanation.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="BP13.03_CloseOutTheDay" targetRef="TextAnnotation_X8" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A day to settle">
      <bpmn:outgoing>SF_Start_1_checkOut</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="checkOut" name="Open the day check-out">
      <bpmn:incoming>SF_Start_1_checkOut</bpmn:incoming>
      <bpmn:outgoing>SF_checkOut_account</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="account" name="What is done and what is still open">
      <bpmn:incoming>SF_checkOut_account</bpmn:incoming>
      <bpmn:outgoing>SF_account_T_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_account" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_2" name="Confirm the account as it stands">
      <bpmn:incoming>SF_account_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_T_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_3" name="Write the day notes">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_T_2_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_notesDrafted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="notesDrafted" name="Notes drafted">
      <bpmn:incoming>SF_T_3_notesDrafted</bpmn:incoming>
      <bpmn:outgoing>SF_notesDrafted_Gw_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_notesDrafted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_4" name="Archive what is in Done?">
      <bpmn:incoming>SF_notesDrafted_Gw_4</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_4_T_5</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_4_T_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_5" name="Keep the archive action on">
      <bpmn:incoming>SF_Gw_4_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_Gw_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_6" name="Turn the archive action off">
      <bpmn:incoming>SF_Gw_4_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_Gw_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_7" name="Reset what is still open?">
      <bpmn:incoming>SF_T_5_Gw_7</bpmn:incoming>
      <bpmn:incoming>SF_T_6_Gw_7</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_7_T_8</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_7_T_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_8" name="Turn the reset action on">
      <bpmn:incoming>SF_Gw_7_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_closing</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_9" name="Leave the reset action off">
      <bpmn:incoming>SF_Gw_7_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_closing</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="closing" name="Complete the check-out">
      <bpmn:incoming>SF_T_8_closing</bpmn:incoming>
      <bpmn:incoming>SF_T_9_closing</bpmn:incoming>
      <bpmn:outgoing>SF_closing_log</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="log" name="The day's log">
      <bpmn:incoming>SF_closing_log</bpmn:incoming>
      <bpmn:outgoing>SF_log_End_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_log" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_10" name="Day settled">
      <bpmn:incoming>SF_log_End_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_checkOut" sourceRef="Start_1" targetRef="checkOut" />
    <bpmn:sequenceFlow id="SF_checkOut_account" sourceRef="checkOut" targetRef="account" />
    <bpmn:sequenceFlow id="SF_account_T_2" sourceRef="account" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_T_3" sourceRef="T_2" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_T_3_notesDrafted" sourceRef="T_3" targetRef="notesDrafted" />
    <bpmn:sequenceFlow id="SF_notesDrafted_Gw_4" sourceRef="notesDrafted" targetRef="Gw_4" />
    <bpmn:sequenceFlow id="SF_Gw_4_T_5" name="yes, the default" sourceRef="Gw_4" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_Gw_4_T_6" name="no" sourceRef="Gw_4" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_T_5_Gw_7" sourceRef="T_5" targetRef="Gw_7" />
    <bpmn:sequenceFlow id="SF_T_6_Gw_7" sourceRef="T_6" targetRef="Gw_7" />
    <bpmn:sequenceFlow id="SF_Gw_7_T_8" name="yes" sourceRef="Gw_7" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_Gw_7_T_9" name="no, the default" sourceRef="Gw_7" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_T_8_closing" sourceRef="T_8" targetRef="closing" />
    <bpmn:sequenceFlow id="SF_T_9_closing" sourceRef="T_9" targetRef="closing" />
    <bpmn:sequenceFlow id="SF_closing_log" sourceRef="closing" targetRef="log" />
    <bpmn:sequenceFlow id="SF_log_End_10" sourceRef="log" targetRef="End_10" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="accountIn" name="Day account requested">
      <bpmn:outgoing>SF_accountIn_BP13.01_ReadTheDaysAccount</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_accountIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP13.01_ReadTheDaysAccount" name="Read the day's account">
      <bpmn:incoming>SF_accountIn_BP13.01_ReadTheDaysAccount</bpmn:incoming>
      <bpmn:outgoing>SF_BP13.01_ReadTheDaysAccount_End_16</bpmn:outgoing>
      <bpmn:startEvent id="BP13.01_ReadTheDaysAccount_s" name="Start">
        <bpmn:outgoing>SF_BP13.01_ReadTheDaysAccount_s_T_11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_11" name="Read the boards the date's focus chose">
        <bpmn:incoming>SF_BP13.01_ReadTheDaysAccount_s_T_11</bpmn:incoming>
        <bpmn:outgoing>SF_T_11_T_12</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_12" name="Collect the tasks currently in a Done column">
        <bpmn:incoming>SF_T_11_T_12</bpmn:incoming>
        <bpmn:outgoing>SF_T_12_T_13</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_13" name="Collect the tasks past Backlog and not Done">
        <bpmn:incoming>SF_T_12_T_13</bpmn:incoming>
        <bpmn:outgoing>SF_T_13_T_14</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_14" name="Read the day notes drafted so far">
        <bpmn:incoming>SF_T_13_T_14</bpmn:incoming>
        <bpmn:outgoing>SF_T_14_T_15</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_15" name="Report the account">
        <bpmn:incoming>SF_T_14_T_15</bpmn:incoming>
        <bpmn:outgoing>SF_T_15_BP13.01_ReadTheDaysAccount_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP13.01_ReadTheDaysAccount_e" name="fertig">
        <bpmn:incoming>SF_T_15_BP13.01_ReadTheDaysAccount_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_11_T_12" sourceRef="T_11" targetRef="T_12" />
      <bpmn:sequenceFlow id="SF_T_12_T_13" sourceRef="T_12" targetRef="T_13" />
      <bpmn:sequenceFlow id="SF_T_13_T_14" sourceRef="T_13" targetRef="T_14" />
      <bpmn:sequenceFlow id="SF_T_14_T_15" sourceRef="T_14" targetRef="T_15" />
      <bpmn:sequenceFlow id="SF_BP13.01_ReadTheDaysAccount_s_T_11" sourceRef="BP13.01_ReadTheDaysAccount_s" targetRef="T_11" />
      <bpmn:sequenceFlow id="SF_T_15_BP13.01_ReadTheDaysAccount_e" sourceRef="T_15" targetRef="BP13.01_ReadTheDaysAccount_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_16" name="Account answered">
      <bpmn:incoming>SF_BP13.01_ReadTheDaysAccount_End_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="notesIn" name="Day notes drafted">
      <bpmn:outgoing>SF_notesIn_BP13.02_DraftTheDayNotes</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_notesIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP13.02_DraftTheDayNotes" name="Draft the day notes">
      <bpmn:incoming>SF_notesIn_BP13.02_DraftTheDayNotes</bpmn:incoming>
      <bpmn:outgoing>SF_BP13.02_DraftTheDayNotes_End_19</bpmn:outgoing>
      <bpmn:startEvent id="BP13.02_DraftTheDayNotes_s" name="Start">
        <bpmn:outgoing>SF_BP13.02_DraftTheDayNotes_s_T_17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_17" name="Keep the notes as a draft">
        <bpmn:incoming>SF_BP13.02_DraftTheDayNotes_s_T_17</bpmn:incoming>
        <bpmn:outgoing>SF_T_17_T_18</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_18" name="Hold the draft out of version control">
        <bpmn:incoming>SF_T_17_T_18</bpmn:incoming>
        <bpmn:outgoing>SF_T_18_BP13.02_DraftTheDayNotes_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP13.02_DraftTheDayNotes_e" name="fertig">
        <bpmn:incoming>SF_T_18_BP13.02_DraftTheDayNotes_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_17_T_18" sourceRef="T_17" targetRef="T_18" />
      <bpmn:sequenceFlow id="SF_BP13.02_DraftTheDayNotes_s_T_17" sourceRef="BP13.02_DraftTheDayNotes_s" targetRef="T_17" />
      <bpmn:sequenceFlow id="SF_T_18_BP13.02_DraftTheDayNotes_e" sourceRef="T_18" targetRef="BP13.02_DraftTheDayNotes_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_19" name="Notes answered">
      <bpmn:incoming>SF_BP13.02_DraftTheDayNotes_End_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="closeIn" name="Check-out submitted">
      <bpmn:outgoing>SF_closeIn_BP13.03_CloseOutTheDay</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_closeIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP13.03_CloseOutTheDay" name="Close out the day">
      <bpmn:incoming>SF_closeIn_BP13.03_CloseOutTheDay</bpmn:incoming>
      <bpmn:outgoing>SF_BP13.03_CloseOutTheDay_End_29</bpmn:outgoing>
      <bpmn:startEvent id="BP13.03_CloseOutTheDay_s" name="Start">
        <bpmn:outgoing>SF_BP13.03_CloseOutTheDay_s_T_20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_20" name="Record the notes and both task sets as the date's log">
        <bpmn:incoming>SF_BP13.03_CloseOutTheDay_s_T_20</bpmn:incoming>
        <bpmn:outgoing>SF_T_20_Gw_21</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="Gw_21" name="Archive the completed?">
        <bpmn:incoming>SF_T_20_Gw_21</bpmn:incoming>
        <bpmn:outgoing>SF_Gw_21_T_22</bpmn:outgoing>
        <bpmn:outgoing>SF_Gw_21_T_24</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="T_22" name="Archive every task in a Done column on the day's boards">
        <bpmn:incoming>SF_Gw_21_T_22</bpmn:incoming>
        <bpmn:outgoing>SF_T_22_T_23</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_23" name="Archive every task in a Done column on Chores">
        <bpmn:incoming>SF_T_22_T_23</bpmn:incoming>
        <bpmn:outgoing>SF_T_23_Gw_25</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_24" name="Leave the completed tasks where they are">
        <bpmn:incoming>SF_Gw_21_T_24</bpmn:incoming>
        <bpmn:outgoing>SF_T_24_Gw_25</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="Gw_25" name="Reset the still open?">
        <bpmn:incoming>SF_T_23_Gw_25</bpmn:incoming>
        <bpmn:incoming>SF_T_24_Gw_25</bpmn:incoming>
        <bpmn:outgoing>SF_Gw_25_T_26</bpmn:outgoing>
        <bpmn:outgoing>SF_Gw_25_T_27</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="T_26" name="Return each to the top of its Backlog bucket, rightmost column highest">
        <bpmn:incoming>SF_Gw_25_T_26</bpmn:incoming>
        <bpmn:outgoing>SF_T_26_T_28</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_27" name="Leave the open tasks in their columns">
        <bpmn:incoming>SF_Gw_25_T_27</bpmn:incoming>
        <bpmn:outgoing>SF_T_27_T_28</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_28" name="Report the day's log">
        <bpmn:incoming>SF_T_26_T_28</bpmn:incoming>
        <bpmn:incoming>SF_T_27_T_28</bpmn:incoming>
        <bpmn:outgoing>SF_T_28_BP13.03_CloseOutTheDay_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP13.03_CloseOutTheDay_e" name="fertig">
        <bpmn:incoming>SF_T_28_BP13.03_CloseOutTheDay_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_20_Gw_21" sourceRef="T_20" targetRef="Gw_21" />
      <bpmn:sequenceFlow id="SF_T_22_T_23" sourceRef="T_22" targetRef="T_23" />
      <bpmn:sequenceFlow id="SF_Gw_21_T_22" name="archive them" sourceRef="Gw_21" targetRef="T_22" />
      <bpmn:sequenceFlow id="SF_Gw_21_T_24" name="leave them" sourceRef="Gw_21" targetRef="T_24" />
      <bpmn:sequenceFlow id="SF_T_23_Gw_25" sourceRef="T_23" targetRef="Gw_25" />
      <bpmn:sequenceFlow id="SF_T_24_Gw_25" sourceRef="T_24" targetRef="Gw_25" />
      <bpmn:sequenceFlow id="SF_Gw_25_T_26" name="reset them" sourceRef="Gw_25" targetRef="T_26" />
      <bpmn:sequenceFlow id="SF_Gw_25_T_27" name="leave them" sourceRef="Gw_25" targetRef="T_27" />
      <bpmn:sequenceFlow id="SF_T_26_T_28" sourceRef="T_26" targetRef="T_28" />
      <bpmn:sequenceFlow id="SF_T_27_T_28" sourceRef="T_27" targetRef="T_28" />
      <bpmn:sequenceFlow id="SF_BP13.03_CloseOutTheDay_s_T_20" sourceRef="BP13.03_CloseOutTheDay_s" targetRef="T_20" />
      <bpmn:sequenceFlow id="SF_T_28_BP13.03_CloseOutTheDay_e" sourceRef="T_28" targetRef="BP13.03_CloseOutTheDay_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_29" name="Check-out answered">
      <bpmn:incoming>SF_BP13.03_CloseOutTheDay_End_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_accountIn_BP13.01_ReadTheDaysAccount" sourceRef="accountIn" targetRef="BP13.01_ReadTheDaysAccount" />
    <bpmn:sequenceFlow id="SF_BP13.01_ReadTheDaysAccount_End_16" sourceRef="BP13.01_ReadTheDaysAccount" targetRef="End_16" />
    <bpmn:sequenceFlow id="SF_notesIn_BP13.02_DraftTheDayNotes" sourceRef="notesIn" targetRef="BP13.02_DraftTheDayNotes" />
    <bpmn:sequenceFlow id="SF_BP13.02_DraftTheDayNotes_End_19" sourceRef="BP13.02_DraftTheDayNotes" targetRef="End_19" />
    <bpmn:sequenceFlow id="SF_closeIn_BP13.03_CloseOutTheDay" sourceRef="closeIn" targetRef="BP13.03_CloseOutTheDay" />
    <bpmn:sequenceFlow id="SF_BP13.03_CloseOutTheDay_End_29" sourceRef="BP13.03_CloseOutTheDay" targetRef="End_29" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_BP13_CloseOutTheDay">
    <bpmndi:BPMNPlane id="P_BP13_CloseOutTheDay" bpmnElement="Collaboration_BP13_CloseOutTheDay">
      <bpmndi:BPMNShape id="Participant_User_di" bpmnElement="Participant_User" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2260" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Bearing_di" bpmnElement="Participant_Bearing" isHorizontal="true">
        <dc:Bounds x="160" y="500" width="2260" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="252" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="228" y="223" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="checkOut_di" bpmnElement="checkOut">
        <dc:Bounds x="390" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="account_di" bpmnElement="account">
        <dc:Bounds x="592" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="568" y="223" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_2_di" bpmnElement="T_2">
