<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP14_RollTheDayOver" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP14_RollTheDayOver">
    <bpmn:participant id="Participant_Clock" name="Clock" processRef="Process_Clock">
      <bpmn:extensionElements>
        <bpd:initiator xmlns:bpd="urn:bpmn-dsl:pool" kind="scheduler" />
      </bpmn:extensionElements>
    </bpmn:participant>
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP14.01 · Roll the day over" sourceRef="T_2" targetRef="rollIn" />
    <bpmn:messageFlow id="MF_2" name="The day rolled over" sourceRef="BP14.01_RollTheDayOver" targetRef="rolled" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>The board in front of the user stays open and a gesture already under way, a drag included, is unaffected.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="rolled" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>Setting the focus is its own process. The offer only opens it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_8" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>The offer changes nothing by itself. Ignoring it leaves the day unfocused.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="T_9" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>Rollover creates nothing and destroys nothing: no task is spawned, nothing is archived and nothing is closed. A date never checked out stays checkable out. Chores follows the new date on its own while it carries work that is not done.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="BP14.01_RollTheDayOver" targetRef="TextAnnotation_X4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Clock" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Local midnight">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
          <bpmn:timerEventDefinition id="TED_Start_1" />
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Reach the next date">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_End_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_3" name="Date advanced">
      <bpmn:incoming>SF_T_2_End_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_End_3" sourceRef="T_2" targetRef="End_3" />
  </bpmn:process>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_4" name="At work in Bearing">
      <bpmn:outgoing>SF_Start_4_working</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="working" name="Work on whatever is open">
      <bpmn:incoming>SF_Start_4_working</bpmn:incoming>
      <bpmn:incoming>SF_T_9_working</bpmn:incoming>
      <bpmn:outgoing>SF_working_rolled</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="rolled" name="The day rolled over">
      <bpmn:incoming>SF_working_rolled</bpmn:incoming>
      <bpmn:outgoing>SF_rolled_Gw_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_rolled" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_5" name="Is the new date's focus empty?">
      <bpmn:incoming>SF_rolled_Gw_5</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_5_T_6</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_5_T_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_6" name="Read the offer to set the day's focus">
      <bpmn:incoming>SF_Gw_5_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_Gw_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_7" name="Take the offer?">
      <bpmn:incoming>SF_T_6_Gw_7</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_7_T_8</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_7_T_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_8" name="Open the day focus editor">
      <bpmn:incoming>SF_Gw_7_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_End_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_9" name="Carry on with what was open">
      <bpmn:incoming>SF_Gw_7_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_working</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_10" name="Carry on with the new date in play">
      <bpmn:incoming>SF_Gw_5_T_10</bpmn:incoming>
      <bpmn:outgoing>SF_T_10_End_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_11" name="New day in play">
      <bpmn:incoming>SF_T_8_End_11</bpmn:incoming>
      <bpmn:incoming>SF_T_10_End_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_4_working" sourceRef="Start_4" targetRef="working" />
    <bpmn:sequenceFlow id="SF_working_rolled" sourceRef="working" targetRef="rolled" />
    <bpmn:sequenceFlow id="SF_rolled_Gw_5" sourceRef="rolled" targetRef="Gw_5" />
    <bpmn:sequenceFlow id="SF_T_6_Gw_7" sourceRef="T_6" targetRef="Gw_7" />
    <bpmn:sequenceFlow id="SF_Gw_7_T_8" name="take it" sourceRef="Gw_7" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_Gw_7_T_9" name="ignore it" sourceRef="Gw_7" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_Gw_5_T_6" name="yes" sourceRef="Gw_5" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_Gw_5_T_10" name="no" sourceRef="Gw_5" targetRef="T_10" />
    <bpmn:sequenceFlow id="SF_T_8_End_11" sourceRef="T_8" targetRef="End_11" />
    <bpmn:sequenceFlow id="SF_T_10_End_11" sourceRef="T_10" targetRef="End_11" />
    <bpmn:sequenceFlow id="SF_T_9_working" sourceRef="T_9" targetRef="working" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="rollIn" name="Rollover due">
      <bpmn:outgoing>SF_rollIn_BP14.01_RollTheDayOver</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_rollIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP14.01_RollTheDayOver" name="Roll the day over">
      <bpmn:incoming>SF_rollIn_BP14.01_RollTheDayOver</bpmn:incoming>
      <bpmn:outgoing>SF_BP14.01_RollTheDayOver_End_16</bpmn:outgoing>
      <bpmn:startEvent id="BP14.01_RollTheDayOver_s" name="Start">
        <bpmn:outgoing>SF_BP14.01_RollTheDayOver_s_T_12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_12" name="Advance which date is current">
        <bpmn:incoming>SF_BP14.01_RollTheDayOver_s_T_12</bpmn:incoming>
        <bpmn:outgoing>SF_T_12_T_13</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_13" name="Put the new date's focus in play, empty until it is set">
        <bpmn:incoming>SF_T_12_T_13</bpmn:incoming>
        <bpmn:outgoing>SF_T_13_T_14</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_14" name="Carry the previous date's focus and log into history">
        <bpmn:incoming>SF_T_13_T_14</bpmn:incoming>
        <bpmn:outgoing>SF_T_14_T_15</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_15" name="Report whether the new date's focus is empty">
        <bpmn:incoming>SF_T_14_T_15</bpmn:incoming>
        <bpmn:outgoing>SF_T_15_BP14.01_RollTheDayOver_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP14.01_RollTheDayOver_e" name="fertig">
        <bpmn:incoming>SF_T_15_BP14.01_RollTheDayOver_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_12_T_13" sourceRef="T_12" targetRef="T_13" />
      <bpmn:sequenceFlow id="SF_T_13_T_14" sourceRef="T_13" targetRef="T_14" />
      <bpmn:sequenceFlow id="SF_T_14_T_15" sourceRef="T_14" targetRef="T_15" />
      <bpmn:sequenceFlow id="SF_BP14.01_RollTheDayOver_s_T_12" sourceRef="BP14.01_RollTheDayOver_s" targetRef="T_12" />
      <bpmn:sequenceFlow id="SF_T_15_BP14.01_RollTheDayOver_e" sourceRef="T_15" targetRef="BP14.01_RollTheDayOver_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_16" name="Rollover answered">
      <bpmn:incoming>SF_BP14.01_RollTheDayOver_End_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_rollIn_BP14.01_RollTheDayOver" sourceRef="rollIn" targetRef="BP14.01_RollTheDayOver" />
    <bpmn:sequenceFlow id="SF_BP14.01_RollTheDayOver_End_16" sourceRef="BP14.01_RollTheDayOver" targetRef="End_16" />
  </bpmn:process>
