      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_2_di" bpmnElement="Gw_2">
        <dc:Bounds x="755" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="738" y="230" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_3_di" bpmnElement="T_3">
        <dc:Bounds x="900" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_4_di" bpmnElement="T_4">
        <dc:Bounds x="900" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_5_di" bpmnElement="T_5">
        <dc:Bounds x="900" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="impact_di" bpmnElement="impact">
        <dc:Bounds x="1102" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1078" y="463" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_6_di" bpmnElement="Gw_6">
        <dc:Bounds x="1265" y="415" width="50" height="50" />
