      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_Gw_25_T_26" name="yes" sourceRef="Gw_25" targetRef="T_26" />
      <bpmn:sequenceFlow id="SF_Gw_25_T_27" name="no" sourceRef="Gw_25" targetRef="T_27" />
