<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP16_ConsultTheAdvisor" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP16_ConsultTheAdvisor">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Advisor" name="Advisor" processRef="Process_Advisor" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP16.01 · Open the advisor conversation" sourceRef="panel" targetRef="openIn" />
    <bpmn:messageFlow id="MF_2" name="BP16.08 · Draft the question" sourceRef="T_3" targetRef="questionDraftIn" />
    <bpmn:messageFlow id="MF_3" name="BP16.02 · Ask the advisor" sourceRef="T_4" targetRef="askIn" />
    <bpmn:messageFlow id="MF_4" name="BP16.07 · See what applying will take" sourceRef="T_5" targetRef="applyImpactIn" />
    <bpmn:messageFlow id="MF_5" name="BP16.04 · Apply advisor proposals" sourceRef="T_7" targetRef="applyIn" />
    <bpmn:messageFlow id="MF_6" name="BP16.05 · Dismiss advisor proposals" sourceRef="T_9" targetRef="dismissIn" />
    <bpmn:messageFlow id="MF_7" name="BP16.06 · Clear the conversation" sourceRef="T_10" targetRef="clearIn" />
    <bpmn:messageFlow id="MF_8" name="BP16.03 · Take the advisor's answer" sourceRef="T_13" targetRef="answerIn" />
    <bpmn:messageFlow id="MF_9" name="The conversation with its context" sourceRef="BP16.01_OpenTheAdvisorConversation" targetRef="conversation" />
    <bpmn:messageFlow id="MF_10" name="Advice requested" sourceRef="BP16.02_AskTheAdvisor" targetRef="adviceIn" />
    <bpmn:messageFlow id="MF_11" name="The answer with its proposals" sourceRef="BP16.03_TakeTheAdvisorsAnswer" targetRef="answer" />
    <bpmn:messageFlow id="MF_12" name="What applying will take, and where it lands" sourceRef="BP16.07_ReadWhatApplyingWillTake" targetRef="applyImpact" />
    <bpmn:messageFlow id="MF_13" name="What was applied, and where" sourceRef="BP16.04_ApplyAdvisorProposals" targetRef="applied" />
    <bpmn:messageFlow id="MF_14" name="What was dismissed" sourceRef="BP16.05_DismissAdvisorProposals" targetRef="dismissed" />
    <bpmn:messageFlow id="MF_15" name="Conversation cleared" sourceRef="BP16.06_ClearTheConversation" targetRef="cleared" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>The panel knows which view and which selection the user is on. Opening it suspends nothing.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="conversation" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>Applying runs the user's own operation, so whatever that operation discloses is disclosed here: what a deletion will take, the answers an archiving offers, and any part of the funnel the change lands in.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="applyImpact" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>Clearing is deliberate. One conversation runs for the session and nothing clears it on the user's behalf.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="cleared" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>The proposals stay outstanding and nothing is written.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="T_8" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>The answer arrives on its own. The advisor is slower than the rest of the product and stays non-blocking while it thinks.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="answer" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>Each approved proposal is then written completely. Nothing is half-applied.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="applied" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>There is one advisor and one conversation per session. The conversation is journaled and stays out of version control.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="BP16.01_OpenTheAdvisorConversation" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>Every form on this surface drafts as it is filled in, so leaving it half-finished, a crash and a restart all cost nothing. The draft is one-way: nothing waits for it to be kept. Whichever write commits the form discards it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="BP16.08_DraftTheQuestion" targetRef="TextAnnotation_X8" />
    <bpmn:textAnnotation id="TextAnnotation_X9"><bpmn:text>A proposal that takes nothing has nothing to disclose. One that deletes or archives discloses exactly what the user's own gesture would, because it is that gesture.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X9" associationDirection="None" sourceRef="BP16.07_ReadWhatApplyingWillTake" targetRef="TextAnnotation_X9" />
    <bpmn:textAnnotation id="TextAnnotation_X10"><bpmn:text>One request dismisses a single proposal and a whole answer alike. Already-resolved proposals are skipped.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X10" associationDirection="None" sourceRef="BP16.05_DismissAdvisorProposals" targetRef="TextAnnotation_X10" />
    <bpmn:textAnnotation id="TextAnnotation_X11"><bpmn:text>Applied and dismissed proposals are closed already and are unaffected by clearing.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X11" associationDirection="None" sourceRef="BP16.06_ClearTheConversation" targetRef="TextAnnotation_X11" />
    <bpmn:textAnnotation id="TextAnnotation_X12"><bpmn:text>The whole funnel goes with the question: themes, ideas, goals, routines, focus history, tasks and progress check-ins.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X12" associationDirection="None" sourceRef="BP16.02_AskTheAdvisor" targetRef="TextAnnotation_X12" />
    <bpmn:textAnnotation id="TextAnnotation_X13"><bpmn:text>A proposal is a structured object, never prose to be parsed. At most one proposal is outstanding per target, and an already-applied or already-dismissed one is closed and untouched.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X13" associationDirection="None" sourceRef="BP16.03_TakeTheAdvisorsAnswer" targetRef="TextAnnotation_X13" />
    <bpmn:textAnnotation id="TextAnnotation_X14"><bpmn:text>One request applies a single proposal and a whole answer alike. There is no second write path: a proposal to create something carries everything that thing needs.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X14" associationDirection="None" sourceRef="BP16.04_ApplyAdvisorProposals" targetRef="TextAnnotation_X14" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A second opinion wanted">
      <bpmn:outgoing>SF_Start_1_panel</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="panel" name="Open the advisor panel">
      <bpmn:incoming>SF_Start_1_panel</bpmn:incoming>
      <bpmn:outgoing>SF_panel_conversation</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="conversation" name="The conversation with its context">
      <bpmn:incoming>SF_panel_conversation</bpmn:incoming>
      <bpmn:outgoing>SF_conversation_working</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_conversation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="working" name="Work with the advisor">
      <bpmn:incoming>SF_conversation_working</bpmn:incoming>
      <bpmn:incoming>SF_answer_working</bpmn:incoming>
      <bpmn:incoming>SF_applied_working</bpmn:incoming>
      <bpmn:incoming>SF_T_8_working</bpmn:incoming>
      <bpmn:incoming>SF_dismissed_working</bpmn:incoming>
      <bpmn:incoming>SF_cleared_working</bpmn:incoming>
      <bpmn:outgoing>SF_working_Gw_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_2" name="What needs doing?">
      <bpmn:incoming>SF_working_Gw_2</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_2_T_3</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_5</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_9</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_10</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_3" name="Write the question">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_Gw_2_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_T_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_4" name="Put the question">
      <bpmn:incoming>SF_T_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_answer</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="answer" name="The answer with its proposals">
      <bpmn:incoming>SF_T_4_answer</bpmn:incoming>
      <bpmn:outgoing>SF_answer_working</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_answer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_5" name="Accept the proposal, or the whole answer">
      <bpmn:incoming>SF_Gw_2_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_applyImpact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="applyImpact" name="What applying will take, and where it lands">
      <bpmn:incoming>SF_T_5_applyImpact</bpmn:incoming>
      <bpmn:outgoing>SF_applyImpact_Gw_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_applyImpact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_6" name="Approve what applying takes?">
      <bpmn:incoming>SF_applyImpact_Gw_6</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_6_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_6_T_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_7" name="Confirm what applying takes">
      <bpmn:incoming>SF_Gw_6_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_applied</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="applied" name="What was applied, and where">
      <bpmn:incoming>SF_T_7_applied</bpmn:incoming>
      <bpmn:outgoing>SF_applied_working</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_applied" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_8" name="Abandon the application">
      <bpmn:incoming>SF_Gw_6_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_working</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_9" name="Dismiss the proposal, or the whole answer">
      <bpmn:incoming>SF_Gw_2_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_dismissed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="dismissed" name="What was dismissed">
      <bpmn:incoming>SF_T_9_dismissed</bpmn:incoming>
      <bpmn:outgoing>SF_dismissed_working</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_dismissed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_10" name="Clear the conversation">
      <bpmn:incoming>SF_Gw_2_T_10</bpmn:incoming>
      <bpmn:outgoing>SF_T_10_cleared</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="cleared" name="Conversation cleared">
      <bpmn:incoming>SF_T_10_cleared</bpmn:incoming>
      <bpmn:outgoing>SF_cleared_working</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_cleared" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_11" name="Close the panel">
      <bpmn:incoming>SF_Gw_2_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_End_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_12" name="Opinion taken or left">
      <bpmn:incoming>SF_T_11_End_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_panel" sourceRef="Start_1" targetRef="panel" />
    <bpmn:sequenceFlow id="SF_panel_conversation" sourceRef="panel" targetRef="conversation" />
    <bpmn:sequenceFlow id="SF_conversation_working" sourceRef="conversation" targetRef="working" />
    <bpmn:sequenceFlow id="SF_working_Gw_2" sourceRef="working" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="SF_T_3_T_4" sourceRef="T_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_4_answer" sourceRef="T_4" targetRef="answer" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_3" name="ask something" sourceRef="Gw_2" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_T_5_applyImpact" sourceRef="T_5" targetRef="applyImpact" />
    <bpmn:sequenceFlow id="SF_applyImpact_Gw_6" sourceRef="applyImpact" targetRef="Gw_6" />
    <bpmn:sequenceFlow id="SF_T_7_applied" sourceRef="T_7" targetRef="applied" />
    <bpmn:sequenceFlow id="SF_Gw_6_T_7" name="approve" sourceRef="Gw_6" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_Gw_6_T_8" name="abandon" sourceRef="Gw_6" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_5" name="take a proposal up" sourceRef="Gw_2" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_9_dismissed" sourceRef="T_9" targetRef="dismissed" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_9" name="turn one down" sourceRef="Gw_2" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_T_10_cleared" sourceRef="T_10" targetRef="cleared" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_10" name="start over" sourceRef="Gw_2" targetRef="T_10" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_11" name="leave it" sourceRef="Gw_2" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_T_11_End_12" sourceRef="T_11" targetRef="End_12" />
    <bpmn:sequenceFlow id="SF_answer_working" sourceRef="answer" targetRef="working" />
    <bpmn:sequenceFlow id="SF_applied_working" sourceRef="applied" targetRef="working" />
    <bpmn:sequenceFlow id="SF_T_8_working" sourceRef="T_8" targetRef="working" />
    <bpmn:sequenceFlow id="SF_dismissed_working" sourceRef="dismissed" targetRef="working" />
    <bpmn:sequenceFlow id="SF_cleared_working" sourceRef="cleared" targetRef="working" />
  </bpmn:process>
  <bpmn:process id="Process_Advisor" isExecutable="false">
    <bpmn:startEvent id="adviceIn" name="Advice requested">
      <bpmn:outgoing>SF_adviceIn_T_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_adviceIn" />
    </bpmn:startEvent>
    <bpmn:task id="T_13" name="Answer from the context it was given">
      <bpmn:incoming>SF_adviceIn_T_13</bpmn:incoming>
      <bpmn:outgoing>SF_T_13_End_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_14" name="Advice given">
      <bpmn:incoming>SF_T_13_End_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_adviceIn_T_13" sourceRef="adviceIn" targetRef="T_13" />
    <bpmn:sequenceFlow id="SF_T_13_End_14" sourceRef="T_13" targetRef="End_14" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="questionDraftIn" name="Question draft submitted">
      <bpmn:outgoing>SF_questionDraftIn_BP16.08_DraftTheQuestion</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_questionDraftIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP16.08_DraftTheQuestion" name="Draft the question">
      <bpmn:incoming>SF_questionDraftIn_BP16.08_DraftTheQuestion</bpmn:incoming>
      <bpmn:outgoing>SF_BP16.08_DraftTheQuestion_End_16</bpmn:outgoing>
      <bpmn:startEvent id="BP16.08_DraftTheQuestion_s" name="Start">
        <bpmn:outgoing>SF_BP16.08_DraftTheQuestion_s_T_15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_15" name="Keep what is typed as a draft">
        <bpmn:incoming>SF_BP16.08_DraftTheQuestion_s_T_15</bpmn:incoming>
        <bpmn:outgoing>SF_T_15_BP16.08_DraftTheQuestion_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP16.08_DraftTheQuestion_e" name="fertig">
        <bpmn:incoming>SF_T_15_BP16.08_DraftTheQuestion_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_BP16.08_DraftTheQuestion_s_T_15" sourceRef="BP16.08_DraftTheQuestion_s" targetRef="T_15" />
      <bpmn:sequenceFlow id="SF_T_15_BP16.08_DraftTheQuestion_e" sourceRef="T_15" targetRef="BP16.08_DraftTheQuestion_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_16" name="Draft kept">
      <bpmn:incoming>SF_BP16.08_DraftTheQuestion_End_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="openIn" name="Conversation requested">
      <bpmn:outgoing>SF_openIn_BP16.01_OpenTheAdvisorConversation</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_openIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP16.01_OpenTheAdvisorConversation" name="Open the advisor conversation">
      <bpmn:incoming>SF_openIn_BP16.01_OpenTheAdvisorConversation</bpmn:incoming>
      <bpmn:outgoing>SF_BP16.01_OpenTheAdvisorConversation_End_20</bpmn:outgoing>
      <bpmn:startEvent id="BP16.01_OpenTheAdvisorConversation_s" name="Start">
        <bpmn:outgoing>SF_BP16.01_OpenTheAdvisorConversation_s_T_17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_17" name="Read the session's conversation with its outstanding proposals">
        <bpmn:incoming>SF_BP16.01_OpenTheAdvisorConversation_s_T_17</bpmn:incoming>
        <bpmn:outgoing>SF_T_17_T_18</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_18" name="Read the view and the selection the user is on">
        <bpmn:incoming>SF_T_17_T_18</bpmn:incoming>
        <bpmn:outgoing>SF_T_18_T_19</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_19" name="Report the conversation">
        <bpmn:incoming>SF_T_18_T_19</bpmn:incoming>
        <bpmn:outgoing>SF_T_19_BP16.01_OpenTheAdvisorConversation_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP16.01_OpenTheAdvisorConversation_e" name="fertig">
        <bpmn:incoming>SF_T_19_BP16.01_OpenTheAdvisorConversation_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_17_T_18" sourceRef="T_17" targetRef="T_18" />
      <bpmn:sequenceFlow id="SF_T_18_T_19" sourceRef="T_18" targetRef="T_19" />
      <bpmn:sequenceFlow id="SF_BP16.01_OpenTheAdvisorConversation_s_T_17" sourceRef="BP16.01_OpenTheAdvisorConversation_s" targetRef="T_17" />
      <bpmn:sequenceFlow id="SF_T_19_BP16.01_OpenTheAdvisorConversation_e" sourceRef="T_19" targetRef="BP16.01_OpenTheAdvisorConversation_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_20" name="Conversation answered">
      <bpmn:incoming>SF_BP16.01_OpenTheAdvisorConversation_End_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="askIn" name="Question submitted">
      <bpmn:outgoing>SF_askIn_BP16.02_AskTheAdvisor</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_askIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP16.02_AskTheAdvisor" name="Ask the advisor">
      <bpmn:incoming>SF_askIn_BP16.02_AskTheAdvisor</bpmn:incoming>
      <bpmn:outgoing>SF_BP16.02_AskTheAdvisor_End_24</bpmn:outgoing>
      <bpmn:startEvent id="BP16.02_AskTheAdvisor_s" name="Start">
        <bpmn:outgoing>SF_BP16.02_AskTheAdvisor_s_T_21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_21" name="Assemble the funnel as context, with vision and mission when set">
        <bpmn:incoming>SF_BP16.02_AskTheAdvisor_s_T_21</bpmn:incoming>
        <bpmn:outgoing>SF_T_21_T_22</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_22" name="Add the view and the selection to the question">
        <bpmn:incoming>SF_T_21_T_22</bpmn:incoming>
        <bpmn:outgoing>SF_T_22_T_23</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_23" name="Record the question in the conversation">
        <bpmn:incoming>SF_T_22_T_23</bpmn:incoming>
        <bpmn:outgoing>SF_T_23_BP16.02_AskTheAdvisor_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP16.02_AskTheAdvisor_e" name="fertig">
        <bpmn:incoming>SF_T_23_BP16.02_AskTheAdvisor_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_21_T_22" sourceRef="T_21" targetRef="T_22" />
      <bpmn:sequenceFlow id="SF_T_22_T_23" sourceRef="T_22" targetRef="T_23" />
      <bpmn:sequenceFlow id="SF_BP16.02_AskTheAdvisor_s_T_21" sourceRef="BP16.02_AskTheAdvisor_s" targetRef="T_21" />
