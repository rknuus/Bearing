<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP17_MaintainAProject" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP17_MaintainAProject">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP17.02 · Edit a project" sourceRef="T_5" targetRef="editIn" />
    <bpmn:messageFlow id="MF_2" name="BP17.14 · See what archiving a project takes" sourceRef="T_9" targetRef="archImpactIn" />
    <bpmn:messageFlow id="MF_3" name="BP17.15 · Archive a project" sourceRef="T_12" targetRef="archiveIn" />
    <bpmn:messageFlow id="MF_4" name="BP17.04 · See what deleting a project takes" sourceRef="T_15" targetRef="delImpactIn" />
    <bpmn:messageFlow id="MF_5" name="BP17.05 · Delete a project" sourceRef="T_18" targetRef="deleteIn" />
    <bpmn:messageFlow id="MF_6" name="The editing outcome" sourceRef="BP17.02_CreateProject" targetRef="created" />
    <bpmn:messageFlow id="MF_7" name="What the archiving will take" sourceRef="BP17.14_ReadTheProjectArchivingImpact" targetRef="archImpact" />
    <bpmn:messageFlow id="MF_8" name="The archiving outcome" sourceRef="BP17.15_ArchiveProject" targetRef="archived" />
    <bpmn:messageFlow id="MF_9" name="What the project deletion will take" sourceRef="BP17.04_ReadTheProjectDeletionImpact" targetRef="delImpact" />
    <bpmn:messageFlow id="MF_10" name="The deletion outcome" sourceRef="BP17.05_DeleteProject" targetRef="deleted" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>Laying out the activities and their order is its own process (BP18). A simple project has no plan to open.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_7" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>The archive is reached by an explicit act, and it holds the activities and tasks that went down with a project. Reading it, bringing one back and destroying one out of it are its own process (BP15).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_21" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>The parent may be an idea, a goal or a progress measure, or there may be none. The kind holds for the project's life, so it is declared once and is not amendable.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="created" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>The activities and their tasks go with it. Nothing below a project can be kept behind.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="archived" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>Archiving a project is the only way an activity is archived at all, and it is approved whole or rejected whole.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="BP17.14_ReadTheProjectArchivingImpact" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>Everything the project is goes with it. Keeping anything below it is not offered, because nothing below a project can be detached.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="BP17.04_ReadTheProjectDeletionImpact" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>The new template starts from four columns, one per role. The kind is declared once and never migrates, and the parent is single-valued. A plan orders and tracks; it carries no duration, no float and no critical path.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="BP17.02_CreateProject" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>An archived project is frozen until it is brought back, and it comes back as the whole bundle it went as.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="BP17.15_ArchiveProject" targetRef="TextAnnotation_X8" />
    <bpmn:textAnnotation id="TextAnnotation_X9"><bpmn:text>The parent survives a project's deletion. A goal left with no linked idea is flagged on its current state.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X9" associationDirection="None" sourceRef="BP17.05_DeleteProject" targetRef="TextAnnotation_X9" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Work to organize, or a project to settle">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Work a project">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_Gw_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_3" name="What needs doing?">
      <bpmn:incoming>SF_T_2_Gw_3</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_3_T_4</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_9</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_15</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_3_T_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_4" name="Define the project">
      <bpmn:incoming>SF_Gw_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_T_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_5" name="Submit the project">
      <bpmn:incoming>SF_T_4_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_created</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="created" name="The editing outcome">
      <bpmn:incoming>SF_T_5_created</bpmn:incoming>
      <bpmn:outgoing>SF_created_End_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_created" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_6" name="Project recorded">
      <bpmn:incoming>SF_created_End_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_7" name="Open the project's course (BP18)">
      <bpmn:incoming>SF_Gw_3_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_End_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_8" name="Course opened">
      <bpmn:incoming>SF_T_7_End_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_9" name="Archive a project">
      <bpmn:incoming>SF_Gw_3_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_archImpact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="archImpact" name="What the archiving will take">
      <bpmn:incoming>SF_T_9_archImpact</bpmn:incoming>
      <bpmn:outgoing>SF_archImpact_Gw_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archImpact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_10" name="Approve what the archiving takes?">
      <bpmn:incoming>SF_archImpact_Gw_10</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_10_T_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_10_End_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_11" name="Select a valid cascading option">
      <bpmn:incoming>SF_Gw_10_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_T_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_12" name="Confirm the archiving">
      <bpmn:incoming>SF_T_11_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_archived</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="archived" name="The archiving outcome">
      <bpmn:incoming>SF_T_12_archived</bpmn:incoming>
      <bpmn:outgoing>SF_archived_End_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_13" name="Archiving abandoned">
      <bpmn:incoming>SF_Gw_10_End_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_14" name="Project set aside">
      <bpmn:incoming>SF_archived_End_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_15" name="Delete a project">
      <bpmn:incoming>SF_Gw_3_T_15</bpmn:incoming>
      <bpmn:outgoing>SF_T_15_delImpact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="delImpact" name="What the project deletion will take">
      <bpmn:incoming>SF_T_15_delImpact</bpmn:incoming>
      <bpmn:outgoing>SF_delImpact_Gw_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_delImpact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_16" name="Approve what the deletion takes?">
      <bpmn:incoming>SF_delImpact_Gw_16</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_16_T_17</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_16_End_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_17" name="Select a valid cascading option">
      <bpmn:incoming>SF_Gw_16_T_17</bpmn:incoming>
      <bpmn:outgoing>SF_T_17_T_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_18" name="Confirm the deletion">
      <bpmn:incoming>SF_T_17_T_18</bpmn:incoming>
      <bpmn:outgoing>SF_T_18_deleted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="deleted" name="The deletion outcome">
      <bpmn:incoming>SF_T_18_deleted</bpmn:incoming>
      <bpmn:outgoing>SF_deleted_End_20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_deleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_19" name="Deletion abandoned">
      <bpmn:incoming>SF_Gw_16_End_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_20" name="Project deleted">
      <bpmn:incoming>SF_deleted_End_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_21" name="Open the archived projects (BP15)">
      <bpmn:incoming>SF_Gw_3_T_21</bpmn:incoming>
      <bpmn:outgoing>SF_T_21_End_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_22" name="Archive opened">
      <bpmn:incoming>SF_T_21_End_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_T_2" sourceRef="Start_1" targetRef="T_2" />
    <bpmn:sequenceFlow id="SF_T_2_Gw_3" sourceRef="T_2" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="SF_T_4_T_5" sourceRef="T_4" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_5_created" sourceRef="T_5" targetRef="created" />
    <bpmn:sequenceFlow id="SF_created_End_6" sourceRef="created" targetRef="End_6" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_4" name="start something new, or change what a project is" sourceRef="Gw_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_7_End_8" sourceRef="T_7" targetRef="End_8" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_7" name="plan its work" sourceRef="Gw_3" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_T_9_archImpact" sourceRef="T_9" targetRef="archImpact" />
    <bpmn:sequenceFlow id="SF_archImpact_Gw_10" sourceRef="archImpact" targetRef="Gw_10" />
    <bpmn:sequenceFlow id="SF_T_11_T_12" sourceRef="T_11" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_T_12_archived" sourceRef="T_12" targetRef="archived" />
    <bpmn:sequenceFlow id="SF_Gw_10_T_11" name="approve" sourceRef="Gw_10" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_Gw_10_End_13" name="reject" sourceRef="Gw_10" targetRef="End_13" />
    <bpmn:sequenceFlow id="SF_archived_End_14" sourceRef="archived" targetRef="End_14" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_9" name="set one aside" sourceRef="Gw_3" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_T_15_delImpact" sourceRef="T_15" targetRef="delImpact" />
    <bpmn:sequenceFlow id="SF_delImpact_Gw_16" sourceRef="delImpact" targetRef="Gw_16" />
    <bpmn:sequenceFlow id="SF_T_17_T_18" sourceRef="T_17" targetRef="T_18" />
    <bpmn:sequenceFlow id="SF_T_18_deleted" sourceRef="T_18" targetRef="deleted" />
    <bpmn:sequenceFlow id="SF_Gw_16_T_17" name="approve" sourceRef="Gw_16" targetRef="T_17" />
    <bpmn:sequenceFlow id="SF_Gw_16_End_19" name="reject" sourceRef="Gw_16" targetRef="End_19" />
    <bpmn:sequenceFlow id="SF_deleted_End_20" sourceRef="deleted" targetRef="End_20" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_15" name="end one" sourceRef="Gw_3" targetRef="T_15" />
    <bpmn:sequenceFlow id="SF_T_21_End_22" sourceRef="T_21" targetRef="End_22" />
    <bpmn:sequenceFlow id="SF_Gw_3_T_21" name="look at the archived ones" sourceRef="Gw_3" targetRef="T_21" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="editIn" name="Project submitted">
      <bpmn:outgoing>SF_editIn_BP17.02_CreateProject</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_editIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP17.02_CreateProject" name="Edit a project">
      <bpmn:incoming>SF_editIn_BP17.02_CreateProject</bpmn:incoming>
      <bpmn:outgoing>SF_BP17.02_CreateProject_End_29</bpmn:outgoing>
      <bpmn:startEvent id="BP17.02_CreateProject_s" name="Start">
        <bpmn:outgoing>SF_BP17.02_CreateProject_s_Gw_23</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="Gw_23" name="Does the edit keep the project's kind?">
        <bpmn:incoming>SF_BP17.02_CreateProject_s_Gw_23</bpmn:incoming>
        <bpmn:outgoing>SF_Gw_23_T_24</bpmn:outgoing>
        <bpmn:outgoing>SF_Gw_23_T_27</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="T_24" name="Store the edit">
        <bpmn:incoming>SF_Gw_23_T_24</bpmn:incoming>
        <bpmn:outgoing>SF_T_24_T_25</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_25" name="Give a new project its own column template">
        <bpmn:incoming>SF_T_24_T_25</bpmn:incoming>
        <bpmn:outgoing>SF_T_25_T_26</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_26" name="Give it what its kind brings: one board where it is simple, an empty plan where it is activity-based">
        <bpmn:incoming>SF_T_25_T_26</bpmn:incoming>
        <bpmn:outgoing>SF_T_26_T_28</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_27" name="Store the edit and refuse the kind change, saying why">
        <bpmn:incoming>SF_Gw_23_T_27</bpmn:incoming>
        <bpmn:outgoing>SF_T_27_T_28</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_28" name="Report the outcome">
        <bpmn:incoming>SF_T_26_T_28</bpmn:incoming>
        <bpmn:incoming>SF_T_27_T_28</bpmn:incoming>
        <bpmn:outgoing>SF_T_28_BP17.02_CreateProject_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP17.02_CreateProject_e" name="fertig">
        <bpmn:incoming>SF_T_28_BP17.02_CreateProject_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_24_T_25" sourceRef="T_24" targetRef="T_25" />
      <bpmn:sequenceFlow id="SF_T_25_T_26" sourceRef="T_25" targetRef="T_26" />
      <bpmn:sequenceFlow id="SF_Gw_23_T_24" name="yes" sourceRef="Gw_23" targetRef="T_24" />
      <bpmn:sequenceFlow id="SF_Gw_23_T_27" name="no" sourceRef="Gw_23" targetRef="T_27" />
      <bpmn:sequenceFlow id="SF_T_26_T_28" sourceRef="T_26" targetRef="T_28" />
      <bpmn:sequenceFlow id="SF_T_27_T_28" sourceRef="T_27" targetRef="T_28" />
      <bpmn:sequenceFlow id="SF_BP17.02_CreateProject_s_Gw_23" sourceRef="BP17.02_CreateProject_s" targetRef="Gw_23" />
      <bpmn:sequenceFlow id="SF_T_28_BP17.02_CreateProject_e" sourceRef="T_28" targetRef="BP17.02_CreateProject_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_29" name="Project answered">
      <bpmn:incoming>SF_BP17.02_CreateProject_End_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="archImpactIn" name="Archiving impact requested">
      <bpmn:outgoing>SF_archImpactIn_BP17.14_ReadTheProjectArchivingImpact</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archImpactIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP17.14_ReadTheProjectArchivingImpact" name="See what archiving a project takes">
      <bpmn:incoming>SF_archImpactIn_BP17.14_ReadTheProjectArchivingImpact</bpmn:incoming>
      <bpmn:outgoing>SF_BP17.14_ReadTheProjectArchivingImpact_End_31</bpmn:outgoing>
      <bpmn:startEvent id="BP17.14_ReadTheProjectArchivingImpact_s" name="Start">
        <bpmn:outgoing>SF_BP17.14_ReadTheProjectArchivingImpact_s_T_30</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_30" name="Report what the archiving will take, and what of it can be declined">
        <bpmn:incoming>SF_BP17.14_ReadTheProjectArchivingImpact_s_T_30</bpmn:incoming>
        <bpmn:outgoing>SF_T_30_BP17.14_ReadTheProjectArchivingImpact_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP17.14_ReadTheProjectArchivingImpact_e" name="fertig">
        <bpmn:incoming>SF_T_30_BP17.14_ReadTheProjectArchivingImpact_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_BP17.14_ReadTheProjectArchivingImpact_s_T_30" sourceRef="BP17.14_ReadTheProjectArchivingImpact_s" targetRef="T_30" />
      <bpmn:sequenceFlow id="SF_T_30_BP17.14_ReadTheProjectArchivingImpact_e" sourceRef="T_30" targetRef="BP17.14_ReadTheProjectArchivingImpact_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_31" name="Archiving impact answered">
      <bpmn:incoming>SF_BP17.14_ReadTheProjectArchivingImpact_End_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="archiveIn" name="Project archiving requested">
      <bpmn:outgoing>SF_archiveIn_BP17.15_ArchiveProject</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archiveIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP17.15_ArchiveProject" name="Archive a project">
      <bpmn:incoming>SF_archiveIn_BP17.15_ArchiveProject</bpmn:incoming>
      <bpmn:outgoing>SF_BP17.15_ArchiveProject_End_35</bpmn:outgoing>
      <bpmn:startEvent id="BP17.15_ArchiveProject_s" name="Start">
        <bpmn:outgoing>SF_BP17.15_ArchiveProject_s_T_32</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_32" name="Archive confirmed items">
        <bpmn:incoming>SF_BP17.15_ArchiveProject_s_T_32</bpmn:incoming>
        <bpmn:outgoing>SF_T_32_T_33</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_33" name="Withdraw it from the focus selectables and hide its boards">
        <bpmn:incoming>SF_T_32_T_33</bpmn:incoming>
        <bpmn:outgoing>SF_T_33_T_34</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_34" name="Report the outcome">
        <bpmn:incoming>SF_T_33_T_34</bpmn:incoming>
        <bpmn:outgoing>SF_T_34_BP17.15_ArchiveProject_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP17.15_ArchiveProject_e" name="fertig">
        <bpmn:incoming>SF_T_34_BP17.15_ArchiveProject_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_32_T_33" sourceRef="T_32" targetRef="T_33" />
      <bpmn:sequenceFlow id="SF_T_33_T_34" sourceRef="T_33" targetRef="T_34" />
      <bpmn:sequenceFlow id="SF_BP17.15_ArchiveProject_s_T_32" sourceRef="BP17.15_ArchiveProject_s" targetRef="T_32" />
      <bpmn:sequenceFlow id="SF_T_34_BP17.15_ArchiveProject_e" sourceRef="T_34" targetRef="BP17.15_ArchiveProject_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_35" name="Project archiving answered">
