<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP17_MaintainAProject" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP17_MaintainAProject">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP17.01 · Read the project list" sourceRef="courseTab" targetRef="listIn" />
    <bpmn:messageFlow id="MF_2" name="BP17.16 · Draft the project input" sourceRef="T_3" targetRef="projectDraftIn" />
    <bpmn:messageFlow id="MF_3" name="BP17.02 · Create a project" sourceRef="T_4" targetRef="createIn" />
    <bpmn:messageFlow id="MF_4" name="BP17.03 · Amend a project" sourceRef="T_5" targetRef="amendIn" />
    <bpmn:messageFlow id="MF_5" name="BP17.14 · See what archiving a project takes" sourceRef="T_7" targetRef="archImpactIn" />
    <bpmn:messageFlow id="MF_6" name="BP17.15 · Archive a project" sourceRef="T_9" targetRef="archiveIn" />
    <bpmn:messageFlow id="MF_7" name="BP17.04 · See what deleting a project takes" sourceRef="T_11" targetRef="delImpactIn" />
    <bpmn:messageFlow id="MF_8" name="BP17.05 · Delete a project" sourceRef="T_13" targetRef="deleteIn" />
    <bpmn:messageFlow id="MF_9" name="The projects with their parents and kinds" sourceRef="BP17.01_ReadTheProjectList" targetRef="list" />
    <bpmn:messageFlow id="MF_10" name="Project created" sourceRef="BP17.02_CreateProject" targetRef="created" />
    <bpmn:messageFlow id="MF_11" name="Project amended" sourceRef="BP17.03_AmendProject" targetRef="amended" />
    <bpmn:messageFlow id="MF_12" name="What the archiving will take" sourceRef="BP17.14_ReadTheProjectArchivingImpact" targetRef="archImpact" />
    <bpmn:messageFlow id="MF_13" name="Project archived" sourceRef="BP17.15_ArchiveProject" targetRef="archived" />
    <bpmn:messageFlow id="MF_14" name="What the project deletion will take" sourceRef="BP17.04_ReadTheProjectDeletionImpact" targetRef="delImpact" />
    <bpmn:messageFlow id="MF_15" name="Project deleted" sourceRef="BP17.05_DeleteProject" targetRef="deleted" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>Laying out the activities and their order is its own process. A simple project has no plan to open.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_6" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>The name and the parent are one request. The kind is not among them.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="amended" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>The parent may be an idea, a goal or a progress measure, or there may be none. The kind holds for the project's life.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="created" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>Nothing is archived.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="T_10" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>Nothing is deleted. The parent keeps its link.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="T_14" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>The activities and their tasks go with it. Nothing below a project can be kept behind.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="archived" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>There is no in-app undo. Recovery is from version control.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="deleted" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>A project with no parent is legitimate. The counts are of activities; a simple project has none.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="BP17.01_ReadTheProjectList" targetRef="TextAnnotation_X8" />
    <bpmn:textAnnotation id="TextAnnotation_X9"><bpmn:text>Every form on this surface drafts as it is filled in, so leaving it half-finished, a crash and a restart all cost nothing. The draft is one-way: nothing waits for it to be kept. Whichever write commits the form discards it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X9" associationDirection="None" sourceRef="BP17.16_DraftTheProjectInput" targetRef="TextAnnotation_X9" />
    <bpmn:textAnnotation id="TextAnnotation_X10"><bpmn:text>The parent is single-valued and the user is never asked what kind of thing it is.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X10" associationDirection="None" sourceRef="BP17.03_AmendProject" targetRef="TextAnnotation_X10" />
    <bpmn:textAnnotation id="TextAnnotation_X11"><bpmn:text>Archiving a project is the only way an activity is archived at all, and it is approved whole or rejected whole.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X11" associationDirection="None" sourceRef="BP17.14_ReadTheProjectArchivingImpact" targetRef="TextAnnotation_X11" />
    <bpmn:textAnnotation id="TextAnnotation_X12"><bpmn:text>Everything the project is goes with it. Keeping anything below it is not offered, because nothing below a project can be detached.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X12" associationDirection="None" sourceRef="BP17.04_ReadTheProjectDeletionImpact" targetRef="TextAnnotation_X12" />
    <bpmn:textAnnotation id="TextAnnotation_X13"><bpmn:text>One request creates either kind. The new template starts from the default columns, one Backlog and one Done among them. The kind is declared once and never migrates. A plan orders and tracks; it carries no duration, no float and no critical path.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X13" associationDirection="None" sourceRef="BP17.02_CreateProject" targetRef="TextAnnotation_X13" />
    <bpmn:textAnnotation id="TextAnnotation_X14"><bpmn:text>An archived project is frozen until it is brought back, and it comes back as the whole bundle it went as.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X14" associationDirection="None" sourceRef="BP17.15_ArchiveProject" targetRef="TextAnnotation_X14" />
    <bpmn:textAnnotation id="TextAnnotation_X15"><bpmn:text>The parent survives a project's deletion. A goal left with no linked idea is flagged on its current state.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X15" associationDirection="None" sourceRef="BP17.05_DeleteProject" targetRef="TextAnnotation_X15" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Work to organize, or a project to settle">
      <bpmn:outgoing>SF_Start_1_courseTab</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="courseTab" name="Open the Course tab">
      <bpmn:incoming>SF_Start_1_courseTab</bpmn:incoming>
      <bpmn:incoming>SF_T_10_courseTab</bpmn:incoming>
      <bpmn:incoming>SF_T_14_courseTab</bpmn:incoming>
      <bpmn:incoming>SF_Gw_15_courseTab</bpmn:incoming>
      <bpmn:outgoing>SF_courseTab_list</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="list" name="The projects with their parents and kinds">
      <bpmn:incoming>SF_courseTab_list</bpmn:incoming>
      <bpmn:outgoing>SF_list_Gw_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_list" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_2" name="What needs doing?">
      <bpmn:incoming>SF_list_Gw_2</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_2_T_3</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_5</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_6</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_3" name="Name the project, its parent and its kind">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_Gw_2_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_T_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_4" name="Submit the new project">
      <bpmn:incoming>SF_T_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_created</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="created" name="Project created">
      <bpmn:incoming>SF_T_4_created</bpmn:incoming>
      <bpmn:outgoing>SF_created_Gw_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_created" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_5" name="Amend the project">
      <bpmn:incoming>SF_Gw_2_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_amended</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="amended" name="Project amended">
      <bpmn:incoming>SF_T_5_amended</bpmn:incoming>
      <bpmn:outgoing>SF_amended_Gw_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_amended" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_6" name="Open the project's course">
      <bpmn:incoming>SF_Gw_2_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_Gw_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_7" name="Choose a project to archive">
      <bpmn:incoming>SF_Gw_2_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_archImpact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="archImpact" name="What the archiving will take">
      <bpmn:incoming>SF_T_7_archImpact</bpmn:incoming>
      <bpmn:outgoing>SF_archImpact_Gw_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archImpact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_8" name="Approve what the archiving takes?">
      <bpmn:incoming>SF_archImpact_Gw_8</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_8_T_9</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_8_T_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_9" name="Confirm the archiving">
      <bpmn:incoming>SF_Gw_8_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_archived</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="archived" name="Project archived">
      <bpmn:incoming>SF_T_9_archived</bpmn:incoming>
      <bpmn:outgoing>SF_archived_Gw_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_archived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_10" name="Abandon the archiving">
      <bpmn:incoming>SF_Gw_8_T_10</bpmn:incoming>
      <bpmn:outgoing>SF_T_10_courseTab</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_11" name="Choose a project to delete">
      <bpmn:incoming>SF_Gw_2_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_delImpact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="delImpact" name="What the project deletion will take">
      <bpmn:incoming>SF_T_11_delImpact</bpmn:incoming>
      <bpmn:outgoing>SF_delImpact_Gw_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_delImpact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_12" name="Approve what the project deletion takes?">
      <bpmn:incoming>SF_delImpact_Gw_12</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_12_T_13</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_12_T_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_13" name="Confirm the project deletion">
      <bpmn:incoming>SF_Gw_12_T_13</bpmn:incoming>
      <bpmn:outgoing>SF_T_13_deleted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="deleted" name="Project deleted">
      <bpmn:incoming>SF_T_13_deleted</bpmn:incoming>
      <bpmn:outgoing>SF_deleted_Gw_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_deleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_14" name="Abandon the project deletion">
      <bpmn:incoming>SF_Gw_12_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_courseTab</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_15" name="Anything else on the Course tab?">
      <bpmn:incoming>SF_created_Gw_15</bpmn:incoming>
      <bpmn:incoming>SF_amended_Gw_15</bpmn:incoming>
      <bpmn:incoming>SF_T_6_Gw_15</bpmn:incoming>
      <bpmn:incoming>SF_archived_Gw_15</bpmn:incoming>
      <bpmn:incoming>SF_deleted_Gw_15</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_15_T_16</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_15_courseTab</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_16" name="Leave the Course tab">
      <bpmn:incoming>SF_Gw_15_T_16</bpmn:incoming>
      <bpmn:outgoing>SF_T_16_End_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_17" name="Projects current">
      <bpmn:incoming>SF_T_16_End_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_courseTab" sourceRef="Start_1" targetRef="courseTab" />
    <bpmn:sequenceFlow id="SF_courseTab_list" sourceRef="courseTab" targetRef="list" />
    <bpmn:sequenceFlow id="SF_list_Gw_2" sourceRef="list" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="SF_T_3_T_4" sourceRef="T_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_4_created" sourceRef="T_4" targetRef="created" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_3" name="start something new" sourceRef="Gw_2" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_T_5_amended" sourceRef="T_5" targetRef="amended" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_5" name="change what a project is" sourceRef="Gw_2" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_6" name="plan its work" sourceRef="Gw_2" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_T_7_archImpact" sourceRef="T_7" targetRef="archImpact" />
    <bpmn:sequenceFlow id="SF_archImpact_Gw_8" sourceRef="archImpact" targetRef="Gw_8" />
    <bpmn:sequenceFlow id="SF_T_9_archived" sourceRef="T_9" targetRef="archived" />
    <bpmn:sequenceFlow id="SF_Gw_8_T_9" name="approve" sourceRef="Gw_8" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_Gw_8_T_10" name="abandon" sourceRef="Gw_8" targetRef="T_10" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_7" name="set one aside" sourceRef="Gw_2" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_T_11_delImpact" sourceRef="T_11" targetRef="delImpact" />
    <bpmn:sequenceFlow id="SF_delImpact_Gw_12" sourceRef="delImpact" targetRef="Gw_12" />
    <bpmn:sequenceFlow id="SF_T_13_deleted" sourceRef="T_13" targetRef="deleted" />
    <bpmn:sequenceFlow id="SF_Gw_12_T_13" name="approve" sourceRef="Gw_12" targetRef="T_13" />
    <bpmn:sequenceFlow id="SF_Gw_12_T_14" name="abandon" sourceRef="Gw_12" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_11" name="end one" sourceRef="Gw_2" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_created_Gw_15" sourceRef="created" targetRef="Gw_15" />
    <bpmn:sequenceFlow id="SF_amended_Gw_15" sourceRef="amended" targetRef="Gw_15" />
    <bpmn:sequenceFlow id="SF_T_6_Gw_15" sourceRef="T_6" targetRef="Gw_15" />
    <bpmn:sequenceFlow id="SF_archived_Gw_15" sourceRef="archived" targetRef="Gw_15" />
    <bpmn:sequenceFlow id="SF_deleted_Gw_15" sourceRef="deleted" targetRef="Gw_15" />
    <bpmn:sequenceFlow id="SF_Gw_15_T_16" name="no" sourceRef="Gw_15" targetRef="T_16" />
    <bpmn:sequenceFlow id="SF_T_16_End_17" sourceRef="T_16" targetRef="End_17" />
    <bpmn:sequenceFlow id="SF_T_10_courseTab" sourceRef="T_10" targetRef="courseTab" />
    <bpmn:sequenceFlow id="SF_T_14_courseTab" sourceRef="T_14" targetRef="courseTab" />
    <bpmn:sequenceFlow id="SF_Gw_15_courseTab" name="yes" sourceRef="Gw_15" targetRef="courseTab" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="projectDraftIn" name="Project draft submitted">
      <bpmn:outgoing>SF_projectDraftIn_BP17.16_DraftTheProjectInput</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_projectDraftIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP17.16_DraftTheProjectInput" name="Draft the project input">
      <bpmn:incoming>SF_projectDraftIn_BP17.16_DraftTheProjectInput</bpmn:incoming>
      <bpmn:outgoing>SF_BP17.16_DraftTheProjectInput_End_19</bpmn:outgoing>
      <bpmn:startEvent id="BP17.16_DraftTheProjectInput_s" name="Start">
        <bpmn:outgoing>SF_BP17.16_DraftTheProjectInput_s_T_18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_18" name="Keep what is typed as a draft">
        <bpmn:incoming>SF_BP17.16_DraftTheProjectInput_s_T_18</bpmn:incoming>
        <bpmn:outgoing>SF_T_18_BP17.16_DraftTheProjectInput_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP17.16_DraftTheProjectInput_e" name="fertig">
        <bpmn:incoming>SF_T_18_BP17.16_DraftTheProjectInput_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_BP17.16_DraftTheProjectInput_s_T_18" sourceRef="BP17.16_DraftTheProjectInput_s" targetRef="T_18" />
      <bpmn:sequenceFlow id="SF_T_18_BP17.16_DraftTheProjectInput_e" sourceRef="T_18" targetRef="BP17.16_DraftTheProjectInput_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_19" name="Draft kept">
      <bpmn:incoming>SF_BP17.16_DraftTheProjectInput_End_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="listIn" name="Project list requested">
      <bpmn:outgoing>SF_listIn_BP17.01_ReadTheProjectList</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_listIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP17.01_ReadTheProjectList" name="Read the project list">
      <bpmn:incoming>SF_listIn_BP17.01_ReadTheProjectList</bpmn:incoming>
      <bpmn:outgoing>SF_BP17.01_ReadTheProjectList_End_23</bpmn:outgoing>
      <bpmn:startEvent id="BP17.01_ReadTheProjectList_s" name="Start">
        <bpmn:outgoing>SF_BP17.01_ReadTheProjectList_s_T_20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_20" name="Read the projects with their parent and their kind">
        <bpmn:incoming>SF_BP17.01_ReadTheProjectList_s_T_20</bpmn:incoming>
        <bpmn:outgoing>SF_T_20_T_21</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_21" name="Leave the archived ones out">
        <bpmn:incoming>SF_T_20_T_21</bpmn:incoming>
        <bpmn:outgoing>SF_T_21_T_22</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_22" name="Report each project's Done, InProgress and Todo counts">
        <bpmn:incoming>SF_T_21_T_22</bpmn:incoming>
        <bpmn:outgoing>SF_T_22_BP17.01_ReadTheProjectList_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP17.01_ReadTheProjectList_e" name="fertig">
        <bpmn:incoming>SF_T_22_BP17.01_ReadTheProjectList_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_20_T_21" sourceRef="T_20" targetRef="T_21" />
      <bpmn:sequenceFlow id="SF_T_21_T_22" sourceRef="T_21" targetRef="T_22" />
      <bpmn:sequenceFlow id="SF_BP17.01_ReadTheProjectList_s_T_20" sourceRef="BP17.01_ReadTheProjectList_s" targetRef="T_20" />
      <bpmn:sequenceFlow id="SF_T_22_BP17.01_ReadTheProjectList_e" sourceRef="T_22" targetRef="BP17.01_ReadTheProjectList_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_23" name="Project list answered">
      <bpmn:incoming>SF_BP17.01_ReadTheProjectList_End_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="createIn" name="Project submitted">
      <bpmn:outgoing>SF_createIn_BP17.02_CreateProject</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_createIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP17.02_CreateProject" name="Create a project">
      <bpmn:incoming>SF_createIn_BP17.02_CreateProject</bpmn:incoming>
