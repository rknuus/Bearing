<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BP18_PlanAProjectsCourse" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BP18_PlanAProjectsCourse">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Bearing" name="Bearing" processRef="Process_Bearing" />
    <bpmn:messageFlow id="MF_1" name="BP18.01 · Read a project's course" sourceRef="course" targetRef="courseIn" />
    <bpmn:messageFlow id="MF_2" name="BP18.09 · Draft the activity input" sourceRef="T_3" targetRef="activityDraftIn" />
    <bpmn:messageFlow id="MF_3" name="BP18.02 · Create an activity" sourceRef="T_4" targetRef="actCreateIn" />
    <bpmn:messageFlow id="MF_4" name="BP18.03 · Amend an activity" sourceRef="T_5" targetRef="actAmendIn" />
    <bpmn:messageFlow id="MF_5" name="BP18.04 · Set an activity's state" sourceRef="T_6" targetRef="stateIn" />
    <bpmn:messageFlow id="MF_6" name="BP18.07 · Add a dependency" sourceRef="T_7" targetRef="depAddIn" />
    <bpmn:messageFlow id="MF_7" name="BP18.08 · Remove a dependency" sourceRef="T_8" targetRef="depRemoveIn" />
    <bpmn:messageFlow id="MF_8" name="BP18.05 · See what deleting an activity takes" sourceRef="T_9" targetRef="actImpactIn" />
    <bpmn:messageFlow id="MF_9" name="BP18.06 · Delete an activity" sourceRef="T_11" targetRef="actDeleteIn" />
    <bpmn:messageFlow id="MF_10" name="The graph with its states and counts" sourceRef="BP18.01_ReadAProjectsCourse" targetRef="graph" />
    <bpmn:messageFlow id="MF_11" name="Activity created" sourceRef="BP18.02_CreateActivity" targetRef="actCreated" />
    <bpmn:messageFlow id="MF_12" name="Activity amended" sourceRef="BP18.03_AmendActivity" targetRef="actAmended" />
    <bpmn:messageFlow id="MF_13" name="State recorded" sourceRef="BP18.04_SetAnActivitysState" targetRef="stateSet" />
    <bpmn:messageFlow id="MF_14" name="Dependency recorded, or refused" sourceRef="BP18.07_AddDependency" targetRef="depAdded" />
    <bpmn:messageFlow id="MF_15" name="Dependency removed" sourceRef="BP18.08_RemoveDependency" targetRef="depRemoved" />
    <bpmn:messageFlow id="MF_16" name="What the activity deletion will take" sourceRef="BP18.05_ReadTheActivityDeletionImpact" targetRef="actImpact" />
    <bpmn:messageFlow id="MF_17" name="Activity deleted" sourceRef="BP18.06_DeleteActivity" targetRef="actDeleted" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>Todo, InProgress or Done. One request closes an activity and reopens a Done one.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="stateSet" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>Finish-to-start, and only between activities of this project.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="depAdded" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>An activity-based project only. Creating an activity is what brings its board into existence.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="actCreated" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>Nothing is deleted and no dependency is reconnected.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="T_12" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>The result is a graph, not a chain: several activities may be ready at once. The flag names the predecessor and clears itself when that predecessor completes. A plan orders and tracks; it carries no duration, no float and no critical path.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="BP18.01_ReadAProjectsCourse" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>Every form on this surface drafts as it is filled in, so leaving it half-finished, a crash and a restart all cost nothing. The draft is one-way: nothing waits for it to be kept. Whichever write commits the form discards it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="BP18.09_DraftTheActivityInput" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>The state is not among them: it is set by its own request.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="BP18.03_AmendActivity" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>One request serves Todo, InProgress and Done, and reopening a Done activity. This is also where BP11's completion offer lands.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="BP18.04_SetAnActivitysState" targetRef="TextAnnotation_X8" />
    <bpmn:textAnnotation id="TextAnnotation_X9"><bpmn:text>No start-to-start, no lag, no overlap, and no edge to another project's activity. There is one dependency type, and it is technical.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X9" associationDirection="None" sourceRef="BP18.07_AddDependency" targetRef="TextAnnotation_X9" />
    <bpmn:textAnnotation id="TextAnnotation_X10"><bpmn:text>A task needs a board, so declining has no legal outcome: the gesture is approved or abandoned. The dependency edges simply go.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X10" associationDirection="None" sourceRef="BP18.05_ReadTheActivityDeletionImpact" targetRef="TextAnnotation_X10" />
    <bpmn:textAnnotation id="TextAnnotation_X11"><bpmn:text>Activities are flat: finer granularity means more activities, never sub-activities. A board exists because its owner was created.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X11" associationDirection="None" sourceRef="BP18.02_CreateActivity" targetRef="TextAnnotation_X11" />
    <bpmn:textAnnotation id="TextAnnotation_X12"><bpmn:text>The gap an edge leaves is not closed transitively. An activity is never archived on its own; only its project's archiving takes it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X12" associationDirection="None" sourceRef="BP18.06_DeleteActivity" targetRef="TextAnnotation_X12" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A plan to lay out, or work to move on">
      <bpmn:outgoing>SF_Start_1_course</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="course" name="Open a project's course">
      <bpmn:incoming>SF_Start_1_course</bpmn:incoming>
      <bpmn:incoming>SF_T_12_course</bpmn:incoming>
      <bpmn:incoming>SF_Gw_13_course</bpmn:incoming>
      <bpmn:outgoing>SF_course_graph</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="graph" name="The graph with its states and counts">
      <bpmn:incoming>SF_course_graph</bpmn:incoming>
      <bpmn:outgoing>SF_graph_Gw_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_graph" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_2" name="Which part of the plan?">
      <bpmn:incoming>SF_graph_Gw_2</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_2_T_3</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_5</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_6</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_8</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_2_T_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_3" name="Name the activity">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>SF_Gw_2_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_T_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_4" name="Submit the new activity">
      <bpmn:incoming>SF_T_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_actCreated</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="actCreated" name="Activity created">
      <bpmn:incoming>SF_T_4_actCreated</bpmn:incoming>
      <bpmn:outgoing>SF_actCreated_Gw_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_actCreated" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_5" name="Amend the activity">
      <bpmn:incoming>SF_Gw_2_T_5</bpmn:incoming>
      <bpmn:outgoing>SF_T_5_actAmended</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="actAmended" name="Activity amended">
      <bpmn:incoming>SF_T_5_actAmended</bpmn:incoming>
      <bpmn:outgoing>SF_actAmended_Gw_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_actAmended" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_6" name="Set the activity's state">
      <bpmn:incoming>SF_Gw_2_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_stateSet</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="stateSet" name="State recorded">
      <bpmn:incoming>SF_T_6_stateSet</bpmn:incoming>
      <bpmn:outgoing>SF_stateSet_Gw_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_stateSet" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_7" name="Draw a dependency between two activities">
      <bpmn:incoming>SF_Gw_2_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_depAdded</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="depAdded" name="Dependency recorded, or refused">
      <bpmn:incoming>SF_T_7_depAdded</bpmn:incoming>
      <bpmn:outgoing>SF_depAdded_Gw_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_depAdded" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_8" name="Pick a dependency to remove">
      <bpmn:incoming>SF_Gw_2_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_depRemoved</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="depRemoved" name="Dependency removed">
      <bpmn:incoming>SF_T_8_depRemoved</bpmn:incoming>
      <bpmn:outgoing>SF_depRemoved_Gw_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_depRemoved" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_9" name="Choose an activity to delete">
      <bpmn:incoming>SF_Gw_2_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_actImpact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="actImpact" name="What the activity deletion will take">
      <bpmn:incoming>SF_T_9_actImpact</bpmn:incoming>
      <bpmn:outgoing>SF_actImpact_Gw_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_actImpact" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_10" name="Approve what the activity deletion takes?">
      <bpmn:incoming>SF_actImpact_Gw_10</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_10_T_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_10_T_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_11" name="Confirm the activity deletion">
      <bpmn:incoming>SF_Gw_10_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_actDeleted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="actDeleted" name="Activity deleted">
      <bpmn:incoming>SF_T_11_actDeleted</bpmn:incoming>
      <bpmn:outgoing>SF_actDeleted_Gw_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_actDeleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_12" name="Abandon the activity deletion">
      <bpmn:incoming>SF_Gw_10_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_course</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_13" name="Anything else in this plan?">
      <bpmn:incoming>SF_actCreated_Gw_13</bpmn:incoming>
      <bpmn:incoming>SF_actAmended_Gw_13</bpmn:incoming>
      <bpmn:incoming>SF_stateSet_Gw_13</bpmn:incoming>
      <bpmn:incoming>SF_depAdded_Gw_13</bpmn:incoming>
      <bpmn:incoming>SF_depRemoved_Gw_13</bpmn:incoming>
      <bpmn:incoming>SF_actDeleted_Gw_13</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_13_T_14</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_13_course</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_14" name="Leave the course">
      <bpmn:incoming>SF_Gw_13_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_End_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_15" name="Plan current">
      <bpmn:incoming>SF_T_14_End_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Start_1_course" sourceRef="Start_1" targetRef="course" />
    <bpmn:sequenceFlow id="SF_course_graph" sourceRef="course" targetRef="graph" />
    <bpmn:sequenceFlow id="SF_graph_Gw_2" sourceRef="graph" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="SF_T_3_T_4" sourceRef="T_3" targetRef="T_4" />
    <bpmn:sequenceFlow id="SF_T_4_actCreated" sourceRef="T_4" targetRef="actCreated" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_3" name="add an activity" sourceRef="Gw_2" targetRef="T_3" />
    <bpmn:sequenceFlow id="SF_T_5_actAmended" sourceRef="T_5" targetRef="actAmended" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_5" name="change one" sourceRef="Gw_2" targetRef="T_5" />
    <bpmn:sequenceFlow id="SF_T_6_stateSet" sourceRef="T_6" targetRef="stateSet" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_6" name="move one along, or reopen it" sourceRef="Gw_2" targetRef="T_6" />
    <bpmn:sequenceFlow id="SF_T_7_depAdded" sourceRef="T_7" targetRef="depAdded" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_7" name="say what waits for what" sourceRef="Gw_2" targetRef="T_7" />
    <bpmn:sequenceFlow id="SF_T_8_depRemoved" sourceRef="T_8" targetRef="depRemoved" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_8" name="drop a dependency" sourceRef="Gw_2" targetRef="T_8" />
    <bpmn:sequenceFlow id="SF_T_9_actImpact" sourceRef="T_9" targetRef="actImpact" />
    <bpmn:sequenceFlow id="SF_actImpact_Gw_10" sourceRef="actImpact" targetRef="Gw_10" />
    <bpmn:sequenceFlow id="SF_T_11_actDeleted" sourceRef="T_11" targetRef="actDeleted" />
    <bpmn:sequenceFlow id="SF_Gw_10_T_11" name="approve" sourceRef="Gw_10" targetRef="T_11" />
    <bpmn:sequenceFlow id="SF_Gw_10_T_12" name="abandon" sourceRef="Gw_10" targetRef="T_12" />
    <bpmn:sequenceFlow id="SF_Gw_2_T_9" name="remove an activity" sourceRef="Gw_2" targetRef="T_9" />
    <bpmn:sequenceFlow id="SF_actCreated_Gw_13" sourceRef="actCreated" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_actAmended_Gw_13" sourceRef="actAmended" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_stateSet_Gw_13" sourceRef="stateSet" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_depAdded_Gw_13" sourceRef="depAdded" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_depRemoved_Gw_13" sourceRef="depRemoved" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_actDeleted_Gw_13" sourceRef="actDeleted" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="SF_Gw_13_T_14" name="no" sourceRef="Gw_13" targetRef="T_14" />
    <bpmn:sequenceFlow id="SF_T_14_End_15" sourceRef="T_14" targetRef="End_15" />
    <bpmn:sequenceFlow id="SF_T_12_course" sourceRef="T_12" targetRef="course" />
    <bpmn:sequenceFlow id="SF_Gw_13_course" name="yes" sourceRef="Gw_13" targetRef="course" />
  </bpmn:process>
  <bpmn:process id="Process_Bearing" isExecutable="false">
    <bpmn:startEvent id="activityDraftIn" name="Activity draft submitted">
      <bpmn:outgoing>SF_activityDraftIn_BP18.09_DraftTheActivityInput</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_activityDraftIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP18.09_DraftTheActivityInput" name="Draft the activity input">
      <bpmn:incoming>SF_activityDraftIn_BP18.09_DraftTheActivityInput</bpmn:incoming>
      <bpmn:outgoing>SF_BP18.09_DraftTheActivityInput_End_17</bpmn:outgoing>
      <bpmn:startEvent id="BP18.09_DraftTheActivityInput_s" name="Start">
        <bpmn:outgoing>SF_BP18.09_DraftTheActivityInput_s_T_16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_16" name="Keep what is typed as a draft">
        <bpmn:incoming>SF_BP18.09_DraftTheActivityInput_s_T_16</bpmn:incoming>
        <bpmn:outgoing>SF_T_16_BP18.09_DraftTheActivityInput_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP18.09_DraftTheActivityInput_e" name="fertig">
        <bpmn:incoming>SF_T_16_BP18.09_DraftTheActivityInput_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_BP18.09_DraftTheActivityInput_s_T_16" sourceRef="BP18.09_DraftTheActivityInput_s" targetRef="T_16" />
      <bpmn:sequenceFlow id="SF_T_16_BP18.09_DraftTheActivityInput_e" sourceRef="T_16" targetRef="BP18.09_DraftTheActivityInput_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_17" name="Draft kept">
      <bpmn:incoming>SF_BP18.09_DraftTheActivityInput_End_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="courseIn" name="Course requested">
      <bpmn:outgoing>SF_courseIn_BP18.01_ReadAProjectsCourse</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_courseIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP18.01_ReadAProjectsCourse" name="Read a project's course">
      <bpmn:incoming>SF_courseIn_BP18.01_ReadAProjectsCourse</bpmn:incoming>
      <bpmn:outgoing>SF_BP18.01_ReadAProjectsCourse_End_23</bpmn:outgoing>
      <bpmn:startEvent id="BP18.01_ReadAProjectsCourse_s" name="Start">
        <bpmn:outgoing>SF_BP18.01_ReadAProjectsCourse_s_T_18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T_18" name="Read the project's activities with their state and notes">
        <bpmn:incoming>SF_BP18.01_ReadAProjectsCourse_s_T_18</bpmn:incoming>
        <bpmn:outgoing>SF_T_18_T_19</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_19" name="Read the dependencies between them">
        <bpmn:incoming>SF_T_18_T_19</bpmn:incoming>
        <bpmn:outgoing>SF_T_19_T_20</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_20" name="Order them by dependency, then by name">
        <bpmn:incoming>SF_T_19_T_20</bpmn:incoming>
        <bpmn:outgoing>SF_T_20_T_21</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_21" name="Flag an activity whose predecessor is unfinished">
        <bpmn:incoming>SF_T_20_T_21</bpmn:incoming>
        <bpmn:outgoing>SF_T_21_T_22</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="T_22" name="Report the Done, InProgress and Todo counts">
        <bpmn:incoming>SF_T_21_T_22</bpmn:incoming>
        <bpmn:outgoing>SF_T_22_BP18.01_ReadAProjectsCourse_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="BP18.01_ReadAProjectsCourse_e" name="fertig">
        <bpmn:incoming>SF_T_22_BP18.01_ReadAProjectsCourse_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_T_18_T_19" sourceRef="T_18" targetRef="T_19" />
      <bpmn:sequenceFlow id="SF_T_19_T_20" sourceRef="T_19" targetRef="T_20" />
      <bpmn:sequenceFlow id="SF_T_20_T_21" sourceRef="T_20" targetRef="T_21" />
      <bpmn:sequenceFlow id="SF_T_21_T_22" sourceRef="T_21" targetRef="T_22" />
      <bpmn:sequenceFlow id="SF_BP18.01_ReadAProjectsCourse_s_T_18" sourceRef="BP18.01_ReadAProjectsCourse_s" targetRef="T_18" />
      <bpmn:sequenceFlow id="SF_T_22_BP18.01_ReadAProjectsCourse_e" sourceRef="T_22" targetRef="BP18.01_ReadAProjectsCourse_e" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_23" name="Course answered">
      <bpmn:incoming>SF_BP18.01_ReadAProjectsCourse_End_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="actCreateIn" name="Activity submitted">
      <bpmn:outgoing>SF_actCreateIn_BP18.02_CreateActivity</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_actCreateIn" />
    </bpmn:startEvent>
    <bpmn:subProcess id="BP18.02_CreateActivity" name="Create an activity">
      <bpmn:incoming>SF_actCreateIn_BP18.02_CreateActivity</bpmn:incoming>
