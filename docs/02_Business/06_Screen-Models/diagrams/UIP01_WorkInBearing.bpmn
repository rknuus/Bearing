<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="UIP01_WorkInBearing" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_UIP01_WorkInBearing">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:textAnnotation id="TextAnnotation_X1"><bpmn:text>The entities and the records the product keeps, read once and from then on in play. Which they are is the entity vocabulary's and the record inventory's business, not this drawing's.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X1" associationDirection="None" sourceRef="T_2" targetRef="TextAnnotation_X1" />
    <bpmn:textAnnotation id="TextAnnotation_X2"><bpmn:text>Everything the surfaces show that the product does not store - counts, flags, orderings, what is due, what is ready, the theme balance. Which values these are, and which rule governs each, is the derived-data inventory's business.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X2" associationDirection="None" sourceRef="T_3" targetRef="TextAnnotation_X2" />
    <bpmn:textAnnotation id="TextAnnotation_X3"><bpmn:text>The Focus tab on a returning launch, the Themes tab where a data folder was just set up (BP01). At local midnight the date advances under the user, disturbing no gesture in flight and offering the day focus editor where the new date has none (BP14).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X3" associationDirection="None" sourceRef="T_4" targetRef="TextAnnotation_X3" />
    <bpmn:textAnnotation id="TextAnnotation_X4"><bpmn:text>The themes with their vision and mission (BP02); the routines' home, one list and not a theme's sub-list (BP03).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X4" associationDirection="None" sourceRef="T_6" targetRef="TextAnnotation_X4" />
    <bpmn:textAnnotation id="TextAnnotation_X5"><bpmn:text>Ideas (BP04). Committing to one or starting work on one opens that editor here (BP05, BP17).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X5" associationDirection="None" sourceRef="T_7" targetRef="TextAnnotation_X5" />
    <bpmn:textAnnotation id="TextAnnotation_X6"><bpmn:text>Goals grouped by theme with their measures (BP05, BP06); the check-out sitting opens over the tab (BP07).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X6" associationDirection="None" sourceRef="T_8" targetRef="TextAnnotation_X6" />
    <bpmn:textAnnotation id="TextAnnotation_X7"><bpmn:text>The projects (BP17) and one activity-based project's course (BP18).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X7" associationDirection="None" sourceRef="T_9" targetRef="TextAnnotation_X7" />
    <bpmn:textAnnotation id="TextAnnotation_X8"><bpmn:text>Week, month and year, one view stepped and re-scoped (UIP02); a selected day opens the day focus editor (BP08).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X8" associationDirection="None" sourceRef="T_10" targetRef="TextAnnotation_X8" />
    <bpmn:textAnnotation id="TextAnnotation_X9"><bpmn:text>The strip and the board (BP11); capture (BP10), the lanes (BP12) and the work check-out (BP13) open over the tab.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X9" associationDirection="None" sourceRef="T_11" targetRef="TextAnnotation_X9" />
    <bpmn:textAnnotation id="TextAnnotation_X10"><bpmn:text>One view per kind, reached by an explicit act from the tab that owns it (BP15).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X10" associationDirection="None" sourceRef="T_12" targetRef="TextAnnotation_X10" />
    <bpmn:textAnnotation id="TextAnnotation_X11"><bpmn:text>Splits the active tab rather than replacing it, and blocks nothing (BP16).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X11" associationDirection="None" sourceRef="T_13" targetRef="TextAnnotation_X11" />
    <bpmn:textAnnotation id="TextAnnotation_X12"><bpmn:text>Shell chrome, not a tab.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X12" associationDirection="None" sourceRef="T_14" targetRef="TextAnnotation_X12" />
    <bpmn:textAnnotation id="TextAnnotation_X13"><bpmn:text>Ending the session is its own process (BP20): every gesture is committed or left as a draft, which survives the close, and nothing is settled by it.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_X13" associationDirection="None" sourceRef="T_15" targetRef="TextAnnotation_X13" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Bearing launched">
      <bpmn:outgoing>SF_Start_1_T_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_2" name="Load the persistent data">
      <bpmn:incoming>SF_Start_1_T_2</bpmn:incoming>
      <bpmn:outgoing>SF_T_2_T_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_3" name="Calculate the derived data">
      <bpmn:incoming>SF_T_2_T_3</bpmn:incoming>
      <bpmn:outgoing>SF_T_3_T_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_4" name="Land on the tab the launch chose">
      <bpmn:incoming>SF_T_3_T_4</bpmn:incoming>
      <bpmn:outgoing>SF_T_4_shell</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="shell" name="Choose where to work">
      <bpmn:incoming>SF_T_4_shell</bpmn:incoming>
      <bpmn:incoming>SF_T_6_shell</bpmn:incoming>
      <bpmn:incoming>SF_T_7_shell</bpmn:incoming>
      <bpmn:incoming>SF_T_8_shell</bpmn:incoming>
      <bpmn:incoming>SF_T_9_shell</bpmn:incoming>
      <bpmn:incoming>SF_T_10_shell</bpmn:incoming>
      <bpmn:incoming>SF_T_11_shell</bpmn:incoming>
      <bpmn:incoming>SF_T_12_shell</bpmn:incoming>
      <bpmn:incoming>SF_T_13_shell</bpmn:incoming>
      <bpmn:incoming>SF_T_14_shell</bpmn:incoming>
      <bpmn:outgoing>SF_shell_Gw_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_5" name="Which surface?">
      <bpmn:incoming>SF_shell_Gw_5</bpmn:incoming>
      <bpmn:outgoing>SF_Gw_5_T_6</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_5_T_7</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_5_T_8</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_5_T_9</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_5_T_10</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_5_T_11</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_5_T_12</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_5_T_13</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_5_T_14</bpmn:outgoing>
      <bpmn:outgoing>SF_Gw_5_T_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_6" name="Work the Themes tab">
      <bpmn:standardLoopCharacteristics />
      <bpmn:incoming>SF_Gw_5_T_6</bpmn:incoming>
      <bpmn:outgoing>SF_T_6_shell</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_7" name="Work the Ideation tab">
      <bpmn:standardLoopCharacteristics />
      <bpmn:incoming>SF_Gw_5_T_7</bpmn:incoming>
      <bpmn:outgoing>SF_T_7_shell</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_8" name="Work the Goals tab">
      <bpmn:standardLoopCharacteristics />
      <bpmn:incoming>SF_Gw_5_T_8</bpmn:incoming>
      <bpmn:outgoing>SF_T_8_shell</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_9" name="Work the Course tab">
      <bpmn:standardLoopCharacteristics />
      <bpmn:incoming>SF_Gw_5_T_9</bpmn:incoming>
      <bpmn:outgoing>SF_T_9_shell</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_10" name="Work the Focus tab">
      <bpmn:standardLoopCharacteristics />
      <bpmn:incoming>SF_Gw_5_T_10</bpmn:incoming>
      <bpmn:outgoing>SF_T_10_shell</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_11" name="Work the Execution tab">
      <bpmn:standardLoopCharacteristics />
      <bpmn:incoming>SF_Gw_5_T_11</bpmn:incoming>
      <bpmn:outgoing>SF_T_11_shell</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_12" name="Work an archive view">
      <bpmn:standardLoopCharacteristics />
      <bpmn:incoming>SF_Gw_5_T_12</bpmn:incoming>
      <bpmn:outgoing>SF_T_12_shell</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_13" name="Work the advisor panel">
      <bpmn:standardLoopCharacteristics />
      <bpmn:incoming>SF_Gw_5_T_13</bpmn:incoming>
      <bpmn:outgoing>SF_T_13_shell</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_14" name="Read About, or the keyboard shortcuts">
      <bpmn:incoming>SF_Gw_5_T_14</bpmn:incoming>
      <bpmn:outgoing>SF_T_14_shell</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_15" name="Leave Bearing">
      <bpmn:incoming>SF_Gw_5_T_15</bpmn:incoming>
      <bpmn:outgoing>SF_T_15_End_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_16" name="Bearing closed">
      <bpmn:incoming>SF_T_15_End_16</bpmn:incoming>
    </bpmn:endEvent>
